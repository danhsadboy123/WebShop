@model WebShop.ModelViews.HomeViewVM
@inject WebShop.Services.IPageInfoService PageInfoService

@{
    var pageInfo = PageInfoService.GetPageInfo();
    ViewData["Title"] = pageInfo?.Title ?? "laplopstore - Trang chủ";
    ViewData["MoTa"] = pageInfo?.MetaDesc ?? "Khám phá sản phẩm chất lượng tại laplopstore";
    ViewData["Keywords"] = pageInfo?.MetaKey ?? "laplopstore, sản phẩm, mua sắm";
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
@section Styles {
    <!-- Add custom styles here if needed -->
}

<!-- Products Start -->
<div class="container-fluid pt-5 pb-3">
    @if (ViewBag.categoriesWithProducts != null)
    {
        foreach (var item in ViewBag.categoriesWithProducts)
        {
            <a href="@item.category.Alias" title="Xem tất cả sản phẩm danh mục @item.category.CatName">
                <h2 class="section-title position-relative text-uppercase mx-xl-5 mb-4 mt-5">
                    <span class="bg-secondary pr-3">@item.category.CatName</span>
                </h2>
            </a>
            <div class="row px-xl-5" style="margin: 0; padding: 0; justify-content: center;">
                <div class="row col-12 justify-content-center">
                    @foreach (var product in item.lsProducts ?? Enumerable.Empty<WebShop.Models.Product>())
                    {
                        <div class="col-6 col-md-4 col-lg-3 item-product-Cate mb-4" title="Chi tiết sản phẩm @product.ProductName">
                            <div class="product-item bg-light" style="padding: 15px">
                                <div class="product-img position-relative overflow-hidden">
                                    <div class="d-flex justify-content-center" style="height: 200px;">
                                        <img style="object-fit: contain;" class="img-fluid" src="https://novazone.co/@product.Avatar" alt="@product.ProductName - @item.category.CatName" loading="lazy">
                                    </div>
                                    <div class="product-action">
                                        @if (product.UnitsInStock > 0)
                                        {
                                            <a class="btn btn-outline-dark btn-square" href="javascript:void(0)" onclick="addToCart(@product.ProductId)"><i class="fa fa-shopping-cart"></i></a>
                                            <a class="btn btn-outline-dark btn-square" href="/@product.Alias-@product.ProductId"><i class="fa fa-ellipsis-h"></i></a>
                                        }
                                        else
                                        {
                                            <a class="btn btn-outline-dark btn-square" href="/@product.Alias-@product.ProductId"><i class="fa fa-bars"></i></a>
                                        }
                                    </div>
                                </div>
                                <div class="text-center py-3">
                                    <a class="text-decoration-none text-dark"
                                       style="height: 3.3em; display: block; overflow: hidden; line-height: 1.5em; white-space: normal; text-overflow: ellipsis; text-align: left; font-size: 15px; font-weight: bold;"
                                       href="/@product.Alias-@product.ProductId">
                                        @product.ProductName
                                    </a>
                                    <div class="d-md-flex justify-content-center mt-2 flex-column">
                                        @if (product.Price <= 0)
                                        {
                                            <div class="d-flex" style="font-size: 17px; text-align: left;">
                                                <span class="text-muted" style="margin-right: 5px;"> </span>
                                                <span class="text-success ml-2 d-none d-lg-inline"></span>
                                            </div>
                                            <span class="d-block">Giá: <b class="text-danger">Liên hệ</b></span>
                                        }
                                        else
                                        {
                                            @if (product.SalePrice.HasValue && product.SalePrice < product.Price)
                                            {
                                                <div class="d-flex" style="font-size: 13px; text-align: left;">
                                                    <span class="text-muted" style="margin-right: 5px;"><del>@product.Price.ToString("N0")₫</del></span>
                                                    <span class="text-success ml-2 d-none d-lg-inline">Tiết kiệm @((product.Price - product.SalePrice.Value).ToString("N0"))₫</span>
                                                </div>
                                                <span class="text-danger" style="font-size: 1.1em; font-weight: bold; text-align: left;">Giá: @product.SalePrice.Value.ToString("N0")₫</span>
                                            }
                                            else
                                            {
                                                <div class="d-flex" style="font-size: 17px; text-align: left;">
                                                    <span class="text-muted" style="margin-right: 5px;"> </span>
                                                    <span class="text-success ml-2 d-none d-lg-inline"></span>
                                                </div>
                                                <span class="text-danger" style="font-size: 1.1em; font-weight: bold; text-align: left;">Giá: @product.Price.ToString("N0")₫</span>
                                            }
                                        }
                                    </div>
                                    <div class="mt-1" style="text-align: left;">
                                        @if (product.UnitsInStock > 0)
                                        {
                                            <span style="color: #2cc067; font-size: 14px; line-height: 30px;"><i class="fa fa-check" style="color: #2cc067"></i> Sẵn hàng</span>
                                        }
                                        else
                                        {
                                            <span style="color: #0074da"><i class="fas fa-SoDienThoai fa-flip-horizontal"></i> Đặt hàng</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <p class="text-center">Không có sản phẩm để hiển thị.</p>
    }
</div>
<!-- Products End -->
@section Scripts {
    <script>
        function addToCart(productId) {
            // Implement cart addition logic here
            console.log('Adding product to cart:', productId);
            // Example: AJAX call or redirect
        }
    </script>
}