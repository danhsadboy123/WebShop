@model WebShop.Models.KhuyenMai
@{
    ViewData["Title"] = "";
    ViewData["MoTa"] = "";
    ViewData["Keywords"] = "";

    string ConvertToVND(decimal amount)
    {
        return string.Format("{0:N0} VNĐ", amount);
    }

    int CalculateDiscountPercent(decimal originalPrice, decimal? salePrice)
    {
        if (salePrice.HasValue && originalPrice > salePrice.Value)
        {
            return (int)((originalPrice - salePrice.Value) / originalPrice * 100);
        }
        return 0;
    }
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
@section Styles {
    <style>
        .discount {
            position: absolute;
            top: 4px;
            right: 4px;
            padding: 5px;
            background-color: #ff0003;
            color: #fff;
            font-weight: bold;
            font-size: 14px;
            border-radius: 0px 0px 0 10px;
            width: 50px;
            text-align: center;
        }
    </style>
}
 
<div class=" " style="max-width: 100%;margin: 0px auto;">
    <img src="https://novazone.co/images/Banner/banner2.png" class="w-100 h-25" alt="khuyen-mai-gia-khung" />
</div>

<div class="container-fluid pt-5 pb-3">
    <div class="row px-xl-5" style="justify-content:center;">
        @foreach (var category in ViewBag.ProductsByCategory)
        {
            <div class="col-12"> 
                <div class="row">
                    @foreach (var product in category.Value)
                    {
                        <div class="col-lg-2 col-md-4 col-sm-6 p-1 col-6" title="Xem chi tiết @product.ProductName">
                            <div class="product-item bg-light mb-1" style="padding:15px">
                                <div class="product-img position-relative overflow-hidden">
                                    <div class="d-flex justify-content-center" style="height:200px;">
                                        <img style="object-fit:contain;" class="img-fluid" src="https://novazone.co/@product.Avatar" alt="@product.Alias" loading="lazy">
                                    </div>

                                    @if (Model.Code == null)
                                    {
                                        <div class="discount">
                                            - @Model.Discount1 % <!-- Hiển thị tỷ lệ giảm giá -->
                                        </div>
                                    }

                                    <div class="product-action">
                                        @if (product.UnitsInStock > 0)
                                        {
                                            <a class="btn btn-outline-dark btn-square" href="javascript:void(0)" onclick="addToCart(@product.ProductId)"><i class="fa fa-shopping-cart"></i></a>
                                            <a class="btn btn-outline-dark btn-square" href="/@product.Alias-@product.ProductId"><i class="fa fa-ellipsis-h"></i></a>
                                        }
                                        else
                                        {
                                            <a class="btn btn-outline-dark btn-square" href="/@product.Alias-@product.ProductId"><i class="fa fa-bars"></i></a>
                                        }
                                    </div>
                                </div>

                                <div class="text-center py-3">
                                    <a class="text-decoration-none p-7 text-dark"
                                       style="height: 3.3em; display: block; overflow: hidden; line-height: 1.5em; white-space: normal; text-overflow: ellipsis; text-align:left; font-size:15px;font-weight: bold;"
                                       href="/@product.Alias-@product.ProductId">
                                        @product.ProductName
                                    </a>

                                    <div class="d-md-flex justify-content-center mt-2 flex-column">
                                        @if (product.Price <= 0)
                                        {
                                            <div class="md-d-flex" style="font-size: 13px;text-align:left;">
                                                <span class="text-muted" style="margin-right: 5px;"> </span>
                                                <span class="text-success ml-2 d-none d-lg-inline"></span>
                                            </div>
                                            <span class="d-block">Giá: <b class="text-danger">liên hệ</b></span>
                                        }
                                        else
                                        {
                                            @if (product.SalePrice != null && product.SalePrice < product.Price)
                                            {
                                                // Nếu có SalePrice và giá SalePrice nhỏ hơn giá gốc
                                                int percentDiscount = (int)Model.Discount1; // Tỷ lệ giảm giá
                                                decimal discountedPrice = (decimal)product.SalePrice * (1 - percentDiscount / 100m);

                                                <div class="md-d-flex" style="font-size: 13px; text-align: left;">
                                                    <span class="text-muted" style="margin-right: 5px;">
                                                        <del>@ConvertToVND((decimal)product.Price)</del> <!-- Giá gốc bị gạch -->
                                                    </span>
                                                    <span class="text-success ml-2 d-none d-lg-inline">
                                                        Tiết kiệm @ConvertToVND((decimal)product.Price - discountedPrice) <!-- Tiết kiệm -->
                                                    </span>
                                                </div>
                                                <span class="text-danger" style="font-size: 1.1em; font-weight: bold; text-align: left;">
                                                    Giá: @ConvertToVND(discountedPrice) <!-- Giá sau giảm -->
                                                </span>
                                            }
                                            else
                                            {
                                                // Nếu không có SalePrice, tính giảm giá từ Price (giá gốc)
                                                int percentDiscount = (int)Model.Discount1; // Tỷ lệ giảm giá
                                                decimal discountedPrice = (decimal)product.Price * (1 - percentDiscount / 100m); // Tính giá giảm

                                                <div class="md-d-flex" style="font-size: 13px; text-align: left;">
                                                    <span class="text-muted" style="margin-right: 5px;">
                                                        <del>@ConvertToVND((decimal)product.Price)</del> <!-- Giá gốc bị gạch -->
                                                    </span>
                                                    <span class="text-success ml-2 d-none d-lg-inline">
                                                        Tiết kiệm @ConvertToVND((decimal)product.Price - discountedPrice) <!-- Tiết kiệm -->
                                                    </span>
                                                </div>
                                                <span class="text-danger" style="font-size: 1.1em; font-weight: bold; text-align: left;">
                                                    Giá: @ConvertToVND(discountedPrice) <!-- Giá sau giảm -->
                                                </span>
                                            }
                                        }
                                    </div>

                                    <div class="mt-1" style="text-align:left;">
                                        @if (product.UnitsInStock > 0)
                                        {
                                            <span style="color: #2cc067; font-size: 14px; line-height: 30px;">
                                                <i class="fa fa-check" style="color:#2cc067"></i> Sẵn hàng
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="color:#0074da"><i class="fas fa-SoDienThoai fa-flip-horizontal"></i> Đặt hàng</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
