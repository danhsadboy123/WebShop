@{
    ViewData["Title"] = "Giới thiệu về Công ty TNHH Novazone - Cung cấp Laptop, PC, Server và Thiết bị Công nghệ Thông Tin Chính Hãng";
}

@section Styles{
    <style>
        * {
            padding: 0;
            margin: 0;
            box-sizing: border-box;
        }

        body {
            background-color: #F0F1FB !important;
            color: #3c3e3f;
        }


        .btn-primary {
            background-color: #16bcdc;
            border: none;
            color: #FFF !important;
        }

        .content-right-1 {
            font-family: "Roboto", sans-serif;
            font-size: 1.2rem;
            line-height: 1.6;
            text-align: justify;
            line-height: 1.8rem;
        }

        .content-left-1 {
            font-size: 1.25rem;
            text-align: center;
            padding: 10px 20px;
            position: relative;
        }

        .title {
            font-size: 2rem;
            font-weight: bold;
            font-family: "Roboto", sans-serif;
            color: #16bcdc;
        }

        .row {
            align-items: center;
        }

        .border {
            border: 1px dashed #dee2e6 !important;
        }

        .btn-title {
            width: 100%;
            margin: 10px;
            height: 67px;
            color: #FFF !important;
            align-items: center;
            display: flex;
            justify-content: center;
        }
 
        /* Đặt ảnh với position relative để phần tử con được căn chỉnh đúng */
        .position-relative {
            position: relative;
        }

        /* Đặt vị trí tuyệt đối cho phần tử con và căn giữa */
        .position-absolute.center-text {
            position: absolute; /* Đặt phần tử tuyệt đối so với phần tử cha */
            top: 80%; /* Đặt phần tử ở giữa theo chiều dọc */
            left: 50%; /* Đặt phần tử ở giữa theo chiều ngang */
            transform: translate(-50%, -50%); /* Đảm bảo phần tử căn chính xác ở trung tâm */
            color: white; /* Màu chữ sáng để nổi bật trên nền tối */
            font-weight: bold; /* Định dạng chữ đậm */
            font-size: 17px; /* Kích thước chữ */
            padding: 10px 15px; /* Padding để thêm khoảng cách từ viền */
            background-color: #FFF; /* Nền mờ để làm nổi bật chữ */
            border-radius: 15px; /* Làm cho viền của phần tử chữ tròn */
        }

       
        /* Responsive adjustments */
        @@media (min-width: 768px) {
            .content-left-1 {
                padding: 10px 40px;
                font-size: 1.5rem;
                text-align: right !important;
            }

            .title {
                font-size: 2rem;
            }

            .btn-title {
                width: 100%; 
                margin: 10px;
                height: 67px;
                color: #FFF !important;
                align-items: center;
                display: flex;
                justify-content: center;
            }
             
        }


        @@media (min-width: 758px) and (max-width: 1130px) {
            
            .content-left-1 {
                padding: 10px 35px; /* Giảm padding để phù hợp với màn hình trung bình */
                font-size: 1.4rem; /* Giảm kích thước font chữ */
            }
            /* Điều chỉnh cho .title */
            .title {
                font-size: 2.5rem; 
            }
            
            .btn-title {
                width: 100%;  
                margin: 10px;
                height: 60px;  
                color: #FFF !important;
                align-items: center;
                display: flex;
                justify-content: center;
                font-size: 1.2rem;  
            }
           
            .position-absolute.center-text {
                font-size: 9px;  
            }
        }

        .brand-logo {
            max-width: 100px;
            height: auto;
        }
        

        @@media (max-width: 576px) {
            .content-right-1 {
                font-size: 0.9rem;
                text-align: justify;
            }

            .brand-logo {
                max-width: 80px;
            }

            .btn-title {
                width: 100%;
                margin: 10px;
                height: 67px;
                color: #FFF !important;
                align-items: center;
                display: flex;
                justify-content: center;
            }

            .position-absolute.center-text {
                font-size: 15px;
            }
        }
    </style>
}

