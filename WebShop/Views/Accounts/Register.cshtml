@model WebShop.ModelViews.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-12">
            <nav class="breadcrumb bg-light mb-30">
                <a class="breadcrumb-item text-dark" href="/">Trang chủ</a>
                <a class="breadcrumb-item text-dark" href="#">Tài khoản</a>
                <span class="breadcrumb-item IsActivated">Đăng ký</span>
            </nav>
        </div>
    </div>
</div>
<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-lg-12">
            <h5 class="section-title position-relative text-uppercase mb-3"><span class="bg-secondary pr-3">Đăng nhập</span></h5>
            <div class="bg-light  ">
                <div style="padding:150px">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <form method="post">
                        <div class="form-group">
                            <label>Nhập tên của bạn </label>
                            <input class="form-control" type="text" asp-for="FullName" placeholder="Nhập tên của bạn">
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label>Nhập số điện thoại</label>
                            <input class="form-control" type="text" asp-for="SoDienThoai" placeholder="Nhập số điện thoại">
                            <span asp-validation-for="SoDienThoai" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label>địa chỉ Email</label>
                            <input class="form-control" type="text" asp-for="Email" placeholder="Nhập địa chỉ Email">
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class=" form-group">
                            <label>Nhập mật khẩu</label>
                            <input class="form-control" type="Password" asp-for="Password" placeholder="Nhập mật khẩu">
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        <div class=" form-group">
                            <label>Nhập lại mật khẩu</label>
                            <input class="form-control" type="Password" asp-for="ConfirmPassword" placeholder="Nhập mật khẩu">
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <div style="display:flex; flex-wrap:wrap">
                                <button type="submit" class="btn btn-primary">Đăng ký</button> 
                            </div>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
