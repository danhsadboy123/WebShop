@model WebShop.ModelViews.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
} 
<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-12">
            <nav class="breadcrumb bg-light mb-30">
                <a class="breadcrumb-item text-dark" href="#">Trang chủ</a>
                <a class="breadcrumb-item text-dark" href="#">Tài khoản</a>
                <span class="breadcrumb-item active">Đăng nhập</span>
            </nav>
        </div>
    </div>
</div>
<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-lg-12">
            <h5 class="section-title position-relative text-uppercase mb-3"><span class="bg-secondary pr-3">Đăng nhập</span></h5>
            <div class="bg-light  ">
                <div style="padding:150px">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <form method="post">
                        <div class="form-group">
                            <label>Nhập tên tài khoản </label>
                            <input class="form-control" type="text" asp-for="UserName" placeholder="Nhập tên tài khoản">
                            <span asp-validation-for="UserName" class="text-danger"></span>
                        </div>
                        <div class=" form-group">
                            <label>Nhập mật khẩu</label>
                            <input class="form-control" type="password" asp-for="Password" placeholder="Nhập mật khẩu">
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <div style="display:flex; flex-wrap:wrap">
                                <button class="btn btn-primary">Đăng nhập</button>
                                <span class="font-size-13 text-muted">
                                    Bạn chưa có tài khoản?
                                    <a href="/Account/Register"> Đăng ký</a>
                                </span>
                            </div>
                        </div>
                    </form>
                    
                </div>
            </div>
        </div>
    </div>
</div>