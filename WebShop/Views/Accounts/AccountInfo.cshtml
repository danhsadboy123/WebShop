                    <div class="ac-ct-info">
                        <div class="box-cus-info-2021">
                            <div class="title-ac-2021">Đơn hàng của bạn</div>
                            <div class="box-cus-info-2021">
                                <div class="table-responsive" style="padding:12px">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th scope="col"><b>Mã đơn hàng</b></th>
                                                <th scope="col"><b>Ngày mua</b></th>
                                                <th scope="col"><b>Tổng tiền</b></th>
                                                <th scope="col"><b>Thanh toán</b></th>
                                                <th scope="col"><b>Trạng thái</b></th>
                                                @*<th scope="col"><b>#</b></th>*@
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (DanhSachDonHang.Count() > 0)
                                            {
                                                @foreach (var order in DanhSachDonHang)
                                                {
                                                    <tr>
                                                        <th scope="row">#@order.OrderId</th>
                                                        <td>@order.OrderDate</td>
                                                        <td>@order.TotalMoney.ToString("#,##0")VND</td>
                                                        @if (order.PaymentStatusId == 2)
                                                        {
                                                            <td>Đã thanh toán</td>
                                                        }
                                                        else
                                                        {
                                                            <td>Chưa thanh toán</td>
                                                        }
                                                        <td>
                                                            <div>
                                                                @{
                                                                    string statusClass;
                                                                    if (@order.DeliveryStatusId == 1)
                                                                    {
                                                                        statusClass = "processing";
                                                                    }
                                                                    else if (@order.DeliveryStatusId == 2)
                                                                    {
                                                                        statusClass = "confirm";
                                                                    }
                                                                    else if (@order.DeliveryStatusId == 3)
                                                                    {
                                                                        statusClass = "deliver";
                                                                    }
                                                                    else if (@order.DeliveryStatusId == 4)
                                                                    {
                                                                        statusClass = "success";
                                                                    }
                                                                    else
                                                                    {
                                                                        statusClass = "failed";
                                                                    }
                                                                }
                                                                <span class="status-label @statusClass">@order.DeliveryStatus.Status</span>

                                                            </div>
                                                        </td>
                                                        <td>
                                                            <a data-target="#modal-header" data-toggle="modal" class="btn btn-primary btn-tone m-r-5" asp-controller="DonHang" asp-action="Details" asp-route-id="@order.OrderId">Chi tiết</a>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
