        </div>
    </div>
</div>
@section Scripts{
    <script src="~/Adminassets/vendors/bootstrap-datepicker/bootstrap-datepicker.min.js"></script>
    <script>
        $('#update-change-info').on('click', function () { 
           //var Birthday1 = $('.Birthday1').val();
            var Gender1 = $('.Gender1').val();
            var Phone1 = $('.Phone1').val();
            var Email1 = $('.Email1').val();
            var FullName1 = $('.FullName1').val();
            var idcus = $('.idcus').val();
            if (Gender1 !=null&& Phone1!=null&& Email1!=null&& FullName1!=null){
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("UpdateAccountAddress","AccountAddresses")',
                    dataType: "Json",
                    data: {
                        //Birthday1: Birthday1,
                        Gender1 : Gender1,
                        Phone1 : Phone1,
                        Email1 : Email1,
                        FullName1 : FullName1,
                        id:idcus,
                    },
                    success: function (data) {
                        if (data== true) {
                            alert('Bạn đã cập nhật thông tin mới');
                            location.reload();
                        } else {
                            alert('Bạn không thể cập nhật thông tin mới');
                        }
                    }
                })
            }

        })

        $(document).ready(function () {
            $('.datepicker-input').datepicker();
            var changeInfoBtn = document.getElementById('change-info-btn');
            var cancelBtn = document.getElementById('cancel-change-info');
            var updateBtn = document.getElementById('update-change-info');

            var changeInfo = document.getElementById('box-change-info');
            var info = document.getElementById('box-info');
            
            //block:hiện,none:ẩn
            //Xử lý các sự kiện click button
            changeInfoBtn.onclick = function () {
                info.style.display = "none";
                changeInfo.style.display = "block";
            };
            cancelBtn.onclick = function () {
                info.style.display = "block";
                changeInfo.style.display = "none";
            };
             
            
            $('#modal-header').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget); // Button that triggered the modal
                var url = button.attr("href");
                var modal = $(this);
                // note that this will replace the content of modal-content ever time the modal is opened
                modal.find('.modal-content').load(url);
            });
        });
    </script>
}