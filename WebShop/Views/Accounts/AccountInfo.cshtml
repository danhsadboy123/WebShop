@section Styles{
    <style>
      
        .status-label {
            color: #ffffff;
            padding: 4px 8px;
            border-radius: 4px;
            margin-left: 8px;
        }

        .status-label.processing {
            background-color: #FFD700;
        }

        .status-label.confirm {
            background-color: #20B2AA;
        }

        .status-label.deliver {
            background-color: grey;
        }

        .status-label.success {
            background-color: #32CD32;
        }

        .status-label.failed {
            background-color: #FF0000;
        }
    </style>
}
