@model WebShop.Models.Page

@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
    string url = $"/page/{Model.Alias}";
}
@section Styles {
    <style>
        table {
            width: 100% !important;
            margin-left: 0px !important;
        }

            table tr {
                line-height: 22px !important;
            }

                table tr th {
                    padding: 0px 10px !important;
                }

                table tr td {
                    width: 20% !important;
                }

                    table tr td ul {
                        width: 100%;
                        float: left;
                        padding: 15px;
                    }

                table tr:nth-child(1) {
                    background: #f1f1f1 !important;
                    font-weight: bold
                }

                table tr:nth-child(2) {
                    background: #fff !important
                }

                table tr:nth-child(2n+1) {
                    background: #f3f3f3 !important;
                }

            table td {
                padding: 7px !important;
                padding-left: 10px !important;
                text-align: left !important;
                border: 1px solid #ccc !important
            }

            table tr td, table tr td p, table tr td p {
                margin: 0 0 0 0 !important;
            }

                table tr td p strong {
                    font-weight: 600;
                }

        .step1 {
            position: absolute;
            top: -20px; /* Điều chỉnh vị trí chữ lên trên */
            left: 20px; /* Điều chỉnh vị trí ngang */
            background-color: white;
            padding: 0 10px;
            font-weight: bold;
        }

 

    </style>
}
<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-12">
            <nav class="breadcrumb bg-light mb-30">
                <a class="breadcrumb-item text-dark" href="/">Trang chủ</a>
                <span class="breadcrumb-item active">@Model.PageName</span>
            </nav>
        </div>
    </div>
</div>

<div style="width: 93.5%;  background: #fff; margin: auto;color:#000">

    @if (Model.Contents != "<p><br></p>" && Model.Contents != null)
    {
        @Html.Raw(Model.Contents)
    }
    else
