@model WebShop.Models.Product
@inject WebShop.Services.IPageInfoService PageInfoService;

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<Product> lsProducts = ViewBag.SanPham;
    List<Product> lsProductByCate = ViewBag.lsProductByCate;
    List<Post> Lsposts = ViewBag.newpost;
    List<WebShop.ModelViews.AttributePriceDto> lsAttribute = ViewBag.attrbutePrices;
    List<Product> listprooption = ViewBag.listprooption;
    List<ProductThumb> productThumbs = ViewBag.Images;
    List<Discount> discountsls = ViewBag.discountHome;
    ViewData["Title"] = Model.Title;
    ViewData["MoTa"] = Model.MetaDesc;
    ViewData["Keywords"] = Model.MetaKey;
    
    var ogImage = Model?.Avatar != null
                  ? PageInfoService.GetPageInfo().Domain + Model.Avatar  
                  : PageInfoService.GetPageInfo().Domain + "Adminassets/images/logo/" + PageInfoService.GetPageInfo().OgImage; // Ảnh mặc định nếu không phải trang chi tiết sản phẩm

    ViewData["OGimage"] = ogImage;

    var addtocart = true;
}
<link href="~/novazone/css/productdetail.css" rel="stylesheet" />
<script src="~/lib/jquery/dist/jquery.min.js"></script>
@section Styles{
    <style>
        a {
            text-decoration: none !important;
        }
        /* Đặt chiều rộng ảnh lớn và căn giữa */
        #main-slider {
            width: 780px;
            margin: 0 auto;
            display: block;
        }
        #main-slider-track{
            padding-left:50px!important;
            padding-right:50px !important;
        }
            /* Đặt chiều rộng cho từng ảnh lớn */
            #main-slider .splide__slide img {
                width: 100%;
                height: auto;
            }

        /* Căn chỉnh thumbnail dưới ảnh lớn */
        #thumbnail-slider {
            margin-top: 15px; /* Khoảng cách giữa ảnh lớn và thumbnail */
            display: flex;
            justify-content: center;
        }

            /* Đặt chiều rộng thumbnail vừa phải để hiển thị hàng ngang */
            #thumbnail-slider .splide__slide {
                width: 100px; /* Tùy chỉnh kích thước thumbnail */
                margin-right: 8px; /* Khoảng cách giữa các thumbnail */
                border: 2px solid transparent;
                cursor: pointer;
                transition: border-color 0.3s;
            }

                /* Hiệu ứng khi hover vào thumbnail */
                #thumbnail-slider .splide__slide:hover {
                    border-color: #00B98E; /* Màu viền khi hover */
                }

                /* Điều chỉnh ảnh trong thumbnail */
                #thumbnail-slider .splide__slide img {
                    width: 100%;
                    height: auto;
                    object-fit: cover; /* Đảm bảo ảnh được cắt gọn nếu kích thước không khớp */
                    border-radius: 4px; /* Tùy chọn: bo tròn góc ảnh */
                }



        .static-html-group .content {
            max-height: 400px; /* Giới hạn chiều cao ban đầu */
            overflow: hidden;
            transition: max-height 0.3s ease;
        }

        .static-html-group.expanded .content {
            max-height: none; /* Hiển thị toàn bộ khi được mở rộng */
        } 

        /* Style cho BoxGallery */
        .box-gallery {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        .box-gallery-content {
            position: relative;
            background: white;
            padding: 20px;
            border-radius: 8px;
            max-width: 80%;
            max-height: 80%;
            overflow-y: auto;
        }

        .box-gallery .gallery-images img {
            width: 100%;
            margin-bottom: 10px;
            border-radius: 8px;
        }

        .box-gallery .close {
            position: absolute;
            top: 10px;
            right: 10px;
            font-size: 24px;
            color: #fff;
            cursor: pointer;
        }

            .box-gallery .close:hover {
                color: #f00;
            }
   

        .custom-modal .modal-header {
            border-bottom: none;
        }

        .custom-modal .close {
            font-size: 1.5rem;
            opacity: 1;
        }

        .custom-modal .modal-body {
            padding: 0;
        }

        /* Tùy chỉnh Carousel */
        .custom-modal .carousel-inner {
            border-radius: 8px;
            overflow: hidden;
        }

        .custom-modal .carousel-item img {
            max-height: 500px;
            object-fit: cover;
            border-radius: 8px;
        }

        /* Nút điều hướng tuỳ chỉnh */
        .custom-carousel-control {
            width: 5%;
        }

            .custom-carousel-control .carousel-control-prev-icon,
            .custom-carousel-control .carousel-control-next-icon {
                background-color: rgba(0, 0, 0, 0.5); /* Nền nửa trong suốt */
                border-radius: 50%;
                padding: 10px;
            }

            .custom-carousel-control:hover .carousel-control-prev-icon,
            .custom-carousel-control:hover .carousel-control-next-icon {
                background-color: rgba(255, 255, 255, 0.8); /* Hiệu ứng khi hover */
            }

        .carousel-indicators li {
            background-color: rgba(255, 255, 255, 0.5);
        }

        .carousel-indicators .KichHoat {
            background-color: #fff;
        }

        .modal-body {
            max-height: 70vh; /* Giới hạn chiều cao tối đa của nội dung modal */
            overflow-y: auto; /* Thêm cuộn dọc nếu nội dung dài hơn */
        }

         

            .pr-detail-item .b-img {
                display: block;
                max-width: 100%;
                margin-bottom: 10px;
            }

        .product-detail-page .pr-detail-item .b-link {
            font-size: 16px;
            margin-bottom: 4px;
            display: block;
        }

        .single-service {
            position: relative;
            text-align: center;
            padding-bottom: 30px;
            margin-bottom: 30px;
            transition: all 0.5s;
            border-radius: 4px;
            z-index: 1;
            overflow: hidden;
            box-shadow: 0 0 20px 3px rgba(0, 0, 0, 0.05);
        }

            .single-service .service-img {
                margin-bottom: 20px;
            }

                .single-service .service-img img {
                    height: 200px;
                }

            .single-service .service-content .service-title {
                height: 60px;
            }

                .single-service .service-content .service-title h3 {
                    margin-bottom: 5px;
                }

            .single-service .service-content p {
                margin-bottom: 10px;
            }

            .single-service::before {
                content: "";
                position: absolute;
                top: 0;
                left: 100%;
                width: 100%;
                height: 100%;
                background-color: #aab3bb;
                z-index: -1;
                transition: all 0.5s;
            }

            .single-service::after {
                content: "";
                position: absolute;
                bottom: -100px;
                right: 100%;
                width: 100%;
                height: 100%;
                background: url(https://sunhitech.vn/images/service/hover.png) no-repeat;
                z-index: -1;
                transition: all 0.5s;
            }
            /**/
            .single-service:hover {
                transform: translateY(-10px);
            }

                .single-service:hover h3 {
                    color: #fff;
                }

                .single-service:hover p {
                    color: #fff;
                }

                .single-service:hover::before {
                    left: 0;
                }

                .single-service:hover::after {
                    right: -47px;
                }

                .single-service:hover .service-content .line-bnt {
                    color: #fff;
                }
 

    </style>
}
<!-- Breadcrumb Start -->
<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-12">
            <nav class="breadcrumb bg-light mb-30">
                <a class="breadcrumb-item text-dark" href="/">Trang chủ</a>
                <a class="breadcrumb-item text-dark" href="/@ViewBag.BreadcrumbCategories.Alias">@ViewBag.BreadcrumbCategories.CatName</a>
                <a class="breadcrumb-item KichHoat" href="/">@Model.ProductName</a>
            </nav>
        </div>
    </div>
</div>
<!-- Breadcrumb End -->
<!-- Shop Detail Start --> 
<div class="product-detail-page  container-2019"> 
    <div class="pd-box-container pd-info-container row"> 
        <div class="pd-info-left col-12 col-md-12 col-lg-7">
            <div id="main-slider" class="splide">
                <div class="splide__track">
                    <ul class="splide__list">
                        @foreach (var img in productThumbs)
                        {
                            <li class="splide__slide"  >
                                <img src="https://novazone.co/@img.Alias" alt="@Model.Alias"/>
                            </li>
                        } 
                    </ul>
                </div>
            </div>

            <div id="thumbnail-slider" class="splide mt-5">
                <div class="splide__track">
                    <ul class="splide__list">
                        @foreach (var img in productThumbs)
                        {
                            <li class="splide__slide">
                                <img src="https://novazone.co/@img.Alias" alt="@Model.Alias"/>
                            </li>
                        } 
                    </ul>
                </div>
            </div>


            <div class="pd-image-btn row">
                <a href="javascript:void(0)" class="item item-image js-box-open-gallery col-4" onclick="openGallery()" data-id="anh_sp">
                    <span class="item-icon lazy" data-was-processed="true" style="background-image: url('https://novazone.co/@Model.Avatar');">
                    </span>
                    <span class="item-text d-none d-md-block" style="color:#2d2c74">Hình ảnh chụp<br>sản phẩm</span>
                </a>
                @if(Model.Video !=null)
                {
                    <a href="@Model.Video" data-fancybox="" class="item item-video col-4">
                        <span class="item-icon">
                            <i class="fab fa-youtube"></i>
                        </span>
                        <span class="item-text  d-none d-md-block" style="color:#2d2c74"> Video<br>sản phẩm </span>
                    </a>
                }
                else
                {
                    <a href="https://www.youtube.com/watch?v=dsPXZJmaKzso" data-fancybox="" class="item item-video col-4">
                        <span class="item-icon">
                            <i class="fab fa-youtube"></i>
                        </span>
                        <span class="item-text  d-none d-md-block" style="color:#2d2c74"> Video<br>sản phẩm </span>
                    </a>
                }

                <a href="javascript:void(0)" onclick="showPopup('popup-spec')" class="item item-product-spec col-4" data-toggle="modal" data-target="#exampleModal">
                    <span class="item-icon">
         @*               <i class="fas fa-clipboard-list-check  tada" style="color: #2d2c74"></i>*@
                        <i class='fas fa-clipboard-list'></i>
                      
                    </span>
                    <span class="item-text  d-none d-md-block" > Thông số<br>kỹ thuật </span>
                </a>

            </div>
        </div>


        <div class="pd-info- col-12 col-md-12 col-lg-5">
            <h1 class="sptitle2024">@Model.ProductName</h1>
            <div class="pd-status-group">

                <p> Mã SP: <b class="blue">@Model.ProductCode</b></p>


                <p onclick="$('body,html').animate({ scrollTop: $('#pd-review-group').offset().top - 60},800);" style="cursor: pointer;">
                    Đánh giá:
                    <img data-src="/media/lib/star_0.png" width="1" height="1" alt="rate" class="lazy pd-rating">
                    <b class="blue">0</b>
                </p>

                <p onclick="$('body,html').animate({ scrollTop: $('#pd-review-group').offset().top - 60},800);" style="cursor: pointer;">
                    Bình luận: <b class="blue">0</b>
                </p>
 
            </div>




            @if (lsAttribute.Count() > 0)
            {

                <div class="pd-summary-group" id="js-pd-summary">
                    <p class="group-title"> Thông số sản phẩm </p>

                    <div>
                        @foreach (var att in lsAttribute)
                        {
                            <div class="item">
                                @att.AttributeName: @att.Price
                            </div>
                        }

                    </div>
                    <a href="javascript:void(0)" class="btn-summary" onclick="$('#js-pd-summary').toggleClass('KichHoat')"></a>

                </div>
            }
             
            <div class="pd-price-group"> 
                @if (Model.Price <=0 )
                {
                    <p class="pd-price text-danger"> Liên hệ  </p>
                }
                else
                {
                    @if (Model.SalePrice != 0)
                    {
                        if (Model.SalePrice != Model.Price)
                        {
                            int tietkiem = (int)Model.Price - (int)Model.SalePrice;

                            <div class="pd-special-price">
                                <p class="w-100"> Giá ưu đãi đặc biệt: </p>

                                <p class="pd-price"   >
                                    @($"{Model.SalePrice:N0}")<u>đ</u>

                                </p>

                                <del class="pd-market-price">@($"{Model.Price:N0}")<u>đ</u> </del>
                                <p> Tiết kiệm:@($"{tietkiem:N0}") <u>đ</u> </p>
                                <div class="pd-addon-box" id="js-pd-addon-box" style="display: none">
                                    <p class="w-100"> Giá kèm gói Bảo Hành Mở Rộng: </p>
                                    <p class="pd-price" id="js-pd-price"  data-unprice=""> </p>
                                </div>
                            </div>
                        }
                        else
                        {

                            <div class="pd-price-holder">
                                <p class="w-100-nt"> Giá khuyến mại: </p>

                                <p class="pd-price-plus text-danger">@($"{Model.Price:N0}")<u>đ</u></p>
                            </div>
                             
                        }

                    }
                }
            
                <div class="pd-warranty-group"> 
                    <p>Giá đã bao gồm VAT</p> 
                    <p> Bảo hành: @Model.Warranty tháng </p>

                </div>
            </div> <!-- Hết phần giá -->
            <!-- Phần giỏ hàng -->

            <div class="pd-quantity-group">
                <p> Số lượng: </p> 
              
                    <div class="input-group quantity mr-3" style="width: 130px;">
                        <div class="input-group-btn">
                            <button class="btn btn-primary btn-minus">
                                <i class="fa fa-minus"></i>
                            </button>
                        </div>
                    <input type="text" class="form-control bg-secondary border-0 text-center add-count" min="1" max="100" value="1" >
                        <div class="input-group-btn">
                            <button class="btn btn-primary btn-plus">
                                <i class="fa fa-plus"></i>
                            </button>
                        </div>
                    </div>
              

                <a href="javascript:void(0)" class="pd-btn-add-cart" onclick="addToCart(@Model.ProductId)"> Thêm vào giỏ hàng </a>
            </div>

            <div class="pd-btn-group">
                <a href="javascript:void(0)" class="pd-buy-now" >
                    <b> mua ngay </b>
                    <span> Giao nhanh tận nơi, miễn phí toàn quốc </span>
                </a> 
            </div>   
              
            <!-- Store -->
            <div class="classhidden2024">
                <div class="pd-store-group" id="js-store-container" style="">
                    <p class="group-title" id="socuahangcosanpham"> Cửa hàng có sẵn sản phẩm:</p>

                    <div class="pd-store-list" id="js-store-list">
                        <p class="item">
                            <span class="sdtchinhanh"><i class="fas fa-SoDienThoai-alt"></i> @PageInfoService.GetPageInfo().SoDienThoai</span> -
                            <a href="#" class="js-store-item" data-erp="Ton101" target="_blank" title="@PageInfoService.GetPageInfo().Address">
                                <i class="fas fa-map-marker-alt"></i>
                                @PageInfoService.GetPageInfo().Address
                            </a>
                        </p>
                         
                </div>
                </div>
            </div>

            <!-- offer -->
            <div class="pd-offer-group" id="id-pd-offer-group">
                <p class="group-title">
                    <i class="fas fa-gift" style="margin-right: 3px;"></i>
                    QUÀ TẶNG KHUYẾN MẠI 
                </p> 
                <div class="pd-offer-list" id="km20242"> 
                    
                    <div class="item item-other js-other-offer">
                        <div class="km-title">ƯU ĐÃI HỌC SINH - SINH VIÊN</div>
                        <ul> 
                            <li><a href="/danh-sach-san-pham-Novazone" target="_blank">Giảm thêm <span style="color: red; font-weight: bold">200.000đ</span> - Không áp dụng Khuyến Mãi cho Macbook, Surface và Laptop cũ (xem chi tiết)</a></li>

                        </ul>
                    </div>
                     
                     
                    <div class="item item-other js-other-offer">
                         
                        <div class="km-title">BỘ QUÀ TẶNG CỦA NOVAZONE</div>
                        <ul>
                            <li>Tặng ngay chuột không dây logitech M220 Silent <span style="color: red; font-weight: bold">300.000đ</span></li> 
                        </ul> 
                    </div>
                   
                    <div class="item item-other js-other-offer">
                        
                        <div class="km-title">ƯU ĐÃI GAMER - ĐỪNG CHẦN CHỜ</div>
                        <ul>
                            <li>Giảm ngay <span style="color: red; font-weight: bold">50.000đ</span> khi mua cùng <a href="#" target="_blank">Balo, Cặp, Túi chống sốc</a></li>
                            <li>Giảm ngay <span style="color: red; font-weight: bold">100.000đ</span> khi mua cùng <a href="#" target="_blank">Ram Laptop thương hiệu KINGSTON,LEXAR</a></li>
                            <li>Giảm ngay <span style="color: red; font-weight: bold">100.000đ</span> khi mua cùng <a href="#" target="_blank">Ghế công thái học thương hiệu LEGION</a></li>
                        </ul>



                    </div>                     <p class="item" id="camketpr">
                        <i class="fas fa-SoDienThoai-alt"></i> CAM KẾT GIÁ CẠNH TRANH NHẤT, HÃY GỌI @PageInfoService.GetPageInfo().SoDienThoai  
                    </p>

                </div>
            </div>
             

            <div class="pd-offer-group km-o-cung-camera" id="km-o-cung-camera">
                <p class="group-title"><i class="fas fa-user-headset" style="margin-right:5px"></i> Liên hệ mua hàng</p>
                <div class="pd-offer-list">
                    <div class="item item-other js-other-offer">
                        <p style="margin-top: 0"><i class="fas fa-SoDienThoai fa-flip-horizontal"></i> Liên hệ qua số điện thoại/zalo:<b> @PageInfoService.GetPageInfo().SoDienThoai</b> </p>
                         
                    </div> 
                </div>
            </div>

            <style>
                .km-o-cung-camera p {
                    padding: 10px 10px 0px 15px
                }

                .km-o-cung-camera ul {
                    margin-top: 15px
                }
            </style>





        </div>
    </div>


    <!-- Comboset -->






    <div class="pd-box-container pd-desc-group">
        <h2 class="box-title">
            Đánh giá:  @Model.ProductName
        </h2>

        <div class="static-html-group js-static-container">
            @if (Model.MoTa != "<p><br></p>" || Model.MoTa!=null)
            {
                <div class="content">
                    @Html.Raw(Model.MoTa)
                </div>
                <div class="static-btn-group">
                    <a href="javascript:void(0)" class="js-showmore-button" style="display: block;">Xem thêm </a>
                    <a href="javascript:void(0)" class="js-showless-button" style="display: none;">Thu gọn  </a>
                </div>

            }
            else
            {
                <p>Đang cập nhật ...</p>
            }
        </div>
    </div>  
</div>


<!-- Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1"  VaiTro="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl" VaiTro="document">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="exampleModalLabel">Thông số kỹ thuật @Model.ProductName</h6>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body text-break">
                <div>
                    @if (Model.ShortDesc != "<p><br></p>")
                    {
                        @Html.Raw(Model.ShortDesc);
                    }
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Shop Detail End -->
<!-- Products Start -->
<div class="container-fluid py-5">
    <h2 class="section-title position-relative mx-xl-5 mb-4"><span  style="background-color:#F0F1FB" class=" pr-3">Sản phẩm cùng thương hiệu @Model.Brand.BrandName</span></h2>
    <div class="row px-xl-5">
        <div class="col">
            <div class="owl-carousel related-carousel">
                @if (lsProducts.Count() > 0)
                {
                    @foreach (var product in lsProducts)
                    {
                        <div class=" " title="Chi tiết sản phẩm  @product.ProductName">
                            <div class="product-item bg-light mb-1" style="padding:15px">
                                <div class="product-img position-relative overflow-hidden">
                                    <div class="d-flex justify-content-center" style="height:200px;">
                                        <img style="object-fit:contain;" class="img-fluid" src="https://novazone.co/@product.Avatar" alt="@product.Alias" loading="lazy">
                                    </div>
                                    <div class="product-action">
                                        @if (product.UnitsInStock > 0)
                                        {
                                            <a class="btn btn-outline-dark btn-square" href="javascript:void(0)" onclick="addToCart(@product.ProductId)"><i class="fa fa-shopping-cart"></i></a>
                                            <a class="btn btn-outline-dark btn-square" href="/@product.Alias-@product.ProductId"><i class="fa fa-ellipsis-h"></i></a>
                                        }
                                        else
                                        {
                                            <a class="btn btn-outline-dark btn-square" href="/@product.Alias-@product.ProductId"><i class="fa fa-bars"></i></a>
                                        }
                                    </div>
                                </div>
                                <div class="text-center py-3">
                                    <a class="text-decoration-none p-7 text-dark"
                                       style="height: 3.3em; display: block; overflow: hidden; line-height: 1.5em; white-space: normal; text-overflow: ellipsis; text-align:left; font-size:15px;"
                                       href="/@product.Alias-@product.ProductId">
                                        @product.ProductName
                                    </a>

                                    <div class="d-md-flex  justify-content-center mt-2 flex-column">
                                        @if (product.Price <= 0)
                                        {
                                            <div class="md-d-flex  " style="font-size: 13px;text-align:left;">
                                                <span class="text-muted" style="margin-right: 5px;"> </span>
                                                <span class="text-success ml-2 d-none d-lg-inline "></span>
                                            </div>
                                            <span class="d-block">Giá: <b class="text-danger">liên hệ</b></span>
                                        }
                                        else
                                        {
                                            @if (product.SalePrice != null && product.SalePrice < product.Price)
                                            {
                                                int tietkiem = (int)product.Price - (int)product.SalePrice;

                                                <div class="md-d-flex  " style="font-size: 13px;text-align:left;">
                                                    <span class="text-muted" style="margin-right: 5px;"><del> @($"{product.Price:N0}")<u>đ</u>   </del></span>
