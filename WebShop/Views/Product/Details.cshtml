@section Scripts{
    <script>
        $('.btnon').on('click', function () {
            var check = $(this).attr('data-check');
            var btnon = $('.btnon');
            $.each(btnon, function (key, item) {
                if ($(item).attr('data-check') == check) {
                    $(item).css('display', 'none');
                } else {
                    $(item).css('display', 'block');
                }
            })
            if (check == "show") {
                $('.itempro').css('display', 'block');
            } else {
                $('.itempro').css('display', 'none');
            }
        })
        function openGallery() {
            $('#galleryModal').modal('show');
        }
        $(document).ready(function () {
            $('.js-showmore-button').on('click', function () {
                $(this).hide(); // Ẩn nút "Xem thêm"
                $('.js-showless-button').show(); // Hiển thị nút "Thu gọn"
                $('.static-html-group').addClass('expanded'); // Mở rộng nội dung
            });

            $('.js-showless-button').on('click', function () {
                $(this).hide(); // Ẩn nút "Thu gọn"
                $('.js-showmore-button').show(); // Hiển thị lại nút "Xem thêm"
                $('.static-html-group').removeClass('expanded'); // Thu gọn nội dung
            });


            $('.lsCatcarousel').owlCarousel({
                items: 2,
                loop: true,
                autoplay: true,
                autoplayTimeout: 2500,
                autoplaySpeed: 2500,
                autoplayHoverPause: true,
                nav: true,
                dots: true,
                margin: 7,
                responsive: {
                    0: { items: 1 },
                    575: { items: 1 },
                    576: { items: 2 },
                    768: { items: 3 },
                    992: { items: 3 },
                    1000: { items: 3 },
                    1200: { items: 4 },
                },
            });


            $('#js-img-gallery').owlCarousel({
                items: 5,
                loop: false,
                margin: 7,
                autoplay: true,
                autoplayTimeout: 1000,
                autoplaySpeed: 1000,
                autoplayHoverPause: true,
                dots: false,
                nav: true,
                navText: ["<i class='arrow arrow-left'></i>", "<i class='arrow'></i>"],
                lazyLoad: true
            });
            //checkShortDescLength();
            _imagesClick();
            var isBuyNow = false; // Giá trị mặc định của isBuyNow
            $(".buy-now").click(function () {
                isBuyNow = true; // Đặt giá trị isBuyNow là true khi nhấn nút "Mua ngay"
                var productid = $('#ProductId').val();
                // Gọi hàm AJAX để thực hiện thêm vào giỏ hàng
                addToCart(productid, isBuyNow);
            });
            $(".add-to-cart").click(function () {
                isBuyNow = false; // Đặt giá trị isBuyNow là false khi nhấn nút "Thêm vào giỏ"
                var productid = $('#ProductId').val();
                // Gọi hàm AJAX để thực hiện thêm vào giỏ hàng
                addToCart(productid, isBuyNow);
            });
            function addToCart(productID, isBuyNow) {
                $.ajax({
                    url: '/api/cart/add',
                    type: "POST",
                    dataType: "JSON",
                    data: {
                        productID: productID,
                        amount: 1,
                        isBuyNow: isBuyNow
                    },
                    success: function (response) {
                        if (response.result == 'Redirect') {
                            window.location = response.url;
                        }
                        else if (response.success) {
                            $("#successForm").show();

                            setTimeout(function () {
                                $("#successForm").fadeOut();
                            }, 1000);


                            loadHeaderCart();//Reload lai gio hang
                        }
                    },
                    error: function (error) {
                        alert("There was an error posting the data to the server: " + error.responseText);
                    }
                });
            }
            // Gallery san pham
            $('#js-img-gallery a:first-child').addClass('current');
            function _imagesClick() {
                $('#js-img-gallery a').click(function () {
                    var href = $(this).attr('data-href');
                    var fancybox_id = $(this).attr('data-id');
                    $('#js-big-img').attr('data-id', fancybox_id);
                    $('#js-big-img img').attr('src', href);

                    $('#js-img-gallery a').removeClass('current');
                    $(this).addClass('current');
                });

                $('#js-big-img a').click(function () {
                    var fancybox_id = $(this).parents('#js-big-img').attr('data-id');
                    $('#' + fancybox_id).click();
                });
            }
            //hien thi them mo ta san pham

            var MoTa = document.getElementById("pd-decs");
            var expandButton = document.getElementById("expandDescription");
            var collapseButton = document.getElementById("collapseDescription");

            if (MoTa) {
                expandButton.addEventListener("click", function () {
                    // Xóa giới hạn chiều cao, cho phép hiển thị toàn bộ nội dung
                    MoTa.style.maxHeight = "none";
                    // Ẩn nút "Xem thêm"
                    expandButton.style.display = "none";
                    // Hiển thị nút "Thu gọn"
                    collapseButton.style.display = "block";
                });

                collapseButton.addEventListener("click", function () {
                    // Giới hạn lại chiều cao để thu gọn phần mô tả
                    MoTa.style.maxHeight = "800px";
                    // Hiển thị nút "Xem thêm"
                    expandButton.style.display = "block";
                    // Ẩn nút "Thu gọn"
                    collapseButton.style.display = "none";

                    // Lấy đối tượng jQuery của phần tử mà bạn muốn cuộn đến
                    var targetElement = $("#pd-box-group");

                    // Kiểm tra nếu phần tử tồn tại
                    if (targetElement.length) {
                        // Cuộn đến phần tử với hiệu ứng trơn tru
                        $("html, body").animate({
                            scrollTop: targetElement.offset().top
                        }, 500); // Thời gian cuộn (ms)
                    }
                });
            }



            $('[data-fancybox="gallery"]').fancybox({
                thumbs: {
                    autoStart: true
                }
            });
        });
    </script>
}
