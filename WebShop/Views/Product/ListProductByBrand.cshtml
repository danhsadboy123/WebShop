@using PagedList.Core.Mvc
@model PagedList.Core.IPagedList<WebShop.Models.Product>
@inject WebShop.Services.IPageInfoService PageInfoService;

@{
    Brand brand = ViewBag.Brand;
    List<AttributesPrice> priceP = ViewBag.price;
    Layout = "~/Views/Shared/_Layout.cshtml";
    int PageCurrent = ViewBag.CurrentPage;
    int PageNext = PageCurrent + 1;
    ViewData["Title"] = "Thương hiệu " + brand.BrandName;
    ViewData["MoTa"] = brand.MoTa;
    ViewData["Keywords"] = brand.BrandName + "giá tốt nhất thị trường, sản phẩm đến từ thường hiệu" + brand.BrandName;

}

@section Styles{
    <link href="~/Adminassets/vendors/select2/select2.css" rel="stylesheet">
    <link href="~/Adminassets/vendors/datatables/dataTables.bootstrap.min.css" rel="stylesheet">
    <style>
        .page-link {
            color: white;
            background-color: aqua;
            border-radius: 50%;
        }

        .filter-button {
            border: 1px solid gray;
            padding: 5px;
            margin-right: 5px;
            text-decoration: none;
            color: black;
        }

        .selected {
            border-color: green;
        }

        .ps-percent {
            background: red;
            border-bottom-right-radius: 14px;
            padding: 4px;
            left: 8px;
            position: absolute;
            top: -1px;
        }

        .ps-percent-detail {
            color: #fff;
            font-size: 12px;
            font-weight: 700;
            margin: 3px 0 0;
            text-align: center;
            width: 100%;
        }

        .sub_nav {
            display: none;
        }

        .js-hover-menu:hover .sub_nav {
            display: block;
        }
        /* Container */
        .container-2023 {
            margin-bottom: 20px;
        }

        /* Page Header */
        .page-header {
            margin-bottom: 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-bottom-item {
            margin-right: 12px;
        }

        /* Header Sub Title */
        .header-sub-title {
            text-transform: uppercase;
        }

        /* Breadcrumb */
        .breadcrumb {
            margin: 0;
            padding: 0;
            list-style: none;
            display: flex;
            align-items: center;
        }

        .breadcrumb-item {
            display: inline-block;
            margin-right: 5px;
        }

            .breadcrumb-item:last-child {
                font-weight: bold;
            }

        /* Filter Nav */
        #filter-nav {
            display: none;
        }

        .menu-filter {
            display: flex;
            align-items: center;
        }

            .menu-filter b {
                margin-right: 5px;
            }

        #close-filter {
            cursor: pointer;
            margin-left: 10px;
        }

        /* Product Page */
        .product-page {
            margin-bottom: 20px;
        }

        .page-title-group {
            margin-bottom: 10px;
            display: flex;
            align-items: center;
        }

        .page-title {
            margin-right: 10px;
            text-transform:capitalize !important;
        }

        .home-categories {
            margin-bottom: 20px;
        }

        .lst-cate-grid {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
        }

        .home-categories-item {
            text-align: center;
            margin-right: 10px;
            margin-bottom: 10px;
            text-decoration: none;
            color: #333;
        }

            .home-categories-item:hover {
                text-decoration: underline;
            }

        .home-categories-item-image {
            margin-bottom: 5px;
        }

        .home-categories-item-title {
            font-weight: bold;
        }

        .p-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: start;
        }

        /* Product Item */
        .p-item {
            width: calc(25% - 10px);
            margin-bottom: 20px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            padding: 15px;
            border-radius: 5px;
        }

        .p-img {
            text-align: center;
        }

        .p-info {
            margin-top: 10px;
        }

        .p-name {
            margin-bottom: 5px;
        }

        .p-sku {
            margin-bottom: 5px;
        }

        .p-price {
            font-weight: bold;
        }

        .p-buy {
            display: block;
            width: 100%;
            text-align: center;
            background-color: #ffc107;
            color: #fff;
            padding: 5px 0;
            border-radius: 5px;
            text-decoration: none;
        }

            .p-buy:hover {
                background-color: #0056b3;
            }

        .col-8 {
            display: flex;
            justify-content: space-between;
        }


        .catSelect, .sortSelect {
            width: 100%;
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 5px;
            margin-bottom: 10px;
            font-size: 14px;
        }

 
        .col-xl-6 b {
            margin-right: 10px;
            font-weight: bold;
        }

        .col-xl-6:last-child b {
            margin-right: 10px;
            font-weight: bold;
        }

    </style>
}
<div class="container-2023 " >
    <div class="page-header " style="margin-bottom:24px">
 
        <div class="header-sub-title" style="text-transform:capitalize">
            <nav class="breadcrumb breadcrumb-dash">
                <a href="/" class="breadcrumb-item"><i class="anticon anticon-home m-r-5"></i>Trang chủ</a>
                <a class="breadcrumb-item" href="/danhmuc/@brand.BrandName">Thương hiệu @brand.BrandName</a>
            </nav>
        </div>
    </div>
</div>


<div id="filter-nav" class="collapse" style="">
    <div class="menu-filter">
        <b title="Bộ lọc">Bộ lọc</b>
        <a id="close-filter" aria-expanded="false"><i class="fa fa-times"></i></a>
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var closeButton = document.getElementById('close-filter');
                var menuContent = document.getElementById('filter-nav');

                closeButton.addEventListener('click', function () {
                    menuContent.classList.remove('show');
                });
            });
        </script>
    </div>
</div>
<div class="container-2023">
    <div class="product-page">
        @if (Model != null && Model.Count() > 0)
        {
            <div class="page-title-group">
                <h1 class="page-title">Thương hiệu @brand.BrandName</h1>
                <span>(@Model.Count() sản phẩm)</span>
            </div>

        }
        else
        {
            <div class="page-title-group">
                <h1 class="page-title">Thương hiệu @brand.BrandName</h1>
                <span>(0 sản phẩm)</span>
            </div>

        }
    </div>
    <div class="home-categories">
        <div class="lst-cate">
            <div class="lst-cate-grid" style="justify-content:center">
                @foreach (var cat in brand.CategoryBrands)
                {
                    <a href="/Product/catebreand/@brand.BrandId?alias=@cat.Cat.Alias" class="home-categories-item">
                        <div class="home-categories-item-image"><img src="@cat.Cat.Thumb" loading="lazy" class="home-categories-item-image-images" alt="@cat.Cat.CatName"></div>
                        <div class="home-categories-item-title p-name">@cat.Cat.CatName</div>
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<div class="container-2023">
    <div class="product-page">
        <div class="col-right">
            <div class="product-holder-group">
                <div class="sort-by-group">
                    <div class="col-8" style="display:flex;">
                        <div class="col-xl-6 col-lg-12">
                            <b style="margin-right:10px">Danh mục:</b>
                            <select class="catSelect" name="sort" data-id="@brand.BrandId">
                                <option value="all" selected>Tất cả sản phẩm</option>
                                @foreach (var cat in brand.CategoryBrands)
                                {
                                    <option value="@cat.Cat.CatId">@cat.Cat.CatName</option>
                                }
                            </select>
                        </div>
                        <div class="col-xl-6 col-lg-12">
                            <b style="margin-right:10px">Sắp xếp:</b>
                            <select class="sortSelect  " name="sort" data-id="@brand.BrandId">
                                <option value="discount" selected>Khuyến mãi tốt nhất</option>
                                <option value="asc">Giá tăng dần</option>
                                <option value="desc">Giá giảm dần</option>
                                <option value="new">Sản phẩm mới nhất</option>
                                <option value="az">Tên A -> Z</option>
                            </select>
                        </div>
                    </div>  
                </div>
                <div class="p-container">
                    @if (Model != null && Model.Count() > 0)
                    {
                        foreach (var item in Model)
                        {
                            decimal discount = 0;
                            decimal moneydis = 0;
                            var text = "";
                            string url = $"/{item.Alias}-{item.ProductId}";

                            /// check giam gia sanphaamr
                            @foreach (var prodis in ViewBag.listdiscount)
                            {
                                if (prodis.CheckDiscount == false)
                                {
                                    if (item.ProductId == prodis.ProductId)
                                    {
                                        if (@prodis.Discount.Discount1 <= 100)
                                        {
                                            moneydis = (decimal)@item.SalePrice * ((decimal)@prodis.Discount.Discount1 / 100);
                                            discount = (decimal)(@item.SalePrice - moneydis);
                                            text = @prodis.Discount.Discount1.ToString("#,##0") + "%";
                                        }
                                        else
                                        {
                                            moneydis = (decimal)@prodis.Discount.Discount1;
                                            discount = (decimal)(@item.SalePrice - moneydis);
                                            text = @prodis.Discount.Discount1.ToString("#,##0") + "VND";
                                        }
                                    }
                                }
                                else
                                {
                                    if (@prodis.Discount.Discount1 <= 100)
                                    {
                                        moneydis = (decimal)@item.SalePrice * ((decimal)@prodis.Discount.Discount1 / 100);
                                        discount = (decimal)(@item.SalePrice - moneydis);
                                        text = @prodis.Discount.Discount1.ToString("#,##0") + "%";
                                    }
                                    else
                                    {
                                        moneydis = (decimal)@prodis.Discount.Discount1;
                                        discount = (decimal)(@item.SalePrice - moneydis);
                                        text = @prodis.Discount.Discount1.ToString("#,##0") + "VND";
                                    }
                                }

                            }

                            <div class="p-item col-xl-3 col-lg-4 col-md-4 col-sm-6 col-12  card " style="margin:unset;margin-top:10px">
                                <div class="p-img">
                                    <a href="@url">
                                        <img loading="lazy" src="@item.Avatar" alt="@item.Avatar" width="200" height="200">
                                    </a>
                                </div>
                                @if (text != "")
                                {
                                    <div class="ps-percent fa-bounce">
                                        <p class="ps-percent-detail">
                                            Giảm @text
                                        </p>
                                    </div>
                                }
                                <div class="align-items-center d-flex my-2">
                                    @{
                                        var testcode = "";
                                        var code = @item.ProductCode.Length;
                                        if (code > 15)
                                        {
                                            code = 15;
                                            testcode = "...";
                                        }

                                    }
                                    <p class="p-sku">Mã SP:@item.ProductCode.Substring(0, code) @testcode</p>
                                    @if (item.UnitsInStock > 0)
                                    {
                                        <span class="p-qty conhang"><i class="anticon anticon-check " aria-hidden="true"></i> Còn hàng</span>
                                    }
                                    else
                                    {
                                        <span class="p-qty"> Liên hệ</span>
                                    }

                                </div>
                                <div class="p-info">
                                    <h3 class="p-name"><a href="@url">@item.ProductName </a></h3>
                                    @if (item.Price != 0)
                                    {
                                        if (text != "")
                                        {
                                            <span class="p-mprice">@item.SalePrice.Value.ToString("#,##0")VND</span>
                                            <span style="color:red">@moneydis.ToString("#,##0")VND</span>
                                            @if (discount > 0)
                                            {
                                                <span class="p-price"> @discount.ToString("#,##0")VND</span>
                                            }
                                            else
                                            {
                                                <span class="p-price">Liên hệ</span>
                                            }
                                        }
                                        else
                                        {
                                            @if (item.SalePrice == 0)
                                            {

                                                <span class="p-price">Liên hệ</span>
                                            }
                                            else
                                            {
                                                <span class="p-price">@item.SalePrice.Value.ToString("#,##0")VND</span>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <span class="p-price">Liên hệ</span>
                                    }
                                    
                                    <div class="p-action">
                                        @if (item.UnitsInStock > 0)
                                        {
                                            @if (item.SalePrice == 0)
                                            {
                                                <p>Liên hệ</p>
                                            }
                                            else
                                            {
                                                <a href="javascript:void(0)" class="p-buy" data-product-id="@item.ProductId">
                                                    Thêm vào giỏ
                                                </a>
                                            }
                                        }
                                    </div>
                                </div>
                                @*<div class="p-action">
                                    @if (item.UnitsInStock > 0)
                                    {
                                        @if (item.SalePrice == 0)
                                        {
                                            <p>Liên hệ</p>
                                        }
                                        else
                                        { 
                                            <a href="javascript:void(0)" class="p-buy" data-product-id="@item.ProductId">
                                            Thêm vào giỏ</a>
                                        }
                                    }
                                </div>*@
                            </div>


                        }
                    }
                </div>
                <div class="pagination-area pt-10">
                    <ul class="pagination justify-content-center">
                        <pager class="pager-container" list="@Model" options="@PagedListRenderOptions.Bootstrap4PageNumbersPlusPrevAndNext" asp-area="" asp-controller="Product" asp-route-brandname="@brand.BrandName" />
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/Adminassets/vendors/select2/select2.min.js"></script>
    <script>
        $('.catSelect').on('change', function () {
            var value = $(this).val();
            var id = $('.catSelect').attr('data-id');
            console.log(value,id);
            $.ajax({
                type: 'GET',
                url: '@Url.Action("checkSearchBrand","Product")',
                dataType: "Json",
                data: {
                    id: id,
                    cateid: value,
                },
                success: function (data) {
                    location.reload();
                }
            })
        })
        $('.sortSelect').on('change', function () {
            var name = $(this).val();
            var id = $('.sortSelect').attr('data-id'); 
            $.ajax({
                type: 'GET',
                url: '@Url.Action("checkSearchSort","Product")',
                dataType: "Json",
                data: {
                    id: id,
                    name: name,
                },
                success: function (data) {
                    location.reload();
                }
            })
        })
        function loadindex() {
            var id = $('.sortSelect').attr('data-id');
            $.ajax({
                type: 'GET',
                url: '@Url.Action("loadSearch","Product")',
                dataType: "Json",
                data: {
                   id:id,
                },
                success: function (data) {
                    if (data.categories != null) {
                        $(".catSelect option[value=" + data.categories.catId + "]").attr('selected', 'selected');
                    }
                    if (data.sort != null) {
                        $(".sortSelect option[value=" + data.sort + "]").attr('selected', 'selected');
                    }
                }
            })
        }
        
        $(document).ready(function () {
            loadindex();
            $('.page-link').each(function (i) {
                if ($(this).attr('rel') == "prev" || $(this).attr('rel') == "next") {
                    $(this).css('display', 'none');
                }
            });
         
            chekcHeightFilter();
            showFilter();
            $('#sliderCarousel').owlCarousel({
                dots: false,
                loop: true,
                margin: 10,
                autoplay: true,
                autoplayTimeout: 3000,
                autoplaySpeed: 1000,
                autoplayHoverPause: true,
                nav: true,
                responsive: {
                    0: {
                        items: 1
                    },
                    1200: {
                        items: 2
                    },
                }
            });
            var productLinks = document.querySelectorAll(".p-buy");
            // Gắn trình lắng nghe sự kiện click cho từng thẻ <a>
            productLinks.forEach(function (link) {
                link.addEventListener("click", function (event) {
                    event.preventDefault();
                    // Lấy product ID từ thuộc tính dữ liệu "data-product-id"
                    var productId = link.dataset.productId;
                    // Xử lý product ID tại đây
                    addToCart(productId);
                });
            });
            function chekcHeightFilter() {
                var h = $("#js-filter-height").height();
                if (h > 240) {
                    $("#js-filter-height").css("height", "240px");
                    $(".product-filter-container").css("padding-bottom", "60px");
                    $("#js-show-filter").show();
                } else {
                    $(".product-filter-container").css("padding-bottom", "0");
                }

                $("#js-show-filter").click(function () {
                    $("#js-filter-height").addClass("KichHoat");
                    $("#js-hide-filter").show();
                    $(this).hide();
                });

                $("#js-hide-filter").click(function () {
                    $("#js-filter-height").removeClass("KichHoat");
                    $("#js-show-filter").show();
                    $(this).hide();
                });
            };

            function showFilter() {
                $(".filter-list").each(function () {
                    var filter_height = $(this).height();

                    if (filter_height > 52) {
                        $(this).css("height", "48px");
                        $(this).parents(".filter-item").find(".toggle-filter").show();
                    } else {
                        $(this).parents(".filter-item").find(".toggle-filter").hide();
                    }
                });

                $(".js-toggle-filter").click(function () {
                    $(this).parents(".filter-item").find(".filter-list").toggleClass("show-filter");
                    $(this).toggleClass("KichHoat");
                });
            };
        });
    </script>
}
