@model List<Product>

@if (Model != null && Model.Count() > 0)
{
    @foreach (var item in Model)
    {
        // string url = $"/{item.Alias}-{item.ProductId}";
        string url = "/" + item.Alias + "-" + item.ProductId;
        decimal discount = 0;
        decimal moneydis = 0;
        var diss = 0;
        var text = "";
        if (ViewBag.lisDiscount != null)
        {
            foreach (var dis in ViewBag.lisDiscount)
            {
                if (item.ProductId == dis.Product.ProductId)
                {
                    diss = dis.Discount.Discount1;
                    if (dis.Discount.Discount1 <= 100)
                    {
                        moneydis = (decimal)item.SalePrice * ((decimal)dis.Discount.Discount1 / 100);
                        discount = (decimal)(item.SalePrice - moneydis);
                        text = "%";
                    }
                    else
                    {
                        moneydis = (decimal)dis.Discount.Discount1;
                        discount = (int)item.SalePrice - moneydis;
                        text = "VND";
                    }
                }
            }
        }
        <div class="p-item " style="max-width:271.667px">
            <div class="p-img">
                <a href="@url">
                    <img loading="lazy" class="lazy loading" src="@item.Avatar" alt="@item.Avatar" style="width:250px;height:250px">
                </a>
            </div>
            @if (text != "")
            {
                <div class="ps-percent fa-bounce">
                    <p class="ps-percent-detail">
                        Giảm @diss.ToString("#,##0") @text
                    </p>
                </div>
            }
            <div class="align-items-center d-flex flex-wrap my-2">
                <p class="p-sku text-primary">Mã SP: @item.ProductCode</p>
                @if (item.UnitsInStock > 0)
                {
                    <span class="p-qty conhang"><i class="anticon anticon-check" aria-hidden="true"></i>Còn hàng</span>
                }
                else
                {
                    <span class="p-qty">Liên hệ</span>
                }

            </div>
            <div class="p-info">
                <h3 class="p-name"><a href="@url">@item.ProductName</a></h3>
                @if (item.SalePrice > 0)
                {
                    if (text != "")
                    {
                        <span class="p-mprice">@item.SalePrice.Value.ToString("#,##0")VND</span>
                        <span style="color:red">@moneydis.ToString("#,##0")VND</span>
                        if (discount > 0)
                        {
                            <span class="p-price">@discount.ToString("#,##0")VND</span>
                        }
                        else
                        {
                            <span class="p-price">0VND</span>
                        }
                    }
                    else
                    {
                        @if (item.UnitsInStock > 0)
                        {

                            <span class="p-price">@item.SalePrice.Value.ToString("#,##0")VND</span>
                        }
                        else
                        {
                            <span class="p-price">Liên hệ</span>
                        }

                    }
                }
                else
                {
                    <span class="p-price">Liên hệ</span>
                }
            </div>
            <div class="p-action" style="height:100%;">
                <div style="display:flex;justify-content:flex-end; ">
                    @if (item.UnitsInStock > 0)
                    {
                        <a title="Thêm sản phẩm vào giỏ" href="javascript:void(0)" class="p-buy btn btn-warning" onclick="addToCart(@item.ProductId)"><i class="anticon anticon-shopping-cart"></i></a>
                    }
                </div>
            </div>

        </div>
    }
  
}
