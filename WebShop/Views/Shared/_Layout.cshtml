    <style>
        /* Product Image Styling */
        .product-img img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            object-position: center;
        }

        .prices-list .full-prices {
            display: none;
        }

        .prices-list:hover .full-prices {
            display: block;
            position: absolute;
            z-index: 99999;
            background: #FFFFFF;
            left: 120px;
            top: 152px;
            padding: 10px;
        }

        .show-more {
            cursor: pointer;
            color: #007bff;
            text-decoration: underline;
        }

            .show-more.hide {
                display: none;
            }

        .item-brand {
            background: rgba(0, 0, 0, .04);
            float: left;
            display: flex;
            align-items: center;
            width: calc(50% - 5px);
            height: 50px;
            margin-right: 5px;
            margin-top: 5px;
        }

        .container {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 10px;
        }

        .card {
            width: 100%;
            max-width: 180px;
            background: #fff;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
            transition: transform 0.4s ease-in-out, box-shadow 0.4s ease-in-out;
        }

            .card:hover {
                transform: translateY(-10px);
                box-shadow: 0 12px 24px rgba(0, 0, 0, 0.4);
            }

        .imgBx {
            width: 100%;
            height: 120px;
            overflow: hidden;
            position: relative;
        }

            .imgBx img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.4s ease-in-out;
            }

            .imgBx:hover img {
                transform: scale(1.1);
                z-index: 9999;
            }

        .contentBx {
            text-align: center;
            padding: 10px;
        }

            .contentBx h6 {
                font-size: 14px;
                color: #333;
                margin-bottom: 5px;
                transition: color 0.3s ease;
            }

        .card:hover h6 {
            color: #00B98E;
        }

        .contentBx a {
            text-decoration: none;
            color: #00B98E;
            font-weight: bold;
            font-size: 12px;
            transition: color 0.3s ease;
        }

            .contentBx a:hover {
                color: #007B5E;
            }

        /* Contact Box */
        .contact-box-bottom {
            position: fixed;
            bottom: 270px;
            right: 10px;
            z-index: 10000;
        }

        .contact-icon-box {
            display: block;
            text-align: center;
            width: 40px;
            height: 40px;
            font-size: 16px;
            line-height: 38px;
            border: 1px solid #e5e5e5;
            border-radius: 999px;
        }

        .contact-info, .he_thong_showroom-row .showroom-container:first-child {
            padding-left: 10px;
        }

        .contact-box-wrapper {
            display: flex;
            align-items: center;
            background: #fff;
            margin-bottom: 10px;
            padding: 10px;
            border-radius: 50%;
            text-decoration: none;
            animation: lightShake 1.5s infinite;
            transition: transform 0.3s;
            background-size: 200% 200%;
        }

        .contact-info span {
            color: #868686;
            font-size: 12px;
        }

        .scrolling-links {
            display: inline-flex;
            white-space: nowrap;
            animation: scroll-left 10s linear infinite;
        }

        .contact-box-wrapper:hover {
            transform: scale(1.1);
        }

        .link-web:hover {
            color: Red;
        }

        @@keyframes scroll-left {
            0%

        {
            transform: translateX(100%);
        }

        100% {
            transform: translateX(-100%);
        }

        }

        @@keyframes lightShake {
            0%, 100%

        {
            transform: translateX(0);
        }

        10% {
            transform: translateX(-2px);
        }

        20% {
            transform: translateX(2px);
        }

        30% {
            transform: translateX(-2px);
        }

        40% {
            transform: translateX(2px);
        }

        50% {
            transform: translateX(-1px);
        }

        60% {
            transform: translateX(1px);
        }

        70% {
            transform: translateX(-1px);
        }

        80% {
            transform: translateX(1px);
        }

        90% {
            transform: translateX(-1px);
        }

        }
    </style>
</head>

<body>
