@using System.Security.Claims;
@inject WebShop.Services.IPageInfoService PageInfoService;
@{
    // Calculate ogImage with null safety
    var pageInfo = PageInfoService.GetPageInfo();
    var ogImage = Model?.Avatar != null
        ? (pageInfo?.Domain ?? "https://novazone.co") + Model.Avatar
        : (pageInfo?.Domain ?? "https://novazone.co") + "Adminassets/images/logo/" + (pageInfo?.OgImage ?? "default-image.jpg");
    ViewData["OGimage"] = ogImage;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <!-- Google Tag Manager -->
    <script>
        const BASE_URL = "https://novazone.co";
