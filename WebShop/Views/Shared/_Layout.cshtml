    <script src="https://cdn.jsdelivr.net/npm/@@splidejs/splide@3.6.12/dist/js/splide.min.js"></script>

    <!-- Contact and Template Javascript -->
    <script src="~/Novazone/mail/jqBootstrapValidation.min.js"></script>
    <script src="~/Novazone/js/main.js"></script>

    <!-- Notifications -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            var successMessage = '@TempData["SuccessMessage"]';
            var errorMessage = '@TempData["ErrorMessage"]';
            if (successMessage) toastr.success(successMessage);
            if (errorMessage) toastr.error(errorMessage);

            $('.click-showCate').on('mouseenter', function () {
                $('.dropdown-menu').removeClass("show");
                $(this).next('.dropdown-menu').addClass("show");
                var id = $(this).attr('data-id');
            });

            $('.dropdown-menu').on('mouseleave', function () {
                $(this).removeClass("show");
            });

            $('.btn-seeMoreProductHome').on('click', function () {
                $(this).addClass('d-none');
                $.ajax({
                    url: '/Home/SeeMoreProductCateIndex',
                    method: 'GET',
                    dataType: 'json',
                    success: function (categoriesWithProductsSee) {
                        categoriesWithProductsSee.forEach(function (category) {
                            const categoryTitle = `<a href="/${category.CategoryAlias}" class=""><h2 class="section-title position-relative mx-xl-5 mb-4 mt-5"><span style="background-color:#F0F1FB" class="pr-3">${category.CategoryName}</span></h2></a>`;
                            $('#product-container').append(categoryTitle);

                            const rowDiv = $('<div class="row px-xl-5" style="margin:0; padding:0;justify-content:center;"></div>');
                            if (category.Banner) {
                                rowDiv.append(`<div class="col-12 col-md-12 col-lg-3 poster"><img style="height:100%;" src="https://novazone.co/${category.Banner}" class="img-fluid" alt="${category.CategoryName}" loading="lazy"></div>`);
                            } else {
                                rowDiv.append(`<div class="col-12 col-md-12 col-lg-3 poster"><p>Đang cập nhật</p></div>`);
                            }

                            const productCol = $('<div class="row justify-content-center row-category col-12 col-md-12 col-lg-9"></div>');
                            category.Products.forEach(function (product) {
                                const discountAmount = product.Price && product.SalePrice && product.SalePrice < product.Price
                                    ? (product.Price - product.SalePrice).toLocaleString() : null;
                                productCol.append(`
                                    <div class="item-product-Cate" title="Xem chi tiết ${product.ProductName}">
                                        <div class="product-item bg-light mb-1" style="padding:15px">
                                            <div class="product-img position-relative overflow-hidden">
                                                <div class="d-flex justify-content-center" style="height:200px;">
                                                    <img style="object-fit:contain;" class="img-fluid" src="https://novazone.co/${product.Avatar}" alt="${product.Alias}" loading="lazy">
                                                </div>
                                                <div class="product-action">
                                                    ${product.UnitsInStock > 0 ? `<a class="btn btn-outline-dark btn-square" href="javascript:void(0)" onclick="addToCart(${product.ProductId})"><i class="fa fa-shopping-cart"></i></a>` : ''}
                                                    <a class="btn btn-outline-dark btn-square" href="/${product.Alias}-${product.ProductId}"><i class="fa fa-search"></i></a>
                                                </div>
                                            </div>
                                            <div class="text-center py-3">
                                                <a class="text-decoration-none p-7 text-dark" style="height: 3.3em; display: block; overflow: hidden; line-height: 1.5em; white-space: normal; text-overflow: ellipsis; text-align:left; font-size:15px; font-weight: bold;" href="/${product.Alias}-${product.ProductId}">
                                                    ${product.ProductName.length > 50 ? product.ProductName.substring(0, 50) + "..." : product.ProductName}
                                                </a>
                                                <div class="d-md-flex justify-content-center mt-2 flex-column">
                                                    <div class="md-d-flex" style="font-size: 13px;text-align:left;">
                                                        ${discountAmount ? `<span class="text-muted" style="margin-right: 5px;"><del>${product.Price.toLocaleString()}₫</del></span><span class="text-success ml-2 d-none d-lg-inline">Tiết kiệm ${discountAmount}₫</span>` : `<span class="text-muted" style="margin-right: 5px;"> </span><span class="text-success ml-2 d-none d-lg-inline"> </span>`}
                                                    </div>
                                                    <span class="text-danger" style="font-size: 1.1em; font-weight: bold; text-align:left;">Giá: ${product.SalePrice ? product.SalePrice.toLocaleString() : product.Price.toLocaleString()}₫</span>
                                                </div>
                                                <div class="mt-1" style="text-align:left;">
                                                    ${product.UnitsInStock > 0 ? `<span style="color: #2cc067; font-size: 14px;line-height: 30px;"><i class="fa fa-check" style="color:#2cc067"></i> Còn hàng</span>` : `<span style="color:#0074da"><i class="fas fa-SoDienThoai fa-flip-horizontal"></i> Đặt hàng</span>`}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                `);
                            });
                            rowDiv.append(productCol);
                            $('#product-container').append(rowDiv);
                        });
                    },
                    error: function (xhr, status, error) {
                        console.error('Error fetching products:', error);
                    }
                });
            });

            $('.hover-price').hover(
                function () { $(this).find('.tooltip-prices').show(); },
                function () { $(this).find('.tooltip-prices').hide(); }
            );

            $('.show-more-remaining').hover(
                function () { $('.remaining-prices').removeClass('d-none'); },
                function () { if (!$('.remaining-prices').is(':hover')) $('.remaining-prices').addClass('d-none'); }
            );

            $('.remaining-prices').hover(
                function () { $(this).removeClass('d-none'); },
                function () { $(this).addClass('d-none'); }
            );

            updateCartCount();
            $('.click-showCate').hover(function () {
                var id = $(this).attr('data-id');
                var alias = $(this).attr('data-alias');
                loadAttributeByCateId(id, alias);
                loadBrandByCategoryId(id);
                loadProductNavByCateId(id);
            });

            function updateClass() {
                if ($(window).width() >= 1558) $('.row-category').addClass('col-12 col-md-12 col-lg-9');
                else $('.row-category').removeClass('col-12 col-md-12 col-lg-9');
                if ($(window).width() >= 1200) $('.product-detail-page').css({ 'padding-right': '77px', 'padding-left': '77px' });
                else $('.product-detail-page').css({ 'padding-right': '', 'padding-left': '' });
            }
            updateClass();
            $(window).resize(updateClass);
        });

        document.addEventListener('DOMContentLoaded', function () {
            var main = new Splide('#main-slider', { type: 'fade', rewind: true, pagination: false, arrows: false });
            var thumbnails = new Splide('#thumbnail-slider', {
                fixedWidth: 100, fixedHeight: 60, gap: 10, rewind: true, pagination: false, cover: true, isNavigation: true,
                breakpoints: { 600: { fixedWidth: 60, fixedHeight: 44 } }
            });
            main.sync(thumbnails);
            main.mount();
            thumbnails.mount();
        });

        function addToCart(id, amount = 1) {
            var amountDetail = $('.add-count').val();
            if (amountDetail != null) amount = amountDetail;
            Swal.fire({ position: "center", icon: "success", title: "Thêm vào giỏ hàng thành công", showConfirmButton: false, timer: 1500 });
            $.ajax({
                url: "/api/cart/add", type: "POST", data: { productID: id, amount: amount },
                success: function (response) {
                    if (response.success) {
                        console.log('Khách hàng thêm sản phẩm vào giỏ');
                        updateCartCount();
                        if (response.result === "Redirect") window.location.href = response.url;
                    } else {
                        Swal.fire({ position: "center", icon: "error", title: "Thêm sản phẩm thất bại", showConfirmButton: false, timer: 1500 });
                    }
                },
                error: function () {
                    Swal.fire({ position: "center", icon: "error", title: "Có lỗi xảy ra, vui lòng thử lại!", showConfirmButton: false, timer: 1500 });
                }
            });
        }

        function updateCartCount() {
            $.ajax({ url: '/cart/getCartCount', method: 'GET', success: function (response) { $('.shopping-cart-count').text(response.cartCount); }, error: function () { console.log("Lỗi khi lấy số lượng sản phẩm trong giỏ hàng"); } });
        }

        $('.text-search').on('input', function () {
            var text = $(this).val(), cateId = $('.selected-category').val();
            if (text !== "") {
                $('.search-result').removeClass('d-none');
                $.ajax({
                    url: "/Product/Search", type: "GET", data: { textSearch: text, cateId: cateId },
                    success: function (response) {
                        $('.search-result').empty();
                        if (response.data.length > 0) {
                            response.data.forEach(function (item) {
                                $('.search-result').append(`
                                    <a href="/${item.alias}-${item.productId}" class="link-product">
                                        <img style="width: 65px; float: left;" src="${item.avatar}" alt="${item.alias}"/>
                                        <span class="info" style="display: block; margin-left: 65px;">
                                            <p class="name">${item.productName}</p>
                                            <p class="text-danger">${item.salePrice ? new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(item.salePrice) : 'liên hệ'}</p>
                                        </span>
                                    </a>
                                `);
                            });
                        } else $('.search-result').append('<div class="link-product">Không tìm thấy sản phẩm nào.</div>');
                    },
                    error: function (error) {
                        console.error("Có lỗi xảy ra:", error);
                        $('.search-result').append('<div class="link-product">Có lỗi xảy ra trong quá trình tìm kiếm.</div>');
                    }
                });
            } else $('.search-result').addClass('d-none');
        });

        function loadAttributeByCateId(id, alias) {
            $.ajax({ url: "/Product/loadAttributeByCateId", type: "GET", data: { id: id }, success: function (response) {
                if (response) {
                    $('.fillter-list').empty(); $('.view-lsAttribute').addClass('show');
                    var attributes = response.attributes.slice(0, 8);
                    $.each(attributes.slice(0, 7), function (index, attribute) {
                        var attributeItem = `<div class="col-3"><span class="fillter-item col-12 font-weight-bold text-danger">${attribute.attributeName}</span><div class="attribute-values mt-2">`;
                        $.each(attribute.attributesPrices.slice(0, 5), function (i, price) {
                            var priceText = price.price, priceTextSub = priceText.length > 20 ? priceText.substring(0, 20) + '...' : priceText;
                            attributeItem += `<div class="attribute-value-item"><a class="text-dark" href="/loc-san-pham/${price.priceId}/${alias}">${priceTextSub}</a></div>`;
                        });
                        attributeItem += `</div></div>`;
                        $('.fillter-list').append(attributeItem);
                    });
                    if (attributes.length > 7) {
                        var remainingAttributesItem = `<div class="col-3"><span class="fillter-item col-12 font-weight-bold text-danger">Thuộc tính</span><div class="attribute-values mt-2">`;
                        $.each(response.attributes.slice(7), function (i, attribute) { remainingAttributesItem += `<div class="attribute-value-item text-danger font-weight-bold">${attribute.attributeName}</div>`; });
                        remainingAttributesItem += `</div></div>`;
                        $('.fillter-list').append(remainingAttributesItem);
                    }
                } else console.warn("Không có thuộc tính nào được trả về.");
            }, error: function (error) { console.error("Có lỗi xảy ra:", error); } });
        }

        function loadBrandByCategoryId(id) {
            $.ajax({ url: "/Product/loadBrandByCategoryId", type: "GET", data: { id: id }, success: function (response) {
                if (response.data.length === 0) console.log('No brands available');
                else if (response.data.length <= 1) {
                    $(".brand-list").empty();
                    response.data.forEach(function (brand) {
                        $(".brand-list").append(`<div class="col-12 bg-secondary p-1" style="margin-right:5px;margin-bottom:2px;"><a class="d-flex justify-content-center p-2" href="#"><img style="width: 100%; height: 100%; object-fit: cover;" class="img-fluid" src="${brand.poster}" alt="${brand.name}" /></a></div>`);
                    });
                } else {
                    $(".brand-list").empty();
                    response.data.forEach(function (brand) {
                        $(".brand-list").append(`<div class="col-5 bg-secondary p-1" style="margin-right:5px;margin-bottom:2px;"><a class="d-flex justify-content-center p-2" href=" "><img style="width: 100%; height: 20px; object-fit: cover;" class="img-fluid" src="${brand.thumb}" alt="${brand.name}" /></a></div>`);
                    });
                }
            }, error: function (err) { console.log(err); } });
        }

        function loadProductNavByCateId(id) {
            $.ajax({ url: "/Product/loadProductNavByCateId", type: "GET", data: { id: id }, success: function (response) {
                $(".ls-product-nav").empty();
                response.data.forEach(function (item) {
                    $(".ls-product-nav").append(`<div class="col-3 row"><div class="imgBx col-8"><img src="${item.thumb}" alt="${item.slideName}" itemprop="image" title="${item.slideName}"></div><div class="contentBx col-4 "><span class="h6 d-block" style="width:120px; text-align:left" itemprop="name">${item.slideName}</span><a href="${item.alias}" itemprop="url" title="Xem chi tiết">Xem ngay</a></div></div>`);
                });
            }, error: function (err) { console.log(err); } });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
    @await RenderSectionAsync("Styles", required: false)
