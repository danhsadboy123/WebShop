@{
    List<Slide> slides = ViewBag.Slider;
}
<!-- Carousel Start -->
<div class="container-fluid mb-3">
    <div class="row px-xl-5">
        <div class="col-lg-8">
            <div id="header-carousel" class="carousel slide carousel-fade mb-30 mb-lg-0" data-ride="carousel">
                <div class="carousel-inner">
                    <!-- Carousel Item 1 -->
                    <div class="carousel-item active">
                        <img class="w-100 banner-desktop" src="https://novazone.co/images/Banner/banner1.webp" alt="Novazone Banner 1" style="object-fit: cover; ">

                        <img class="w-100 banner-mobile" src="https://novazone.co/images/Banner/banner-noi.png?_t=1714721322" alt="Novazone Banner 1" style="object-fit: cover; ">



                        <div class="carousel-caption d-flex flex-column align-items-center justify-content-center">
                            <div class="p-3" style="max-width: 700px;">
                                <!-- Nội dung cho banner 1 -->
                            </div>
                        </div>
                    </div>

                    <!-- Carousel Item 2 -->
                    <div class="carousel-item">
                        <img class="w-100 banner-desktop" src="https://novazone.co/images/Banner/banner3.png" alt="Novazone Banner 2" style="object-fit: cover;">
                        <img class="w-100 banner-mobile" src="https://novazone.co/images/Banner/laptopBanner.jpg?_t=1714386319" alt="Novazone Banner 1" style="object-fit: cover; ">
                        <div class="carousel-caption d-flex flex-column align-items-center justify-content-center">
                            <div class="p-3" style="max-width: 700px;">
                                <!-- Nội dung cho banner 2 -->
                            </div>
                        </div>
                    </div>

                    <!-- Carousel Item 3 -->
                    <div class="carousel-item">
                        <img class="w-100 banner-desktop" src="https://novazone.co/images/Banner/banner2.png" alt="Novazone Banner 2" style="object-fit: cover;">
                        <img class="w-100 banner-mobile" src="https://novazone.co/images/Banner/chuot.jpg?_t=1714208392" alt="Novazone Banner 1" style="object-fit: cover; ">
                        <div class="carousel-caption d-flex flex-column align-items-center justify-content-center">
                            <div class="p-3" style="max-width: 700px;">
                                <!-- Nội dung cho banner 3 -->
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Nút điều hướng trái -->
                <a class="carousel-control-prev" href="#header-carousel" role="button" data-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="sr-only">Previous</span>
                </a>

                <!-- Nút điều hướng phải -->
                <a class="carousel-control-next" href="#header-carousel" role="button" data-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="sr-only">Next</span>
                </a>
            </div>

        </div>
        <div class="col-lg-4">

            @foreach(var thumb in slides)
            {
                <!-- Product Offer 1 -->
                <div class="product-offer mb-30">
                    <img class="img-fluid" src="~/images/slides/@thumb.Thumb" alt="@thumb.Thumb" loading="lazy">
                    <div class="offer-text"> 
                        <h3 class="text-white mb-3">@thumb.SlideName</h3>
                        <h6 class="text-white mb-3">Đang ưu đãi</h6>
                        <a href="@thumb.Alias" class="btn btn-primary">Xem ngay</a>
                    </div>
                </div>
            } 
        </div>
    </div>
</div>
<!-- Carousel End -->
