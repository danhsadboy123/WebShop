@model IEnumerable<WebShop.ModelViews.CategoryViewModel>

<div class="navbar-nav w-100 d-block"  >
    @foreach (var category in Model)
    {
        <div class="nav-item dropdown dropright">
            <a href="/danh-muc/@category.Alias" class="nav-link dropdown-toggle" id="click-showCate" data-alias="@category.Alias">@category.CategoryName <i class="fa fa-angle-right float-right mt-1"></i></a>
            <div class="dropdown-menu position-absolute rounded-0 border-0 m-0">
                <div class="row p-3" style="width:1300px;">

                    <!-- Cột thuộc tính chiếm 7 phần -->
                    <div class="col-9 mb-2">
                        <div class="row">
                            @foreach (var item in category.Attributes)
                            {
                                <div class="col-3 mb-3">
                                    <h6 class="text-danger">@item.AttributeName</h6>
                                    <div class="prices">
                                        @if (item.AttributesPrices.Count > 5)
                                        {
                                            <div class="prices-list">
                                                @foreach (var price in item.AttributesPrices.Take(5))
                                                {
                                                    <div class="price">
                                                        <a class="text-dark" href="/Product/cateatribute/@item.AttributeId?alias=@category.Alias"> @price.Price</a>

                                                    </div>
                                                }
                                                <a href="#" class="show-more" data-target="#fullPrices-@item.AttributeId">Xem thêm</a>
                                                <div class="full-prices d-none" id="fullPrices-@item.AttributeId">
                                                    @foreach (var price in item.AttributesPrices.Skip(5))
                                                    {
                                                        <div class="price">
                                                            <a class="text-dark" href="/Product/cateatribute/@item.AttributeId?alias=@category.Alias"> @price.Price</a>

                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            @foreach (var price in item.AttributesPrices)
                                            {
                                                <div class="price">
                                                    <a class="text-dark" href="/Product/cateatribute/@item.AttributeId?alias=@category.Alias"> @price.Price</a>

                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            }

                        </div>
                    </div>


                    <div class="col-3 mb-2">
                        <div class="row ">
                            @foreach (var brand in category.Brands)
                            {
                                <div class="col-5 bg-secondary  item-brand">
                                    <img class="w-100" src="@brand.Image" alt="@brand.Image" />
                                </div>
                            }
                        </div>


                    </div>

                </div>
            </div>
        </div>
    }

</div>
 