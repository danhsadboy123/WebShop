@model WebShop.ModelViews.MuaHangSuccessVM
@{
    ViewData["Title"] = "Thông tin đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml"; 
}

<script src="~/lib/jquery/jquery.min.js"></script>
<section class="order-success">
    <input id="CodeId" type="hidden" value="@Model.Order.Code"/>
    <input id="OrderId" type="hidden" value="@Model.Order.OrderId" />
    <div class="text-center p-4">
        <span style="font-size:30px;">
            <b>ĐẶT HÀNG THÀNH CÔNG</b>
            <img src="~/adminassets/images/others/ảnh tick xanh.png" alt="dat-hang-thanh-cong" width="30px">
        </span><br />
        <span class="text-danger" style="font-size:18px;"> <b>Mã đơn hàng: @Model.Order.Code</b></span>
        <p class="text-dark" style="font-size:18px;"> <b class="status-pay">Thanh toán: @Model.Order.PaymentStatus.Status </b></p>
    </div>

    <div class="container d-flex justify-content-center">
        <div class="order-success order-success-container">
            <div class="table-responsive">
                <table class="table table-hover e-commerce-table">
                    <thead>
                        <tr style="background-color:#ffc800;color:white;text-align:center">
                            <th class="col-4"><b>Ảnh sản phẩm</b></th>
                            <th class="col-4"><b>Tên sản phẩm</b></th>
                            <th class="col-2"><b>Số lượng</b></th>
                            <th class="col-2"><b>Thành tiền</b></th>
                        </tr>
                    </thead>
                    <tbody id="records_table">
                        @if (Model.OrderDetails != null && Model.OrderDetails.Any())
                        {
                            foreach (var item in Model.OrderDetails)
                            {
                                var price = item.Amount * item.Price;
                                var discountAmount = item.Discount > 0 && item.Discount <= 100
                                ? price * (item.Discount / 100.0)
                                : 0;
                                var finalPrice = price - discountAmount;
                                string url = $"/{item.Product.Alias}-{item.Product.ProductId}";
                                <tr class="font-weight-bold">
                                    <td class="col-4 text-center">
                                        <a href="@url"><img src="@item.Product.Avatar" alt="@item.Product.Avatar" class="img-fluid" style="max-width: 130px; max-height: 100%;"></a>
                                    </td>
                                    <td class="col-4  ">
                                        <a href="@url" class="p-n-s-name">@item.Product.ProductName</a>
                                    </td>
                                    <td class="col-2 text-center ">
                                        x @item.Amount
                                    </td>
                                    <td class="col-2 text-center ">
                                        @if (finalPrice.HasValue && price.HasValue)
                                        {
                                            decimal finalPriceValue = Convert.ToDecimal(finalPrice.Value); // Ép kiểu từ double sang decimal
                                            decimal priceValue = Convert.ToDecimal(price.Value); // Ép kiểu từ double sang decimal

                                            if (finalPriceValue < priceValue)
                                            {
                                                <del>@priceValue.ToString("#,##0") VND</del>
                                                <p>@finalPriceValue.ToString("#,##0") VND</p>
                                            }
                                            else
                                            {
                                                <p>@priceValue.ToString("#,##0") VND</p>
                                            }
                                        }
                                        else
                                        {
                                            <p>Giá không hợp lệ</p>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center">Không có sản phẩm nào trong đơn hàng.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="text-center font-weight-bold">
        <p>Chúng tôi sẽ liên hệ với quý khách ngay sau khi nhận được đơn đặt hàng này</p>
        <p class="text-danger">Vui lòng chụp màn hình đơn hàng được đặt thành công</p>
        <p>Mọi thắc mắc xin vui lòng liên hệ hotline: 0848 967 333</p>
    </div>

    <div class="text-center">
        <a class="btn btn-primary" href="/" style="color:white"><i class="fas fa-shopping-cart"></i> Tiếp tục mua hàng</a>
    </div>
</section>

<!-- Đảm bảo thêm thẻ meta viewport trong phần head của bạn -->
@section Scripts{
    <script>

        // Hàm để lấy giá trị từ query string
        function getQueryParam(param) {
            var urlParams = new URLSearchParams(window.location.search);
            return urlParams.get(param);
        }

        $(document).ready(function () {
            var codeId = $('#CodeId').val();
            var OrderId = $('#OrderId').val();
            console.log(codeId);
            // Lấy giá trị của vnp_ResponseCode từ URL
            var responseCode = getQueryParam("vnp_ResponseCode"); 
            if (responseCode === "00") {
                $.ajax({
                    url: "/ChangeStatusPay",
                    type: "POST",          
                    data: {
                        codeId: codeId,
                        OrderId: OrderId
                    },
                    success: function (response) { 
                        if(response.success==true)
                        {
                            $('.status-pay').text('Thanh toán: Đã thanh toán'); 
                        }
                    },
                    error: function (err) {
                         console.log(err);
                    }
                });
            } 
        }); 
    </script>
}
