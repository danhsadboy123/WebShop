@inject WebShop.Services.IPageInfoService PageInfoService;

@{
    List<WebShop.ModelViews.CartItem> Carts = ViewBag.Cart;
    List<DiscountAddProduct> listdiscount = ViewBag.discount;
    List<GitAttribute> gift = ViewBag.gift;
    Discount discountcode = ViewBag.discountcode;
    var totalCart = 0;
    int totaldis = 0;
}
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title>Báo giá sản phẩm Công ty TNHH Novazone</title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="keywords" content="">
    <meta name="MoTa" content="">
    <meta name="revisit-after" content="2 days">
    <meta name="ROBOTS" content="INDEX, FOLLOW">
    <meta name="author" content="CÔNG TY TNHH NOVAZONE">
    <meta name="distribution" content="global">
    <meta name="Copyright" content="www.novazone.co">
    <link rel="stylesheet" href="/template/style/script/style.css?v=1" type="text/css">
    <link rel="stylesheet" href="/template/default/script/all.css?v=1" type="text/css">
    <link href="~/css/print.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,400;0,700;1,400&amp;display=swap" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        p {
            line-height: 1.4;
            font-size: 15px;
            text-align: justify;
        }
        body {
            background: #f5f5f5;
            font-family: 'Roboto', Arial, Helvetica, 'Ubuntu', 'Open Sans', 'Source Sans Pro', sans-serif;
            min-width: unset; 
        }
       
        .list_table {
            border-collapse: collapse;
            border-color: #f5f5f5;
            margin-top: 12px;
        }

        .list_table th, td {
            border: 1px solid #000;
            padding: 10px;
            vertical-align: middle;
        }

        .in-bao-gia-container {
            width: 1080px;
            margin: 0 auto;
            padding: 20px;
            font-family: 'Roboto', Arial, Helvetica, 'Ubuntu', 'Open Sans', 'Source Sans Pro', sans-serif;
            font-size: 14px;
            background: #fff;
        }

        .in-bao-gia-header {
            position: relative;
            padding: 25px 0 15px 0;
            color: #000
        }

        .in-bao-gia-header-right {
            position: relative
        }

        .in-bao-gia-header-right p {
            margin: 0 0 10px 0
        }

        .in-bao-gia-header-right p:last-child {
            margin-bottom: 0
        }

        .ten-cong-ty {
            font-size: 20px;
            font-weight: 700
        }

        .in-bao-gia-title {
            color: #fff;
            display: inline-block;
            font-size: 20px;
            font-weight: 700;
            text-align: center;
            line-height: 60px;
            height: 60px;
            background: #FF9801;
        }


        .date-currency {
            display: flex;
            color: #000;
            font-weight: 500;
            flex-direction: row-reverse;
        }


        .currency {
            color: #d2171b;
            font-weight: 700
        }

        .print-button {
            display: block;
            text-align: center;
            margin: 20px 0 20px 0
        }

        .nut-do,
        .nut-xanh {
            display: inline-block;
            min-width: 200px;
            padding: 15px 20px;
            border-radius: 3px;
            color: #fff !important;
            text-align: center;
            text-decoration: none;
            text-transform: uppercase;
            font-size: 15px
        }

        .nut-xanh {
            background: #666362
        }

        .nut-do {
            background: #FF9801;
        }

        .nut-do:hover,
        .nut-xanh:hover {
            opacity: .9
        }

        .in-bao-gia-note {
            border-bottom: 1px solid #000;
        }

        .in-bao-gia-footer {
            display: flex;
            justify-content: space-between;
            align-items: center
        }

        .in-bao-gia-footer-right {
            color: #000;
            margin: 0 0 10px 0;
            font-size: 16px
        }

        .in-bao-gia-footer p a {
            font-size: 14px
        }

        .thank-you {
            text-align: center;
            margin-top: 30px
        }

        table {
            width: 100%;
        }
    </style>
</head>
    <body class="body">
        <div class="in-bao-gia-container" style="max-width:1120px;">
            <div class="in-bao-gia-header" style="padding: 15px 0 15px 0;width: 100%;float: left;display: flex;align-items: center;justify-content: space-between;">
                <div class="in-bao-gia-header-left" style="width:183px;float:left"><img src="~/Adminassets/images/logo/novazone-01.jpg" style="width:160px"></div>
                <div class="in-bao-gia-header-right" style="float:right">
                    <div class="top-content">
                    <p class="ten-cong-ty" style="font-size: 20px;font-weight: 700;margin: 0 0 10px 0;color: #FF9801;">CÔNG TY TNHH NOVAZONE</p>
                    <p style="margin: 0 0 10px 0;font-size: 16px;"><b style="color: #000;">Địa chỉ:</b> 11A Hồng Hà, Phường 2, Quận Tân Bình, TP. HCM</p>
                    <p style="margin: 0 0 10px 0;font-size: 16px;"><b style="color: #000;">Điện thoại: @PageInfoService.GetPageInfo().Address </b></p>
                    <p style="margin: 0 0 10px 0;font-size: 16px;"><b style="color: #000;">Email:</b> @PageInfoService.GetPageInfo().Email <b style="color: #000;"> - Website:</b> www.novazone.co </p>
                    <div class="date-currency">
                        <p style="margin: 0 0 10px 0;font-size: 14px;"><i>Date(Ngày báo giá): <span id="price_time"> </span> </i> </p>
                    </div>
                    <script>
                        var dt = new Date();
                        let day = dt.getDate();
                        let month = dt.getMonth()+1;
                        let year = dt.getFullYear();
                        document.getElementById('price_time').innerHTML = day + '/' + month + '/' + year;
                    </script>
                </div>
                </div>
            </div>
            <div style="clear: both;"></div>

        

        <div class="in-bao-gia-title" style="width:100%;max-width:1080px">
            QUOTATION (BẢNG BÁO GIÁ)
        </div>

        <div style="background: #fff; color: #000;white-space: nowrap;margin-top:10px">
            <p>
                <b>To (Kính gửi)           :</b>
                @if (ViewBag.HoTen != null) {@ViewBag.HoTen}
            </p>

            <p><b>Address (Địa chỉ)       :</b>
                @if (ViewBag.Address != null)
                {
                    @ViewBag.Address
                } 
            </p>
            <p><b>Email                   :</b>
                @if (ViewBag.Email != null)
                {
                    @ViewBag.Email
                }
            </p>
            <p><b>Contact (Người liên hệ) :</b> 
                @if (ViewBag.HoTen != null)
                {
                    @ViewBag.HoTen
                } </p>
            <p><b>SoDienThoai (Số điện thoại)   :</b>
                @if (ViewBag.SoDienThoai != null)
                {
                    @ViewBag.SoDienThoai
                }
            </p>
        </div>
        <p style="background: #fff; color: #000;margin: 0 0 10px 0;font-size: 16px;">
            We highly appreciate your interests in and keep working with our bussiness. Please find the below our quotation which we think serves you best in terms of price and liability. (Công ty Novazone đánh giá cao sự quan tâm và hợp tác kinh doanh của Quí khách. Quí khách vui lòng xem bảng báo giá sau đây mà Công ty Novazone cho rằng sẽ đáp ứng Quí khách tốt nhất trong bảng báo giá và trách nhiệm).
        </p>
        <table class="list_table" style="width: 100%;max-width:1080px">
            <thead>
                <tr style="background: #FF9801; color: #fff;white-space: nowrap;">
                    <th style="text-align: center;">
                        <h4>No.</h4>
                        <h4>STT</h4>
                    </th>
                    <th style="text-align: center;">
                        <h4>P/N</h4>
                        <h4>Mã Hàng</h4>
                    </th>
                    <th style="text-align: center;">
                        <h4>Descriptions</h4>
                        <h4>Mô Tả</h4>
                    </th>
                    <th style="text-align: center;">
                        <h4>Unit</h4>
                        <h4>Đvt</h4>
                    </th>
                    <th style="text-align: center;">
                        <h4>Qty</h4>
                        <h4>SL</h4>
                    </th>
                    <th style="text-align: center;">
                        <h4>Unit Price</h4>
                        <h4>Đơn Giá</h4>
                    </th>
                    <th style="text-align: center;">
                        <h4>Total Amount</h4>
                        <h4>Thành tiền</h4>
                    </th>
                    <th style="text-align: center;">
                        <h4>Warranty</h4>
                        <h4>Bảo hành</h4>
                    </th>
                </tr>
            </thead>
            <tbody>


                @if (Carts.Count() > 0)
                {
                    var stt = 1;
                  
                    @foreach (var item in Carts)
                    {
                        int totalMoney = @item.amount * @item.product.SalePrice.Value;
                        var pirce = item.product.SalePrice;
                        int discout = -1;
                        var text = "";
                        int maxaply = 0;
                        totalCart += item.product.SalePrice.Value;
                        if(listdiscount != null)
                        {
                            foreach (var dis in listdiscount)
                            {
                                if (dis.ProductId == item.product.ProductId)
                                {
                                    maxaply = (int)dis.Discount.MaxApply;
                                    discout = (int)dis.Discount.Discount1;
                                    if (dis.Discount.Discount1 <= 100)
                                    {
                                        text = "%";
                                        pirce = (int)pirce - (int)(pirce * discout / 100);
                                    }
                                    else
                                    {
                                        text = "VND";
                                        pirce = (int)pirce - discout;
                                    }
                                }
                            }
                        }
                        totaldis += (int)pirce;
                        <tr valign="middle">
                            <td>@stt</td>
                            <td>@item.product.ProductCode</td>
                            <td>
                                <p style="word-break: break-all;">@item.product.ProductName</p>
                                @if (listdiscount != null)
                                {
                                    @foreach (var dis in listdiscount)
                                    {
                                        if (dis.ProductId == item.product.ProductId && dis.Discount.Gift == false)
                                        {
                                            if (ViewBag.gift != null)
                                            {
                                                <p>Gift (Quà tặng):</p>
                                                @foreach (var gigpro in gift)
                                                {
                                                    if (gigpro.Discount.Id == dis.DiscountId)
                                                    {
                                                        int itemx = 1;
                                                        itemx = item.amount;
                                                        if (itemx > gigpro.Discount.MaxApply && gigpro.Discount.MaxApply != 0)
                                                                    {
                                                            itemx = (int)gigpro.Discount.ProductCount;
                                                        }
                                                        else
                                                        {
                                                            itemx = item.amount;
                                                        }
                                                        <span>
                                                            - (@itemx) @gigpro.ProductGift.Name
                                                        </span>
                                                        <br />

                                                    }
                                                }
                                            } 
                                        } 
                                    } 
                                }
                            </td>
                            <td>Pcs</td>
                            <td align="center">@item.amount</td>
                            <td align="center">
                                @if (item.product.SalePrice != pirce)
                                {
                                    <p>@item.product.SalePrice.Value.ToString("#,##0")</p>
                                    <p>- @discout.ToString("#,##0")</p>
                                }
                                else
                                {
                                    <p>@item.product.SalePrice.Value.ToString("#,##0")</p>
                                }
                            </td>
                            <td>
                                <p style="text-align: right;">@pirce.Value.ToString("#,##0") VND</p>
                            </td>
                            @if (item.product.Warranty != null)
                            {
                                <td align="center"> @item.product.Warranty tháng</td>
                            }
                        </tr>
                        stt++;
                    }
                }
                <tr style="background: #FF9801; color: #fff;white-space: nowrap;">
                    <td colspan="4" style=""><strong>Total (Tổng Cộng)</strong></td>
                    <td colspan="1"></td>
                    <td colspan="1"></td>
                    <td style="text-align: right;"><strong>@totaldis.ToString("#,##0") VNĐ</strong></td>
                    <td colspan="1"></td>
                </tr>
                @if (discountcode != null && discountcode.Code != null)
                {
                    <tr style="background: #FF9801; color: #fff;white-space: nowrap;">
                    <td colspan="4" style=""><strong>Promotion Code (Mã Khuyến mãi): @discountcode.Code </strong></td>
                    <td colspan="1"></td>
                    <td colspan="1"></td>
                    <td style="text-align: right;">
                        @if (@discountcode.Discount1 > 100)
                        {                           
                            <strong>@discountcode.Discount1.Value.ToString("#,##0") VND </strong>
                        }
                        else
                        {
                            <strong>@discountcode.Discount1.Value.ToString("#,##0") % </strong>                            
                        }
                     
                    </td>
                    <td colspan="1"></td>
                </tr>
                    
                }
                <tr style="background: #FF9801; color: #fff;white-space: nowrap;">
                    <td colspan="4" style=""><strong>VAT (10%) (Thuế GTGT 10%)</strong></td>
                    <td colspan="1"></td>
                    <td colspan="1"></td>
                    <td style="text-align: right;"><strong>0 VNĐ</strong></td>
                    <td colspan="1"></td>
                </tr>
                <tr style="background: #FF9801; color: #fff;white-space: nowrap;">
                    <td colspan="4" style=""><strong>Grand Total (Tổng giá trị sau thuế)</strong></td>
                    <td colspan="1"></td>
                    <td colspan="1"></td>
                    <td style="text-align: right;">
                            @if (discountcode != null && discountcode.Code != null)
                            {
                                if (@discountcode.Discount1 > 100)
                                {
                                    totaldis = totaldis - (int)discountcode.Discount1;
                                }
                                else
                                {
                                    totaldis = totaldis - ((int)discountcode.Discount1 * totaldis);
                                }

                            }
                       <strong>  @totaldis.ToString("#,##0") VNĐ</strong>
                    </td>
                    <td colspan="1"></td>
                </tr>
            </tbody>
        </table>
        @if (discountcode != null && discountcode.Code!=null)
        {
            <br />
            <b>Promotion Code (Mã Khuyến mãi): @discountcode.Code ( @discountcode.TimeOn.Value.ToString("dd/MM/yyyy") <-> @discountcode.TimeOff.Value.ToString("dd/MM/yyyy") )</b>
            <p>Gift (Quà tặng)</p>
            foreach(var git in discountcode.GitAttributes)
            {
                <p>- @git.ProductGift.Name</p>
            }

        }
        <div class="print-button">
            <a href="/cart" class="nut-xanh">Đặt mua</a>
            <a href="javascript:void(0)" class="nut-do">In đơn hàng</a>
        </div>
        <div class="in-bao-gia-note" style="margin: 0 0 10px 0;font-size: 16px;">
            <p>Terms & Conditions (Điều khoản và điều kiện):</p>
            <p>1. Warranty time: Follow Manufactory warranty policy (Bảo hành thiết bị theo tiêu chuẩn nhà sản xuất)</p>
            <p>2. Delivery: 1-3 day after you confirm the order (Thời hạn giao: 1-3 ngày sau khi nhận được đơn đặt hàng của Quí khách)</p>
            <p>3.Payment: Cash or Transfer ( Thanh Toán: Bằng Tiền mặt hoặc Chuyển khoản)</p>
            <p>4. This Quotation is within 1 day, (Bảng báo giá này có giá trị trong 1 ngày)</p>
            <p>5. If you have any questions concerning this Quotation, contact us, (Quí khách có bất kì câu hỏi liên quan đến bảng giá, vui lòng liên hệ với chúng tôi)</p>
            <p>6.Bank Account: please make your prompt payment to our following bank Account, (Tài Khoản Ngân Hàng: Quí khách vui lòng thanh toán qua tài khoản của chúng tôi)</p>
            <p><b>CÔNG TY TNHH NOVAZONE</b></p>
            <p><b>Số TK: 6927977777 Ngân Hàng TMCP QUÂN ĐỘI MB BANK - CN An Phú</b></p>
            <p><b>Số TK : Trương Quang Viên -  9273437777 Ngân Hàng Vietcombank -  CN Vạn Phúc</b></p>
        </div>

        <div style="text-align:center;display:block;margin: 0 0 10px 0;font-size: 16px;">
            <p style="text-align:center"><b>"We hope continously to be of your satisfactory services"</b></p>
            <p style="text-align:center">"Novazone hy vọng tiếp tục cung cấp các dịch vụ thỏa đáng đến Quí Khách"</p>
        </div>
            <div class="in-bao-gia-footer">
            <div class="in-bao-gia-footer-left" style="margin: 0 0 10px 0;font-size: 16px;">
                <p><b>Yours Sincerely:</b> </p>
                <p>Name: Yumi Truong </p>
                <p>Email: hello@novazone.com.vn</p>
                <p>SoDienThoai: 0937 963 779 </p>
                </div> 
                <div class="in-bao-gia-footer-right">
                <p>Customer's confirmation (Xác nhận đặt hàng) </p>
                <p>Signed and stamped (Ký tên và đóng dấu) </p>
                </div>
            </div>
        </div>
    </body>
</html>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>

    $(".nut-do").on('click', function () {
    
        var restorepage = $('body').html();
        var printcontent = $('.in-bao-gia-container').html();
        $('body').empty().html(restorepage);
        window.print();
        $('body').html(restorepage);
    })
</script>