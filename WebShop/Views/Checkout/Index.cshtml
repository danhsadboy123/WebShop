@using Microsoft.AspNetCore.Html; 
@inject WebShop.Services.IPageInfoService PageInfoService;
@{
    ViewData["Title"] = "Mua hàng"; 
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<WebShop.ModelViews.CartItem> Carts = ViewBag.GioHang;
    //List<DiscountAddProduct> listdiscount = ViewBag.discount;
    //List<GitAttribute> gift = ViewBag.gift;
    //Order orderfull = ViewBag.Orderd;  
    var og = PageInfoService.GetPageInfo().Domain + "Adminassets/images/logo/" + PageInfoService.GetPageInfo().OgImage;

    ViewData["OGimage"] = PageInfoService.GetPageInfo().Domain + "Adminassets/images/logo/" + PageInfoService.GetPageInfo().OgImage;
    
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>

@section Styles {
    <style>
        .Gift {
            min-width: 5rem;
            background: white;
            margin-right: 5px;
            margin-top: 5px;
            padding: 5px;
            border-radius: 5px;
            box-shadow: 0 2px 1px -1px rgba(0, 0, 0, 0.2), 0 1px 1px rgba(0, 0, 0, 0.1411764705882353), 0 1px 3px rgba(0, 0, 0, 0.12156862745098039);
        }

        .textp {
            display: flex;
        }
    </style>
}

<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-12">
            <nav class="breadcrumb bg-light mb-30">
                <a class="breadcrumb-item text-dark" href="/">Trang chủ</a> 
                <span class="breadcrumb-item KichHoat">Giỏ hàng</span>
            </nav>
        </div>
    </div>
</div>
@if(Carts !=null && Carts.Count()>0  )
{
    <!-- Cart Start -->
    <div class="container-fluid">
        <div class="row px-xl-5">
            <div class="col-lg-8 table-responsive mb-5">
                <table class="table table-light table-borderless table-hover mb-0">
                    <thead class="thead-dark">
                        <tr>
                            <th>Sản phẩm</th>
                            <th>Giá tiền</th>
                            <th>Số lượng</th>
                            <th>Tổng tiền</th>
                            <th>Xóa</th>
                        </tr>
                    </thead>
                    <tbody class="align-middle">
                        @foreach (var item in Carts)
                        {
                            var price = item.product.SalePrice != null && item.product.SalePrice > 0 ? item.product.SalePrice : item.product.Price;
                            var quantity = item.amount; // Lấy số lượng từ item
                            var totalPrice = price * quantity; // Tính tổng cho từng sản phẩm

                            <tr >
                                <td class="align-middle">
                                    <div class="d-flex">
                                        <img class="img-fluid" style="width:100px;" src="https://novazone.co/@item.product.Avatar" alt="@item.product.Alias">
                                        <a style="text-align:left;" href="/@item.product.Alias-@item.product.ProductId" data-productid="@item.product.ProductId">
                                            @item.product.ProductName
                                        </a>
                                    </div> 
                                </td>
                                <td class="align-middle">@price</td>
                                <td class="align-middle">
                                    <div class="input-group quantity mx-auto" style="width: 100px;">
                                        <div class="input-group-btn">
                                            <button class="btn btn-sm btn-primary btn-minus">
                                                <i class="fa fa-minus"></i>
                                            </button>
                                        </div>
                                        <input type="text" readonly class="form-control form-control-sm bg-secondary border-0 text-center" value="@quantity">
                                        <div class="input-group-btn">
                                            <button class="btn btn-sm btn-primary btn-plus">
                                                <i class="fa fa-plus"></i>
                                            </button>
                                        </div>
                                    </div>
                                </td>
                                <td class="align-middle total-price">@totalPrice VND</td>
                                <td class="align-middle"><button class="btn btn-sm btn-danger"><i class="fa fa-times"></i></button></td>
                            </tr>
                        }

                    </tbody>
                </table>
                <button class="btn btn-block btn-primary font-weight-bold my-3 py-3 d-none" id="update-cart">Cập nhật giỏ hàng</button> <!-- Nút Cập nhật -->

            </div>
            <div class="col-lg-4">
                <form class="mb-30" action="">
                    <div class="input-group">
                        <input type="text" class="form-control border-0 p-4" placeholder="Mã giảm giá">
                        <div class="input-group-append">
                            <button class="btn btn-primary">Áp dụng</button>
                        </div>
                    </div>
                </form>
                <h5 class="section-title position-relative text-uppercase mb-3">
                    <span class="bg-secondary pr-3">Tổng giỏ hàng</span>
                </h5>
                <div class="bg-light p-30 mb-5">
                    <div class="border-bottom pb-2">
                        <div class="d-flex justify-content-between mb-3">
                            <h6>Tổng tiền</h6>
                            <h6 class="cart-summary-subtotal">0 VND</h6> <!-- Cập nhật subtotal động -->
                        </div>
                        <div class="d-flex justify-content-between">
                            <h6 class="font-weight-medium">Phí ship</h6>
                            <h6 class="font-weight-medium shipping-cost">0 VND</h6> <!-- Giá ship mặc định -->
                        </div>
                    </div>
                    <div class="pt-2">
                        <div class="d-flex justify-content-between mt-2">
                            <h5>Tổng cộng</h5>
                            <h5 class="cart-summary-total">0 VND</h5> <!-- Cập nhật total động -->
                        </div>
                        <a href="/cart/checkInfor" class="btn btn-block btn-primary font-weight-bold my-3 py-3 btn-continute">Tiếp tục đặt hàng</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Cart End -->
}
else
{
    <!-- Cart Start -->
    <div class="container-fluid">
        <div class="row px-xl-5 justify-content-center">
            <a href="/danh-sach-san-pham-Novazone">Bạn chưa có sản phẩm nào! Quay lại để mua sắm</a>
        </div>
    </div>
    <!-- Cart End -->
}
@section Scripts {
    <script>
        // Sự kiện cho nút Cập nhật
        $("#update-cart").click(function () {
            var cartItems = []; 
            $("tr[data-productid]").each(function () {
                var productId = $(this).data("productid");
                var quantity = $(this).find("input").val();
                cartItems.push({ ProductId: productId, Quantity: quantity });
            });

            console.log(cartItems);
            $.ajax({
                type: "POST",
                url: 'api/cart/update',  
                data: JSON.stringify(cartItems),
                contentType: "application/json",
                success: function (response) {
                    if (response.success ==true)
                    {
                        $('#update-cart').addClass('d-none');
                        $('.btn-continute').removeClass('d-none');
                        alert("Giỏ hàng đã được cập nhật!");
                    } 
                },
                error: function (xhr, status, error) {
                    alert("Có lỗi xảy ra khi cập nhật giỏ hàng!");
                }
            });
        });

        $(document).ready(function () { 
            // Sự kiện giảm số lượng
            $(".btn-minus").off('click').on('click', function () {
                $('#update-cart').removeClass('d-none');
                $('.btn-continute').addClass('d-none');
                var input = $(this).closest(".quantity").find("input");
                var currentQuantity = parseInt(input.val());
                if (currentQuantity > 1) {
                    input.val(currentQuantity - 1);
                    updateCart($(this).closest("tr"), parseInt(input.val()));
                }
            });

            // Sự kiện tăng số lượng
            $(".btn-plus").off('click').on('click', function () {
                $('#update-cart').removeClass('d-none');
                $('.btn-continute').addClass('d-none');
                var input = $(this).closest(".quantity").find("input");
                var currentQuantity = parseInt(input.val());
                input.val(currentQuantity + 1);
                updateCart($(this).closest("tr"), parseInt(input.val()));
            });

            // Hàm cập nhật giỏ hàng
            function updateCart(row, quantity) {
                var priceText = row.find('td:nth-child(2)').text(); // Lấy giá từ cột thứ 2
                var price = parseFloat(priceText.replace(/[^0-9.-]+/g, "")); // Loại bỏ ký tự không phải số và chuyển thành số

                if (isNaN(price)) {
                    console.error("Giá không hợp lệ:", priceText);
                    return;
                }

                var newTotalPrice = price * quantity; // Tính tổng giá mới cho sản phẩm
                 
                // Định dạng giá trị và cập nhật tổng giá cho sản phẩm này
                row.find(".total-price").text(newTotalPrice.toLocaleString('vi-VN') + " VND"); // Định dạng giá trị

                // hàm để cập nhật lại tổng giỏ hàng
                updateTotalCart();
            }
         
            // Hàm tính tổng giá toàn bộ giỏ hàng
            function updateTotalCart() {
                var totalCart = 0;
                $(".total-price").each(function () {
                    var priceText = $(this).text().replace(/[^0-9]+/g, ""); // Loại bỏ tất cả ký tự không phải số
                    var price = parseFloat(priceText); // Chuyển đổi thành số nguyên
                      
                    if (!isNaN(price)) {
                        totalCart += price; // Cộng giá trị vào tổng
                    }
                });
 
                var shippingCost = 0; // Giá ship mặc định
                var subtotal = totalCart; // Subtotal chính là tổng giỏ hàng
                var total = subtotal + shippingCost; // Tổng cộng bao gồm cả giá ship

                // Cập nhật lại giá trong phần Cart Summary
                $(".cart-summary-subtotal").text(subtotal.toLocaleString('vi-VN') + " VND"); // Cập nhật Subtotal
                $(".cart-summary-total").text(total.toLocaleString('vi-VN') + " VND"); // Cập nhật Total
            }
            // Gọi hàm updateTotalCart() để tính toán lại khi trang được tải
            updateTotalCart();
        });
    </script>
}
