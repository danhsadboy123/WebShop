@using Microsoft.AspNetCore.Html;
@model WebShop.ModelViews.MuaHangSuccessVM
@{
    ViewData["Title"] = "Mua hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<WebShop.Models.OrderDetail> orderDetails = ViewBag.lsProduct;

}
<link rel="stylesheet" href="~/assets/template/style/script/cart_style.css" />
<link rel="stylesheet" href="~/assets/template/style/script/otherroot_style.css" />
<link rel="stylesheet" href="~/assets/template/style/script/root_style.css" />
<link rel="stylesheet" href="~/assets/template/style/script/media.css" />
<section class="order-success"> 
    <div style="text-align:center">
        <span style="font-size:30px;">
            <b>ĐẶT HÀNG THÀNH CÔNG</b>
        <img src="~/adminassets/images/others/ảnh tick xanh.png" alt="anhtickxanh" width="30px">
        </span><br />
        <span style="color:red;font-size:18px;"> <b>Mã đơn hàng: #@Model.DonHangID</b></span>
    </div> 
    <div style="display:flex">
        <div class="order-success order-success-container">
        <table class="table table-hover e-commerce-table " >
            <thead>
                <tr style="background-color:red;color:white;text-align:center">
                        <th style="width:150px;color:white"><b>Ảnh sản phẩm</b></th>
                        <th style="color:white"><b>Tên sản phẩm</b></th>
                        <th style="width:150px;color:white"><b>Số lượng</b></th>
                        <th style="width:150px;color:white"><b>Thành tiền</b></th>
                </tr>
            </thead>
            <tbody id="records_table">
                @if (orderDetails.Count() > 0)
                {
                    @foreach (var item in orderDetails)
                    {
                        var price = item.Amount * item.Price;                    
                        if (item.Discount > 0 && item.Discount<=100)
                        {
                            item.Discount = (int)price * (int)item.Discount;
                        }
                        var price2 = price - item.Discount;
                        string url = $"{item.Product.Alias}-{item.Product.ProductId}";
                        <tr style="text-align:center;font-weight:500;">
                            <td>
                                <a href="@url"><img src="@item.Product.Avatar" alt="@item.Product.Avatar" width="150" height="150"></a>
                            </td>
                            <td>
                                <a href="@url" class="p-n-s-name">@item.Product.ProductName</a>
                            </td>
                            <td>
                                x @item.Amount
                            </td>
                            <td>  
                                @if (price2 != price)
                                {
                                    <del>@price.Value.ToString("#,##0") VND</del>
                                    <p>@price2.Value.ToString("#,##0") VND</p>
                                }
                                else
                                {
                                    <p>@price.Value.ToString("#,##0") VND </p>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
        @if (Model.Order.Note != null)
        {
            <div class="card" style="width:300px;padding:10px 10px 0 10px;margin-left:10px">
                <div style="color: white;background: red;padding-top:6px">
                    <p style="text-align:center"><b>Thông tin đơn hàng #@Model.DonHangID</b></p>
                </div>
                @(new HtmlString(Model.Order.Note.ToString()))       
            </div>            
        }
    </div>
    
    <div style="text-align:center;font-weight:500;">
        <p>Chúng tôi sẽ liên hệ với quý khách ngay sau khi nhận được đơn đặt hàng này</p>
        <p>Mọi thắc mắc xin vui lòng liên hệ hotline: 0937 963 779</p>
    </div>
    <div class="button-buy-other-send-cart-continue">
        <a href="/" style="color:white"><i class="fas fa-shopping-cart"></i> Tiếp tục mua hàng</a>
    </div>
</section>



