@model WebShop.Models.DiaChiTaiKhoan


@section Styles{
    <style type="text/css">
        .nice-select {
            margin-top: 10px;
            width: 100%;
            margin-bottom: 4px;
            height: 48px;
        }

            .nice-select .list {
                width: 100%;
                border-radius: 0px;
                overflow-y: auto;
                overflow: hidden;
                max-height: 200px;
                overflow-y: scroll;
            }

            .nice-select .option:hover, .nice-select .option.focus, .nice-select .option.selected.focus {
                color: red;
                background: none;
            }

    </style>
}

<div class="modal-header" id="modal-header">
    <h5 class="modal-title">Thông tin người nhận hàng</h5>
    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
<div class="modal-body">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <form asp-controller="AccountAddresses" id="addShippingAddressForm" asp-action="CreateAddress" method="post">
        <div class="form-group">
            <label class="font-weight-semibold">Họ tên:</label>
            <input type="text" asp-for="UserName" class="form-control" placeholder="Vui lòng nhập tên người nhận" required >
            @*<span asp-validation-for="UserName" class="text-danger"></span>*@

        </div>
        <div class="form-group">
            <label class="font-weight-semibold">Số điện thoại:</label>
            <input type="text" asp-for="SoDienThoai" class="form-control" placeholder="Nhập số điện thoại" required>
        </div>
        <h5 class="modal-title">Địa chỉ nhận hàng</h5>

        <div class="row">
            <div class="form-group col-6">
                <label class="font-weight-semibold">Tỉnh/Thành phố</label>
                <select asp-for="ProvinceId" class="custom-select" style="min-width: 200px;" asp-items="ViewBag.lsProvinces" required>
                    <option value="" disabled selected>Tỉnh/Thành phố</option>
                </select>
            </div>
            <div class="form-group col-6">
                <label class="font-weight-semibold" >Quận/Huyện</label>
                <select asp-for="DistrictId" class="custom-select" style="min-width: 200px;" required>
                    <option value="" disabled selected>Quận/Huyện</option>
                </select>
            </div>
        </div>
        <div class="row">
            <div class="form-group col-6">
                <label class="font-weight-semibold">Phường/Xã</label>
                <select asp-for="WardId" class="custom-select" style="min-width: 200px;" required>
                    <option value="" disabled selected>Phường/Xã</option>
                </select>
            </div>
            <div class="form-group col-6">
                <label class="font-weight-semibold">Địa chỉ cụ thể</label>
                <input type="text" asp-for="Content" required class="form-control" placeholder="Số nhà, tên đường...">

            </div>
        </div>
        <div class="form-group">
            <input asp-for="IsDefault" style="margin-top:19px"  class="check-box" type="checkbox">
            <label>Đặt làm mặt định</label>
        </div>
        <button id="btn-add-address" type="submit" class="btn btn-success">Lưu địa chỉ</button>
        <script>
            $(document).ready(function () {              
                $(function () {
                    $("#ProvinceId").change(function () {
                        var provinceid = $('#ProvinceId').val();
                        $.ajax({
                            url: '/AccountAddresses/GetDistricts',
                            type: "GET",
                            dataType: "JSON",
                            data: { ProvinceId: provinceid },
                            success: function (Districts) {
                                $('#DistrictId').empty();
                                $('#WardId').empty();
                                //Clear nội dung quận huyện và phường xã
                                var strPhuongXa = '<option value="" disabled selected> Phường / Xã </option>';
                                $("#WardId").append(strPhuongXa);
                                var strQuanHuyen = '<option value="" disabled selected> Quận / Huyện </option>';
                                $("#DistrictId").append(strQuanHuyen);

                                $.each(Districts, function (i, item) {
                                    var option = '<option value ="' + item.districtId + '">' + item.type + " " + item.districtName + '</option>';

                                    $("#DistrictId").append(option);
                                });
                                $('select').niceSelect('update');
                            }
                        })
                    })
                });
                $(function () {
                    $("#DistrictId").change(function () {
                        var districtid = $('#DistrictId').val();

                        $.ajax({
                            url: '/AccountAddresses/GetWards',
                            type: "GET",
                            dataType: "JSON",
                            data: { DistrictId: districtid },
                            success: function (Wards) {


                                $('#WardId').empty();

                                //Clear nội dung quận huyện và phường xã
                                var strPhuongXa = '<option value="" disabled selected> Phường / Xã </option>';
                                $("#WardId").append(strPhuongXa);


                                $.each(Wards, function (i, item) {
                                    var option = '<option value ="' + item.wardId + '">' + item.type + " " + item.wardName + '</option>';

                                    $("#WardId").append(option);
                                });
                                $('select').niceSelect('update');
                            }
                        })
                    })
                });
            });
        </script>
    </form>
</div>
