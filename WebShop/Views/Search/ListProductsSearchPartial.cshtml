@model List<Product>
@if (Model != null)
{
    <div class="table-responsive">
        <table class="table table-hover e-commerce-table" style="width:100%">
            @foreach (var item in Model)
            {
                string url = "/products/"+item.Alias+"-"+item.ProductId+"";
                <tr>
                    <td>
                        <div class="list">
                            <a href="@url">
                                <img src="@item.Avatar" alt="@item.Avatar" width="60" height="60">
                                <span class="info">
                                    <span class="name">@item.ProductName</span>
                                    @if (item.Price == 0)
                                    {
                                        <span class="price">Liên hệ</span>
                                    }
                                    else
                                    {                                        
                                       <span class="price">@item.Price.Value.ToString("#,##0") đ</span>
                                    }
                                </span>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </table>
    </div>
}
else{
    <div>
        Không tìm thấy sản phẩm nào!
    </div>
}