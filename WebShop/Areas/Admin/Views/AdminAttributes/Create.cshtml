@model WebShop.Models.Attribute

@{
    ViewData["Title"] = "Create";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
@section Styles{
    <link href="~/Adminassets/vendors/select2/select2.css" rel="stylesheet">

}

<h4>Thêm thuộc tính</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row">
                <div class="form-group col-md-6">
                    <label asp-for="Name" class="control-label">Tên thuộc tính</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="NameEn" class="control-label">Attribute Name</label>
                    <input asp-for="NameEn" class="form-control" />
                    <span asp-validation-for="NameEn" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="Ordering" class="control-label">Sắp xếp</label>
                <input asp-for="Ordering" class="form-control" />
                <span asp-validation-for="Ordering" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label class="control-label">Danh mục</label>
                <div class="m-b-15">
                    <select class="select2" name="categoryAttributes" multiple="multiple" asp-items="ViewBag.DanhMuc">
                    </select>
                </div>
            </div>
            <div class="form-group d-flex align-items-center">
                <div class="switch m-r-10">
                    <input type="checkbox" asp-for="IsActivated" checked="">
                    <label for="IsActivated"></label>
                </div>
                <label>Công khai</label>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Quay lại</a>
</div>

@section Scripts{
    <script src="~/Adminassets/vendors/select2/select2.min.js"></script>
    <script>
        $('.select2').select2();
    </script>
}
