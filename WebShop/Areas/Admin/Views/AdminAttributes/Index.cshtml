 
@model IEnumerable<WebShop.Models.Attribute>
@{
     
    ViewData["Title"] = "Danh sách hãng sản xuất ";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
@section Styles{  
    <link href="~/Adminassets/vendors/datatables/dataTables.bootstrap.min.css" rel="stylesheet">
    <style type="text/css">
        .spinner-border {
            display: none;
        }
        .dataTables_filter label {
            display: none
        }
    </style>
}
<div class="page-header">
    <div class="header-sub-title">
        <nav class="breadcrumb breadcrumb-dash">
            <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="breadcrumb-item"><i class="anticon anticon-home m-r-5"></i>Trang chủ</a>
            <span class="breadcrumb-item active">Danh sách thuộc tính</span>
        </nav>
    </div>
</div>
<div class="card">
    <div class="card-header">
        <div class="col-md-6">
            <h6>Tìm kiếm</h6>
            <div class="input-affix m-v-10">
                <i class="prefix-icon anticon anticon-search opacity-04"></i>
                <input id="keyword" name="keyword" type="text" class="form-control" placeholder="Nhập tên thuộc tính">
            </div>
        </div>
        <div class="row justify-content-between">
            <h3>Danh sách thuộc tính</h3>
            <div class="col-lg-4 text-right">
                <a class="btn btn-primary btn-tone m-r-5" asp-area="Admin" asp-controller="AdminAttributes" asp-action="Create">Thêm thuộc tính</a>
            </div>
        </div>
    </div>
    <div class="card-body">
           
        <div class="table-responsive">
            <table id="data-table" class="display" style="width:100%">
                <thead>
                    <tr>
                        <th>STT</th>
                        <th>Tên thuộc tính</th>
                        <th>Sắp xếp</th>
                        <th>Trạng thái</th>               
                        <th>#</th>
                    </tr>
                </thead>
                <tbody id="records_table">
                    @if (Model != null)
                    {
                        var stt = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @stt
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img class="img-fluid rounded" src="Adminassets/images/others/thumb-9.jpg" style="max-width: 60px" alt="">
                                        <h6 class="m-b-0 m-l-10">@item.Name</h6>
                                    </div>
                                </td>
                                <td>
                                    @item.Ordering
                                </td>
                                <td>
                                    @if (item.Active == true)
                                    {
                                        <div class="d-flex align-items-center">
                                            <div class="badge badge-success badge-dot m-r-10"></div>
                                            <div>Công khai</div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center">
                                            <div class="badge badge-danger badge-dot m-r-10"></div>
                                            <div>Bị ẩn</div>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <a class="btn btn-primary btn-tone m-r-5" asp-area="Admin" asp-controller="AdminAttributes" asp-action="Details" asp-route-id="@item.AttributeId">Chi tiết</a>
                                    <a class="btn btn-secondary btn-tone m-r-5" data-toggle="tooltip" data-placement="top" title="Chỉnh sửa" asp-area="Admin" asp-controller="AdminAttributes" asp-action="Edit" asp-route-id="@item.AttributeId">
                                        <i class="anticon anticon-edit"></i>
                                    </a>
                                    <a class="btn btn-danger btn-tone m-r-5" data-toggle="tooltip" data-placement="top" title="Xóa" asp-controller="AdminAttributes" asp-action="Delete" asp-route-id="@item.AttributeId">
                                        <i class="anticon anticon-delete"></i>
                                    </a>

                                </td>
                            </tr>
                            stt++;
                        }
                    }
                </tbody>
            </table>
            
        </div>
    </div>
</div>
<div id="modal-header" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/Adminassets/vendors/datatables/jquery.dataTables.min.js"></script>
    <script src="~/Adminassets/vendors/datatables/dataTables.bootstrap.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#modal-header').on('show.bs.modal', function (event) {
                console.log('haha')
                var button = $(event.relatedTarget); // Button that triggered the modal
                var url = button.attr("href");
                var modal = $(this);
                // note that this will replace the content of modal-content ever time the modal is opened
                modal.find('.modal-content').load(url);
            });
        });
        var table = $('#data-table').DataTable({
            language: {
                search: "Tìm kiếm",
                lengthMenu: "Hiển thị _MENU_",
                zeroRecords: "Không tìm thấy",
                info: "Hiển thị từ _START_ đến _END_ trong _TOTAL_ thuộc tính",
                infoEmpty: "",
                infoFiltered: "",
                paginate: {
                    "previous": "Trước",
                    "next": "Sau"
                }
            },

        });
        $('#keyword').keyup(function () {
            table.search($(this).val()).draw();
        })
    </script>
}
