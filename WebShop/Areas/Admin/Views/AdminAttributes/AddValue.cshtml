@model WebShop.Models.ThuocTinh

<div class="modal-body">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <h5>Thêm thuộc tính</h5>
    <form asp-area="Admin" asp-controller="AdminAttributes" asp-action="Create" method="post">
        <div class="form-group">
            <input type="text" asp-for="Name" class="form-control" placeholder="Nhập tên thuộc tính" required>
            @*<span asp-validation-for="UserName" class="text-danger"></span>*@
        </div>
        <button id="btn-add-address" type="submit" class="btn btn-success">Thêm</button>
    </form>
</div>
