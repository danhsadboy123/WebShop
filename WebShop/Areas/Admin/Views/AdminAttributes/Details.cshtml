@model WebShop.Areas.Admin.Models.AttributeValueVM

<h2>@Model.Attribute.Name</h2>

<form method="post">
    <input type="hidden" name="AttributeId" value="@Model.Attribute.AttributeId" />
    <div class="form-row">
        <div class="form-group col-md-6" style="display:flex">
            <input type="text" class="form-control" name="newValue" placeholder="Nhập giá trị">
            <button type="submit" class="btn btn-primary" style="margin-left:12px">Thêm</button>
        </div>
    </div>
</form>

<h3>Danh sách giá trị:</h3>
<div class="table-responsive">
    <table class="table table-hover e-commerce-table">
        <thead>
            <tr>
                <th>STT</th>
                <th>Tên giá trị</th>
                <th>#</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                var stt = 1;
                foreach (var item in Model.AttributePrices)
                {
                    <tr>
                        <td>
                            @stt
                        </td>
                        <td>
                            <div class="d-flex align-items-center">
                                <h6 class="m-b-0 m-l-10">@item.Price</h6>
                            </div>
                        </td>
                        <td>
                            @*<a class="btn btn-secondary btn-tone m-r-5" asp-area="Admin" asp-controller="AdminAttributes" asp-action="Edit" asp-route-id="@item.AttributeId">Sửa</a>*@
                            <a class="btn btn-success btn-tone m-r-5" asp-area="Admin" asp-controller="AdminAttributes" asp-action="DeleteAttributePrice" asp-route-id="@item.AttributesPriceId">Xóa</a>
                        </td>
                    </tr>
                    stt++;
                }
            }
        </tbody>
    </table>
</div>
@section Scripts{
    <script>
        $(document).ready(function () {
            // Bắt sự kiện submit form
            $('form').submit(function (e) {
                e.preventDefault(); // Ngăn chặn việc tải lại trang

                // Lấy dữ liệu từ form
                var attributeId = $(this).find('input[name="AttributeId"]').val();
                var newValue = $(this).find('input[name="newValue"]').val();
                // Gửi yêu cầu AJAX đến action AddValue
                $.ajax({
                    url: '/Admin/AdminAttributes/AddValue',
                    type: 'POST',
                    dataType: "JSON",
                    data: { attributeId: attributeId, newValue: newValue },
                    success: function (response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            // Xử lý khi có lỗi
                        }
                    },
                    error: function () {
                        // Xử lý khi có lỗi
                    }
                });
            });
        });

    </script>
}