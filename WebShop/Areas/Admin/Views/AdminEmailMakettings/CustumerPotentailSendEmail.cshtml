@model PagedList.Core.IPagedList<WebShop.Models.CustomerPotentail>
@using Microsoft.AspNetCore.Html;

@{
    ViewData["Title"] = "Danh sách khách hàng tiềm năng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
@section Styles{
    <link href="~/Adminassets/vendors/datatables/dataTables.bootstrap.min.css" rel="stylesheet">
    <link href="~/Adminassets/summernote/summernote-bs4.css" rel="stylesheet" />
    <link href="~/Adminassets/summernote/summernote.css" rel="stylesheet" />
    @*<link href="~/Adminassets/datatable/datatabese.css" />*@
    <link href="~/Adminassets/vendors/datatables/dataTables.bootstrap.min.css" rel="stylesheet">
    <style type="text/css">
        .spinner-border {
            display: none;
        }

        .dataTables_filter label {
            display: none
        }

        #errEmail {
            display: none;
        }
      
    </style>

}
<div class="page-header">
    <div class="header-sub-title">
        <nav class="breadcrumb breadcrumb-dash">
            <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="breadcrumb-item"><i class="anticon anticon-home m-r-5"></i>Trang chủ</a>
            <a class="breadcrumb-item">Chăm sóc khách hàng</a>
            <span class="breadcrumb-item KichHoat">Khách hàng tiềm năng</span>
        </nav>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="row m-b-30" id="search-h">
            <div class="col-lg-4">
                <label>Tìm kiếm</label>
                <input id="inputText" name="search" value="@ViewBag.Search" type="text" class="form-control" placeholder="Nhập thông tin khách hàng">
            </div>
            <div class="col-lg-4">
                <label>Khách hàng</label>
                <div class="row">
                    <div class="col-lg-10">
                        <select class="custom-select" id="levercustomer" name="levercustomer" style="min-width: 200px;">
                            <option value="0">Chọn tất cả</option>
                            @foreach (var item in ViewBag.lever)
                            {
                                string a = item.Id.ToString();
                                if (ViewBag.checklever == a)
                                {
                                    <option value="@item.Id" selected>@item.NameLever</option>
                                }
                                else
                                {
                                    <option value="@item.Id">@item.NameLever</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-lg-2">
                        <a data-toggle="modal" data-target="#exampleModalLong1"><i class="btn btn-primary anticon anticon-setting"></i></a>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-2">
                <label for="OptionEmailID">Chọn mẫu thư</label>
                <select onclick="updatesection()" class="custom-select" id="OptionEmailID" name="OptionEmailID">
                    @foreach (var item in ViewBag.Email)
                    {
                        string a = item.EmailId.ToString();
                        if (ViewBag.itemEmail == a)
                        {
                            <option value="@item.EmailId" selected>@item.Title</option>
                        }
                        else
                        {
                            <option value="@item.EmailId">@item.Title</option>
                        }
                    }
                </select>
            </div>
            <div class="col-lg-2">
                <label for="OptionEmailID">Xem trước và cài đặt</label>
                <div class="row">
                    <button type="button" class="btn btn-secondary btn-tone" data-toggle="modal" data-target="#exampleModalLongIsEmail" onclick="viewEmail()"><i class="anticon anticon-eye"></i></button>
                    <div>
                        <a data-toggle="modal" data-target="#exampleModalLongOPtionmail"><i class="btn btn-primary anticon anticon-setting"></i></a>
                    </div>                    
                </div>
            </div>
        </div>

        <div class="row m-b-30" id="optionSend">
            <div class="col-lg-12">
                <div class="d-md-flex">
                    <div class="m-b-15">
                        <button class="btn btn-primary" id="ClickAllEmail" onclick="SendAllEmail()"><i class="anticon anticon-mail"></i> <span>Gửi thư </span></button>
                        <div id="loadAllEmail" class="spinner-border text-primary" VaiTro="status">
                            <span class="sr-only"></span>
                        </div>
                        <span id="errEmail">Liên hệ Sunhitech lỗi gửi email</span>
                    </div>
                    <span style="width:2%;"></span>
                    <div class="form-group d-flex align-items-center">
                        <div class="switch m-r-10">
                            @if (ViewBag.checksave == "1")
                            {
                                <input onclick="updatesection()" type="checkbox" id="checksaveInput" checked>
                            }
                            else
                            {
                                <input onclick="updatesection()" type="checkbox" id="checksaveInput">

                            }
                            <label for="checksaveInput"></label>
                        </div>
                        <label>Lưu vào hộp thư</label>
                    </div>
                </div>
            </div>
        </div>
        <table id="data-table" class="display" style="width:100%">
            <thead>
                <tr class="text-center">
                    <th>MKH</th>
                    <th>Họ Và Tên</th>
                    <th>Tên công ty</th>
                    <th>Email</th>
                    <th>Địa chỉ</th>
                    <th>SĐT</th>
                    <th>Loại khách hàng</th>
                    <th>Hộp thư</th>
                    @if (ViewBag.checknull == 0)
                    {
                        <th>Chọn<input id="checkinput" onclick="CheckedAllSendmail()" type="checkbox" checked /></th>
                    }
                    else
                    {
                        <th>Chọn<input id="checkinput" onclick="CheckedAllSendmail()" type="checkbox" /></th>
                    }
                </tr>
            </thead>
            <tbody >

                @if (Model != null)
                {

                    foreach (var item in Model)
                    {
                        if (item.Email != null)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">

                                        <h6 class="m-b-0 m-l-10">KH @item.Id</h6>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">

                                        <h6 class="m-b-0 m-l-10">@item.Name</h6>
                                    </div>
                                </td>
                                <td>
                                    @item.CompannyName
                                </td>
                                <td>@item.Email</td>
                                <td>@item.Address</td>
                                <td>@item.SoDienThoai</td>
                                <td class="row ist">
                                    <div class="col-lg-10">
                                    @item.Lever.NameLever
                                    </div>
                                    <select class="col-lg-1 custom-select selectlever" id="@item.Id" name="levercustomer" style="max-height:2rem;">
                                        <option disabled selected hidden>Đổi</option>
                                        @foreach (var c in ViewBag.lever)
                                        {
                                            <option value="@c.Id">@c.NameLever</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <a data-target="#modal-header" data-toggle="modal" class="btn btn-secondary btn-tone m-r-5" asp-area="Admin" asp-controller="AdminEmailMakettings" asp-action="ListEmailCusP" asp-route-id="@item.Id"><i class="anticon anticon-eye"></i></a>
                                </td>
                                <td>
                                    @if (item.Checked == 1)
                                    {
                                        <input onclick="CheckedSendmail(@item.Id)" type="checkbox" checked />
                                    }
                                    else
                                    {
                                        <input onclick="CheckedSendmail(@item.Id)" type="checkbox" />
                                    }
                                </td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>

    </div>
</div>
 @*View add khach hàng*@
<div class="modal fade" id="exampleModalCenter">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalCenterTitle">Thêm khách hàng mới</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <i class="anticon anticon-close"></i>
                </button>
            </div>
            <form>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group">
                        <label for="Name" class="control-label">Tên khách hàng</label>
                        <input id="Name" class="form-control" placeholder="Nhập tên khách hàng" />
                        <span class="text-danger Name"></span>
                    </div>
                    <div class="form-group">
                        <label for="Company" class="control-label">Tên công ty</label>
                        <input id="Company" class="form-control" placeholder="Nhập tên công ty khách hàng" />
                        <span class="text-danger Company"></span>
                    </div>
                    <div class="form-group">
                        <label for="Email" class="control-label">Email</label>
                        <input id="Email" class="form-control" type="email" placeholder="Nhập email khách hàng" />
                        <span class="text-danger Email"></span>
                    </div>
                    <div class="form-group">
                        <label for="Address" class="control-label">Địa chỉ</label>
                        <input id="Address" class="form-control" placeholder="Nhập địa chỉ khách hàng" />
                        <span class="text-danger Address"></span>
                    </div>
                    <div class="form-group">
                        <label for="SoDienThoai" class="control-label">SĐT</label>
                        <input id="SoDienThoai" type="number" class="form-control" placeholder="Nhập số điện thoại khách hàng" />
                        <span class="text-danger SoDienThoai"></span>
                    </div>
                    <div class="form-group">
                        <label>Khách hàng</label>
                        <select class="custom-select" id="levercustomerAdd" name="levercustomerAdd" style="min-width: 200px;">
                            @foreach (var item in ViewBag.lever)
                            {
                                <option value="@item.Id">@item.NameLever</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button onclick="AddressCustomeP()" id="createCus" style="display:none;" value="Submit" type="button" class="btn btn-primary">Tạo mới</button>
                </div>
            </form>
        </div>
    </div>
</div>
@*view kach hang*@
<div class="modal fade bd-example-modal-lg" id="exampleModalLong1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <div class="modal-title" id="Title1">
                    <h5>Phân Loại khách hàng
                        <a class="btn btn-primary" onclick="createLever()"><i class="anticon anticon-plus m-r-5"></i><span>Thêm mới</span></a>
                        <input id="Namelerver" style="display:inline;max-width:200px;" placeholder="Tên loại khách hàng" type="text" class="form-control" />
                    </h5>    
                   
                </div>
                
                <button type="button" class="close" data-dismiss="modal">
                    <i class="anticon anticon-close"></i>
                </button>
            </div>
            <div class="modal-body">
                
                <table class="display" style="width:100%">
                    <thead>
                        <th>Id loại</th>
                        <th>Tên</th>
                        <th width="20%">#</th>
                    </thead>
                    <tbody>
                         
                        @foreach (var item in ViewBag.lever)
                        {
