<div class="modal fade" id="exampleModal1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Nhập thay đổi</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <i class="anticon anticon-close"></i>
                </button>
            </div>
            <div class="modal-body">
                <input id="updateId" type="hidden"/>
                <input id="updateName" type="text" class="form-control"/>
            </div>
            <div class="modal-footer">
                <button onclick="updateSave()" type="button" class="btn btn-primary">Lưu thay đổi</button>
            </div>
        </div>
    </div>
</div>
@*excel*@
<div id="import_excel_md" class="modal fade" tabindex="-1" VaiTro="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-area="Admin" asp-controller="AdminCustomerPotentails" asp-action="ImportCustommerP" method="post" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5>Tải lên file excel</h5>
                    <button type="button" class="close" data-dismiss="modal">
                        <i class="anticon anticon-close"></i>
                    </button>
                </div>

                <div class="modal-body">
                    <div class="form-group">
                        <input class="form-control" type="file" name="excelFile" id="excelFile" accept=".xlsx" required />
                    </div>
                    <div class="form-group">
                        <label>Khách hàng</label>
                        <select class="custom-select" id="LeverID" name="LeverID" style="min-width: 200px;" required>
                            @foreach (var item in ViewBag.lever)
                            {
                                <option value="@item.Id">@item.NameLever</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button style="float:right" type="submit" onclick="insertExecl" class="btn btn-success m-r-5">
                        <i class="anticon anticon-loading m-r-5"></i>
                        <span>Thực hiện</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@*<div class="modal fade" id="exampleModalCenter1"></div>*@
@section Scripts{
    <script src="~/Adminassets/vendors/datatables/jquery.dataTables.min.js"></script>
    <script src="~/Adminassets/vendors/datatables/dataTables.bootstrap.min.js"></script>
    <script>
         
      

        function updateSave(){
            var name =$("#updateName").val();
            var id = $("#updateId").val();
             
            if(name==""){
                alert ="Tên Không tồn tại";
            }
            else{
                $.ajax({
                type: 'POST',
                url: '@Url.Action("SaveNameLever","AdminLeverCustommerPtts")',
                dataType: "Json",
                data: {
                    id: id,
                    name:name
                },
                success: function (data) {
                    location.reload();
                   
                }

            })
            }
        }
        function updateLeverCus(id){
            $.ajax({
                type: 'POST',
                url: '@Url.Action("LeverCus","AdminLeverCustommerPtts")',
                dataType: "Json",
                data: {
                    id: id
                },
                success: function (data) {
                     console.log(data);
                    $("#updateName").val(data.value.nameLever);
                    $("#updateId").val(data.value.id);
                }

            })
            
        }
        function createLever(){
            var Namelerver = $("#Namelerver").val();
            if (Namelerver==""){
                alert("Vui lòng nhập");
            }
            else{
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("createLever","AdminLeverCustommerPtts")',
                    dataType: "Json",
                    data: {
                        Namelerver: Namelerver
                    },
                    success: function (data) {
                        if (data.success == "Ok") {
                            location.reload();
                        }
                        if (data.success == "No") {
                            alert("Không tìm thấy danh mục này!");
                        }
                        if (data.success == "No1") {
                            alert("Danh mục lớn hơn 1 khách hàng không thể xóa!");
                        }
                    }

                })

            }
        }
        function deleteLeverCus(Id){
            $.ajax({
                type: 'POST',
                url: '@Url.Action("deleteitem","AdminLeverCustommerPtts")',
                dataType: "Json",
                data: {
                    id: Id                    
                },
                success: function (data) {
                    if (data.success == "Ok") {
                        location.reload();
                    }
                    if (data.success == "No") {
                        alert("Không tìm thấy danh mục này!");
                    }
                    if (data.success == "No1") {
                        alert("Danh mục lớn hơn 1 khách hàng không thể xóa!");
                    }
                }

            })
        }
        $('.selectlever').on('change',function(){
            var value = $(this).val();
            var id =this.id;
            $.ajax({
                type: 'POST',
                url: '@Url.Action("updateValue","AdminCustomerPotentails")',
                dataType: "Json",
                data: {
                    id:id, 
                    lerver:value                   
                },
                success: function (data) {
                    if (data.success == "Ok") {
                        location.reload();
                    }
                }

            })
        })


        function DeleteEmail(id) {
            $.ajax({
                type: 'POST',
                url: '@Url.Action("Delete","AdminEmailMakettings")',
                dataType: "Json",
                data: {
                    id: id,
                },
                success: function (data) {
                    if (data.success == "Ok") {
                        alert("Xóa thành công");
                        location.reload();
                    }
                    if (data.success == "No") {
                        alert("Xóa không thành công");
                    }


                }

            });
        }
        function viewEmail() {
            var option = $("#OptionEmailID").val();
            $.ajax({
                type: 'GET',
                url: '@Url.Action("ViewEmail","AdminEmailMakettings")',
                dataType: "Json",
                data: {
                    option: option
                },
                success: function (data) {
                    $("#exampleModalLongTitleIsEmail").html(data.value.title)
                    $(".isemail").html(data.value.body)
                    $(".isemail img").css('width', '100%');
                    $(".ViewEdit").html('<div class="btn-group" dropdown>'
                        + '<a class="btn btn-secondary btn-tone" href="/Admin/AdminEmailMakettings/Edit/'+option+'?url=CustumerPotentailSendEmail">'
                                        +'<i class="anticon anticon-edit"></i></a>'
                        + '<a onclick ="DeleteEmail('+option+')" class="btn btn-danger btn-tone">'
                                        +'<i class="anticon anticon-delete"> </i></a>'
                                        +'</div>')
                }

            })
        }
        function viewEmail1(id) {
            var option = id;
            $.ajax({
                type: 'GET',
                url: '@Url.Action("ViewEmail","AdminEmailMakettings")',
                dataType: "Json",
                data: {
                    option: option
                },
                success: function (data) {
                    $("#exampleModalLongTitleIsEmail").html(data.value.title);
                    $(".isemail").html(data.value.body);
                    $(".isemail img").css('width', '100%');
                    $(".ViewEdit").html('<div class="btn-group" dropdown>'
                        + '<a class="btn btn-secondary btn-tone" href="/Admin/AdminEmailMakettings/Edit/' + id + '?url=CustumerPotentailSendEmail">'
                                        +'<i class="anticon anticon-edit"></i></a>'
                                        +'<a onclick ="DeleteEmail('+id+')" class="btn btn-danger btn-tone">'
                                        +'<i class="anticon anticon-delete"> </i></a>'
                                        +'</div>');
                }

            })
        }
        $(document).ready(function () {
            $(".isemail img").css('width', '100%');
            var table = $('#data-table').DataTable({
                language: {
                    search: "Tìm kiếm",
                    lengthMenu: "Hiển thị _MENU_",
                    zeroRecords: "Không tìm thấy",
                    info: "Hiển thị từ _START_ đến _END_ trong _TOTAL_ khách hàng",
                    infoEmpty: "",
                    infoFiltered: "",
                    paginate: {
                        "previous": "Trước",
                        "next": "Sau"
                    }
                },

            });

            $('#inputText').keyup(function () {
                table.search($(this).val()).draw();
            })
            var html = '<div>' +
                '<a class="btn btn-default m-r-5" data-target="#import_excel_md" data-toggle="modal" ><i class="anticon anticon-file-excel m-r-5" > </i><span>Import Excel</span > </a>' +
                '<button type="button" class="btn btn-primary" data-toggle="modal" data-target="#exampleModalCenter">' +
                '<i class="anticon anticon-plus m-r-5"></i><span>Thêm khách hàng</span>' +
                '</button>' +
                '<button onclick="deleteItem()" class="btn btn-danger btn-tone m-r-5" data-toggle="tooltip" data-placement="top" title="Xóa người đã chọn">' +
                '<i class="anticon anticon-delete"></i>' +
                '</button>' +
                '</div>'
            $("#data-table_filter").html(html)
        });



        function updatesection() {
            var option = $("#OptionEmailID").val();
            var checksave = 0;
            if ($("#checksaveInput").is(":checked")) {
                checksave = 1;
            };
            $.ajax({
                type: 'POST',
                url: '@Url.Action("updatesection","AdminEmailMakettings")',
                dataType: "Json",
                data: {
                    option: option,
                    checksave: checksave
                },
            })
        }
        /// check khach hang
        $("#levercustomer").on('change', function () {
            var leverID = $(this).val();
            
