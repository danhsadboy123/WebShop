        /// check email
        function CheckedSendmail(id) {
            $.ajax({
                type: 'POST',
                url: '@Url.Action("CheckedSendmail","AdminCustomerPotentails") ',
                dataType: "Json",
                data: {
                    Id: id
                },
                success: function (data) {
                    console.log(data.value);
                    if (data.value == 0) {
                        $("#checkinput").prop("checked", true);
                    }
                    else {
                        $("#checkinput").prop("checked", false);
                    }
                }
            })
        }
