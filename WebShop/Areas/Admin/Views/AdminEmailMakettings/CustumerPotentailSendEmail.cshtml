        function checkshow(check) {
            let show = 0;
            for (let i = 0; i < 5; i++) {
                show += check[i];
            }
            if (show == 0) {
                $("#createCus").css("display", "block");
            }
            else {
                $("#createCus").css("display", "none");
            }
        }
