        // them khach hang
        function AddressCustomeP() {
            var Name = $("#Name").val();
            var Company = $("#Company").val();
            var Email = $("#Email").val();
            var Address = $("#Address").val();
            var SoDienThoai = $("#SoDienThoai").val();
            var LeverId = $('#levercustomerAdd').find(":selected").val();
            $.ajax({
                type: 'POST',
                url: '@Url.Action("Create","AdminCustomerPotentails")',
                dataType: "Json",
                data: {
                    Name: Name,
                    CompannyName: Company,
                    Email: Email,
                    Address: Address,
                    SoDienThoai: SoDienThoai,
                    LeverId: LeverId
                },
                success: function (data) {
                    if (data.success == "Ok") {
                        location.reload();
                    }
                    if (data.success == "No1") {
                        $(".Email").html("Hộ thống kiểm tra thấy email bạn nhập ko hợp lệ");
                    }
                    if (data.success == "No") {
                        $(".Email").html("Hộ thống kiểm tra thấy email đã tồn tại");
                    }

                }
            })
        }
