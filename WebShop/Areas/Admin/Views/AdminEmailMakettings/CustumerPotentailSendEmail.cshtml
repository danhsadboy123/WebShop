                                    </a>                                   
                                    
                                    <a onclick="deleteLeverCus(@item.Id)" class="btn btn-danger btn-tone">
                                        <i class="anticon anticon-delete"> </i>
                                    </a>
                                </td>
                            </tr>

                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
