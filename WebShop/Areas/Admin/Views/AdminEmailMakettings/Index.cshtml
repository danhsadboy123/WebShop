@using Microsoft.AspNetCore.Html;
@model IEnumerable<WebShop.Models.EmailTiepThi>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}


<div class="card-header">
    <div class="header-sub-title row justify-content-between">
        <nav class="breadcrumb breadcrumb-dash">
            <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="breadcrumb-item"><i class="anticon anticon-home m-r-5"></i>Trang chủ</a>
            <a class="breadcrumb-item">Chăm sóc khách hàng</a>
            <span class="breadcrumb-item KichHoat">Danh sách thư</span>
        </nav>
        <div class="col-lg-4 text-right">
            <a class="btn btn-primary" asp-action="Create"><i class="anticon anticon-plus m-r-5"></i><span>Tạo thư</span></a>
        </div>
    </div>
</div>
<br />
<div class="card-group">
        <div class="row ">
    @foreach (var item in Model)
    {
        <div class="col-12 col-sm-4 col-lg-6">
                <div class="card"  >
                    <div class="card-header">
                        <p>Loại thư: @Html.DisplayFor(modelItem => item.Title)</p>
                        <p> Người Tạo: @Html.DisplayFor(modelItem => item.Acount.HoTen)</p>
                    </div>
                    <div class="card-body">
                        <div>                          
                           
                            @if (item.Body != null)
                            {
                                @(new HtmlString(item.Body.ToString()))
                            }
                           
                        </div>
                    </div>
                    <div class="card-footer">
                        <a class="btn btn-secondary btn-tone m-r-5" data-toggle="tooltip" data-placement="top" asp-action="Edit" asp-route-id="@item.EmailId"><i class="anticon anticon-edit"></i></a>
                        @*<a class="btn btn-secondary btn-tone m-r-5" data-toggle="tooltip" data-placement="top" asp-action="Details" asp-route-id="@item.EmailId"> <i class="anticon anticon-eye"></i></a>*@
                        <a class="btn btn-danger btn-tone m-r-5" data-toggle="tooltip" data-placement="top" asp-action="Delete" asp-route-id="@item.EmailId"><i class="anticon anticon-delete"></i></a>
                    </div>
                
                </div>
         
            </div>
    } 
        </div>
</div>







 
