@model List<WebShop.ModelViews.CartItem>
@if (Model != null && Model.Count() > 0)
{
    <div class="table-responsive">
        <table class="table table-hover e-commerce-table" style="width:100%">
            <thead style="background:#edf2f9">
                <tr>
                    <th>Sản phẩm</th>
                    <th>Số lượng</th>
                    <th>Giá (đ)</th>
                    <th>Thành tiền (đ)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    string url = $"/{item.product.Alias}-{item.product.ProductId}";
                    <tr>
                        <td>
                            <div class="d-flex justify-content-between">
                                <div class="d-flex" style="max-width:500px">
                                    @if (item.product.Avatar != null)
                                    {
                                        <img class="img-fluid rounded" src="~/images/products/@item.product.Avatar" style="max-width: 60px;border:solid #DDDDDD 1px;" alt="">
                                    }
                                    else
                                    {
                                        <img class="img-fluid rounded" src="~/Adminassets/images/avatars/thumb-1.jpg" style="max-width: 60px;border:solid #DDDDDD 1px;" alt="">
                                    }
                                    <div style="margin-left:12px"><a target="_blank" href="@url" class="text-dark" style="font-weight:500;">@item.product.ProductName</a></div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <input min="1" max="@item.product.UnitsInStock" type="number" class="form-control amountInput" style="max-width:80px" value="@item.amount"  data-productid="@item.product.ProductId">
                        </td>
                        <td>@string.Format("{0:#,##0 VND}", item.product.SalePrice.Value)</td>
                        <td><span class="totalMoney">@string.Format("{0:#,##0 VND}", (item.product.SalePrice * item.amount).Value)</span></td>
                        <td>
                            <a style="border-color:transparent" class="btn" onclick="RemoveItem(@item.product.ProductId)">
                                <i class="anticon anticon-close"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <script>
            var amountInput = document.querySelectorAll('.amountInput');
            amountInput.forEach(function (amountInput) {
                amountInput.addEventListener("input", function () {
                    var amount = amountInput.value;
                    var productId = amountInput.dataset.productid;
                    if (amount >= 1) {
                        $.ajax({
                            url: "/api/order/update",
                            type: "POST",
                            dataType: "JSON",
                            data: {
                                productID: productId,
                                amount: amount
                            },
                            success: function (result) {
                                if (result.success) {
                                    loadProductOrder();
                                }
                            },
                            error: function (rs) {
                                alert("Update Product Error !")
                            }
                        });
                    }
                })
            })

            function RemoveItem(productId) {
                var productid = productId;
                $.ajax({
                    url: "/api/order/remove",
                    type: "POST",
                    dataType: "JSON",
                    data: { productID: productid },
                    success: function (result) {
                        if (result.success) {
                            loadProductOrder();
                        }
                    },
                    error: function (rs) {
                        alert("Remove Product Error !")
                    }
                });
            }
            function loadProductOrder() {
                $('#productOrder').load("/Admin/AdminAjaxContent/ProductOrder");
                $('#productOrderDetails').load("/Admin/AdminAjaxContent/ProductOrderDetails");
            }
         </script>
    </div>
}
