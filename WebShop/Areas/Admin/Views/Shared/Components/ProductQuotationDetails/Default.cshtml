@model List<WebShop.ModelViews.CartItem>
@if (Model != null && Model.Count() > 0)
{
    <div class="table-responsive" id="productQuotationDetails">
        <table class="product-info-table">
            <tbody>
                <tr>
                    <td>Số lượng sản phẩm</td>
                    <td class="text-right">
                        <span id="totalAmount">@Model.Sum(x => x.amount)</span>
                    </td>
                </tr>
                <tr>
                    <td>Tổng tiền hàng:</td>
                    <td class="text-right">
                        <span id="totalPriceTotal">@Model.Sum(x => x.TotalMoney).ToString("#,##0") đ</span>
                    </td>
                </tr>
                <tr>
                    <td>Giảm giá:</td>
                    <td class="text-right">0 VND</td>
                </tr>
                <tr>
                    <td>VAT:</td>
                    <td class="text-right">@ViewBag.vat %</td>
                </tr>
                <tr>
                    <td>
                        <span class="font-weight-bold">
                            Tổng giá trị đơn hàng:
                        </span>
                    </td>
                    <td class="text-right">
                        @{
                            var totalPrice = Model.Sum(x => x.TotalMoney);
                            var totalVat = (totalPrice * ViewBag.vat) / 100;
                            var grandTotal = totalPrice + totalVat;
                        }
                        <span class="text-right font-weight-bold">@grandTotal.ToString("#,##0") đ</span>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
}
else
{
    <div class="table-responsive" id="productQuotationDetails">
        <table class="product-info-table">
            <tbody>
                <tr>
                    <td>Số lượng sản phẩm</td>
                    <td class="text-right">
                        <span id="totalAmount">0</span>
                    </td>
                </tr>
                <tr>
                    <td>Tổng tiền hàng:</td>
                    <td class="text-right">
                        <span id="totalPriceTotal">0 VND</span>
                    </td>
                </tr>
                <tr>
                    <td>Giảm giá:</td>
                    <td class="text-right">0 VND</td>
                </tr>
                <tr>
                    <td>VAT:</td>
                    <td class="text-right">%</td>
                </tr>
                <tr>
                    <td>
                        <span class="font-weight-bold">
                            Tổng giá trị đơn hàng:
                        </span>
                    </td>
                    <td class="text-right">
                        đ
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
}
