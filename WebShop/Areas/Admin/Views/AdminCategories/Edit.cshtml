@using NPOI.OpenXmlFormats.Wordprocessing;
@model WebShop.Models.Category
@using System.Security.Claims;

@{
    List<Banner> lsBanner = ViewBag.lsBanner;
    ViewData["Title"] = "Tạo mới danh mục sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    List<CategoryAttribute> CateAttribute = ViewBag.atrr;
    List<BrandGroup> brandGroups = ViewBag.brandg;
    List<Brand> lsbrand = ViewBag.lsbrand;
    var admin = ViewBag.admin;
}
@section Styles{
    <link href="~/Adminassets/summernote/summernote-bs4.css" rel="stylesheet" />
    <link href="~/Adminassets/summernote/summernote.css" rel="stylesheet" />
    <link href="~/lib/jqueryui/themes/base/theme.css" rel="stylesheet" />
    <link href="~/lib/jqueryui/themes/base/jquery-ui.css" rel="stylesheet" />
    <link href="~/lib/elfinder/css/elfinder.full.css" rel="stylesheet" />
    <link href="~/lib/elfinder/css/theme.min.css" rel="stylesheet" />
    <link href="~/lib/css/theme-gray.css" rel="stylesheet" />
    <style>      
        .item-brand {
            background: rgba(0, 0, 0, .04);
            float: left;
            display: flex;
            align-items: center;
            width: calc(50%-5px);
            height: 50px;
            margin-right: 5px;
            margin-top: 5px;
        }
        .grouptop{
            margin-right: 5px;
            border-radius: 5%;
            border: 2px solid aqua;
         
            display: flex;
            padding: 5px;
            align-items: center;
        }
        .active1{
            border:2px solid blue;
        }
        .itemAttr{
            margin-left:3px;
            margin-top:3px;
            padding: 3px;
            background: #5a98f7;
            border-radius: 9px;
            color: white;
        }
        .itemAttrRed{
            padding: 3px;
            background: red;
            border-radius: 9px;
            color: white;
        }

        label {
            display: block;
            margin-top: 1em;
        } 
        .validata:valid{
            background-color: palegreen;
        }
         
    </style>
}

<div class="page-header">
    <div class="header-sub-title">
        <nav class="breadcrumb breadcrumb-dash">
            <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="breadcrumb-item"><i class="anticon anticon-home m-r-5"></i>Trang chủ</a>
            <a asp-area="Admin" asp-controller="AdminCategories" asp-action="Index" class="breadcrumb-item">Danh mục sản phẩm</a>
            <span class="breadcrumb-item IsActivated">Sửa danh mục: @Model.CatName</span>
        </nav>
    </div>
</div>
<div>
    <form asp-controller="AdminCategories" asp-action="Edit" asp-route-id="@Model.CatId" method="post" enctype="multipart/form-data">
        <input type="hidden" class="cateid" value="@Model.CatId" asp-for="CatId" />
        <input type="hidden" class="iBrandShow" asp-for="BrandShow" value="@Model.BrandShow"/>
        <input type="hidden" class="iThumbShow" asp-for="ThumbShow" value="@Model.ThumbShow" />
        <input type="hidden" class="iNameBrand" asp-for="NameBrand" value="@Model.NameBrand" />
        <input type="hidden" class="iBannerThumb" asp-for="BannerThumb" value="@Model.BannerThumb" />
        <div class="page-header no-gutters has-tab">
            <div class="d-md-flex m-b-15 align-items-center justify-content-between">
                <div class="media align-items-center m-b-15">                   
                    <div class="avatar avatar-image rounded" style="height:80px; width:80px">
                        <img class="Thumbimage" src="@Model.Thumb" alt="@Model.Thumb" />
                    </div>
                    <div class="m-l-15">
                        <div class="m-b-0" style="display:flex">
                            <h4>
                                @Model.CatName
                            </h4>
                            <div style="display:flex">
                                <img class="Iconimage" src="@Model.Icon" alt="@Model.Icon" width="30px" height="30px" />                                 
                            </div>
                        </div>
                        <div>
                             <div class="form-group" style="display:flex">
                                <p class="text-muted m-b-0">ID: #@Model.CatId</p>                               
                            </div>
                        </div>
                    </div>

                </div>
                <div class="media align-items-center m-b-15">
                    <div class="form-group">
                        <button type="button" class="btn btn-light m-r-5 fileserver" data-toggle="modal" data-target=".bd-example-modal-xl" title="Quản lý file">
                            <i class="fa-solid fa-paperclip"></i>
                        </button>
                    </div>
                    <button type="button" class="btn btn-primary m-r-5 showmodal" data-toggle="modal" data-target="#brandmodal" title="Thương hiệu liên kết">
                            <i class="fa-solid fa-code-branch"></i>
                    </button>
                    <button type="button" class="btn btn-primary m-r-5 showmodalst1" data-toggle="modal" data-target="#exampleModalCenter" title="Hiển thị tìm kiếm">
                         <i class="fa-solid fa-filter"></i>
                    </button>
                    <div class="form-group m-r-5">
                        <button type="submit" value="Save" class="btn btn-primary" title="Lưu chỉnh sửa">
                            <i class="fa-solid fa-floppy-disk"></i>
                            </button>
                    </div> 
                        <a asp-area="Admin" asp-controller="AdminCategories" asp-action="Index" class="btn btn-warning m-r-5" title="Đóng">
                            <i class="fa-solid fa-rectangle-xmark"></i>                           
                        </a> 
                </div>

            </div>
        </div>
        <div>
            <h3>Danh sách banner</h3>
            <div class="mb-3  card banner">
                @if (lsBanner.Count() > 0)
                {

                    @foreach (var item in lsBanner)
                    {
                        <div class="d-flex mb-2 mt-2" style="align-items:center;">
                            <div>
                                <img style="width:100px; height:100px;" class="  mr-5" src="@item.Banner1" alt="banner" />
                                <span class="mr-4">
                                    Trạng thái:  @if (item.Status == true)
                                    {
                                        <b class="text-primary">Hiển thị</b>
                                    }
                                    else
                                    {
                                        <b class="text-danger">Ẩn</b>
                                    }
                                </span>
                            </div>

                            <button data-id="@item.Id" type="button" class=" btn btn-danger btn-delete-banner">Xóa</button>
                        </div>

                    }
                }
                else
                {
                    <p>Chưa có banner</p>
                }
            </div>
            <div class="mb-3">
                <button type="button" class="btn btn-success btn-viewBanner" data-toggle="modal" data-target="#bannerModal">
                    <i class="fa fa-plus"></i> Thêm banner
                </button>
            </div>
        </div>


        <div class="card">
            <div class="card-body">
                <h1>Chi tiết danh mục</h1>
                <div asp-validation-summary="All" class="text-danger"></div>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="row">
                    <div class="form-group col-md-6">                        
                        <p class="font-weight-semibold" for="Thumb">Ảnh đại diện</p>
                        <div class="form-group" style="display:flex">
                            <input id="Thumbimage" class="form-control col-8" type="text" asp-for="Thumb" placeholder="Nhập link ảnh" />
                        </div>
                    </div>
                    <div class="form-group col-md-6">                      
                        <p class="font-weight-semibold" for="Icon">Icon danh mục</p>
                        <div class="form-group">
                            <input id="Iconimage"  class="form-control" type="text" asp-for="Icon" placeholder="Nhập link icon" />
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="form-group col-md-6">
                        <label class="font-weight-semibold" for="CatName">Tên danh mục</label>
                        <input type="text" class="form-control" asp-for="CatName" required>
                    </div>
                    <div class="form-group col-md-6">
                        <label class="font-weight-semibold" for="CatName">Category Name</label>
                        <input type="text" class="form-control" asp-for="CatNameEn" required>
                    </div>
                </div>

                <div class="row">
                    <div class="form-group col-md-6">
                        <label class="font-weight-semibold" for="parentCategoryId">Danh mục cha</label>
                        <select class="custom-select" asp-for="ParentId" style="min-width: 200px;">
                            <option value="" disabled selected>Chọn danh mục cha</option>
                            @foreach (var item in ViewBag.Categories)
                            {
                                <option value="@item.CatId">@item.CatName</option>
                            }
                        </select>
                    </div>
                    <div class="form-group col-md-6">
                        <label class="font-weight-semibold" for="ShortDesc">Sắp xếp</label>
                        <input type="text" class="form-control" asp-for="Ordering">
                    </div>
                </div>

                <div class="row">
                    <div class="form-group col-md-6">
                        <label class="font-weight-semibold" for="MoTa">Mô tả</label>
                        <textarea class="form-control" asp-for="MoTa"></textarea>
                    </div>
                    <div class="form-group col-md-6">
                        <label class="font-weight-semibold" for="MoTa">MoTa</label>
                        <textarea class="form-control" asp-for="DescriptionEn"></textarea>
                    </div>
                </div>
                <div class="row">
                    <div class="form-group col-md-6">
                        <label class="font-weight-semibold" for="Title">Tiêu đề SEO</label>
                        <input type="text" class="form-control" asp-for="Title">
                    </div>
                    <div class="form-group col-md-6">
                        <label class="font-weight-semibold" for="Title">SEO Title</label>
                        <input type="text" class="form-control" asp-for="TitleEn">
                    </div>
                </div>
                <div class="row">
                    <div class="form-group col-md-6">
                        <label class="font-weight-semibold" for="MetaDesc">Mô tả SEO</label>
                        <input type="text" class="form-control" asp-for="MetaDesc">
                    </div>
                    <div class="form-group col-md-6">
                        <label class="font-weight-semibold" for="MetaDesc">SEO MoTa</label>
                        <input type="text" class="form-control" asp-for="MetaDescEn">
                    </div>
                </div>
                <div class="row">
                    <div class="form-group col-md-6">
                        <label class="font-weight-semibold" for="MetaKey">Từ khóa SEO</label>
                        <input type="text" class="form-control" asp-for="MetaKey">
                    </div>
                    <div class="form-group col-md-6">
                        <label class="font-weight-semibold" for="MetaKey">SEO Keywords</label>
                        <input type="text" class="form-control" asp-for="MetaKeyEn">
                    </div>
                </div>
                <div class="form-group d-flex align-items-center">
                    <div class="switch m-r-10">
                        <input type="checkbox" asp-for="Published">
                        <label for="Published"></label>
                    </div>
                    <label>Công khai</label>
                </div>
                <div class="form-group d-flex align-items-center">
                    <div class="switch m-r-10">
                        <input type="checkbox" asp-for="Outstanding">
                        <label for="Outstanding"></label>
                    </div>
                    <label>Danh mục nổi bật</label>
                </div>
            </div>
        </div>
    </form>
    <div class="card">
        <div class="card-body">
        <h1>Danh sách thuộc tính</h1>        
            @foreach (var attr in CateAttribute.OrderBy(o=>o.Attribute.Ordering))
            {
                @*@attr.Attribute.Ordering*@
                <div style="margin-bottom:1rem 0 1rem 0;background:#ebf3fe;display:flex;align-items:center;justify-content:space-between;">
                    <strong>- @attr.Name:</strong>
                    <div>
                        @attr.Attribute.Ordering
                        <button class="btn btn-default" onclick="updatecate(@attr.AttributeId)" ><i class="anticon anticon-up"></i></button>
                        <button class="btn btn-danger btn-tone" onclick="deletecate(@attr.CategoryAttributeId)" data-toggle="tooltip" data-placement="top" title="" data-original-title="Xóa">
                            <i class="anticon anticon-delete"></i>
                        </button>
                    </div>
                    
                </div>
                <div style="display:flex;flex-wrap:wrap">
                   
                        @foreach (var proatt in attr.Attribute.AttributesPrices)
                        {
                            if (proatt.ProductId == null)
                            {
                                <span class="btn btn-tone">@proatt.Price</span>
                            }
                        }

                    <a asp-area="Admin" asp-action="Details" asp-controller="AdminAttributes" asp-route-id="@attr.AttributeId" class="btn btn-tone btn-warning">Thêm</a>
                </div>                    
            }            
            <a asp-area="Admin" asp-action="Create" asp-controller="AdminAttributes" class="btn btn-primary btn-tone" style="margin-top:1rem">Thêm thuộc tính khác</a> <br />
            @{
                List<CategoryAttribute> cateattb = ViewBag.cate;  
                
                foreach(var itemcates in cateattb.GroupBy(c=>c.Name))
                {
                    int i = 0;
                    foreach (var itemcate in itemcates)
                    {
                        
                        <button class="btn btn-primary btn-tone" onclick="addcate(@itemcate.AttributeId)" style="margin-top:1rem">@itemcate.Name</button>
                        i++;
                        if (i > 0) break;
                    }
                }
            }            
        </div>
    </div>
</div>


<div class="modal fade bd-example-modal-xl" style="z-index:5000">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title h4">File</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <i class="anticon anticon-close"></i>
                </button>
            </div>
            <div class="modal-body" style="padding:1.5rem">
                <div class="card">
                    <div id="elfinder"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="brandmodal">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title h4">Thương hiệu liên kết (@Model.CategoryBrands.Count())</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <i class="anticon anticon-close"></i>
                </button>
            </div>
            <div class="modal-body">
                @foreach(var brand in Model.CategoryBrands.Where(c=>c.Topbrand==true).OrderByDescending(c=>c.Brand.Products.Count()))
                {
                    <div style="align-items:center" class="brandcheck @brand.CategoryBrandId">
                        <div style="display:flex;align-items:center;width:100%;justify-content: space-between;">
                            <div class="d-flex align-items-center" style="margin-left:10px">
                                <img class="img-fluid rounded" src="@brand.Brand.Thumb" style="max-width: 60px;border:solid #DDDDDD 1px;" alt="">
                                <div class="d-flex" style="flex-direction:column; margin-left:12px">
                                    <a target="_blank" class="text-dark" style="font-weight:500">@brand.Name</a>
                                    <span style="display: inline-flex;align-items: center;font-size: 12px;color: #9c9c9c;max-width: 100%">Model: @brand.BrandId - SLSP: @brand.Brand.Products.Count()</span>                                     
                                </div>
                            </div>
                            <div class="col-2">
                                <a class="btn btn-secondary btn-tone m-r-5 checkin" data-id="@brand.CategoryBrandId" data-check="false" title="Chỉnh sửa">
                                    <i class="fa-solid fa-chevron-down"></i>
                                </a>
                                @if (User.Claims.Any(c => c.Type == "RoleId" && c.Value == "1"))
                                {                                   
                                    @if (@brand.Brand.Products.Count() == 0)
                                    {                                    
                                        <a class="btn btn-danger btn-tone m-r-5 delete-button" onclick="Deletebrandca(@brand.CategoryBrandId)" title="Xóa khỏi">
                                            <i class="anticon anticon-delete"></i>
                                        </a>                              
                                    }
                                }
                            </div>
                        </div>
                        <div class="brandcheckpro card" data-id="@brand.CategoryBrandId" style="display:none;padding:5px">
                            <div class="card" style="display:flex;flex-direction: row;flex-wrap:wrap">
                                <div style="display:none" class="col-3 addgroup @brand.CategoryBrandId">
                                    <input class="form-control nameGroup @brand.CategoryBrandId" type="text"/>
                                    <button class="btn btn-primary btn-tone Savegroup" data-id="@brand.CategoryBrandId" title="Lưu tên nhóm">
                                        <i class="fa-solid fa-floppy-disk"></i>
                                    </button>
                                </div>
                                <button class="btn btn-primary btn-tone m-r-5 checkadd" data-id="@brand.CategoryBrandId" title="Tạo nhóm sản phẩm"><i class="fa-solid fa-plus"></i></button>
                                <div class="grouptop @brand.Name active1" data-id="-1">
                                    <span>Chưa có nhóm</span>
                                    <a class="btn btn-secondary btn-tone m-r-5 editgroup" data-id="-1" data-name="@brand.Name" title="Chỉnh sửa">
                                        <i class="anticon anticon-edit"></i>
                                    </a>
                                </div>
                                @foreach(var brandg in brandGroups.Where(c=>c.BrandId==brand.BrandId))
                                {
                                    <div class="grouptop @brand.Name col-3" data-id="@brandg.Id">
                                        <input value="@brandg.Name" class="col-4 textupdate @brandg.Id" />
                                        <button class="btn btn-secondary btn-tone updateGroup" data-id="@brandg.Id"><i class="fa-solid fa-floppy-disk"></i></button>
                                        <a class="btn btn-secondary btn-tone editgroup" data-id="@brandg.Id" data-name="@brand.Name"  title="Chỉnh sửa">
                                            <i class="anticon anticon-edit"></i>
                                        </a>
                                        @if (User.Claims.Any(c => c.Type == "RoleId" && c.Value == "1"))
                                        {                                            
                                            <a id="delete-button" class="btn btn-danger btn-tone deletegroup" data-id="@brandg.Id" data-name="@brand.Name" title="Xóa nhóm sản phẩm">
                                                <i class="anticon anticon-delete"></i>
                                            </a> 
                                        }
                                   </div>
                                }
                            </div>
                            <div style="display:flex;justify-content: space-between;">
                                <h3>Danh sách sản phẩm</h3>
                                <div class="card" style="width:70%;display:flex;flex-direction: row;align-items: flex-end;justify-content: space-between">
                                    <p class="titleNull @brand.Name"></p>
                                    <img class="img-fluid imgNull @brand.Name" data-id="" loading="lazy" style="width: 60px;border:solid #db2222  1px; cursor:pointer">
                                    <div style="width:50%;display:flex">                                    
                                        <select class="form-control groupNull @brand.Name">
                                            @foreach (var brandg in brandGroups.Where(c => c.BrandId == brand.BrandId))
                                            {
                                                <option value="@brandg.Id">@brandg.Name</option>
                                            }
                                        </select>
                                        <button class="btn btn-secondary btn-tone m-r-5 Savepro" data-brand="@brand.Name"><i class="fa-solid fa-floppy-disk"></i></button>
                                        <button class="btn btn-danger btn-tone m-r-5 Deletepro @brand.Name" data-brand="@brand.Name" style="display:none"><i class="anticon anticon-delete"></i></button>
                                    </div>
                                </div>
                            </div>
                            <div style="display:flex;flex-wrap: wrap;">
                                @foreach (var pro in brand.Brand.Products.Where(c=>c.BrandGroup==null).ToList())
                                {
                                    <img class="img-fluid brandgropbimg @brand.Name" data-brand="@brand.Name" data-id="-1" src="@pro.Avatar" loading="lazy" title="@pro.ProductName"
                                         data-proid="@pro.ProductId"
                                         style="max-width: 60px;border:solid #DDDDDD 1px; cursor:pointer;">                                
                                }
                                @foreach (var brandg in brandGroups.Where(c => c.BrandId == brand.BrandId))
                                {
                                    @foreach (var pro in brand.Brand.Products.Where(c => c.BrandGroup == brandg.Id).ToList())
                                    {
                                        <img class="img-fluid brandgropbimg @brand.Name" data-brand="@brand.Name" data-id="@brandg.Id" src="@pro.Avatar" loading="lazy" title="@pro.ProductName"
                                             data-proid="@pro.ProductId"
                                            style="display:none;max-width: 60px;border:solid #DDDDDD 1px; cursor:pointer;">
                                    }
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<div class="modal fade  bd-example-modal-xl" id="exampleModalCenter" tabindex="-1" Role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog  modal-xl modal-dialog-centered modal-dialog-scrollable" Role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">Hiển thị tim kiếm trên trang</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <i class="anticon anticon-close"></i>
                </button>
            </div>
            <div class="modal-body row">
                <div class="col-xl-8 col-md-12 col-sm-12" style="display:flex">
                    <div class="col-xl-4 col-md-12 col-sm-12 box-cate">
                        @foreach (var brand in Model.CategoryBrands.Where(c => c.BrandProduct == true).OrderByDescending(c => c.Brand.Products.Count()))
                        {
                            <div class="item-brand" data-id="@brand.BrandId" data-event="delete">
                                <a title="Nhấn để xóa liên kết">
                                    <img src="@brand.Brand.Thumb" style="max-width: 89px;">
                                </a>
                            </div>
                        }
                        <button type="button" class="btn btn-tone btn-primary item-brand showss" title="Thêm thương hiệu" data-toggle="modal" data-target="#side-modal-left" style="max-width: 89px;">
                            <i class="fa-solid fa-plus"></i>
                        </button> 
                          
                    
                    </div> 
                    <div class="col-xl-4 col-md-12 col-sm-12">
                        <div class="card" style="height:650px;padding:5px">
                            <img id="thumcate" style="width:100%;height:100%;border:none" src="@Model.BannerThumb" />
                        </div>
                        <input type="text" class="thumcate" value="@Model.BannerThumb" />                       
                        <p>Thay thế cột ảnh thương hiệu
                            @if (Model.ThumbShow == true)
                            {
                                <input class="Thumbshow" type="checkbox" checked />
                            }
                            else
                            {
                                <input class="Thumbshow" type="checkbox" />
                            }                        
                        </p>                       
                         <button type="button" class="btn btn-primary SaveThumbShow">Cập nhật</button>                        
                    </div>
                    <div class="col-xl-4 col-md-12 col-sm-12">
                        @foreach (var slide in Model.Slides)
                            {
                                <div class="card @slide.SlideId itembrand" style="display:flex;flex-direction:row;align-items:center;padding:5px">
                                    <div class="col-6">
                                    <input class="SlideId @slide.SlideId" type="hidden" value="@slide.SlideId">
                                        @if(slide.HomeFlag==true){
                                        <input class="HomeFlag @slide.SlideId" type="checkbox" checked />
                                        }
                                        else
                                        {
                                        <input class="HomeFlag @slide.SlideId" type="checkbox" />
                                        }
                                        <br/>
                                        <input class="col-10 form-control Thumb @slide.SlideId" data-id="@slide.SlideId" style="padding:0;margin-bottom:0" type="text" placeholder="Nhập link hinh ảnh" value="@slide.Thumb" />
                                        <input class="col-10 form-control SlideName @slide.SlideId" style="padding:0;margin-bottom:0" type="text" minlength="3" maxlength="22" placeholder="Tên nỗi bật" value="@slide.SlideName" />
                                        <input class="col-10 form-control Ordering @slide.SlideId" style="padding:0;margin-bottom:0" type="number" placeholder="Top nỗi bật" value="@slide.Ordering" />
                                        <input class="col-10 form-control Alias @slide.SlideId" style="padding:0;margin-bottom:0" type="text" value="@slide.Alias" />
                                        <a href="@slide.Alias">Đến liên kết</a>
                                    </div>
                                    <div>
