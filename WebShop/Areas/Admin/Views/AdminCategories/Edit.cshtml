                $('.Thumbimage').attr('src', name)
            }
        })
        $('#Iconimage').on('keyup', function () {
            var name = $(this).val();
            if (name != null) {
                $('.Iconimage').attr('src', name)
            }

        })


        function addcate(id) {             
            var cateid = $('.cateid').val();            
            $.ajax({
                type: 'GET',
                url: '@Url.Action("addatribute","AdminCategories")',
                dataType: "Json",
                data: {
                    id:id,
                    cateid:cateid
                },
                success: function (data) {
                    location.reload();
                }
            })
        }
        function deletecate(id) {
            $.ajax({
                type: 'GET',
                url: '@Url.Action("deleteatribute","AdminCategories")',
                dataType: "Json",
                data: {
                    id: id,                   
                },
                success: function (data) {
                    location.reload();
                }
            })
        }
       
        function updatecate(id){
            $.ajax({
                type: 'GET',
                url: '@Url.Action("updatecate","AdminCategories")',
                dataType: "Json",
                data: {
                    id: id,
                },
                success: function (data) {
                    if (data == "Ok") {
                        location.reload();
                    }
                }
            })
        }

        //xử lý upload banner
        $('.btn-saveBanner').on('click', function () {

            var file = $('.fileBanner')[0].files[0];
            var CatId = $('.CatId').val();
            var status = $('.statusBanner').prop('checked');
            if (file == null) {
                alert('Vui lòng thêm hình ảnh')
            }
            else {
                var formData = new FormData();
                formData.append('file', file);
                formData.append('CatId', CatId);
                formData.append('Status', status);
                $.ajax({
                    url: '@Url.Action("UploadFile","AdminCategories")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        if (response.success == true) {
                            alert('Thêm banner thành công')
                            window.location.reload();
                        }
                    },
                    error: function (xhr, status, error) {
                        // Xử lý khi có lỗi
                        console.error('Lỗi khi upload:', error);
                    }
                });
            }
            console.log(file, CatId, status);
        });


        $('.btn-delete-banner').on('click', function () {
            var id = $(this).attr('data-id');
            $.ajax({
                url: '@Url.Action("DeleteBanner","AdminCategories")',
                type: 'POST',
                data: { id: id },
                success: function (response) {
                    if (response.success == true) {
                        alert('Xóa banner thành công')
                        window.location.reload();
                    }
                },
                error: function (xhr, status, error) {
                    // Xử lý khi có lỗi
                    console.error('Lỗi khi xóa:', error);
                }
            });
        });
    </script>
}



