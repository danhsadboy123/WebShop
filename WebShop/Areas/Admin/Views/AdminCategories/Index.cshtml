@model IEnumerable<WebShop.Models.Category>
@{

    ViewData["Title"] = "Danh sách danh mục sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section Styles{
    @*<link href="~/Adminassets/datatable/datatabese.css" />*@
    <link href="~/Adminassets/vendors/datatables/dataTables.bootstrap.min.css" rel="stylesheet">
    <style type="text/css">
        .spinner-border {
            display: none;
        }

        .dataTables_filter label {
            display: none
        }
    </style>

}

<div class="page-header">
    <div class="header-sub-title">
        <nav class="breadcrumb breadcrumb-dash">
            <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="breadcrumb-item"><i class="anticon anticon-home m-r-5"></i>Trang chủ</a>
            <span class="breadcrumb-item active">Quản lý danh mục</span>
        </nav>
    </div>
</div>
<div class="text-right" style="margin-bottom:12px;">
    <a class="btn btn-primary" asp-area="Admin" asp-controller="AdminCategories" asp-action="Create"><i class="anticon anticon-plus m-r-5"></i><span>Thêm danh mục</span></a>
</div>
<div class="card">
    <div class="card-header">
        <div class="row justify-content-between">
            <h3>Danh sách danh mục</h3>
        </div>
        <div class="row">
            <div class="col-md-6">
                <h6>Tìm kiếm</h6>
                <div class="input-affix m-v-10">
                    <i class="prefix-icon anticon anticon-search opacity-04"></i>
                    <input id="keyword" name="keyword" type="text" class="form-control" placeholder="Nhập tên danh mục">
                </div>
            </div>
        </div>
    </div>
    <div class="card-body" id="show1">
        <div class="table-responsive">
            <table id="data-table" class="display" style="width:100%">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Tên danh mục</th>
                        <th>Sắp xếp</th>
                        <th>Trạng thái</th>
                        <th>#</th>
                    </tr>
                </thead>
                <tbody id="records_table" class="table-hover e-commerce-table dataTable">
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                            string url = $"/{item.Alias}";

                            <tr id="@item.CatId">
                                <td>@item.CatId</td>
                                <td>
                                    <div class="d-flex align-items-center" style="max-width:700px">
                                        <img class="img-fluid rounded" style="max-width: 60px;border:solid #DDDDDD 1px;" src="@item.Thumb">
                                        <div class="d-flex" style="flex-direction:column; margin-left:12px">
                                            <a target="_blank" class="text-dark" style="font-weight:500">@item.CatName</a>
                                            <span style="display: inline-flex;align-items: center;font-size: 12px;color: #9c9c9c;max-width: 100%">SL: @item.ProductCategories.Count()</span>
                                        </div>
                                    </div>
                                    
                                </td>
                                <td>@item.Ordering</td>
                                <td>
                                    @if (item.Published == true)
                                    {
                                        <div class="d-flex align-items-center">
                                            <div class="badge badge-success badge-dot m-r-10"></div>
                                            <div>Công khai</div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center">
                                            <div class="badge badge-success badge-dot m-r-10"></div>
                                            <div>Ẩn</div>
                                        </div>
                                    }
                                </td>

                                <td width="15%">
                                    <a class="btn btn-secondary btn-tone m-r-5" data-toggle="tooltip" data-placement="top" title="Chỉnh sửa" asp-area="Admin" asp-controller="AdminCategories" asp-action="Edit" asp-route-id="@item.CatId" asp-route-page="@ViewBag.CurrentPage">
                                        <i class="anticon anticon-edit"></i>
                                    </a>

                                    <a id="delete-button" class="btn btn-danger btn-tone m-r-5" data-target="#delete-pd-md" data-toggle="modal" title="Xóa sản phẩm" onclick="deleteCate(@item.CatId)">
                                        <i class="anticon anticon-delete"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>
<div id="delete-pd-md" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <input type="hidden" class="idCate" />
        <div class="modal-content">
            <div class="modal-header">
                <h5>Xóa danh mục</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <i class="anticon anticon-close"></i>
                </button>
            </div>
            <div class="modal-body">
                Danh mục này sẽ bị xóa khỏi website vĩnh viễn khi không chứa sản phẩm trong danh mục, bạn có chắc chắn muốn xóa danh mục này không?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-dismiss="modal">Hủy</button>
                <a id="confirm-delete-button" onclick="deletecategory()" class="btn btn-danger">Xóa danh mục</a>
            </div>
        </div>
    </div>
</div>





@section Scripts{
    <script src="~/Adminassets/vendors/datatables/jquery.dataTables.min.js"></script>
    <script src="~/Adminassets/vendors/datatables/dataTables.bootstrap.min.js"></script>
    <script>
        $(document).ready(function () {
            //jQuery("#txtCatID").change(function () {
            //    var catID = jQuery(this).children(":selected").attr("value");
            //    catID = parseFloat(catID);
            //    $('#txtCatID option')
            //        .removeAttr('selected');
            //    $("#txtCatID > [value=" + catID + "]").attr("selected", "true");
            //    $.ajax({
            //        url: '/Admin/AdminProducts/Filtter',
            //        datatype: "json",
            //        type: "GET",
            //        data: {
            //            CatID: catID
            //        },
            //        async: true,
            //        success: function (results) {
            //            if (results.status == "success") {
            //                window.location.href = results.redirectUrl;
            //            }
            //        },
            //        error: function (xhr) {
            //            alert('error');
            //        }
            //    });
            //});
            var table = $('#data-table').DataTable({
                language: {
                    search: "Tìm kiếm",
                    lengthMenu: "Hiển thị _MENU_",
                    zeroRecords: "Không tìm thấy",
                    info: "Hiển thị từ _START_ đến _END_ trong _TOTAL_ danh mục",
                    infoEmpty: "",
                    infoFiltered: "",
                    paginate: {
                        "previous": "Trước",
                        "next": "Sau"
                    }
                },

            });
            $('#keyword').keyup(function () {
                table.search($(this).val()).draw();
            })
        });
        function deleteCate(id) {
            $('.idCate').val(id);
        }
        function deletecategory() {
            var id = $('.idCate').val();
            $.ajax({
                type: 'GET',
                url: '@Url.Action("checkProduct","AdminCategories")',
                dataType: "Json",
                data: { id: id },
                success: function (data) {
                    if (data.success == "Ok") {
                        $('#delete-pd-md').modal('hide');
                        $('#' + id).css('display', 'none');
                    } else {
                        alert("Không thể xóa dữ liệu này, danh mục vẫn còn chứa sản phẩm");
                    }
                }
            })
        }

    </script>
}
