@model WebShop.Models.Post

@{
    ViewData["Title"] = "Chỉnh sửa tin tức";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var cat = ViewBag.CatItem;
}
@section Styles{
    <link href="~/Adminassets/summernote/summernote-bs4.css" rel="stylesheet" />
    <link href="~/Adminassets/summernote/summernote.css" rel="stylesheet" />
}

<form asp-area="Admin" asp-controller="AdminTinDangs" asp-action="Edit" method="post" name="myForm" enctype="multipart/form-data">
    <input type="hidden" asp-for="PostId" />
    <input type="hidden" asp-for="Thumb" />
    <input type="hidden" asp-for="CreatedDate" />
    <div class="page-header">
        <div class="row" style="justify-content:space-between">
            <div class="header-sub-title">
                <nav class="breadcrumb breadcrumb-dash">
                    <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="breadcrumb-item"><i class="anticon anticon-home m-r-5"></i>Trang chủ</a>
                    <span class="breadcrumb-item IsActivated">Chỉnh sửa bài viết</span>
                </nav>
            </div>
            <div style="float:right">
                <button type="submit" class="btn btn-primary">
                    <i class="anticon anticon-save"></i>
                    <span>Lưu</span>
                </button>
                <a asp-area="Admin" asp-controller="AdminTinDangs" asp-action="Index" class="btn btn-warning m-r-5">
                    <span>Đóng</span>
                </a>
            </div>
        </div>
    </div>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="card">
        <div class="card-header" style="border-bottom:none">
            <ul class="nav nav-tabs">
                <li class="nav-item">
                    <a class="nav-link IsActivated" data-toggle="tab" href="#project-details-tasks">Thông tin bài viết</a>
                </li>
            </ul>
        </div>
        <div class="card-body">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="row">
                <div class="form-group col-md-6">
                    <label class="font-weight-semibold" for="productName">Tiêu đề</label>
                    <input type="text" id="productName" class="form-control" asp-for="Title" required>
                </div>
                <div class="form-group col-md-6">
                    <label class="font-weight-semibold" for="productName">Post Title</label>
                    <input type="text" id="productName" class="form-control" asp-for="TitleEn">
                </div>
            </div>
            <div class="row">
                <div class="form-group col-md-6" style="margin-bottom:12px">
                    <label class="font-weight-semibold" for="productBrand">Ảnh đại diện</label>
                    <input name="fThumb" type="file" class="form-control-file" asp-for="Thumb" />
                    <span asp-validation-for="Thumb" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="form-group col-md-4">
                    <label class="font-weight-semibold" for="productBrand">Loại bài viết</label>
                    <select class="custom-select" asp-for="PostCatId" style="min-width: 200px;" asp-items="ViewBag.LoaiBaiViet">
                        <option value="" disabled selected>Lại bài viết</option>
                    </select>
                </div>
                <div class="form-group col-md-4">
                    <div class="form-group d-flex align-items-center">
                        <div class="checkbox">
                            <input asp-for="Published" type="checkbox" />
                            <label for="Published">Công khai </label>
                        </div>
                    </div>
                    <div class="form-group d-flex align-items-center">
                        <div class="checkbox">
                            <input asp-for="IsHot" type="checkbox" />
                            <label for="IsHot">Tin nổi bật </label>
                        </div>
                    </div>
                    <div class="form-group d-flex align-items-center">
                        <div class="checkbox">
                            <input asp-for="IsNewfeed" type="checkbox" />
                            <label for="IsNewfeed">Tin mới </label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="form-group col-md-6">
                    <label class="font-weight-semibold" for="productFit">Mô tả ngắn</label>
                    <input type="text" class="form-control" id="Scontents" asp-for="Scontents" required>
                </div>
                <div class="form-group col-md-6">
                    <label class="font-weight-semibold" for="productFit">Short MoTa</label>
                    <input type="text" class="form-control" id="Scontents" asp-for="ScontentsEn">
                </div>
            </div>
            <div class="row">
                <div class="form-group col-md-6">
                    <label class="font-weight-semibold" for="productFit">Mô tả</label>
                    <textarea class="summernote" asp-for="Contents" id="Contents"></textarea>
                </div>
                <div class="form-group col-md-6">
                    <label class="font-weight-semibold" for="productFit">MoTa</label>
                    <textarea class="summernote" id="Contents" asp-for="ContentsEn"></textarea>
                </div>
            </div>
            <label>THÔNG TIN SEO</label>
            <div class="row">
                <div class="form-group col-md-6">
                    <label class="font-weight-semibold" for="productColors">Tiêu đề SEO</label>
                    <input type="text" class="form-control" asp-for="TitleSeo" style="max-width: 700px;">
                </div>
                <div class="form-group col-md-6">
                    <label class="font-weight-semibold" for="productColors">SEO Title</label>
                    <input type="text" class="form-control" asp-for="TitleSeoEn" style="max-width: 700px;">
                </div>
            </div>
            <div class="row">
                <div class="form-group col-md-6">
                    <label class="font-weight-semibold" for="productColors">Mô tả SEO</label>
                    <input type="text" class="form-control" asp-for="MetaDesc" style="max-width: 700px;">
                </div>
                <div class="form-group col-md-6">
                    <label class="font-weight-semibold" for="productColors">SEO MoTa</label>
                    <input type="text" class="form-control" asp-for="MetaDescEn" style="max-width: 700px;">
                </div>
            </div>
            <div class="row">
                <div class="form-group col-md-6">
                    <label class="font-weight-semibold" for="productColors">Từ khóa SEO</label>
                    <input type="text" class="form-control" asp-for="MetaKey" style="max-width: 700px;">
                </div>
                <div class="form-group col-md-6">
                    <label class="font-weight-semibold" for="productColors">SEO Keywords</label>
                    <input type="text" class="form-control" asp-for="MetaKeyEn" style="max-width: 700px;">
                </div>
            </div>
        </div>
    </div>
</form>


@section Scripts{
    <script src="~/Adminassets/vendors/select2/select2.min.js"></script>
    <script src="~/Adminassets/js/pages/e-commerce-product-edit.js"></script>
    <script src="https://ajax.aspnetcdn.com/ajax/jquery.validate/1.19.1/jquery.validate.min.js"></script>
    <script src="~/Adminassets/summernote/summernote-bs4.js"></script>

    <script>
        jQuery(document).ready(function () {
            $('.summernote').summernote({
                fontNames: ['Arial', 'Arial Black', 'Comic Sans MS', 'Courier New'],
                styleTags: ['p', 'h1', 'h2', 'h3', 'h4', 'h5'],
                height: 200,
                minHeight: null,
                maxHeight: null,
            });
        });
    </script>
}
