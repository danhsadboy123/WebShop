@model IEnumerable<WebShop.Models.SystemWeb>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h1>Hệ thống</h1>

<p>
    @if (ViewBag.count==0)
    {
        <a asp-action="Create">Thêm Thông tin hệ thống</a>
    }
</p>
  
    @foreach (var item in Model)
    {
    <div class="row">
            <div class="col-md-4">
            @using (Html.BeginForm("Edit", "AdminSystemWebs"))
            {
                <div>
                    <input type="hidden" name="Id" value="@item.Id" type="text" class="form-control">
                </div>
                <div class="form-group ">
                    <label for="Server">Server</label>
                    <input id="Server" name="Server" value="@item.Server" type="text" class="form-control">
                </div>
                <div class="form-group">
                    <label for="EmailSend">Email gửi</label>
                    <input id="EmailSend" name="EmailSend" value="@item.EmailSend" type="text" class="form-control">
                </div>
                <div class="form-group">
                    <label for="Name">Tên Công ty</label>
                    <input id="Name" name="Name" value="@item.Name" type="text" class="form-control">
                </div>
                <div class="form-group">
                    <label for="Post">Post</label>
                    <input id="Post" name="Post" value="@item.Post" type="number" class="form-control">

                </div>
                <div class="form-group">
                    <label for="EmailSmtp">Email Smtp</label>
                    <input id="EmailSmtp" name="EmailSmtp" value="@item.EmailSmtp" type="text" class="form-control">
                </div>
                <div class="form-group">
                    <label for="PassSmtp">Mật Khẩu Smtp</label>
                    <input id="PassSmtp" name="PassSmtp" value="@item.PassSmtp" type="MatKhau" class="form-control">
                </div>
                <input class="btn btn-primary" type="submit" value="Lưu" />
            } 
            </div>
        </div>
        
         
    }
    

 