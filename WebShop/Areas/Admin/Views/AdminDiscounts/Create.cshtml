        function CheckAddDiscount(){
            var check =false;
            if ($("#ShowWeb").is(':checked')){
                Discount.ShowWeb=true;
            }
            else
            {
                Discount.ShowWeb = false;
            }
            if ($("#ApplyGift").is(':checked')) {
                Discount.ApplyGift = true;
            }
            else {
                Discount.ApplyGift = false;
            }

            if ($("#ConditionCheck").is(':checked')) {
                Discount.ConditionCheck=true;
                Discount.Discount1=0;
                Discount.Money= 0;
            }
            else {
                Discount.ConditionCheck = false;
                Discount.Discount1= $('#Discount1').val();
                Discount.Money= $('#Money').val();                
            }
            if ($('.Discount1').val()!="VND"){
                let so = $('#Discount1').val();
                if(so>100){
                    so=100;
                }
                Discount.Discount1=so;
            }else{
                Discount.Discount1= $('#Discount1').val();
            }
            if ($("#Gift1").is(':checked')) {
                Discount.Gift = true;
            }
            else {
                Discount.Gift = false;
            }

            //Discount.ConditionCheck: true
            Discount.Name = $('#Name').val();
            Discount.Image= $('#Image').val();
            Discount.Description= $('#Description').val();
            Discount.TimeOn= $('#TimeOn').val();
            Discount.TimeOff= $('#TimeOff').val();
            Discount.MaxApply= $('#MaxApply').val();
            Discount.Startus= true;
            Discount.ProductCount = $("#ProductCount").val();
            Discount.Sum= $('#Sum').val();
            if (Discount.Name != "" && Discount.TimeOn != "" && Discount.TimeOff != "" && Discount.MaxApply != "" && Discount.Sum != "") {
                check =true;
            }
            return check;
        };



      
        function Create(){
            var custonmer = $(".customercheck");
            var product = $(".Productitem");
            var listproduct = [];
            var listcustomer = [];
            var Gift = $(".Giftitem");
            var listGift = [];

            product.each(function () {
                var id = $(this).attr('id');                
                listproduct.push(id);               
            });
            custonmer.each(function () {
                var id = $(this).attr('id');                
                listcustomer.push(id); 
            });
            Gift.each(function () {
                var id = $(this).attr('id');
                listGift.push(id);
            });
      
            if (CheckAddDiscount()){
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("CreateData","AdminDiscounts")',
                    dataType: "Json",
                    data: {
                        Name: Discount.Name,
                        Gift: Discount.Gift,
                        Image: Discount.Image,
                        Description: Discount.Description,
                        TimeOn: Discount.TimeOn,
                        TimeOff: Discount.TimeOff,
                        ShowWeb: Discount.ShowWeb,
                        MaxApply: Discount.MaxApply,
                        Startus: Discount.Startus,
                        Discount1: Discount.Discount1,
                        ConditionCheck: Discount.ConditionCheck,
                        Money: Discount.Money,
                        ProductCount: Discount.ProductCount,
                        Sum: Discount.Sum,
                        listProduct: listproduct,
                        listCustomer: listcustomer,
                        listGift: listGift,
                    },
                    success: function (data) {
                        if(data.data=="Ok"){
                            location.href = '@Url.Action("Index","AdminDiscounts")';
                        }
                        else{
                            alert("Đã gặp lỗi do quá trình tạo hoặc thêm dữ liệu vui lòng kiểm tra lại");
                        }
                    }

                })
            }
            else{
                alert("Bạn chưa điền đủ thông tin của khuyến mãi vui lòng điền");
            }
        }
       
