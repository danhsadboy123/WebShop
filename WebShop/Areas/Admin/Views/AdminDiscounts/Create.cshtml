@model WebShop.Models.Discount
@{
    ViewData["Title"] = "Create";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
@section Styles{
    <link href="~/adminassets/css/settingfull.css" rel="stylesheet" />
    <link href="~/Adminassets/vendors/datatables/dataTables.bootstrap.min.css" rel="stylesheet">
    
    <link href="~/Adminassets/summernote/summernote-bs4.css" rel="stylesheet" />
    <link href="~/Adminassets/summernote/summernote.css" rel="stylesheet" />
  <style>
       .note-group-select-from-files{
           display:none;
       }

        .customerok{
            display:none;
        }

        .Productok {
            display: none;
        }

        .fullproduct {
            display: none;
        }

        .fullcustomer{
            display:none;
        }

        .spinner-border {
            display: none;
        }

        #data-table_wrapper > div:first-child {
           display:none;
        }

        #data-table_wrapper > div:nth-child(3) {
            display: none;
        }

        .Money{
            display: none;
        }

        .ProductCount {
            display: none;
        }

        #MaxApply{
            display:none;
        }

        #Sum {
            display: none;
        }

        /*gift*/
        .ProductGift {
            display: none;
        }

        .avatars {
            font-size: .875rem;
            text-align: center;
            color: #fff;
            white-space: nowrap;
            position: relative;
            vertical-align: middle;
            width: 2rem;
            line-height: 40px;
            border-radius: 50%;
            display: inline-block;
        }
  </style>

}
 
<div class="omni-layout-body discount-detail-page">
    <div class="omni-layout-body-md">
        <div class="row no-gutters ui-title-bar-container" id="bgs" style="border-radius:5px; background:#dbd7d7;background-repeat:no-repeat; background-size:100% 100%;max-height:15rem; min-height:10rem">
            <div class="col align-items-center d-flex">                
                <div class="form-group title-page" style="padding:5px">
                    <label asp-for="Name" class="control-label">Tên Khuyến mãi</label>
                        <input asp-for="Name" id="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                    <a class="btn btn-primary" data-toggle="modal" data-target="#exampleModal">
                        <i class="fa-solid fa-plus fa-beat-fade"></i>
                        Ảnh khuyến mãi
                    </a>
                     
                    <div class="modal fade" id="exampleModal">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="exampleModalLabel">Link ảnh</h5>
                                    <button type="button" class="close" data-dismiss="modal">
                                        <i class="anticon anticon-close"></i>
                                    </button>
                                </div>
                                <div class="modal-body">
                                    <div class="form-group">                                        
                                        <input id="Image" class="form-control" />
                                        <span asp-validation-for="Image" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                        <button type="button" class="btn btn-default checkImage" data-dismiss="modal">Save changes</button>
                                    </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
        </div>
        <div class="row">
            <div class="col-lg-8 col-12">
                <div>
                    <div class="">
                        <div class="omni-layout-card card-default">                            
                            <div class="form-group omni-layout-card--section">
                                <label asp-for="Description" class="control-label">Mô tả Khuyến mãi</label>
                                    <textarea id="Description" class="summernote" asp-for="Description"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span> 
                            </div>
                        </div>
                    </div>
                    <div class="">
                        <div class="omni-layout-card card-default">
                            <div class="omni-layout-card--header"><span class="header-title">Thời Gian Hiệu Lực</span></div>
                            <div class="omni-layout-card--section">
                                <div class="row">
                                    <div class="col-6">                                        
                                        <div class="form-group">
                                            <label asp-for="TimeOn" class="control-label mb-2">Thời gian bắt đầu</label>
                                             <input asp-for="TimeOn" id="TimeOn" min="" type="datetime-local" class="form-control listingDateOpen" />
                                            <span asp-validation-for="TimeOn" class="text-danger"></span>
                                        </div>                                        
                                    </div>
                                    <div class="col-6">                                        
                                        <div class="form-group">
                                            <label asp-for="TimeOff" class="control-label mb-2">Có thời gian kết thúc</label>
                                                <input type="datetime-local" id="TimeOff" asp-for="TimeOff" class="form-control listingDateOpen" />
                                            <span asp-validation-for="TimeOff" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="d-flex flex-column"></div>
                            </div>
                        </div>
                    </div>

                    <div class="">
                        <div class="omni-layout-card card-default">
                            <div class="omni-layout-card--header"><span class="header-title">Giảm giá sản phẩm</span></div>
                            <div class="omni-layout-card--section">
                                <label asp-for="Discount1" class="control-label"> Mức giảm</label>
                                <div class="d-flex">
                                    <div class="form-group w-50" >
                                        <input asp-for="Discount1" id="Discount1" value="0" step="1" class="form-control" style="text-align:right;" />
                                        <span asp-validation-for="Discount1" class="text-danger"></span>
                                    </div>
                                        <select class="form-control w-20 Discount1">
                                        <option value="VND">VND</option>
                                        <option value="%">%</option>
                                    </select>
                                    </div>                                    
                                </div>
                            </div>
                        </div>
                    </div>
                    @*Product*@

                    <div class="">
                        <div class="omni-layout-card card-default">
                            <div class="omni-layout-card--header"><span class="header-title"></span>Sản phẩm áp dụng</div>
                            <div class="omni-layout-card--section">
                                <div class="radio">
                                    <input id="Product1" onclick="ProductSearch(1)" name="Product" type="radio" checked="">
                                    <label for="Product1">Tất cả sản phẩm chưa có khuyến mãi</label>
                                </div>
                                <div class="radio">
                                    <input id="Product2" onclick="ProductSearch(2)" name="Product" type="radio">
                                    <label for="Product2">Tùy chỉnh sản phẩm</label>
                                </div>
                            </div>
                            <div class="list-group Productok">
                                <div style="position:relative;width:100%">
                                    <div class="input-affix m-b-10">
                                        <i class="prefix-icon anticon anticon-search"></i>
                                        <input type="text" id="inputText" class="form-control searchProductadd" placeholder="tên sản phẩm">
                                    </div>
                                    <div class="fullproduct" style="text-align:center">
                                        <i class="fa-solid fa-xmark outProductsearch"></i>
                                        <ul loadfullproduct" style="position:absolute;z-index:100;background:#e2e2f9;width:100%;height:150px;overflow:auto;border:1px solid;border-radius:5px">
                                            <table id="data-table" class="table table-hover e-commerce-table" style="width:100%">
                                                <thead>
                                                    <tr>
                                                        <th>Sản phẩm</th>
                                                        <th>Chọn</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (ViewBag.product != null)
                                                    {
                                                        foreach (var item in ViewBag.product){
                                                            <tr style="background:#ffffff;border-radius:5px">
                                                                <td>
                                                                    <div class="d-flex">
                                                                        <div class="avatar avatar-image col-1">
                                                                        <img src="@item.Avatar" />
                                                                        </div>
                                                                        <div class="m-l-10" style="text-align:left">
                                                                            <div class="m-b-0 text-dark font-weight-semibold">@item.ProductName</div>
                                                                            <div class="m-b-0 opacity-07 font-size-13">@item.UnitsInStock cái | @item.SalePrice.ToString("#,##0") VND</div>
                                                                        </div>
                                                                    </div>
                                                                </td>
                                                                <td width="10%">
                                                                    <input type="checkbox" id="@item.ProductId" class="checkitem">
                                                                </td>
                                                            </tr>
                                                        }
                                                    }
                                                     
                                                </tbody>
                                            </table>
                                        </ul>
                                    </div>
                                </div>
                                <ul class="deleteProdeuct">
                                </ul>
                            </div>


                        </div>
                    </div>
                    @*Gift*@
                    <div class="omni-layout-card card-default">
                        <div class="omni-layout-card--header"><span class="header-title"></span>Sản phẩm quà tặng</div>
                        <div class="omni-layout-card--section">
                            <div class="radio">
                                <input id="Gift1" onclick="GiftSearch(1)" name="Gift" type="radio" checked="">
                                <label for="Gift1">Không áp dụng sản phẩm khuyến mãi</label>
                            </div>
                            <div class="radio">
                                <input id="Gift2" onclick="GiftSearch(2)" name="Gift" data-toggle="modal" data-target=".bd-example-modal-xl" type="radio">
                                <label for="Gift2">
                              
                                    Tùy chỉnh sản phẩm
                                
                                </label>

                            </div>
                        </div>
                    <div class="list-group ProductGift" style="padding:1rem">
                            <ul class="deleteGift">
                            </ul>
                        </div>
                    </div>


                    <div class="">
                        <div class="omni-layout-card card-default">
                            <div class="omni-layout-card--header"><span class="header-title">Điều kiện tối thiểu</span></div>
                            <div class="omni-layout-card--section">
                                <div class="radio">
                                    <input id="ConditionCheck" name="ConditionCheck" value="Không yêu cầu" type="radio" checked="">
                                    <label for="ConditionCheck">Không yêu cầu</label>                                 
                                   
                                </div>
                                <div class="radio">
                                    <input id="ConditionCheck2" name="ConditionCheck" value="Giá trị tối thiểu" type="radio">
                                    <label for="ConditionCheck2">Giá trị tối thiểu</label>
                                    <input asp-for="Money" value="0" id="Money" class="form-control Money" />
                                </div>
                                <div class="radio">
                                    <input id="ConditionCheck3" name="ConditionCheck" value="Số lượng sản phẩm tối thiểu" type="radio">
                                    <label for="ConditionCheck3">Số lượng sản phẩm tối thiểu</label>
                                <input type="number" asp-for="ProductCount" value="0" id="ProductCount" class="form-control ProductCount" step="1" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="omni-layout-card card-default form-group" style="display:none" >
                        <div class="omni-layout-card--header"><span class="header-title">Đối tượng khách hàng</span></div>
                        <div class="omni-layout-card--section">
                            <div class="radio">
                                <input id="radio1" onclick="checkSearch(1)" name="Customer" type="radio" value="1" checked="">
                                <label for="radio1">Không giới hạn khách hàng</label>
                            </div>
                            <div class="radio">
                                <input id="radio2" onclick="checkSearch(2)" name="Customer" value="2" type="radio">
                                <label for="radio2">Tùy chỉnh khách hàng</label>
                            </div>                            
                       </div>
                        <div class="list-group customerok">
                            <div style="position:relative;width:100%">
                                <div class="input-affix m-b-10">
                                    <i class="prefix-icon anticon anticon-search"></i>
                                    <input type="text" onclick="checkforcus()" class="form-control searchadd" placeholder="Tìm kiếm khách hàng">
                                </div>  
                                <div class="fullcustomer" style="text-align:center">
                                    <i class="fa-solid fa-xmark outsearch"></i>
                                    <ul class="list-group loadfullcustomer" style="position:absolute;z-index:100;background:#e2e2f9;width:100%;height:150px;overflow:auto;border:1px solid;border-radius:5px">
                                         
                                         
                                    </ul>
                                </div>                               
                            </div>
                            <ul class="deletecustomer">
                                 
                            </ul>
                        </div>
                    </div>

                   
                        <div class="omni-layout-card card-default">
                            <div class="omni-layout-card--header"><span class="header-title">Giới hạn sử dụng</span></div>
                            <div class="omni-layout-card--section">
                                <div class="radio">
                                    <input id="MaxApply1" name="MaxApply1" type="radio" value="1" checked="">
                                    <label for="MaxApply1">Không áp dụng </label>
                                </div>
                                <div class="radio">
                                    <input id="MaxApply2" name="MaxApply1" type="radio" value="2">
                                    <label for="MaxApply2">Giới hạn</label>
                                </div>
                                
                                <div class="next-input--disabled form-group">
                                    <input type="number" value="0" class="next-input text-left min-width-100px" id="MaxApply" asp-for="MaxApply" step="1">
                                 </div>
                            </div>                            
                        </div>
                    <div class="omni-layout-card card-default">
                        <div class="omni-layout-card--header"><span class="header-title">Giới hạn Khuyến mãi</span></div>
                        <div class="omni-layout-card--section">
                            <div class="radio">
                                <input id="Sum1" name="Sum1" type="radio" value="1" checked="">
                                <label for="Sum1">Không áp dụng </label>
                            </div>
                            <div class="radio">
                                <input id="Sum2" name="Sum1" value="2" type="radio">
                                <label for="Sum2">Giới hạn</label>
                            </div>
                            <div class="next-input--disabled form-group">
                                <input type="number" value="0" class="next-input text-left min-width-100px" id="Sum" asp-for="Sum" step="1">
                            </div>
                        </div>
                    </div>
                        <br />
                    <button onclick="Create()" class="btn btn-primary">Tạo khuyến mãi</button>
                        <a asp-action="Index"> Quay lại</a>
                </div>
            <div class="col-lg-4 col-12">
                <div class="discount--right-column">
                    <div class="omni-layout-card card-secondary">
                        <div class="omni-layout-card--header"><span class="header-title">Tóm tắt</span></div>
                        <div class="omni-layout-card--section">                            
                            <h3 class="mb-4 nameTitle"></h3>
                             <strong>Chi tiết</strong>
                                <ul class="loadcontent" style="padding:5px">                                 
                                    
                                </ul>                           
                             
                        </div>
                    </div>
                     
                    <div class="omni-layout-card card-secondary">
                        <div class="omni-layout-card--header"><span class="header-title">Cài đặt</span></div>
                        <div class="omni-layout-card--section">
                            <div class="d-flex flex-row">
                                <div class="form-group d-flex align-items-center">
                                    <div>
                                         <input class="btn-check" id="ShowWeb" type="checkbox" checked="">
                                        <i><strong class="fa-beat-fade"> Hiển thị trên Web của bạn.</strong></i>
                                         
                                    </div>                                    
                                </div>                               
                                
                            </div>
                            
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade bd-example-modal-xl">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title h4">Danh sách sản phẩm quà tặng</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <i class="anticon anticon-close"></i>
                </button>
            </div>
            <div class="modal-body">               
                <div class="row">                    
                    <div class="col-sm-12 col-md-7 col-lg-8">
                        <div class="card-header">
                            <h4 class="card-title">Danh sách sản phẩm</h4>
                            <div class="card-body">
                                <table style="width:100%">
                                    <thead>
                                        <tr>
                                            <th>Sản phẩm</th>
                                            <th>Chọn</th>
                                        </tr>
                                    </thead>
                                    <tbody id="GiftProduct">                                     
                                        
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-12 col-md-5 col-lg-4">
                        <div class="CreateDiv">
                            <div class="card-header" style="display:flex">
                                <h4 class="card-title">Thêm sản phẩm</h4>                            
                            </div>
                            <div class="card-body">                                
                                <label for="NamePro">Tên sản phẩm</label>
                                <input type="text" id="NamePro" class="form-control" placeholder="Tên sản phẩm">
                                <span class="NamePro" style="color:red"></span>

                                <label for="AvatarPro">Link hình ảnh</label>
                                <input type="text" id="AvatarPro" class="form-control" placeholder="Link hình ảnh">
                                <span class="AvatarPro" style="color:red"></span>

                                <label for="Alias">Link sản phẩm</label>
                                <input type="text" id="Alias" class="form-control" placeholder="Link sản phẩm">
                                <span class="Alias" style="color:red"></span>

                                <label for="Prite">Giá tiền sản phẩm</label>
                                <input type="number" id="Prite" class="form-control" placeholder="Giá tiền sản phẩm">
                                <span class="Prite" style="color:red"></span>

                                <div style="display:flex;flex-direction: row-reverse;">
                                    <button id="CreateGift" class="btn btn-primary">Tạo mới</button>                               
                                </div>
                            </div>
                        </div>
                        <div class="EditDiv" style="display:none">
                            <div class="card-header" style="display:flex">
                                <h4 class="card-title">Sửa sản phẩm</h4>
                            </div>
                            <div class="card-body">
                                <input type="hidden" id="Idgift" />
                                <label for="NamePros">Tên sản phẩm</label>
                                <input type="text" id="NamePros" class="form-control" placeholder="Tên sản phẩm">
                                <span class="NamePros" style="color:red"></span>

                                <label for="AvatarPros">Link hình ảnh</label>
                                <input type="text" id="AvatarPros" class="form-control" placeholder="Link hình ảnh">
                                <span class="AvatarPros" style="color:red"></span>

                                <label for="Aliass">Link sản phẩm</label>
                                <input type="text" id="Aliass" class="form-control" placeholder="Link sản phẩm">
                                <span class="Aliass" style="color:red"></span>

                                <label for="Prites">Giá tiền sản phẩm</label>
                                <input type="number" id="Prites" class="form-control" placeholder="Giá tiền sản phẩm">
                                <span class="Prites" style="color:red"></span>

                                <div style="display:flex;flex-direction: row-reverse;">
                                    <a href="javascript:void(0)" class="btn breadCreate">Quay lai</a>
                                    <button onclick="EditGift()"class="btn btn-primary">Lưu</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>                
            </div>
        </div>
    </div>
</div>


@section Scripts{
    <script src="~/Adminassets/vendors/datatables/jquery.dataTables.min.js"></script>
    <script src="~/Adminassets/vendors/datatables/dataTables.bootstrap.min.js"></script>
    <script src="~/Adminassets/summernote/summernote-bs4.min.js"></script>
   
    <script>
        // them  xóa sửa product gift
        // loadproductGift
        
        $(document).ready(function () {
             
            loadfullproductgift();
             
            if ($('.checkitem').val()!="on"){
                alert('Hiện tất cả sản phẩm dang trong chương trình khuyến mãi bạn không thể tạo khuyến mãi')
            }
            laodcontendiscount();
            datacustomer();
            $('.summernote').summernote({
                fontNames: ['Arial', 'Arial Black', 'Comic Sans MS', 'Courier New'],
                styleTags: ['p', 'h1', 'h2', 'h3', 'h4', 'h5'],
                height: 150,
                minHeight: null,
                maxHeight: null,
                focus: false
            });
            var table = $('#data-table').DataTable({
                language: {
                    search: "Tìm kiếm",
                    lengthMenu: "Hiển thị _MENU_",
                    zeroRecords: "Không tìm thấy hoặc sản phẩm đang trong sư chương trình khuyến mãi",
                    info: "Hiển thị từ _START_ đến _END_ trong _TOTAL_ khuyến mãi",
                    infoEmpty: "",
                    infoFiltered: "",
                    paginate: {
                        "previous": "Trước",
                        "next": "Sau"
                    }
                },

            });
            $('#inputText').keyup(function () {
                table.search($(this).val()).draw();
            })
        });
        
        // GET: Admin/AdminDiscounts/SearchCustomer full customer
        var customer;
        var cusadd = [];
        var cusdelete = [];
        var origin = window.location.origin;
        function datacustomer() {
            $.ajax({
                type: 'GET',
                url: '@Url.Action("SearchCustomer","AdminDiscounts")',
                dataType: "Json",
                success: function (data) {
                    customer = data.data;
                }
            })
            return customer;
        }
      // css customer
        $(".searchadd").on("focusout", function () {
            $('.outsearch').addClass("fa-beat-fade");           
        })
        $(".searchadd").on("keydown", function () {            
            if ($(this).val() == "") {
                $('.fullcustomer').css("display", "none");
            } else {
                $('.fullcustomer').css("display", "block");
            }
        })
        $(".searchadd").on("focus", function () {
            $('.outsearch').removeClass("fa-beat-fade");
            loadfullcustomer(customer);
        })
        $(".outsearch").on("click", function () {
            $('.fullcustomer').css("display", "none");
            $('.outsearch').removeClass("fa-beat-fade");
        })
        function checkforcus(id){
            if (id==1) {
                $('.fullcustomer').css("display", "none");
            }
            else{
                $('.fullcustomer').css("display", "block");
            }
        }
        function checkSearch(id){            
            if(id==2)
            {
                $('.customerok').css("display", "block");
                
            }else{
                $('.customerok').css("display", "none");
            }
        }
        
        // laod customer
        function loadfullcustomer(data) {
            var html = ""; for (var item = 0; item < data.length; item++) {
                html += '<li onclick="itemcustomeradd(' + data[item].customerId + ')" style="text-align:left" class="list-group-item d-flex justify-content-between" id="' + data[item].customerId + '">'
                            +'<div class="d-flex align-items-center">'
                            +'<div class="avatar avatar-image" >'
                            + '<img src="'+origin+'/adminassets/images/avatars/thumb-1.jpg"/></div>'
                            +'<div class="m-l-10">'
                            + '<div class="m-b-0 text-dark font-weight-semibold"> ' + data[item].fullName + ' </div>'
                            + '<div class="m-b-0 opacity-07 font-size-13">' + data[item].email + '</div></div></div>'
                            +'<div style="display:flex;align-items:center">'
                            +'<i class="fa-solid fa-plus fa-beat-fade"></i> </div></li>';
                }
                $(".loadfullcustomer").html(html);
        }
        // load customer delete
        function loaddeletecustomer(data) {
            var html = ""; for (var item = 0; item < data.length; item++) {
                html += '<li style="text-align:left" class="list-group-item d-flex justify-content-between customercheck" id="' + data[item].customerId + '">'
                    + '<div class="d-flex align-items-center">'
