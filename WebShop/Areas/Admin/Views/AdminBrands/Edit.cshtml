@model WebShop.Models.Brand

@{
    List<Video> video = ViewBag.videos;
    ViewData["Title"] = "Edit";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
@section Styles{
    <link href="~/Adminassets/vendors/select2/select2.css" rel="stylesheet">
    <style>
        .banner {
            max-height: 500px;
            overflow-y: auto;
        }
    </style>
}

<div class="card">
    <h1 style="padding:10px">Sửa thương hiệu : @Model.BrandName</h1>

    <hr />

    <div class="row card">
        <div>
            <button class="btn btn-success" data-toggle="modal" data-target="#bannerModal"><i class="fa fa-plus"></i> Thêm video </button>
        </div>

        <div class="modal fade" id="bannerModal" tabindex="-1" Role="dialog" aria-labelledby="bannerModalLabel" aria-hidden="true">
            <div class="modal-dialog" Role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="bannerModalLabel">Thêm video</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <form  enctype="multipart/form-data">
                            <input type="hidden" class="brandId" value="@Model.BrandId" />
                            <label>Banner</label>
                            <input type="file" class="fileBanner form-control" />
                            <label>Link video youtube <span class="text-danger"> </span></label>
                            <input type="text" class="textLink form-control" placeholder="Nhập link video youtube" />
                            <label>Sắp xếp</label>
                            <input type="number" class="sort form-control" placeholder="Sắp xếp thứ tự" />
                            <label>Hiển thị</label>
                            <input type="checkbox" class="statusBanner " />
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-saveLink">Lưu</button>

                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="card banner row">
        <div> <h5><b>Danh sách link video</b></h5></div> 
        <div class="d-flex">
            @foreach (var item in video)
            {
                <div class="social col-xl-3 col-lg-3 col-md-3 col-sm-3 col-3">
                    <img class="w-50 h-50" src="@item.Image" alt="@item.Image" />
                    <p> <a href="@item.Video1">@item.Video1</a></p>
                    <div>
                        <button data-id="@item.Id" class="btn btn-secondary btn-hide" type="button"><i class="fa fa-trash"></i>Xóa</button>
                    </div>
                </div>
            }
        </div>
       
    </div>



    <div class="row">
        <div class="col-md-4">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="BrandId" />
                <img src="@Model.Thumb" class="Thumbcheck" style="max-width: 60px;border:solid #DDDDDD 1px;" />
                <div class="form-group">
                    <label asp-for="Thumb" class="control-label"></label>
                    <input asp-for="Thumb" class="form-control ThumbText" />
                    <span asp-validation-for="Thumb" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="BrandName" class="control-label"></label>
                    <input asp-for="BrandName" class="form-control" />
                    <span asp-validation-for="BrandName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="MoTa" class="control-label"></label>
                    <input asp-for="MoTa" class="form-control" />
                    <span asp-validation-for="MoTa" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label class="control-label">Danh mục</label>
                    <div class="m-b-15">
                        <select class="select2" name="categoryBrands" multiple="multiple">
                            @foreach (var category in ViewBag.AllCategories)
                            {
                                var isSelected = ViewBag.SelectedCategories.Contains(category);
                                <option value="@category.CatId" selected=@isSelected ? selected:"">@category.CatName</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <input type="submit" value="Save" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>
    <div>
        <a asp-action="Index">Lui về</a>
    </div>
</div>

@section Scripts{
    <script src="~/Adminassets/vendors/select2/select2.min.js"></script>

    <script>
        $('.select2').select2();
        $('.ThumbText').on('keyup', function () {
            $('.Thumbcheck').attr('src', $('.ThumbText').val());
        })
        $('.btn-saveLink').on('click',function(){
            var file = $('.fileBanner')[0].files[0];
            var IdBrand = $('.brandId').val();
            var textLink = $('.textLink').val();
            var sort = $('.sort').val();
            var status = $('.statusBanner').prop('checked');
            var embeddedLink = textLink.replace("watch?v=", "embed/");
           // console.log(embeddedLink);


            if (file == null) {
                alert('Vui lòng thêm hình ảnh')
            }
            else
            {
                var formData = new FormData();
                formData.append('file', file);
                formData.append('brandId', IdBrand);
                formData.append('embeddedLink', embeddedLink);
                formData.append('sort', sort);
                formData.append('Status', status);
                $.ajax({
                    url: '@Url.Action("UploadFile","AdminBrands")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        if (response === "pass") {
                            alert('Thêm thành công')
                            window.location.reload();
                        }
                    },
                    error: function (xhr, status, error) {
                        // Xử lý khi có lỗi
                        console.error('Lỗi khi upload:', error);
                    }
                });
            }
           
        });
        $('.btn-hide').on('click',function(){
            var id = $(this).attr('data-id');
            $.ajax({
                url: '@Url.Action("DeleteVideo","AdminBrands")',
                type: 'POST',
                data: {id:id},
                success: function (response) {
                    if (response.success ==true) {
                        alert('Xóa thành công')
                        window.location.reload();
                    }
                },
                error: function (xhr, status, error) {
                    // Xử lý khi có lỗi
                    console.error('Lỗi khi upload:', error);
                }
            });
        })
    </script>
}
