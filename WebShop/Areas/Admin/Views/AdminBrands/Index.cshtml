
@model IEnumerable<WebShop.Models.Brand>

@{
    
    ViewData["Title"] = "Danh sách hãng sản xuất ";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section Styles{
    @*<link href="~/Adminassets/datatable/datatabese.css" />*@
    <link href="~/Adminassets/vendors/datatables/dataTables.bootstrap.min.css" rel="stylesheet">
    <link href="~/Adminassets/vendors/select2/select2.css" rel="stylesheet">
    <style type="text/css">
        .spinner-border {
            display: none;
        }

        .dataTables_filter label {
            display: none
        }
    </style>
}
<div class="page-header">
    <div class="header-sub-title">
        <nav class="breadcrumb breadcrumb-dash">
            <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="breadcrumb-item"><i class="anticon anticon-home m-r-5"></i>Trang chủ</a>
            <span class="breadcrumb-item IsActivated">Quản lý thương hiệu</span>
        </nav>
    </div>
</div>
<div class="row m-b-30">
    <div class="col-md-12">
        <div class="row">
           
            
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <div class="col-md-6">
            <h6>Tìm kiếm</h6>
            <div class="input-affix m-v-10">
                <i class="prefix-icon anticon anticon-search opacity-04"></i>
                <input id="keyword" name="keyword" type="text" class="form-control" placeholder="Nhập tên thương hiệu">
            </div>
        </div>
        <div class="row justify-content-between">
            <h3>Danh sách thương hiệu</h3>
            <div class="col-lg-4 text-right">
                <a class="btn btn-primary" asp-area="Admin" asp-controller="AdminBrands" asp-action="Create"><i class="anticon anticon-plus m-r-5"></i><span>Thêm thương hiệu</span></a>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table id="data-table" class="display" style="width:100%">
                <thead>
                    <tr>
                        <th>ID</th>
                        
                        <th>Tổng sản phẩm</th>
                        <th>Mô tả</th>
                        <th>#</th>
                    </tr>
                </thead>
                <tbody id="records_table" class="table-hover">
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center" style="max-width:700px">
                                        <img class="img-fluid rounded" style="max-width: 60px;border:solid #DDDDDD 1px;" src="@item.Thumb">                                        
                                        <div class="d-flex" style="flex-direction:column; margin-left:12px">
                                            <a target="_blank" class="text-dark" style="font-weight:500">@item.BrandName</a>
                                            <span style="display: inline-flex;align-items: center;font-size: 12px;color: #9c9c9c;max-width: 100%">ID: @item.BrandId</span>
                                        </div>
                                    </div>                                                                        
                                </td> 
                                <td>@item.Products.Count()</td>
                                <td>@item.MoTa</td>
                                <td>
                                    @{
                                        var catitem = "";
                                        foreach(var cate in item.CategoryBrands)
                                        {
                                            catitem += " " +cate.CatId;
                                        }
                                     }
                                  @*  <button type="button" class="btn btn-primary EditBrand" data-cate="@catitem" data-id="@item.BrandId"       
                                    data-src="@item.Thumb"  data-id="@item.BrandId" data-des="@item.MoTa" data-name="@item.BrandName" data-toggle="modal" data-target="#exampleModalScrollable">
                                        <i class="anticon anticon-edit"></i>
                                    </button>*@
                                    <a class="btn btn-secondary btn-tone m-r-5" data-toggle="tooltip" data-placement="top" title="Chỉnh sửa" asp-controller="AdminBrands" asp-action="Edit" asp-route-id="@item.BrandId" asp-route-page="@ViewBag.CurrentPage">
                                        <i class="anticon anticon-edit"></i>
                                    </a>
                                    <a class="btn btn-danger btn-tone m-r-5" data-toggle="tooltip" data-placement="top" title="Xóa" asp-controller="AdminBrands" asp-action="Delete" asp-route-id="@item.BrandId" asp-route-page="@ViewBag.CurrentPage">
                                        <i class="anticon anticon-delete"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            
        </div>
    </div>
</div>


<!-- Modal -->
<div class="modal fade" id="exampleModalScrollable">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">           
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalScrollableTitle">Thông tin thương hiệu</h5>
                    <button type="button" class="close" data-dismiss="modal">
                        <i class="anticon anticon-close"></i>
                    </button>
                </div>
                <div class="modal-body">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                         <img class="img-fluid rounded Thumbs" name="Thumbs" style="max-width: 60px;border:solid #DDDDDD 1px;">
                        <input type="number" class="BrandId" name="BrandId"/>
                        <div class="form-group">
                            <label class="control-label" for="Thumb"></label>
                            <input class="form-control Thumb" name="Thumb" placeholder ="Link ảnh thương hiệu"/>
                        </div>
                        <div class="form-group">
                            <label class="control-label" for="BrandName"></label>
                            <input class="form-control BrandName" name="BrandName" placeholder="Tên thương hiệu"/>
                        </div>
                        <div class="form-group">
                            <label class="control-label" for="MoTa"></label>
                            <input class="form-control MoTa" name="MoTa" placeholder="Nội dung" />
                        </div>
                        <div class="form-group">
                            <label class="control-label">Danh mục</label>
                            <div class="m-b-15">
                                <select class="select2" name="CategoryBrands" multiple="multiple">
                                    @foreach (var category in ViewBag.AllCategories)
                                    {
                                        <option data-id="@category.CatId" data-name="@category.CatName" value="@category.CatId" class="itemcate">@category.CatName</option>
                                    }
                                </select>
                            </div>
                        </div>                         
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary SaveBrand">Lưu</button>
                </div>
        </div>
    </div>
</div>



