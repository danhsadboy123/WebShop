@section Scripts{
    <script src="~/Adminassets/vendors/datatables/jquery.dataTables.min.js"></script>
    <script src="~/Adminassets/vendors/datatables/dataTables.bootstrap.min.js"></script>
    <script src="~/Adminassets/vendors/select2/select2.min.js"></script>
    <script>
        $('.Thumb').on('keyup',function(){
            $('.Thumbs').attr('src', $('.Thumb').val());
        })
        $('.select2').select2();
        $('.EditBrand').on('click',function(){           
            var id = $(this).attr('data-id');
            var name = $(this).attr('data-name');
            var des = $(this).attr('data-des');
            var src = $(this).attr('data-src');
            var catecheck = $(this).attr('data-cate');
            console.log(id);
            $('.BrandId').val(id);
            $('.BrandName').val(name);
            $('.MoTa').val(des);
            $('.Thumbs').attr('src', src);
            $('.Thumb').val(src);
            var itemarr = catecheck.split(' ');
            var itemc = $('.itemcate');
            var html="";
            $.each(itemarr, function (key, item) { 
                $.each(itemc,function(key2,item2){
                    if($(item2).attr('data-id')==item){
                        html += '<li class="select2-search-choice">'
                            + '<div>' + $(item2).attr('data-name') + '</div>'
                        +'<a href="#" class="select2-search-choice-close" tabindex="-1"></a></li>';                        
                        console.log(item2);
                        $(item2).attr('selected',true);
                    }
                })
            })
            html += '<li class="select2-search-field"><label for="s2id_autogen2" class="select2-offscreen"></label> <input type="text" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" class="select2-input" id="s2id_autogen2" placeholder="" style="width: 20px;">  </li>';
            $('.select2-choices').html(html);
        });
        $('.SaveBrand').on('click',function(){
            var id = $('.BrandId').val();
            var BrandName= $('.BrandName').val();
            var MoTa =$('.MoTa').val();          
            var Thumb =$('.Thumb').val();
            var itemc = $('.itemcate');
            var cate =[];
            $.each(itemc, function (key2, item2) {
                if ($(item2).change()) {
                    cate.push($(item2).attr('data-id'))
                }
            })
            console.log(cate, id, BrandName, MoTa, Thumb, Thumb);
        }) 
        $(document).ready(function () {
            var table = $('#data-table').DataTable({
                order: [[1, 'desc']],
                language: {
                    search: "Tìm kiếm",
                    lengthMenu: "Hiển thị _MENU_",
                    zeroRecords: "Không tìm thấy",
                    info: "Hiển thị từ _START_ đến _END_ trong _TOTAL_ thương hiệu",
                    infoEmpty: "",
                    infoFiltered: "",
                    paginate: {
                        "previous": "Trước",
                        "next": "Sau"
                    }
                },

            });
            $('#keyword').keyup(function () {
                table.search($(this).val()).draw();
            })

