@model List<WebShop.Models.Order>

@{
    ViewData["Title"] = "Đơn hàng nháp";
}
@section Styles{
    <style>
        <link href="~/Adminassets/vendors/datatables/dataTables.bootstrap.min.css" rel="stylesheet" >
        .dataTables_filter label {
            display: none;
        }

        div.dataTables_wrapper div.dataTables_filter{
            display:none;
        }
        .dataTables_filter input {
            display: none;
        }

        #data-table_length {
            display: none;
        }

        .dataTables_wrapper {
            width: 100%;
            margin: 0 auto;
        }

        .status-label {
            padding: 4px 8px;
            border-radius: 4px;
            margin-left: 8px;
        }

            .status-label.processing {
                background-color: #f0f6ff;
                color: #2463eb;
                border: solid #2463eb 1px;
            }

            .status-label.confirm {
                background-color: #fefce7;
                color: #c88a04;
                border: solid #c88a04 1px;
            }

            .status-label.deliver {
                background-color: #f2fdf5;
                color: #16a249;
                border: solid #16a249 1px;
            }

            .status-label.success {
                background-color: #f2fdf5;
                color: #16a249;
                border: solid #16a249 1px;
            }

            .status-label.failed {
                background-color: #fef1f1;
                color: #dc2828;
                border: solid #dc2828 1px;
            }

            .status-label.return {
                background-color: #f3f4f6;
                color: grey;
                border: solid grey 1px;
            }

        .dt-buttons {
            display: none;
        }

        .table-hover input {
        }
        .wrapper-block {
            padding: 0 32px 52px;
        }

        .max-width-center {
            max-width: 1245px;
            margin: 0 auto;
        }

        .ui-empty-state_container {
            padding: 0 30px;
            background-image: none;
            background-position: 100%;
            background-repeat: no-repeat;
            background-size: 0;
        }

            .ui-empty-state_container .row {
                height: calc(100vh - 140px);
            }
    </style>
}
@if(Model!=null && Model.Count() > 0)
{
    <div class="page-header">
        <div class="header-sub-title">
            <nav class="breadcrumb breadcrumb-dash">
                <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="breadcrumb-item"><i class="anticon anticon-home m-r-5"></i>Trang chủ</a>
                <span class="breadcrumb-item KichHoat">Đơn hàng nháp</span>
            </nav>
        </div>
    </div>
    <div class="text-right" style="margin-bottom:12px;">
        <a class="btn btn-default m-r-5" id="exportBtn"><i class="anticon anticon-file-excel m-r-5"></i><span>Xuất dữ liệu</span></a>
        <a class="btn btn-primary" asp-area="Admin" asp-controller="AdminOrders" asp-action="Create"><i class="anticon anticon-plus m-r-5"></i><span>Tạo đơn nháp</span></a>
    </div>
    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-md-9">
                    @*<div class="col-md-3">
                        <h6>Lọc theo trạng thái</h6>
                        <div class="input-affix m-v-10">
                        <select class="custom-select" id="txtStatusID" name="txtStatusID" style="min-width: 200px;" asp-items="ViewBag.TrangThai">
                        <option selected>Chọn trạng thái</option>
                        <option value="0">Tất cả đơn</option>
                        </select>
                        </div>
                    </div>*@
                    <div class="input-group" style="flex-wrap:nowrap">
                        @* <select class="custom-select" style="min-width: 230px;" id="selectOption">
                            <option value="0" selected>Mã đơn hàng</option>
                            <option value="2">Tên khách hàng</option>
                            <option value="2">Số điện thoại khách hàng</option>
                            <option value="3">Email khách hàng</option>
                            <option value="4">Sản phẩm</option>
                            <option value="5">Mã vận đơn</option>
                        </select>*@
                        <div class="input-affix m-l-10">
                            <input id="inputText" name="keyword" style="margin-bottom:0px" type="text" class="form-control" placeholder="Vui lòng nhập">
                            <i class="suffix-icon anticon anticon-search opacity-04"></i>
                        </div>
                    </div>
                </div>
                <div class="col-md-3 d-flex text-right" style="margin-bottom:12px;">
                    <a class="btn btn-primary" href="#" id="searchBtn">Tìm kiếm</a>

                    @*<a class="btn m-r-5" style="margin-left:12px" data-target="#modal-header" data-toggle="modal">Đặt lại</a>*@
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header" style="border-bottom:none">
            <ul class="nav nav-tabs">
                <li class="nav-item">
                    <a class="nav-link KichHoat" data-toggle="tab" href="#project-details-tasks">Tất cả đơn hàng nháp</a>
                </li>
            </ul>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="data-table" class="table table-hover e-commerce-table" style="width:100%">
                    <thead>
                        <tr>
                            <th>Mã</th>
                            <th>Ngày tạo</th>
                            <th>Khách hàng</th>
                          @*   <th>Email</th>
                            <th>SĐT</th> *@
                            <th>Tổng tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            foreach (var item in Model)
                            {
                                <tr class="@item.OrderId">
                                    <td><a asp-area="Admin" asp-action="Details" asp-controller="AdminOrders" asp-route-id="@item.OrderId" style="color: #1a71ff;">#@item.OrderId</a></td>
                                    <td>@item.OrderDate</td>

                                    @if (item.Customer == null)
                                    {
                                        <td>Không có thông tin khách hàng</td>
                                        @* <td>@item.Guest.Email</td>
                                        <td>@item.Guest.SoDienThoai</td> *@
                                    }
                                    else
                                    {
                                        <td>@item.Customer.HoTen</td>
                                       @*  <td>@item.Customer.Email</td>
                                        <td>@item.Customer.SoDienThoai</td> *@
                                    }
                                   
                                    <td>@item.TotalMoney.ToString("#,##0") đ</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                @*@if (Model.Count() > 0)
            {
            <div aria-label="Page navigation example">
            <ul class="pagination">
            <pager class="pager-container" list="@Model" asp-area="Admin" asp-controller="AdminOrders" asp-route-CatID="@ViewBag.CurrentStatusID" asp-action="Index" />
            </ul>
            </div>
            }*@
            </div>
        </div>
    </div>
    <div id="modal-header" class="modal fade bd-example-modal-xl" tabindex="-1" VaiTro="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
            </div>
        </div>
    </div>
}
else
{
    <div class="wrapper-block" id="wrapper-block">
        <div class="ui-empty-state_container max-width-center">
            <div class="row align-items-center">
                <div class="col-xs-12 col-md-6">
                    <h1 class="ui-empty-state_title">Quản lý đơn hàng nháp</h1>
                    <span class="ui-empty-state_subtitle">Đơn hàng nháp là nơi lưu trữ các đơn hàng đặt trước và đợi xác nhận từ khách hàng, có khả năng chỉnh sửa thông tin trước khi chuyển sang đơn hàng chính thức.</span>
                    <div style="margin-top:12px" class="ui-empty-state_btngroup"><a asp-area="Admin" asp-controller="AdminOrders" asp-action="Create" class="btn btn-primary ui-empty-state_button mr-3">Tạo đơn hàng</a></div>
                </div>
                <div class="col-xs-12 col-md-6 pt-2"><img src="//hstatic.net/0/0/global/design/omni/order-init-v3.svg" alt="" class="img-fluid"></div>
            </div>
        </div>
    </div>
}
@section Scripts {
    <script src="~/Adminassets/vendors/datatables/jquery.dataTables.min.js"></script>
    <script src="~/Adminassets/vendors/datatables/dataTables.bootstrap.min.js"></script>
    <script type="text/javascript" src="https://cdn.datatables.net/buttons/1.3.1/js/dataTables.buttons.min.js"></script>
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
    <script type="text/javascript" src="https://cdn.datatables.net/buttons/1.3.1/js/buttons.html5.min.js"></script>
    <script type="text/javascript" language="javascript" src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script>
        var table = $('#data-table').DataTable({
            dom: 'Bfrtip',
            buttons: [
                'excel'
            ],
            order: [[0, 'desc']],
            scrollX: true,
            language: {
                search: "Tìm kiếm",
                lengthMenu: "Hiển thị _MENU_",
                zeroRecords: "Không tìm thấy",
                info: "Hiển thị _START_ đến _END_ trong _TOTAL_ đơn hàng",
                infoEmpty: "",
                loadingRecords: "Loading...",
                infoFiltered: "",
                paginate: {
                    "previous": "Trước",
                    "next": "Sau"
                }
            },
        });

        $(document).ready(function () {
            $('#exportBtn').click(() => {
                table.buttons(0, 0).trigger()
            });
            $('#inputText').keyup(function () {
                table.search($(this).val()).draw();
            })
            $('#modal-header').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget); // Button that triggered the modal
                var url = button.attr("href");
                var modal = $(this);
                // note that this will replace the content of modal-content ever time the modal is opened
                modal.find('.modal-content').load(url);
            });
        });
    </script>
}


