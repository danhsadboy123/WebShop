@model WebShop.Areas.Admin.Models.AdminProductPageVM
 

@{
    ViewData["Title"] = "Danh sách sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    List<DanhMuc> listcate = ViewBag.AllCategories;
    List<Product> proOption = ViewBag.proOption;
}
 
@section Styles{
    <link href="~/Adminassets/vendors/datatables/dataTables.bootstrap.min.css" rel="stylesheet">
 
    <style>
        .dataTables_filter {
            display: none;
        } 
        .dataTables_wrapper {
            width: 100%;
            margin: 0 auto;
        } 
        div.dataTables_wrapper div.dataTables_length select{
            width:70px;
        }
        .nav-link{
            cursor: pointer;
        }
        .tabcheck{
            display:none;
        }
    </style>
}
<div class="page-header">
    <div class="header-sub-title">
        <nav class="breadcrumb breadcrumb-dash">
            <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="breadcrumb-item"><i class="anticon anticon-home m-r-5"></i>Trang chủ</a>
            <span class="breadcrumb-item KichHoat">Quản lý sản phẩm</span>
        </nav>
    </div>
</div>
 
<div class="text-right" style="margin-bottom:12px;">    
    <span style="color:red" id="SaveExcel">
        @if(ViewBag.SaveExcel != "")
        {
            @ViewBag.SaveExcel
        }
    </span>
    <a class="btn btn-default m-r-5" data-target="#import_excel_md" data-toggle="modal"><i class="anticon anticon-file-excel m-r-5"></i><span>Import Excel</span></a>
    <a class="btn btn-primary" asp-area="Admin" asp-controller="AdminProducts" asp-action="Create"><i class="anticon anticon-plus m-r-5"></i><span>Thêm sản phẩm</span></a>
</div>
<div class="card">
    <div class="card-body">
        <div>
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-4">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text" id="basic-addon3">Danh mục</span>
                            </div>
                            <select class="custom-select" id="txtCatID" name="txtcatid" style="min-width: 200px;" asp-items="ViewBag.DanhMuc">
                                <option value="allcate">Tất cả</option>
                                @{
                                    @foreach (var item in listcate)
                                    {
                                        <option value="@item.CatName-@item.CatId">@item.CatName</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <div class="input-group" style="flex-wrap:nowrap">
                           @* <select class="custom-select" style="min-width: 200px;" id="selectOption">
                                <option value="1" selected>Tên sản phẩm</option>
                                <option value="0">Mã sản phẩm</option>
                                <option>Nhà cung cấp</option>
                            </select>*@
                            <div class="input-affix m-l-10" style="margin-right:5px">
                                <input id="inputText" name="keyword" style="margin-bottom:0px" type="text" class="form-control" placeholder="Vui lòng nhập">
                                <i class="suffix-icon anticon anticon-search opacity-04"></i>
                            </div>
                            <button class="btn btn-primary m-r-5" title="Nhóm sản phẩm cùng loại" data-toggle="modal" data-target="#exampleModal"><i class="fa-solid fa-layer-group"></i></button>
                        </div>
                    </div> 
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header" style="border-bottom:none">
        <ul class="nav nav-tabs">
            <li class="nav-item">
                <a class="nav-link KichHoat" data-check="Full" data-column="0" data-toggle="tab">Tất cả</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-check="True" data-column="2" data-toggle="tab">Đang hoạt động</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-check="False" data-column="1" data-toggle="tab">Hết hàng</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-check="False" data-column="2" data-toggle="tab">Đã ẩn</a>
            </li>
           
        </ul>
    </div>
    <div class="card-body">
        <div class="dropdown dropdown-animated scale-left" style="float:right">
            <button class="btn btn-primary dropdown-toggle" data-toggle="dropdown">
                <i class="anticon anticon-table"></i>
            </button>
            <div class="dropdown-menu" style="width:500px">
                <p class="dropdown-item">Tùy chọn hiển thị</p>
                <div class="row">
                    <div class="col-lg-11 mx-auto">
                        <form asp-action="SaveCheckboxs" method="post">
                            <div class="row">
                                <a class="checkbox col-md-6">
                                    <input id="checkbox5" class="checkitembox" data-column="4" type="checkbox" asp-for="CheckboxProduct.ProductCode">
                                    <label for="checkbox5">Mã sản phẩm</label>
                                </a>                                
                                <a class="checkbox col-md-6">
                                    <input id="checkbox7" class="checkitembox" data-column="6" type="checkbox" asp-for="CheckboxProduct.InputPrice">
                                    <label for="checkbox7">Đơn giá nhập</label>
                                </a>
                                <a class="checkbox col-md-6">
                                    <input id="checkbox8" class="checkitembox" data-column="7" type="checkbox" asp-for="CheckboxProduct.SalePrice">
                                    <label for="checkbox8">Giá bán ra</label>
                                </a>
                                <a class="checkbox col-md-6">
                                    <input id="checkbox9" class="checkitembox" data-column="8" type="checkbox" asp-for="CheckboxProduct.UnitsInStock">
                                    <label for="checkbox9">Tồn kho</label>
                                </a>
                                <a class="checkbox col-md-6">
                                    <input id="checkbox10" class="checkitembox" data-column="9" type="checkbox" asp-for="CheckboxProduct.KichHoat">
                                    <label for="checkbox10">Trạng thái</label>
                                </a>
                               <a class="checkbox col-md-6">
                                    <input id="checkbox11" class="checkitembox" data-column="10" type="checkbox" asp-for="CheckboxProduct.DateCreated">
                                    <label for="checkbox11">Ngày tạo</label>
                                </a>
                               @* <a class="checkbox col-md-6">
                                    <input id="checkbox8" data-column="7" type="checkbox" asp-for="CheckboxProduct.CodStatus">
                                    <label for="checkbox8">COD</label>
                                </a>
                                <a class="checkbox col-md-6">
                                    <input id="checkbox9" data-column="8" type="checkbox" asp-for="CheckboxProduct.Total">
                                    <label for="checkbox9">Tổng tiền</label>
                                </a>*@
                            </div>
                            <button class="btn btn-primary" style="float:right" type="submit">Lưu</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <div class="tab-content">
            @if (Model.Products != null && Model.Products.Count() > 0)
            { 
                <div class="table-responsive tab-pane fade show KichHoat">
                    <table id="data-table" class="table table-hover e-commerce-table" style="width:100%">
                        <thead>
                            <tr>
                                <th class="tabcheck">Full</th>
                                <th class="tabcheck">Hết hàng</th>
                                <th class="tabcheck">True</th>
                                <th class="tabcheck">cate</th>
                                <th>Mã SP</th>
                                <th>Thông tin sản phẩm</th>
                                <th>Giá nhập</th>
                                <th>Giá bán</th>
                                <th>Kho hàng</th>
                                <th>Trạng thái</th>
                                <th>Ngày tạo</th>
                                <th>Công khai</th>
                                <th>Trang chủ</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="records_table">
                            @foreach (var item in Model.Products)
                            {
                                string url = $"/{item.Alias}-{item.ProductId}";
                                var cate = item.ProductCategories.FirstOrDefault();
                                <tr id="@item.ProductId">
                                    <td class="tabcheck">Full</td>
                                    <td class="tabcheck">
                                        @if (item.UnitsInStock > 0)
                                        {
                                            <p>True</p>
                                        }
                                        else
                                        {
                                            <p>False</p>
                                        }</td>
                                    <td class="tabcheck">@item.KichHoat</td>

                                    <td class="tabcheck">
                                        <p>allcate</p>
                                       @if(cate!=null){
                                            <p>@cate.Cat.CatName-@cate.CatId</p>                                            
                                        }
                                    </td>
                                    <td>#@item.ProductCode</td>
                                    <td>
                                        <div class="d-flex align-items-center" style="max-width:700px">
                                            @if (item.Avatar != null)
                                            {
                                                <img class="img-fluid rounded" src="@item.Avatar"  style="max-width: 60px;border:solid #DDDDDD 1px;" alt="">
                                            }
                                            else
                                            {
                                                <img class="img-fluid rounded" src="~/Adminassets/images/avatars/thumb-1.jpg" style="max-width: 60px;border:solid #DDDDDD 1px;" alt="">
                                            }
                                            <div class="d-flex" style="flex-direction:column; margin-left:12px">
                                                <a href="@url" target="_blank" class="text-dark" style="font-weight:500">@item.ProductName</a>
                                                <span style="display: inline-flex;align-items: center;font-size: 12px;color: #9c9c9c;max-width: 100%">Model: @item.ProductCode</span>
                                            </div>
                                        </div>
                                    </td>
                                  @*  <td>@item.Price.Value.ToString("#,##0") đ</td>*@
                                    <td>@String.Format("{0:#,##0}", item.Price) đ </td>
                                    <td>@String.Format("{0:#,##0}", item.SalePrice) đ</td>
                                    <td>@item.UnitsInStock</td>
                                    <td class="productitemcheck-@item.ProductId">
                                        @if (item.KichHoat == true)
                                        {
                                            <div class="d-flex align-items-center">
                                                <div class="badge badge-success badge-dot m-r-10"></div>
                                                <div>Đang bán</div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center">
                                                <div class="badge badge-danger badge-dot m-r-10"></div>
                                                <div>Ẩn</div>
                                            </div>
                                        }
                                    </td>
                                    <td>@item.DateCreated</td>
                                    <td>
                                        @if(@item.KichHoat==true)
                                        {
                                            <input class="checkactive" data-id="@item.ProductId" type="checkbox" checked="checked"/>
                                        }
                                        else{
                                            <input class="checkactive" data-id="@item.ProductId" type="checkbox" />
                                        }

                                       </td>
                                    <td>
                                        @if (@item.HomeFlag == true)
                                        {
                                            <input class="checkHome" data-id="@item.ProductId" type="checkbox" checked="checked" />
                                        }
                                        else
                                        {
                                            <input class="checkHome" data-id="@item.ProductId" type="checkbox" />
                                        }
                                    
                                    </td>
                                    <td width="15%">
                                     
                                        <a class="btn btn-secondary btn-tone m-r-5" asp-area="Admin" asp-controller="AdminProducts" asp-action="Edit" asp-route-id="@item.ProductId" asp-route-curPage="@ViewBag.CurrentPage">
                                            <i class="anticon anticon-edit"></i>
                                        </a>
                                        <a id="delete-button" class="btn btn-danger btn-tone m-r-5 delete-button" data-target="#delete-pd-md" data-toggle="modal" onclick="Deleteitem(@item.ProductId)" data-productid="@item.ProductId">
                                            <i class="anticon anticon-delete"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>                    
                </div>                 
            }
        </div>       
     </div>   
</div>
@*san phẩm cùng loại*@
<div class="modal fade bd-example-modal-xl" id="exampleModal">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title h4">Nhóm sản phẩm cùng loại</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <i class="anticon anticon-close"></i>
                </button>
            </div>
            <div class="modal-body">
                @if (proOption != null)
                {
                    
                    <div class="table-responsive tab-pane fade show KichHoat">
                        <table class="table table-hover e-commerce-table" style="width:100%">
                            <thead>
                                <tr> 
                                    <th>Mã SP</th>
                                    <th>Thông tin sản phẩm</th>  
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in proOption)
                                {
                                    string url = $"/{item.Alias}-{item.ProductId}";
                                    var cate = item.ProductCategories.FirstOrDefault();
                                    <tr id="@item.ProductId" class="itemoption"> 
                                        <td>#@item.ProductCode</td>
                                        <td>
                                            <div class="d-flex align-items-center" style="max-width:700px">
                                                @if (item.Avatar != null)
                                                {
                                                    <img class="img-fluid rounded" src="@item.Avatar" style="max-width: 60px;border:solid #DDDDDD 1px;" alt="">
                                                }
                                                else
                                                {
                                                    <img class="img-fluid rounded" src="~/Adminassets/images/avatars/thumb-1.jpg" style="max-width: 60px;border:solid #DDDDDD 1px;" alt="">
                                                }
                                                <div class="d-flex" style="flex-direction:column; margin-left:12px">
                                                    <a href="@url" target="_blank" class="text-dark" style="font-weight:500">@item.ProductName</a>
                                                    <span style="display: inline-flex;align-items: center;font-size: 12px;color: #9c9c9c;max-width: 100%">Model: @item.ProductCode</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <a class="btn btn-secondary btn-tone m-r-5" asp-area="Admin" asp-controller="AdminProducts" asp-action="Edit" asp-route-id="@item.ProductId" asp-route-curPage="@ViewBag.CurrentPage">
                                                <i class="anticon anticon-edit"></i>
                                            </a>
                                        </td>
                                        
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
 
<div id="import_excel_md" class="modal fade" tabindex="-1" VaiTro="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-area="Admin" asp-controller="AdminProducts" asp-action="ImportProducts" method="post" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5>Tải lên file excel</h5>
                    <button type="button" class="close" data-dismiss="modal">
                        <i class="anticon anticon-close"></i>
                    </button>
                </div>
                <div class="modal-body">                       
                        <div class="form-group">
                            <input class="form-control" type="file" name="excelFile" id="excelFile" accept=".xlsx" required />
                        </div>
                </div>
                <div class="modal-footer">
                    <button style="float:right" type="submit" class="btn btn-success m-r-5">
                        <i class="anticon anticon-loading m-r-5"></i>
                        <span>Thực hiện</span>
                    </button>
                </div>
                <div class="modal-body">
                     <strong>Vui lòng cấu hình file dữ liệu mẫu rồi tải về trước khi thực hiện thêm dữ liệu</strong>
                    <i class="fa-solid fa-eye 1 fa-fade" id="CategoryEYE"></i>
                    <br />
                    <div style="display:flex;justify-content:flex-end">
                        <a href="javascript:void(0)" id="btnexp" class="btn btn-success m-r-5 btnexp">
                            <span>Xuất file mẫu</span>
                        </a>
                    </div>
                </div>
            </form>
            <div class="listCategory" style="display:none">               
                <div class="table-responsive" style="overflow-y:scroll; height:250px;">
                    @if (ViewBag.AllCategories != null)
                    {
                        List<DanhMuc> category = ViewBag.AllCategories;
                        <table class="table">
                            <thead>
                                <tr>
                                    <th><input type="checkbox" class="CategoryCheckAll" /></th>
                                    <th>Tên danh mục</th>
                                 </tr>                                
                            </thead>
                            <tbody>
                                @foreach (var item in category)
                                {
                                    <tr>
                                        <td><input type="checkbox" class="CategoryCheck" data-id="@item.CatId" /></td>
                                        <td>@item.CatName</td>
                                    </tr>

                                }
                            </tbody>
                        </table>
                       
                    }
                </div>
            </div>
        </div>
    </div>
</div>
<div id="delete-pd-md" class="modal fade" tabindex="-1" VaiTro="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5>Xóa sản phẩm</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <i class="anticon anticon-close"></i>
                </button>
            </div>
            <div class="modal-body">
                <input id="productidss" type="hidden" />
                Sản phẩm này sẽ bị xóa khỏi website vĩnh viễn, bạn có chắc chắn muốn xóa sản phẩm này không?
            </div>
            <div class="modal-footer" >
                <button type="button" class="btn" data-dismiss="modal">Hủy</button>
                <a id="confirm-delete-button" class="btn btn-danger">Xóa sản phẩm</a>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/Adminassets/vendors/datatables/jquery.dataTables.min.js"></script>
    <script src="~/Adminassets/vendors/datatables/dataTables.bootstrap.min.js"></script>
    <script>
        $(document).ready(function () {
            if ($("#SaveExcel").html()!=""){
                setTimeout(function () {
                    $("#SaveExcel").html("");
                    $.ajax({
                        url: '@Url.Action("sectionadd","AdminProducts")',
                        datatype: "json",
                        type: "GET",
                    });
                }, 3000)
            } 
            // chọn danh mục 
            $(".dropdown-menu").click(function (event) {
                event.stopPropagation();
            });

            var table = $('#data-table').DataTable({
                scrollX: true,             
                columnDefs: [
                    {
                        orderable: false,
                        className: 'select-checkbox',
                        targets: 4
                    }
                ],
                select: {
                    style: 'os',
                    selector: 'td:first-child'
                },
                order: [[10, 'desc']],
                language: {
                    search: "Tìm kiếm",
                    lengthMenu: "Hiển thị _MENU_",
                    zeroRecords: "Không tìm thấy",
                    info: "Hiển thị _START_ đến _END_ trong _TOTAL_ sản phẩm",
                    infoEmpty: "",
                    loadingRecords: "Loading...",
                    infoFiltered: "",
                    paginate: {
                        "previous": "Trước",
                        "next": "Sau"
                    }
                },
            });
            var checkitembox = $(".checkitembox");
            $('#txtCatID').on('change',function(){
                var value = $(this).val();                
                var linkActive = $('.nav-link');
                table.search('').columns(3).search('').draw();
                table.columns(3).search(value).draw();
                $.each(linkActive,function(key,item){
                    if ($(this).attr('class') == "nav-link KichHoat"){
                        var column = $(this).attr('data-column');
                        var check = $(this).attr('data-check');
                        table.columns(column).search(check).draw();
                    }
                });

                
            })
            $('.nav-link').on('click', function () {
                table.search('').columns().search('').draw();
                var cate = $("#txtCatID").val();
                table.columns(3).search(cate).draw();                
                var column = $(this).attr('data-column');
                var check = $(this).attr('data-check');
                console.log(check, column);
                table.columns(column).search(check).draw();
            })

            $(".checkitembox").on('click', function () {
                var arr = [];
                checkitembox.each(function () {
                    var id = $(this).attr('data-column');
                    if ($(this).prop("checked")) {
                        table.column(id).visible(true);
                    }
                    else {
                        table.column(id).visible(false);
                    }
                });
            })
            checkitembox.each(function () {
                var id = $(this).attr('data-column');
                if ($(this).prop("checked")) {
                    table.column(id).visible(true);
                }
                else {
                    table.column(id).visible(false);
                }
            });

            function showOrHideColumn(columnIdx) {
                let column = table.column(columnIdx);

                // Toggle the visibility
                column.visible(!column.visible());
            }

            //searchBtn.addEventListener("click", function () {
            //    table.columns(selectedValue).search(inputText.value).draw();
            //});
            $('#inputText').keyup(function () {
                table.search($(this).val()).draw();
            })

           

            //$('#inputText').keyup(function () {
            //    table.columns(selectedValue).search($(this).val()).draw();
            //})
        });
        document.addEventListener("DOMContentLoaded", function () {
            var deleteButtons = document.querySelectorAll("#delete-button");
            var confirmDeleteButton = document.querySelector("#confirm-delete-button");

            var productIdToDelete;

            deleteButtons.forEach(function (deleteButton) {
                deleteButton.addEventListener("click", function () {
                    productIdToDelete = this.getAttribute("data-productid");
                });
            });


        });
        $('.ProductOption').on('click',function(){
            var option = $(this).attr('data-option');
            var itemoption = $('.itemoption');
            $.each(itemoption,function(key,item){
                if ($(this).attr('data-options') == option){
                    $(this).css('display','block');
                }else{
                    $(this).css('display', 'none');
                }
            })
            
        })
        $('#btnexp').on('click',function(){
            var check = [];
            arr.each(function () {
                var id = $(this).attr('data-id');
                if ($(this).prop("checked")) {
                    check.push(id);
                }
            });
            if (check.length > 0) {
                console.log(check);
                $.ajax({
                    url: '@Url.Action("exportExcel","AdminProducts")',
                    datatype: "json",
                    type: "POST",
                    xhrFields: {
                        responseType: 'blob'
                    },
                    data: {listCategoty : check, },
                    success: function (result) {                      
                        alert("Định dạng file mang thông tin của loại sản phẩm và nhà phân cung cấp sản phẩm sẽ được tải xuống");
                        var blob = result;
                        var downloadUrl = URL.createObjectURL(blob);
                        var a = document.createElement("a");
                        a.href = downloadUrl;
                        a.download = "ExcelImport.xlsx";
                        document.body.appendChild(a);
                        a.click();
                    }

                });
            }
        })
        $('.CategoryCheckAll').on('click',function(){          
            if($(this).is(':checked')){
                $('.CategoryCheck').prop('checked', true);
                $('.btnexp').addClass('fa-bounce');
            }
            else{
                $('.CategoryCheck').prop('checked', false);
                $('.btnexp').removeClass('fa-bounce');
            }
        })
        $("#CategoryEYE").on('click',function(){
            if ($(this).attr('class') == "fa-solid fa-eye 1 fa-fade"){
                $(this).removeClass('fa-solid fa-eye 1 fa-fade');
                $(this).addClass('fa-solid fa-eye-slash 2 fa-fade');
                $('.listCategory').css('display', 'block');                
            }else{
                $(this).removeClass('fa-solid fa-eye-slash 2 fa-fade');
                $(this).addClass('fa-solid fa-eye 1 fa-fade');
                $('.listCategory').css('display','none');
            }
        })
        var arr = $('.CategoryCheck');
        $('.CategoryCheck').on('click',function(){
            var check = [];            
            arr.each(function () {
                var id = $(this).attr('data-id');
                if ($(this).prop("checked")) {
                    check.push(id);
                }
            });
            if(check.length > 0){
                $('.btnexp').addClass('fa-bounce');                
            }
            else{
                $('.btnexp').removeClass('fa-bounce');
            }

            if (arr.length == check.length){
                $('.CategoryCheckAll').prop('checked', true);
            }else{
                $('.CategoryCheckAll').prop('checked', false);
            }
             
        })
        function productView(check){
            $('.nav-link').removeClass("KichHoat");           
            $.ajax({
                url: '@Url.Action("setionclick","AdminProducts")',
                datatype: "json",
                type: "POST",
                data: { id: check },
                async: true,
                success: function (results) {
                    if (results.success == true) {
                        $('.' + check).addClass("KichHoat");
                        location.reload();
                    } 
                },
               
            });
        }
