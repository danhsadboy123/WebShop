        function Deleteitem(id){            
            $("#productidss").val(id);
        }; 
        $("#confirm-delete-button").on("click", function () {
            var productid = $("#productidss").val();         
            $.ajax({
                url: '@Url.Action("DeleteProduct","AdminProducts")',
                datatype: "json",
                type: "POST",
                data: { id: productid },
                async: true,
                success: function (results) {
                    if (results.success == true) {
                        $("#delete-pd-md").modal('hide');
                        $('#' + productid).css('display','none');
                    } else {
                        alert(results.message);
                    }
                },
                error: function (xhr) {
