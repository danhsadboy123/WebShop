        });
        $('.checkHome').on('click', function () {
            $.ajax({
                url: '@Url.Action("checkHome","AdminProducts")',
                datatype: "json",
                type: "POST",
                data: { id: $(this).attr('data-id') },
                async: true,
                success: function (results) {
                    if (results.success != true) {
