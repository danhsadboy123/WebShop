@model WebShop.Areas.Admin.Models.AdminProductVM

@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm :" + Model.ProductName;
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    List<WebShop.Models.ProductThumb> Images = ViewBag.lsImage;
    List<WebShop.Models.Attribute> Attributes = ViewBag.lsAttribute;
    List<WebShop.Models.AttributesPrice> SelectedPrices = ViewBag.SelectedPrice;
    List<WebShop.Models.ProductCategory> productsCate = ViewBag.productsCate;
    var imgp = "";
    var max = 0;
    var min =0;
    if (Model.SalePrice < 1000000)
    {
        max = 1000000;
        min = 0;
    }
    else
    {
        max = (int)Model.SalePrice + 3000000;
        min = (int)Model.SalePrice - 3000000;
        if(min < 0)
        {
            min = 0;
        }
    }

}
@section Styles{
    <link href="~/Adminassets/summernote/summernote-bs4.css" rel="stylesheet">
    <link href="~/Adminassets/summernote/summernote.css" rel="stylesheet">
    <link href="~/Adminassets/vendors/select2/select2.css" rel="stylesheet">
    <style>
        .avatar-label {
            display: none;
            color: #ffffff;
            background-color: #428bca;
            padding: 4px 8px;
            border-radius: 4px;
            margin-left:8px;
        }

        .selected-avatar .avatar-label {
            display: block;
        }
    </style>
}

<form asp-controller="AdminProducts" asp-action="Edit" asp-route-id="@Model.ProductId" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" class="proid" asp-for="ProductId" />
    @*<input type="hidden" asp-for="Thumb" />*@
    <input type="hidden" asp-for="DateCreated" />
    <div class="page-header no-gutters has-tab">
        <div class="d-md-flex m-b-15 align-items-center justify-content-between">
            <div class="m-b-15">
                <button type="submit" class="btn btn-primary" asp-route-curPage="@ViewBag.CurrentPage">
                    <i class="anticon anticon-save"></i>
                    <span>Lưu</span>
                </button>
                <a class="btn btn-warning m-r-5" asp-area="Admin" asp-controller="AdminProducts" asp-action="Index" asp-route-page="@ViewBag.CurrentPage">
                    <span>Đóng</span>
                </a>
            </div>
        </div>
        <ul class="nav nav-tabs">
            <li class="nav-item">
                <a class="nav-link active" data-toggle="tab" href="#product-edit-basic">Thông tin sản phẩm</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-toggle="tab" href="#product-edit-image">Hình ảnh</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-toggle="tab" href="#product-edit-attribute">Thuộc tính</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-toggle="tab" href="#product-edit-product">Sản phẩm cùng loại</a>
            </li>
        </ul>
    </div>
    <div class="tab-content m-t-15">
        <div class="tab-pane fade show active" id="product-edit-basic">
            <div class="card">
                <div class="card-body">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="row">
                        <div class="form-group col-md-6">
                            <label class="control-label">Danh mục</label>
                            <div class="m-b-15">
                                <select class="select2" name="productCategories" multiple="multiple">
                                    @foreach (var category in ViewBag.AllCategories)
                                    {
                                        var isSelected = ViewBag.SelectedCategories.Contains(category);
                                        <option value="@category.CatId" selected=@isSelected ? selected:"">@category.CatName</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group col-md-6">
                            <label class="font-weight-semibold" for="productBrand">Thương hiệu</label>
                            <select class="custom-select" asp-for="BrandId" style="min-width: 200px;" asp-items="ViewBag.Hang">
                                <option value="" disabled selected>Chọn hãng</option>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group col-md-6">
                            <div class="form-group">
                                <label class="font-weight-semibold" for="productName">Video sản phẩm</label>
                                <input type="text" class="form-control" asp-for="Video" placeholder="Lấy link từ youtube">
                            </div>
                        </div>
                        <div class="form-group col-md-6">
                            <div class="form-group">
                                <label class="font-weight-semibold" for="productName">Tên sản phẩm</label>
                                <input type="text" class="form-control" asp-for="ProductName">
                            </div>
                        </div>
                        <div class="form-group col-md-6">
                            <div class="form-group">
                                <label class="font-weight-semibold" for="productName">Product Name</label>
                                <input type="text" class="form-control" asp-for="ProductName_EN">
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group col-md-6">
                            <label class="font-weight-semibold" for="productCode">Mã sản phẩm</label>
                            <input type="text" class="form-control" asp-for="ProductCode">
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group col-md-6">
                            <label class="font-weight-semibold">Giá bán</label>

                            <div class="d-flex align-items-center">
                                <div class="input-group">
                                    <input type="text" class="form-control" placeholder="Giá bán" aria-describedby="basic-addon2" asp-for="Price">
                                    <div class="input-group-append">
                                        <span class="input-group-text" id="basic-addon2">VNĐ</span>
                                    </div>
                                </div>
                                <span class="p-h-10">-</span>
                                <div class="input-group">
                                    <input type="text" class="form-control" placeholder="Giá khuyến mãi" aria-describedby="basic-addon2" asp-for="SalePrice">
                                    <div class="input-group-append">
                                        <span class="input-group-text" id="basic-addon2">VNĐ</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group col-md-6">
                            <label class="font-weight-semibold">Bảo hành</label>
                            <div class="d-flex align-items-center">
                                <div class="input-group">
                                    <input type="text" class="form-control" aria-describedby="basic-addon2" asp-for="Warranty">
                                    <div class="input-group-append">
                                        <span class="input-group-text" id="basic-addon2">tháng</span>
                                    </div>
                                </div>
                                <span class="p-h-10">-</span>
                                <input type="text" placeholder="Loại bảo hành" style="margin-bottom:0px" class="form-control" asp-for="WarrantyNote">
                            </div>
                        </div>
                        <div class="form-group col-md-6">
                            <div class="form-group">
                                <label class="font-weight-semibold" for="productName">Warranty Type</label>
                                <input type="text" class="form-control" asp-for="WarrantyNote_EN">
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group col-md-6">
                            <label class="font-weight-semibold" for="productName">Hàng tồn kho</label>
                            <input type="text" class="form-control" asp-for="UnitsInStock">
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group col-md-6">
                            <label class="font-weight-semibold" for="ShortDesc">Mô tả ngắn</label>
                            <textarea class="summernote" asp-for="ShortDesc"></textarea>
                        </div>
                        <div class="form-group col-md-6">
                            <label class="font-weight-semibold" for="ShortDesc">Short Description</label>
                            <textarea class="summernote" asp-for="ShortDesc_EN"></textarea>
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group col-md-6">
                            <label class="font-weight-semibold" for="Gift">Quà Tặng</label>
                            <textarea class="summernote" asp-for="Gift"></textarea>
                        </div>
                        <div class="form-group col-md-6">
                            <label class="font-weight-semibold" for="Gift">Gift</label>
                            <textarea class="summernote" asp-for="Gift_EN"></textarea>
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group col-md-6">
                            <label class="font-weight-semibold" for="Description">Mô tả sản phẩm</label>
                            <textarea class="summernote" asp-for="Description"></textarea>
                        </div>
                        <div class="form-group col-md-6">
                            <label class="font-weight-semibold" for="Description">Description</label>
                            <textarea class="summernote" asp-for="Description_EN"></textarea>
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group col-md-6">
                            <label class="font-weight-semibold" for="configInformation">Thông tin cấu hình</label>
                            <textarea class="summernote" asp-for="ConfigInformation"></textarea>
                        </div>
                        <div class="form-group col-md-6">
                            <label class="font-weight-semibold" for="configInformation">Specification</label>
                            <textarea class="summernote" asp-for="ConfigInformation_EN"></textarea>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group col-md-6">
                            <label class="font-weight-semibold" for="productSize">Tiêu đề SEO</label>
                            <input type="text" class="form-control" asp-for="Title">
                        </div>
                        <div class="form-group col-md-6">
                            <label class="font-weight-semibold" for="productSize">SEO Title</label>
                            <input type="text" class="form-control" asp-for="Title_EN">
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group col-md-6">
                            <label class="font-weight-semibold" for="productColors">Mô tả SEO</label>
                            <input type="text" class="form-control" asp-for="MetaDesc">
                        </div>
                        <div class="form-group col-md-6">
                            <label class="font-weight-semibold" for="productColors">SEO Description</label>
                            <input type="text" class="form-control" asp-for="MetaDesc_EN">
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group col-md-6">
                            <label class="font-weight-semibold" for="productFit">Từ khóa SEO</label>
                            <input type="text" class="form-control" asp-for="MetaKey">
                        </div>
                        <div class="form-group col-md-6">
                            <label class="font-weight-semibold" for="productFit">SEO Keywords</label>
                            <input type="text" class="form-control" asp-for="MetaKey_EN">
                        </div>
                    </div>

                    <div class="row">
                        <div class="m-t-25">
                            <div class="form-group d-flex align-items-center">
                                <div class="switch m-r-10">
                                    <input type="checkbox" asp-for="Active">
                                    <label for="Active"></label>
                                </div>
                                <label>Công khai</label>
                            </div>
                            <div class="form-group d-flex align-items-center">
                                <div class="switch m-r-10">
                                    <input type="checkbox" asp-for="HomeFlag">
                                    <label for="HomeFlag"></label>
                                </div>
                                <label>Hiển thị ở trang chủ</label>
                            </div>
                            <div class="form-group d-flex align-items-center">
                                <div class="switch m-r-10">
                                    <input type="checkbox" asp-for="BestSellers">
                                    <label for="BestSellers"></label>
                                </div>
                                <label>BestSellers</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="tab-pane fade" id="product-edit-image">
            <div class="card">
                <div class="card-body">
                    <div class="form-group" style="display: flex;justify-content: space-between;">
                        <div>
                            <a data-target="#modal-header" data-toggle="modal" class="btn btn-primary btn-tone m-r-5">
                                <i class="anticon anticon-camera"></i>
                                Thêm ảnh
                            </a>
                        </div>
                        <span id="deleteAllImage" data-url="@Url.Action("DeleteAllAvatar", "AdminProducts")" data-product-id="@Model.ProductId">
                            <div class="btn btn-danger m-r-5">
                                <i class="anticon anticon-delete"></i>
                                Xóa tất cả
                            </div>
                        </span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover e-commerce-table" id="imageTable">
                            <thead>
                                <tr>
                                    <th>STT</th>
                                    <th>Hình ảnh</th>
                                    <th>Tên hình ảnh</th>
                                    <th>Ảnh đại diện</th>
                                    <th>#</th>
                                </tr>
                            </thead>
                            <tbody id="imageTableBody">
                                <!-- Các dòng trong bảng sẽ được thêm vào đây -->
                                @if (Images.Count() > 0)
                                {
                                    var stt = 1;
                                    
                                    @foreach (var image in Images)
                                    {
                                        @if (image.IsMain == true)
                                        {
                                            imgp = image.Alias;
                                        }
                                        <tr>
                                            <th scope="row">@stt</th>
                                            <td class="@(image.IsMain == true ? "selected-avatar" : "")">
                                                <div id="image-@image.ImageId" style="display:flex; align-items: center">
                                                    <img src="@image.Alias" align="absmiddle" width="120">
                                                    <span class="avatar-label">Avatar</span>
                                                </div>
                                            </td>
                                            <td>@image.Alias</td>
                                           
                                            <td>
                                                <button class="btn btn-warning m-r-5 set-default-button" data-url="@Url.Action("SetAvatar", "AdminProducts")" data-image-id="@image.ImageId" data-product-id="@image.ProductId">Set Avatar</button>
                                            </td>
                                            <td>
                                                <button class="btn btn-icon btn-danger delete-button" data-url="@Url.Action("DeleteImage", "AdminProducts")" data-image-id="@image.ImageId">
                                                    <i class="anticon anticon-delete"></i>
                                                </button>                                                
                                            </td>
                                        </tr>                                       
                                        stt++;
                                    }
                                }                               
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="tab-pane fade" id="product-edit-attribute">
            <div class="card">
                <div class="card-body">
                    @if (Attributes.Count()>0)
                    {
                        @foreach (var attr in Attributes)
                        {
                            <div class="form-group col-4">
                                <label class="font-weight-semibold">@attr.Name</label>

                                <div class="m-b-15">
                                    <select class="select2" name="attributeValues" multiple="multiple">

                                        @foreach (var attrValue in attr.AttributesPrices)
                                        {
                                            @if (attrValue.ProductId == null)
                                            {
                                                var attributePrices = SelectedPrices.Select(a => a.Price).ToList();
                                                var isSelected = attributePrices.Contains(attrValue.Price);
                                                <option value="@attrValue.AttributesPriceId" selected=@isSelected ? selected:"">@attrValue.Price</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                        }
                    }else{
                       <div>Chưa thêm thuộc tính cho danh mục, vui lòng thêm</div>
                    }
                </div>
            </div>
        </div>
        <div class="tab-pane fade" id="product-edit-product">
            <div class="card">
                <div class="card-body">  
                        <div class="d-flex align-items-center">
                        @{string url = $"/products/{Model.Alias}-{Model.ProductId}";}
                            <img class="img-fluid rounded" src="@imgp==''?'~/Adminassets/images/avatars/thumb-1.jpg':@imgp" style="max-width: 60px;border:solid #DDDDDD 1px;" alt="">
                            <div class="d-flex" style="flex-direction:column; margin-left:12px">
                            <a href="@url" target="_blank" class="text-dark" style="font-weight:500">@Model.ProductName</a>
                                <span style="display: inline-flex;align-items: center;font-size: 12px;color: #9c9c9c;max-width: 100%">Model: @Model.ProductCode - SL: @Model.UnitsInStock </span>
                                <span>@Model.Price.Value.ToString("#,##0") VND - @Model.SalePrice.Value.ToString("#,##0") VND</span>
                                @if (Model.Active == true)
                                {
                                    <div class="d-flex align-items-center">
                                        <div class="badge badge-success badge-dot m-r-10"></div>
                                        <div>Đang bán</div>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center">
                                        <div class="badge badge-danger badge-dot m-r-10"></div>
                                        <div>Ẩn</div>
                                    </div>
                                }
                            </div>
                        </div> 
                </div>
                <div class="EventOption">
                    @if (Model.ProductCode == Model.ProductOption)
                    {
                        <a href="javascript:void(0)" class="btn btn-primary m-r-5" data-toggle="modal" data-target="#exampleModal">Hủy thuộc tính chủ thể</a>                         
                        <a href="javascript:void(0)" class="btn btn-default m-r-5" data-toggle="modal" data-target="#exampleModalScrollable"> Sản phẩm tương tự</a>
                    }
                    else
                    {
                        if (Model.ProductOption == null)
                        {
                            <a href="javascript:void(0)" class="btn btn-default m-r-5" data-toggle="modal" data-target="#exampleModalScrollable">Sản phẩm tương tự</a>
                        }
                        else
                        {
                            <a href="javascript:void(0)" class="btn btn-default m-r-5 deleteitemoption" data-toggle="modal" data-target="#exampleModalScrollable">Hủy liên kết với chủ thể</a>                            
                        } 
                    } 
                </div>
                <div class="listproduct">
                    @foreach (var procate in productsCate.Where(c => c.Product.ProductOption == Model.ProductOption).Where(c=>c.ProductId!=Model.ProductId))
                    {
                        string urls = $"/products/{Model.Alias}-{Model.ProductId}";
                        if (procate.Product.ProductOption != null)
                        {
                            <div style="display:flex;align-items:center" class="productcheck @procate.ProductId" data-id="@procate.ProductId">
                                <div style="display:flex;align-items:center;width:100%;justify-content: space-between;">
                                    <div class="d-flex align-items-center" style="margin-left:10px">
                                        <img class="img-fluid rounded" src="@procate.Product.Avatar" style="max-width: 60px;border:solid #DDDDDD 1px;" alt="">
                                        <div class="d-flex" style="flex-direction:column; margin-left:12px">
                                            <a href="@urls" target="_blank" class="text-dark" style="font-weight:500">@procate.Product.ProductName</a>
                                            <span style="display: inline-flex;align-items: center;font-size: 12px;color: #9c9c9c;max-width: 100%">Model: @procate.Product.ProductCode - SL: @procate.Product.UnitsInStock </span>
                                            <span>@String.Format("{0:#,##0}", procate.Product.Price) VND -@String.Format("{0:#,##0}",procate.Product.SalePrice) VND  </span>
                                            @if (@procate.Product.Active == true)
                                            {
                                                <div class="d-flex align-items-center">
                                                    <div class="badge badge-success badge-dot m-r-10"></div>
                                                    <div>Đang bán</div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="d-flex align-items-center">
                                                    <div class="badge badge-danger badge-dot m-r-10"></div>
                                                    <div>Ẩn</div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    <div class="col-2">
                                        @if (Model.ProductCode == Model.ProductOption)
                                        {
                                            <a class="btn btn-danger btn-tone m-r-5 delete-button" onclick="DeleteOption(@procate.ProductId)" data-original-title="Thêm vào danh sách sản phẩm cùng loại">
                                               <i class="anticon anticon-delete"></i>
                                            </a>                                             
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</form>
<div class="modal fade" id="exampleModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Hủy thuộc tính chủ thể</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <i class="anticon anticon-close"></i>
                </button>
            </div>
            <div class="modal-body">
                <p>-Hủy thuộc tính chủ thể<br />
                    + Lưu ý sản phẩm sẽ không còn là chủ thể<br />
                    + Và sẽ không tồn tại trong danh sách model: @Model.ProductCode<br />
                    + Danh sách với model: @Model.ProductCode sẽ được chuyển tới model cùng loại tương tự<br />
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default " data-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary DeleteTopOption">Xác nhận</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="exampleModalScrollable">
    <input type="hidden" id="brandidcheck" value="@Model.BrandId"/>
    <input type="hidden" id="max" value="@max"/>
    <input type="hidden" id="min" value="@min"/>
    <div class="modal-dialog modal-dialog-scrollable modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <div class="col-8">
                    <div style="display:flex">
                        <h5 class="modal-title col-6" id="exampleModalScrollableTitle">Sản phẩm cùng loại</h5>
                    </div>
                    <div class="bodycheck" data-check="bodycheck2">
                        <ul class="nav nav-tabs col-12">
                            <li class="nav-item col-6">
                                <a class="itemcates nav-link active" data-toggle="tab" href="#product-edit-brand">Cùng thương hiệu</a>
                            </li>
                            <li class="nav-item col-6">
                                <a class="itemcates nav-link" data-toggle="tab" href="#product-edit-outbrand">Khác thương hiệu</a>
                            </li>
                        </ul> 
                    </div>
                </div>
                <button type="button" class="close" data-dismiss="modal">
                    <i class="anticon anticon-close"></i>
                </button>
            </div>
            
            <div class="modal-body bodycheck" data-check="bodycheck2">
                <p>Liên kết các sản phẩm và sản phẩm liên kết là sản phẩm chủ thể </p>
                <div class="itemcate tab-pane fade show active" id="product-edit-brand">
                    @foreach (var procate in productsCate.Where(c => c.Product.BrandId == Model.BrandId))
                    {
                       string urls = $"/products/{Model.Alias}-{Model.ProductId}";
                        if (procate.Product.ProductOption ==null)
                        {
                            <div style="display:flex;align-items:center" class="productcheck @procate.ProductId" data-id="@procate.ProductId">
                                <div style="display:flex;align-items:center;width:100%;justify-content: space-between;">
                                    <div class="d-flex align-items-center" style="margin-left:10px">
                                        <img class="img-fluid rounded" src="@procate.Product.Avatar" style="max-width: 60px;border:solid #DDDDDD 1px;" alt="">
                                        <div class="d-flex" style="flex-direction:column; margin-left:12px">
                                            <a href="@urls" target="_blank" class="text-dark" style="font-weight:500">@procate.Product.ProductName</a>
                                            <span style="display: inline-flex;align-items: center;font-size: 12px;color: #9c9c9c;max-width: 100%">Model: @procate.Product.ProductCode - SL: @procate.Product.UnitsInStock </span>
                                            <span>@String.Format("{0:#,##0}", procate.Product.Price) VND -@String.Format("{0:#,##0}",procate.Product.SalePrice) VND  </span>
                                            @if (@procate.Product.Active == true)
                                            {
                                                <div class="d-flex align-items-center">
                                                    <div class="badge badge-success badge-dot m-r-10"></div>
                                                    <div>Đang bán</div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="d-flex align-items-center">
                                                    <div class="badge badge-danger badge-dot m-r-10"></div>
                                                    <div>Ẩn</div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    <div class="col-2">
                                        <a class="btn btn-secondary btn-tone m-r-5" onclick="AddOption(@procate.ProductId)" data-original-title="Thêm vào danh sách sản phẩm cùng loại">
                                            Chọn
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
                <div class="itemcate tab-pane fade" id="product-edit-outbrand" style="display:none">
                    @foreach (var procate in productsCate.Where(c => c.Product.BrandId != Model.BrandId))
                    {
                        var color = "";
                        string urls = $"/products/{Model.Alias}-{Model.ProductId}";
                        if (procate.Product.SalePrice > min && procate.Product.SalePrice < max)
                        {
                            color = "#f3969f3d";
                        }
                        if (procate.Product.ProductOption==null)
                        {
                            <div style="display:flex;align-items:center;background-color:@color;" class="productcheck" data-id="@procate.ProductId">
                                <div style="display:flex;align-items:center;width:100%;justify-content: space-between;">
                                    <div class="d-flex align-items-center" style="margin-left:10px">
                                        <img class="img-fluid rounded" src="@procate.Product.Avatar" style="max-width: 60px;border:solid #DDDDDD 1px;" alt="">
                                        <div class="d-flex" style="flex-direction:column; margin-left:12px">
                                            <a href="@urls" target="_blank" class="text-dark" style="font-weight:500">@procate.Product.ProductName</a>
                                            <span style="display: inline-flex;align-items: center;font-size: 12px;color: #9c9c9c;max-width: 100%">Model: @procate.Product.ProductCode - SL: @procate.Product.UnitsInStock </span>
                                            <span>@String.Format("{0:#,##0}", procate.Product.Price) VND -@String.Format("{0:#,##0}",procate.Product.SalePrice) VND  </span>
                                            @if (@procate.Product.Active == true)
                                            {
                                                <div class="d-flex align-items-center">
                                                    <div class="badge badge-success badge-dot m-r-10"></div>
                                                    <div>Đang bán</div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="d-flex align-items-center">
                                                    <div class="badge badge-danger badge-dot m-r-10"></div>
                                                    <div>Ẩn</div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    <div class="col-2">
                                        <a class="btn btn-secondary btn-tone m-r-5" onclick="AddOption(@procate.ProductId)" data-original-title="Thêm vào danh sách sản phẩm cùng loại">
                                            Chọn
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
<div id="modal-header" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body">
                <h5>Tải lên hình ảnh</h5>
                
                <form asp-area="Admin" asp-controller="AdminProducts" asp-action="UploadProductImage" asp-route-productId="@Model.ProductId" method="post" enctype="multipart/form-data">
                    <div class="form-group">
                        <input class="productId" type="hidden" value="@Model.ProductId"/>
                        <input class="productName" type="hidden" value="@Model.ProductName"/>
                        <input name="productImages" type="file" class="form-control productImages" multiple>
                    </div>
                    <button type="button" class="btn btn-success updateimage">Tải lên</button>
                </form> 
                @*    <div class="form-group">
                        <input name="productImages" class="form-control listimage" multiple>
                    </div>*@
                   @* <span class="erradd" style="color:red"></span>
                    <button class="btn btn-success updateimage">Tải lên</button> *@
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/Adminassets/vendors/select2/select2.min.js"></script>
    <script src="~/Adminassets/js/pages/e-commerce-product-edit.js"></script>
    <script src="https://ajax.aspnetcdn.com/ajax/jquery.validate/1.19.1/jquery.validate.min.js"></script>
    <script src="~/Adminassets/summernote/summernote-bs4.js"></script>
    <script>
        function loadpro(data){
            var id = $('.proid').val();     
            var html="";
            $.each(data.data,function(key,item){
                var urls = '/products/' + item.alias + '-' + item.productId + '';
                if (item.productCode !=item.productOption){
                    html += '<div style="display:flex;align-items:center" class="productcheck" data-id="' + item.productId + '">'
                        + '<div style="display:flex;align-items:center;width:100%;justify-content: space-between;">'
                        + '<div class="d-flex align-items-center" style="margin-left:10px">'
                        + '<img class="img-fluid rounded" src="' + item.avatar + '" style="max-width: 60px;border:solid #DDDDDD 1px;" alt="">'
                        + '<div class="d-flex" style="flex-direction:column; margin-left:12px">'
                        + '<a href="' + urls + '" target="_blank" class="text-dark" style="font-weight:500">' + item.productName + '</a>'
                        + '<span style="display: inline-flex;align-items: center;font-size: 12px;color: #9c9c9c;max-width: 100%">Model: ' + item.productCode + ' - SL: ' + item.unitsInStock + ' </span>'
                        + '<span>' + item.price + ' VND - ' + item.salePrice + ' VND</span>'
                    if (item.active == true) {
                        html += '<div class="d-flex align-items-center" >'
                            + '<div class="badge badge-success badge-dot m-r-10"></div>'
                            + '<div>Đang bán</div></div>';
                    }
                    else {
                        html += '<div class="d-flex align-items-center" >'
                            + '<div class="badge badge-danger badge-dot m-r-10"></div>'
                            + '<div>Ẩn</div></div>';
                    }
                    html += '</div></div><div class="col-2"><a class="btn btn-danger btn-tone m-r-5 delete-button" onclick="DeleteOption(' + item.productId + ')">'
                        + '<i class="anticon anticon-delete"></i></a>'
                         +'</div></div></div>';
                }
            })
            $('.listproduct').html(html);
        }
        function loadpromadel(data){
            var html1="";
            var html2="";
            var max =$('#max').val();
            var min =$('#min').val();
            var brand =$('#brandidcheck').val();
            $.each(data,function(key,item){
                if(item.product.productOption==null){
                    var color = "";
                    if (item.product.salePrice > min && item.product.salePrice < max) {
                        color = "#f3969f3d";
                    }
                    var urls = '/products/' + item.product.alias + '-' + item.product.productId+'';
                    if(item.product.brandId==brand){
                        html1 += '<div style="display:flex;align-items:center; background-color:' + color + '" class="productcheck ' + item.product.productId + '" data-id="' + item.product.productId + '">'
                            + '<div style="display:flex;align-items:center;width:100%;justify-content: space-between;">'
                            + '<div class="d-flex align-items-center" style="margin-left:10px">'
                            + '<img class="img-fluid rounded" src="' + item.product.avatar + '" style="max-width: 60px;border:solid #DDDDDD 1px;" alt="">'
                            + '<div class="d-flex" style="flex-direction:column; margin-left:12px">'
                            + '<a href="' + urls + '" target="_blank" class="text-dark" style="font-weight:500">' + item.product.productName + '</a>'
                            + '<span style="display: inline-flex;align-items: center;font-size: 12px;color: #9c9c9c;max-width: 100%">Model: ' + item.product.productCode + ' - SL: ' + item.product.unitsInStock + ' </span>'
                            + '<span>' + item.product.price + ' VND - ' + item.product.salePrice + ' VND</span>'
                        if (item.active == true) {
                            html1 += '<div class="d-flex align-items-center" >'
                                + '<div class="badge badge-success badge-dot m-r-10"></div>'
                                + '<div>Đang bán</div></div>';
                        }
                        else {
                            html1 += '<div class="d-flex align-items-center" >'
                                + '<div class="badge badge-danger badge-dot m-r-10"></div>'
                                + '<div>Ẩn</div></div>';
                        }
                        html1 += '</div></div><div class="col-2"><a class="btn btn-secondary btn-tone m-r-5" onclick="AddOption(' + item.product.productId + ')">'
                            + 'Chọn</a>'
                            + '</div></div></div>';
                    }
                    else{

                        html2 += '<div style="display:flex;align-items:center;background-color:' + color + '" class="productcheck ' + item.product.productId + '" data-id="' + item.product.productId + '">'
                            + '<div style="display:flex;align-items:center;width:100%;justify-content: space-between;">'
                            + '<div class="d-flex align-items-center" style="margin-left:10px">'
                            + '<img class="img-fluid rounded" src="' + item.product.avatar + '" style="max-width: 60px;border:solid #DDDDDD 1px;" alt="">'
                            + '<div class="d-flex" style="flex-direction:column; margin-left:12px">'
                            + '<a href="' + urls + '" target="_blank" class="text-dark" style="font-weight:500">' + item.product.productName + '</a>'
                            + '<span style="display: inline-flex;align-items: center;font-size: 12px;color: #9c9c9c;max-width: 100%">Model: ' + item.product.productCode + ' - SL: ' + item.product.unitsInStock + ' </span>'
                            + '<span>' + item.product.price + ' VND - ' + item.product.salePrice + ' VND</span>'
                        if (item.active == true) {
                            html2 += '<div class="d-flex align-items-center" >'
                                + '<div class="badge badge-success badge-dot m-r-10"></div>'
                                + '<div>Đang bán</div></div>';
                        }
                        else {
                            html2 += '<div class="d-flex align-items-center" >'
                                + '<div class="badge badge-danger badge-dot m-r-10"></div>'
                                + '<div>Ẩn</div></div>';
                        }
                        html2 += '</div></div><div class="col-2"><a class="btn btn-secondary btn-tone m-r-5" onclick="AddOption(' + item.productId + ')">'
                            + 'Chọn</a>'
                            + '</div></div></div>';
                    }
                }
            })
            $('#product-edit-brand').html(html1);
            $('#product-edit-outbrand').html(html2);
        }
        // get product
        function loadpro2(){
            var id = $('.proid').val();
            $.ajax({
                url: '@Url.Action("loadpro2","AdminProducts")',
                datatype: "json",
                type: "GET",
                data: {
                    id: id
                },
                success: function (data) {                    
                    loadpromadel(data);
                }
            });
        }
        $('.DeleteTopOption').on('click',function(){
            var id = $('.proid').val();
            $.ajax({
                url: '@Url.Action("DeleteTopOption","AdminProducts")',
                datatype: "json",
                type: "GET",
                data: {
                    id: id
                },
                success: function (data) {
                    if (data.success == true) {                      
                        alert('Đã thuộc tính chủ thể của sản phẩm');
                        $('#exampleModal').modal('hide');
                        $('.listproduct').html('');
                        $('.EventOption').html('<a href="javascript:void(0)" class="btn btn-default m-r-5" data-toggle="modal" data-target="#exampleModalScrollable"> Sản phẩm tương tự</a>');
                        loadpro2();
                    }
                }
            });
        })
        $('.deleteitemoption').on('click',function(){
            var id = $('.proid').val();
            $.ajax({
                url: '@Url.Action("deleteitemoption","AdminProducts")',
                datatype: "json",
                type: "POST",
                data: {
                    id: id,
                },
                success: function (data) {
                    if(data.success==true){
                        alert('Đã hủy liên kết thành công');
                       location.reload();
                        $('.listproduct').html('');
                        loadpro2();
                    }
                }
            });
        })
        function AddOption(iditem){
                var id = $('.proid').val();
                $.ajax({
                    url: '@Url.Action("AddOption","AdminProducts")',
                    datatype: "json",
                    type: "POST",
                    data: {
                        id: id,
                        iditem: iditem,
                    },
                    success: function (data) {
                        if(data.success==true){
                            $('.productcheck'+'.'+iditem).css('display','none');
                            alert('Đã thêm sản phẩm vào nhóm sản phẩm');
                        }
                        if(data.data.length>=1){
                            $('.EventOption').html('<a href="javascript:void(0)" class="btn btn-primary m-r-5" data-toggle="modal" data-target="#exampleModal">Hủy thuộc tính chủ thể</a>'                        
                                 +'<a href="javascript:void(0)" class="btn btn-default m-r-5" data-toggle="modal" data-target="#exampleModalScrollable"> Sản phẩm tương tự</a>');
                        }
                       loadpro(data);
                    }
                });
        }
        function DeleteOption(iditem){
            $.ajax({
                url: '@Url.Action("DeleteOption","AdminProducts")',
                datatype: "json",
                type: "GET",
                data: { 
                    iditem: iditem
                },
                success: function (data) {
                    if (data.success == true) {
                        alert('Đã hủy thêm sản phẩm vào nhóm sản phẩm');
                    }
                    if (data.data.length >= 1) {
                        $('.EventOption').html('<a href="javascript:void(0)" class="btn btn-primary m-r-5" data-toggle="modal" data-target="#exampleModal">Hủy thuộc tính chủ thể</a>'
                            + '<a href="javascript:void(0)" class="btn btn-default m-r-5" data-toggle="modal" data-target="#exampleModalScrollable"> Sản phẩm tương tự</a>');
                    }
                    loadpro(data);
                    loadpro2();
                }
            });
        }
        $('.setitemoption').on('change',function(){
                var itemop = $(this).val();
                var bodeycheck = $('.bodycheck');
                $.each(bodeycheck, function (key, item) {
                    if ($(item).attr('data-check') == itemop) {
                        $(item).css('display', 'block');
                    } else {
                        $(item).css('display', 'none');
                    }
                })
            })
        $('.updateimage').on('click', function () {
            var files = $('.productImages')[0].files;
            var productId = $('.productId').val();
            var productName = $('.productName').val();
            var formData = new FormData();
            if (files.length > 0) {
                for (var i = 0; i < files.length; i++) {
                    formData.append('files[]', files[i]);
                } 
                formData.append('productId', productId);
                formData.append('productName', productName);
                console.log(formData);
                $.ajax({
                    url: '@Url.Action("UploadFile","AdminProducts")',
                    type: "POST",
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (result) {
                        if (result.success == true) {
                            alert('Thêm hình ảnh thành công');
                            window.location.reload();
                        }
                    },
                    error: function (result) {
                        alert(result.message);

                    }
                });
            } else {
                console.log("Không có tệp nào được chọn.");
            }
        });

        $('.itemcates').on('click', function () {
                var href = $(this).attr('href');
                var itemc = $('.itemcate');
                $.each(itemc, function (key, item) {
                    if ($(item).attr('id') == href.slice(1)) {
                        $(item).css('display', 'block');
                    } else {
                        $(item).css('display', 'none');
                    }
                })
            });


        jQuery(document).ready(function () {
            $('.summernote').summernote({
                fontNames: ['Arial', 'Arial Black', 'Comic Sans MS', 'Courier New'],
                styleTags: ['p', 'h1', 'h2', 'h3', 'h4', 'h5'],
                height: 200,
                minHeight: null,
                maxHeight: null,
                focus: false
            });

            // Lấy danh sách các nút xóa
            var deleteButtons = document.querySelectorAll('.delete-button');
            var setDefaultButtons = document.querySelectorAll('.set-default-button');
            var avatarImage = document.getElementById('avatarImage');
            
            // Gắn sự kiện click cho từng nút xóa
            deleteButtons.forEach(function (button) {
                button.addEventListener('click', function (event) {
                    event.preventDefault(); // Ngăn chặn hành vi mặc định của nút xóa

                    // Lấy image id từ thuộc tính data-image-id
                    var imageId = this.getAttribute('data-image-id');
                    var deleteUrl = this.getAttribute('data-url');
                    $.ajax({
                        url: deleteUrl,
                        type: "POST",
                        data: { ImageId: imageId },
                        success: function (result) {
                            if (result.success) {
                                location.reload();
                            }
                        },
                        error: function (result) {
                            alert(result.message);
                        }
                    });
                });
            });

            // Gắn sự kiện click cho từng nút default
            setDefaultButtons.forEach(function (button) {
                button.addEventListener('click', function (event) {
                    event.preventDefault(); // Ngăn chặn hành vi mặc định của nút xóa

                    // Lấy image id từ thuộc tính data-image-id
                    var imageId = this.getAttribute('data-image-id');
                    var productId = this.getAttribute('data-product-id');
                    var setDefaultUrl = this.getAttribute('data-url');

                    $.ajax({
                        url: setDefaultUrl,
                        type: "POST",
                        data: { ImageId: imageId, ProductId:productId },
                        success: function (result) {
                            if (result.success) {
                                setAvatar(result.imageId)
                            }
                        },
                        error: function (result) {
                            alert(result.message);

                        }
                    });
                });
            });


            var mySpan = document.getElementById('deleteAllImage'); 
            function myFunction() {
                let text = "Press a button!\nEither OK or Cancel.";
                if (confirm(text) == true) {
                    text = "You pressed OK!";
                } else {
                    text = "You canceled!";
                }
                document.getElementById("demo").innerHTML = text;
            } 
            mySpan.addEventListener('click', function () {
                let text = "Xác nhận xóa tất cả hình ảnh";
                if (confirm(text) == true) {
                    var productId = this.getAttribute('data-product-id');
                    var deleteAllUrl = this.getAttribute('data-url'); 
                    $.ajax({
                        url: deleteAllUrl,
                        type: "POST",
                        data: { productId: productId },
                        success: function (result) {
                            if (result.success) {
                                location.reload();
                            }
                        },
                        error: function (result) {
                            alert(result.message);
                        }
                    });
                } else {
                }

            });

            function setAvatar(imageId) {
                var selectedImage = document.getElementById('image-' + imageId);
                var avatarLabels = document.getElementsByClassName('avatar-label');
                // Xóa điểm nhấn và ẩn chữ "Avatar" trên tất cả các hình ảnh
                for (var i = 0; i < avatarLabels.length; i++) {
                    var imageItem = avatarLabels[i].parentNode;
                    imageItem.classList.remove('selected-avatar');
                    avatarLabels[i].style.display = 'none';
                }

                if (selectedImage) {
                    // Thêm điểm nhấn và hiển thị chữ "Avatar" trên hình ảnh được chọn
                    var selectedImageItem = selectedImage.parentNode;
                    selectedImageItem.classList.add('selected-avatar');
                    var selectedAvatarLabel = selectedImageItem.getElementsByClassName('avatar-label')[0];
                    selectedAvatarLabel.style.display = 'block';
                }
            }
        });
    </script>
}


