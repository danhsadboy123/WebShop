@model WebShop.Models.DonHang

@{
    ViewData["Title"] = "Create";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    List<WebShop.Models.KhachHang> lsCustomer = ViewBag.Customers;
}

@section Styles{
    <link href="~/Adminassets/vendors/datatables/dataTables.bootstrap.min.css" rel="stylesheet">
    <style>
        .autocomplete-suggestions {
            position: absolute;
            width: 100%;
            border: solid 1px #ddd;
            right: 0;
            margin-top: 2px;
            max-height: 380px;
            overflow: auto;
            display: none;
            background: #fff;
            z-index: 9;
            /*width: 472px;*/
        }

            .autocomplete-suggestions .list {
                display: flex;
                flex-direction: row;
                justify-content: space-between;
                align-items: center;
            }

            .autocomplete-suggestions a {
                display: block;
                padding: 10px;
                overflow: hidden;
                max-width: 80%;
            }

                .autocomplete-suggestions a img {
                    width: 60px;
                    float: left
                }

                .autocomplete-suggestions a .info {
                    display: block;
                    margin-left: 65px
                }

                    .autocomplete-suggestions a .info .name {
                        display: block;
                        color: #333
                    }

                    .autocomplete-suggestions a .info .price {
                        color: #ec1c24
                    }

            .autocomplete-suggestions::-webkit-scrollbar-track {
                -webkit-box-shadow: inset 0 0 6px rgba(0,0,0,0.1);
                background-color: #f1f1f1;
                border-radius: 10px
            }

            .autocomplete-suggestions::-webkit-scrollbar {
                width: 6px;
                background-color: #f1f1f1
            }

            .autocomplete-suggestions::-webkit-scrollbar-thumb {
                border-radius: 10px;
                background-color: #ccc
            }

        div.dataTables_wrapper div.dataTables_length label {
            display: none
        }

        div.dataTables_wrapper div.dataTables_filter {
            display: none
        }
    </style>
}
<div class="page-header">
    <div class="header-sub-title">
        <nav class="breadcrumb breadcrumb-dash">
            <a asp-area="Admin" asp-controller="AdminOrders" asp-action="Index" class="breadcrumb-item"><i class="anticon anticon-home m-r-5"></i>Đơn hàng</a>
            <span class="breadcrumb-item KichHoat">Tạo đơn hàng</span>
        </nav>
    </div>
</div>

<div class="modal-header">
    <h5 class="modal-title">Thông tin đơn hàng</h5>
    <div class="row" id="saveDiv" style="display:none">
        @* <a onclick="exportQuotation" class="btn" id="printQuoteBtn" asp-area="Admin" asp-controller="AdminQuotations" asp-action="ExportQuotation" style="background:#e9ecef!important; margin-left:12px;">
        <i class="anticon anticon-printer"></i>
        In
        </a> *@
        <a onclick="exportQuotation()" class="btn" id="printQuoteBtn" style="background:#e9ecef!important; margin-left:12px;">
            Hủy
        </a>
        <a onclick="createDraftOrder()" class="btn btn-primary" id="printQuoteBtn" style=" color:#fff; margin-left:12px;">
                Lưu nháp
        </a>
        @* <a asp-area="Admin" asp-controller="AdminOrders" asp-action="Create" asp-route-draft="true" class="btn btn-primary" id="printQuoteBtn" style=" color:#fff; margin-left:12px;">
                Lưu nháp
        </a> *@
    </div>
</div>
<form asp-controller="AdminOrders" asp-action="Create" method="post" enctype="multipart/form-data">
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4>Sản phẩm</h4>
                </div>
                <div class="card-body">
                    <div class="input-affix">
                        <i class="prefix-icon anticon anticon-search opacity-04"></i>
                        <input id="text-search" name="keyword" style="margin-bottom:0px" type="text" class="form-control" placeholder="Tìm kiếm sản phẩm">
                    </div>
                    <div class="autocomplete-suggestions list" id="js-seach-result">
                    </div>
                    <div class="m-t-10" id="productOrder">
                        @await Component.InvokeAsync("ProductOrder")
                    </div>
                </div>
            </div>
            <div class="card">
                <div class="card-header">
                    <h4>Tiền hàng</h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-semibold" for="productName">Ghi chú</label>
                                <input id="orderNote" type="text" class="form-control">
                            </div>
                        </div>
                        <div class="col-md-6">
                            @await Component.InvokeAsync("ProductOrderDetails")
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <a id="skip-pay-btn" data-target="#skip-pay-modal" data-toggle="modal" class="btn btn-primary" style="float:right; color:white">
                        Thanh toán sau
                    </a>
                    <a id="paid-btn" data-target="#paid-modal" data-toggle="modal" class="btn btn-primary" style="float:right; color:white; margin-right:8px">
                        Đã thanh toán
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <div class="row justify-content-between">
                        <h4>Khách hàng</h4>
                    </div>
                </div>
                <div id="customerDetails">
                </div>
                <div id="customerList">
                    <div class="card-body">
                        <div class="input-affix">
                            <i class="prefix-icon anticon anticon-search opacity-04"></i>
                            <input id="cusSearch" name="keyword" style="margin-bottom:0px" type="text" class="form-control" placeholder="Tìm kiếm khách hàng">
                        </div>
                        <div class="table-responsive">
                            <table id="data-table" class="table table-hover e-commerce-table" style="width:100%">
                                <thead style="display:none">
                                    <tr>
                                        <th>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (lsCustomer != null)
                                    {
                                        foreach (var item in lsCustomer)
                                        {
                                            <tr>
                                                <td style="border-bottom: 1px solid #dee2e6; border-top:none;">
                                                    <div data-customerid="@item.CustomerId" class="customerDiv">
                                                        <strong>@item.HoTen</strong>
                                                        <p>@item.Email</p>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
<div id="paid-modal" class="modal fade bd-example-modal-xl" tabindex="-1" VaiTro="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5>Tạo đơn hàng</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <i class="anticon anticon-close"></i>
                </button>
            </div>
            <div class="modal-body">
                <div style="border:1px solid #87CEFA ;background:#BFEFFF;border-radius:4px; padding:8px">
                    <div style="margin-bottom:12px">
                        Xác nhận đã thanh toán cho đơn hàng này?
                    </div>
                    Trạng thái thanh toán của đơn hàng là <strong>Đã thanh toán</strong>. Sau khi đơn hàng đã tạo, bạn không thể thay đổi phương thức hoặc trạng thái thanh toán.
                </div>
            </div>
            <div class="form-group" style="padding:14px">
                <label>Phương thức thanh toán</label>
                <select class="custom-select" style="min-width: 200px;">
                    <option value="0">Thanh toán khi giao hàng (COD)</option>
                    <option value="1">Chuyển khoản ngân hàng</option>
                </select>
                <label>Số tiền đã nhận: </label>
            </div>
            <div class="modal-footer" style="justify-content:space-between">
                <div class="form-group" style="float:left">
                    <input type="checkbox" checked="" />
                    <label>Xác thực đơn hàng</label>
                </div>
                <div>
                    <button type="button" class="btn" data-dismiss="modal">Hủy</button>
                    <a id="confirm-delete-button" class="btn btn-primary" style="color:#fff">Tạo đơn hàng</a>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="skip-pay-modal" class="modal fade bd-example-modal-xl" tabindex="-1" VaiTro="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5>Tạo đơn hàng</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <i class="anticon anticon-close"></i>
                </button>
            </div>
            <div class="modal-body">
                <div style="border:1px solid #87CEFA ;background:#BFEFFF;border-radius:4px; padding:8px">
                    <div style="margin-bottom:12px">
                        Xác nhận đã thanh toán cho đơn hàng này?
                    </div>
                    Trạng thái thanh toán của đơn hàng là <strong>Chờ xử lý</strong>. Sau khi đơn hàng đã tạo, bạn không thể thay đổi phương thức hoặc trạng thái thanh toán.
                </div>
            </div>
            <div class="form-group" style="padding:14px">
                <label>Phương thức thanh toán</label>
                <select class="custom-select" style="min-width: 200px;">
                    <option value="0">Thanh toán khi giao hàng (COD)</option>
                    <option value="1">Chuyển khoản ngân hàng</option>
                </select>
                <label>Chờ thanh toán: </label>
            </div>
            <div class="modal-footer" style="justify-content:space-between">
                <div class="form-group" style="float:left">
                    <input type="checkbox" checked="" />
                    <label>Xác thực đơn hàng</label>
                </div>
                <div>
                    <button type="button" class="btn" data-dismiss="modal">Hủy</button>
                    <a id="confirm-delete-button" class="btn btn-primary" style="color:#fff">Tạo đơn hàng</a>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/Adminassets/vendors/datatables/jquery.dataTables.min.js"></script>
    <script src="~/Adminassets/vendors/datatables/dataTables.bootstrap.min.js"></script>
    <script>
        var accept = false;
        var customerid = 0;
        // window.addEventListener('beforeunload', function (e) {
        //     if (accept == false) {
        //         e.preventDefault();
        //         e.returnValue = '';
        //         $.ajax({
        //             url: '/api/order/clear-order',
        //             datatype: "json",
        //             type: "POST",
        //             data: {},
        //             success: function (results) {
        //                 loadProductQuotation();
        //                 accept = true;
        //             },
        //             error: function (xhr) {
        //                 console.log("error", xhr)
        //             }
        //         });
        //     }
        // });

        function createDraftOrder() {
            var orderNote = document.getElementById('orderNote').value;
            if (accept == false) {
                accept = true;
                var obj = {
                    note: orderNote,
                    type:'draft'
                }
                // window.location.href = "/Admin/AdminOrders/CreateOrder?note=" + orderNote + "&type=" + "draft";
                $.ajax({
                    url: '@Url.Action("CreateOrder","AdminOrders")',
                    datatype: "json",
                    type: "POST",
                    data: obj,
                    success: function (results) {
                        if (results.success == true) {
                            window.location.href = "/Admin/AdminOrders/Details/" + results.orderId;
                        }
                    },
                    error: function (xhr) {
                        console.log("error", xhr)
                    }
                });
            }
            accept = false;
        }
        var customerTable = $('#data-table').DataTable({
            scrollX: true,
            order: [[0, 'asc']],
            language: {
                search: "Tìm kiếm",
                lengthMenu: "Hiển thị _MENU_",
                zeroRecords: "Không tìm thấy",
                info: "",
                infoEmpty: "",
                loadingRecords: "Loading...",
                infoFiltered: "",
                paginate: {
                    "previous": "Trước",
                    "next": "Sau"
                }
            },
            // pagingType: "simple",

        });
        function onCancel() {
            $.ajax({
                url: '/api/order/remove-customer',
                datatype: "json",
                type: "POST",
                data: { customerId: customerid },
                success: function (results) {
                    $("#customerList").show();
                    $("#customerDetails").empty();
                    customerid = 0;
                    $('#printQuoteBtn').attr('href', '/Admin/AdminQuotations/ExportQuotation');
                },
                error: function (xhr) {
                    console.log("error", xhr)
                }
            });
        }
        var customerDivs = document.querySelectorAll(".customerDiv");

        customerDivs.forEach(function (customerDiv) {
            customerDiv.addEventListener("click", function () {
                var customerId = this.getAttribute("data-customerid");
                $.ajax({
                    url: '/api/order/customerinfo',
                    datatype: "json",
                    type: "POST",
                    data: { customerId: customerId },
                    success: function (results) {
                        $("#customerDetails").html(results);
                        $("#customerList").hide();
                        updateCreateBtn();
                        customerid = customerId;
                        $('#printQuoteBtn').attr('href', '/Admin/AdminQuotations/ExportQuotation?' + 'customerid=' + customerId);
                    },
                    error: function (xhr) {
                        console.log("error", xhr)
                    }
                });
            })
        })
        var customerDetail = document.getElementById("customerDetails");
        var table = document.getElementById("productOrder");
        function updateCreateBtn() {
            if (table && table.children.length > 0) {
                $("#saveDiv").css("display", "block");
            } else {
                $("#saveDiv").css("display", "none");
            }
        }
        $(document).ready(function () {
            var debounceTimer;
            var inputText = document.getElementById("text-search");
            var vatInput = document.getElementById("vatInput");
            var printQuoteButton = document.getElementById("printQuoteBtn");
            var customerDetail = document.getElementById("customerDetails");
            var table = document.getElementById("productOrder");


            updateCreateBtn();


            $('#cusSearch').keyup(function () {
                customerTable.search($(this).val()).draw();
            })

            //bắt sự kiện thay đổi list product
            var observer = new MutationObserver(function (mutations) {
                mutations.forEach(function (mutation) {
                    if (mutation.type === 'childList' || mutation.type === 'attributes') {
                        $("#js-seach-result").hide();
                        updateCreateBtn();
                    }
                });
            });
            var config = { attributes: true, childList: true, subtree: true };
            observer.observe(table, config);

            //tìm kiếm sản phẩm
            inputText.addEventListener("input", function (event) {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(function () {
                    var searchKeyword = event.target.value;
                    searchHandler(searchKeyword);
                }, 300);
            });
            function searchHandler(searchKeyword) {
                if (searchKeyword.trim() != '') {
                    var strkeyword = searchKeyword
                    $.ajax({
                        url: '/Admin/Search/SearchProductOrder/',
                        datatype: "json",
                        type: "POST",
                        data: { keyword: strkeyword },
                        async: true,
                        success: function (results) {
                            $("#js-seach-result").html("");
                            $("#js-seach-result").html(results);
                            $("#js-seach-result").show();
                        },
                        error: function (xhr) {
                            alert('error');
                        }
                    });
                } else {
                    $("#js-seach-result").hide();
                }
            }
            function loadProductQuotation() {
                $('#productOrder').load("/Admin/AdminAjaxContent/ProductOrder");
                $('#productOrderDetails').load("/Admin/AdminAjaxContent/ProductOrderDetails");
            }
        });
    </script>
}
