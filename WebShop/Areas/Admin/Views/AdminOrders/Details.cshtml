@using Microsoft.AspNetCore.Html;
@model WebShop.Models.Order
@{
    List<OrderDetail> orderDetails = ViewBag.ChiTiet;
    var dem = 0;
    int total = 0;
    int discount = 0;
}

@section Styles{
    <style>
        .status-label {
            padding: 4px 8px;
            border-radius: 4px;
            margin-left: 8px;
        }

            .status-label.processing {
                background-color: #f0f6ff;
                color: #2463eb;
                border: solid #2463eb 1px;
            }

            .status-label.confirm {
                background-color: #fefce7;
                color: #c88a04;
                border: solid #c88a04 1px;
            }

            .status-label.deliver {
                background-color: #f2fdf5;
                color: #16a249;
                border: solid #16a249 1px;
            }

            .status-label.success {
                background-color: #f2fdf5;
                color: #16a249;
                border: solid #16a249 1px;
            }

            .status-label.failed {
                background-color: #fef1f1;
                color: #dc2828;
                border: solid #dc2828 1px;
            }

            .status-label.return {
                background-color: #f3f4f6;
                color: grey;
                border: solid grey 1px;
            }

        #checkedoderload {
            display: none;
        }

        #checkedoderload1 {
            display: none;
        }

        #checkedoderload2 {
            display: none;
        }
        .breakhere { page-break-after: always }
    </style>
}

<div class="page-header">
    <div class="header-sub-title">
        <nav class="breadcrumb breadcrumb-dash">
            <a asp-area="Admin" asp-controller="AdminOrders" asp-action="Index" class="breadcrumb-item"><i class="anticon anticon-home m-r-5"></i>Đơn hàng</a>
            <span class="breadcrumb-item KichHoat">#@Model.OrderId</span>
        </nav>
    </div>
</div>

<div class="modal-header">
    <h5 class="modal-title">ĐƠN HÀNG #@Model.OrderId</h5>
    <div class="row">
        @* <div class="d-md-block d-none border-left col-1"> *@
        <div class="dropdown dropdown-animated">
            <a class="btn dropdown-toggle" data-toggle="dropdown" style="background:#e9ecef!important;">
                <span>Thao tác</span>
            </a>
            <div class="dropdown-menu">
                @* <a target="_blank" asp-area="Admin" asp-controller="AdminOrders" asp-action="AAA" class="dropdown-item">In phiếu bảo hành</a> *@
                <a target="_blank" asp-area="Admin" asp-controller="AdminOrders" asp-action="PrintWarranty" asp-route-id="@Model.OrderId" class="dropdown-item">In phiếu bảo hành</a>
                <a class="dropdown-item" href="#">Hủy đơn hàng</a>
            </div>
        </div>
        <a class="btn" style="background:#e9ecef!important; margin-left:12px">
            <i class="anticon anticon-printer"></i>
            In
        </a>
        @* </div> *@
    </div>
</div>
  
<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <div class="m-t-10 m-b-10">
                    @{
                        string deliveryStatus;
                        if (Model.DeliveryStatus.DeliveryStatusId == 1)
                        {
                            deliveryStatus = "confirm";
                        }
                        else if (Model.DeliveryStatus.DeliveryStatusId == 2)
                        {
                            deliveryStatus = "confirm";
                        }
                        else if (Model.DeliveryStatus.DeliveryStatusId == 3)
                        {
                            deliveryStatus = "deliver";
                        }
                        else if (Model.DeliveryStatus.DeliveryStatusId == 4)
                        {
                            deliveryStatus = "success";
                        }
                        else
                        {
                            deliveryStatus = "failed";
                        }
                    }
                    <span class="status-label @deliveryStatus" id="deliveryStatus">@Model.DeliveryStatus.Status</span>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover e-commerce-table" style="width:100%">
                        <thead style="background:#edf2f9">
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Số lượng</th>
                                <th>Đơn giá</th>
                                <th>Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (orderDetails != null && orderDetails.Count() > 0)
                            {
                                foreach (var item in orderDetails)
                                {
                                    int price = 0;
                                    dem += (int)item.Amount;
                                    string url = $"/{item.Product.Alias}-{item.Product.ProductId}";
                                    <tr>
                                        <td>
                                            <div class="d-flex justify-content-between">
                                                <div class="d-flex" style="max-width:500px">
                                                    <img class="img-fluid rounded" src="@item.Product.Avatar" style="max-width: 60px;border:solid #DDDDDD 1px;" alt="">
                                                    <div style="margin-left:12px"><a target="_blank" href="@url" class="text-dark" style="font-weight:500;">@item.Product.ProductName</a></div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>@item.Amount</td>
                                        <td>
                                            
                                            @if(item.Discount!=0){
                                                if (item.Discount < 100)
                                                {
                                                    price = (int)item.Price - ((int)item.Price * (int)item.Discount / 100);
                                                    <del>@item.Price.Value.ToString("#,##0") VND</del>
                                                    <p>@price.ToString("#,##0") VND</p>
                                                }
                                                else
                                                {
                                                    price = (int)item.Price - (int)item.Discount;
                                                    <del>@item.Price.Value.ToString("#,##0") VND</del>
                                                    <p>@price.ToString("#,##0") VND</p>
                                                }
                                            }
                                            else
                                            {
                                                <p>@item.Price.Value.ToString("#,##0") VND</p>
                                            }
                                            
                                        </td>
                                        <td>
                                            @if(price!=0){
                                                total += (int)price * (int)item.Amount;
                                                @string.Format("{0:#,##0 VND}", (price * item.Amount).Value)
                                            }
                                            else
                                            {
                                                total += (int)item.Price * (int)item.Amount;
                                                @string.Format("{0:#,##0 VND}", (item.Price * item.Amount).Value)                                                
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer check1s">
                <div id="checkedoderload1" class="spinner-border text-primary" VaiTro="status">
                    <span class="sr-only"></span>
                </div>
                @if (Model.DeliveryStatusId == 2)
                {
                    <div class="m-r-10">
                        <i class="anticon anticon-check-o text-success"></i><i>Đơn hàng Đang chờ lấy</i>
                    </div>
                }
                else
                {
                    <div class="checkorderG">
                        @if (Model.Confirmed == false)
                        {
                            <i>Xác nhận đơn hàng trước để tiến hàng đổi trạng thái giao hàng</i>

                        }
                        else
                        {
                            @if (Model.CheckEmail == true)
                            {
                                <input type="checkbox" checked id="check1" />
                                <i>Gửi email cho khách hàng(nút sẽ tự động tích khi khách hàng yêu cầu nhận email)</i>
                            }
                            else
                            {
                                <input type="checkbox" id="check1" />
                                <i>Gửi email cho khách hàng(nút sẽ tự động tích khi khách hàng yêu cầu nhận email)</i>
                            }
                            <a href="javascript:void(0)" onclick="sendEmailOrderTrue(@Model.OrderId, 9)" class="btn btn-primary" style="float:right">
                                Giao hàng
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
        <div class="card">
            <div class="card-header">
                <div class="m-t-10 m-b-10">
                    @{
                        string paymentStatus;
                        if (Model.PaymentStatus.PaymentStatusId == 1)
                        {
                            paymentStatus = "processing";
                        }
                        else if (Model.PaymentStatus.PaymentStatusId == 2)
                        {
                            paymentStatus = "confirm";
                        }
                        else
                        {
                            paymentStatus = "deliver";
                        }
                    }
                    <span class="status-label @paymentStatus" id="paymentStatus">@Model.PaymentStatus.Status</span>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="font-weight-semibold" for="productName">Ghi chú cho đơn hàng</label>

                            @if (Model.Note!=null)
                            {
                                @(new HtmlString(@Model.Note.ToString()))
                            }
                            else
                            {
                                <p>Không có</p>
                            }

                            <textarea type="text" class="form-control" placeholder="Thêm ghi chú"></textarea>
                        </div>
                        <a class="btn" style="float:right">
                            Cập nhật
                        </a>
                    </div>
                    <div class="col-md-6">
                        <div class="table-responsive">
                            <table class="product-info-table">
                                <tbody>
                                    <tr>
                                        <td>Số lượng sản phẩm</td>
                                        <td class="text-right">@dem</td>
                                    </tr>
                                    <tr>
                                        <td>Tổng tiền hàng:</td>
                                        <td class="text-right">@string.Format("{0:#,##0 VND}", Model.TotalMoney)</td>
                                    </tr>
                                    <tr>
                                        <td>Giảm giá:</td>
                                        <td class="text-right">
                                            @{
                                                int t = Model.TotalMoney - total;
                                                
                                                if (Model.Discount != null)
                                                {
                                                    if(Model.Discount>0 && Model.Discount <= 100)
                                                    {
                                                        discount = ((int)Model.TotalMoney * (int)Model.Discount / 100);
                                                    }
                                                    else
                                                    {
                                                        discount = (int)Model.Discount;
                                                    }
                                                }
                                                t = t + discount;
                                            }
                                            @t.ToString("#,##0") VND
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Vận chuyển:</td>
                                        <td class="text-right">0 VND</td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <span class="font-weight-bold">
                                                Tổng giá trị đơn hàng:
                                            </span>
                                        </td>
                                        <td class="text-right">
                                            <span class="text-right font-weight-bold">@string.Format("{0:#,##0 VND}", total - discount)</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Đã thanh toán:</td>
                                        <td class="text-right">VND</td>
                                    </tr>
                                    <tr>
                                        <td>Đã hoàn trả:</td>
                                        <td class="text-right">VND</td>
                                    </tr>
                                    <tr>
                                        <td>Thực nhận:</td>
                                        <td class="text-right">VND</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer" id="check2ss">
                <div id="checkedoderload2" class="spinner-border text-primary" VaiTro="status">
                    <span class="sr-only"></span>
                </div>
                @if (Model.PaymentStatusId == 1)
                {
                    <div id="check2s">
                        @if (Model.CheckEmail == true)
                        {
                            <input type="checkbox" checked id="check2" />
                            <i>Gửi email cho khách hàng(nút sẽ tự động tích khi khách hàng yêu cầu nhận email)</i>
                        }
                        else
                        {
                            <input type="checkbox" id="check2" />
                            <i>Gửi email cho khách hàng(nút sẽ tự động tích khi khách hàng yêu cầu nhận email)</i>
                        } 
                        <a href="javascript:void(0)" onclick="sendEmailOrderTrue(@Model.OrderId, 11)" class="btn btn-primary" style="float:right">
                            Xác nhận thanh toán
                        </a>
                    </div>

                }
                else
                {

                    <i class="anticon anticon-check-o text-success"></i>
                    <i>@Model.PaymentStatus.Status đơn hàng</i>
                }


            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <div class="row justify-content-between">
                    <h4>Xác thực đơn hàng</h4>
                </div>
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center" id="checkedoder">
                    <div id="checkedoderload" class="spinner-border text-primary" VaiTro="status">
                        <span class="sr-only"></span>
                    </div>
                    @if (Model.Confirmed == false)
                    {
                        <button class="btn btn-light" id="checkorder" onclick="sendEmailOrderTrue(@Model.OrderId, 7)"> Xác thực đơn hàng</button>
                    }
                    else
                    {
                        <div class="m-r-10">
                            <i class="anticon anticon-check-o text-success"></i>
                        </div>
                        <i>Đơn hàng đã được xác thực</i>
                    }
                </div>
            </div>
        </div>
        <div class="card">
            <div class="card-header">
                <div class="row justify-content-between">
                    <h4>Thông tin người mua</h4>
                </div>
            </div>
            <div class="card-body">
                @if (Model.CustomerId != null)
                {
                    <a target="_blank" asp-controller="AdminCustomers" asp-action="Details" asp-route-id="@Model.Customer.CustomerId">@Model.Customer.HoTen</a>
                    <p class="m-b-0 text-muted mt-2">@Model.Customer.Email</p>
                    <p class="m-b-0 muted mt-2">@Model.Customer.SoDienThoai</p>
                }
                else if(Model.GuestId !=null)
                {
                    <a href="javascript:void(0)">@Model.Guest.HoTen</a>
                    <p class="m-b-0 text-muted mt-2">@Model.Guest.Email</p>
                    <p class="m-b-0 muted mt-2">@Model.Guest.SoDienThoai</p>
                }
                else{
                    <p class="m-b-0 text-muted mt-2">Chưa có thông tin khách hàng</p>
                }
            </div>
            <div class="card-footer">
                <div class="row justify-content-between">
                    <h4>Thông tin giao hàng</h4>
                </div>
            </div>
            <div class="card-body pt-0">
                @{
                    // loi thanh pho
                    var shippingAddress = ViewBag.DiaChi as ShippingAddress;
                    var strThanhPho = "";
                    var strQuanHuyen = "";
                    var strPhuongXa = "";
                    var Name = "";
                    var SoDienThoai = "";
                    var Address = "";
                    if (shippingAddress != null)
                    {
                        strThanhPho = shippingAddress.Province.ProvinceName;
                        strQuanHuyen = shippingAddress.District.Type + " " + shippingAddress.District.DistrictName;
                        strPhuongXa = shippingAddress.Ward.Type + " " + shippingAddress.Ward.WardName;
                        Name = shippingAddress.Name;
                        SoDienThoai = @shippingAddress.SoDienThoai;
                        Address = shippingAddress.Address;
                    } 
                    <a href="javascript:void(0)">@Name</a>
                    <p class="m-b-0 text-muted mt-2">@SoDienThoai</p>
                    <h5 class="m-b-0 m-t-10">Địa chỉ giao hàng</h5>
                    <p class="m-b-0 mt-2">@Address, @strPhuongXa, @strQuanHuyen, @strThanhPho</p>
                    <hr />
                    <button class="btn btn-primary" data-toggle="modal" data-target="#changeShippingModal">Thay đổi thông tin giao hàng</button>
                    <div class="modal fade" id="changeShippingModal" tabindex="-1" VaiTro="dialog" aria-labelledby="changeShippingModalLabel" aria-hidden="true">
                        <div class="modal-dialog" VaiTro="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="changeShippingModalLabel">Thay đổi thông tin giao hàng</h5>
                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>
                                <div class="modal-body">
                                    <form id="shippingAddressForm" class="form-group">
                                        <div >
                                            <label>Tên người nhận  </label>
                                            <input class="form-control" value="@Name" />
                                        </div>
                                        <div>
                                            <label>Số điện thoại</label>
                                            <input class="form-control" value="@SoDienThoai" />
                                        </div>
                                        <div>
                                            <label>Số điện thoại</label>
                                            <input class="form-control" value="@SoDienThoai" />
                                        </div>
                                    </form>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                                    <button type="button" class="btn btn-primary">Lưu thay đổi</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="card-footer">
                <div class="row justify-content-between">
                    <h4>Ghi chú về khách hàng</h4>
                </div>
            </div>
            <div class="card-body aaa pt-0">
                @if (Model.RedBill != null)
                {
                    <p><b>Yêu cầu xuất hóa đơn</b></p>
                    <p>@Model.RedBill</p>
                }
                @if (Model.NodeCus != null)
                {
                    <p><b>Ghi chú</b></p>
                    @(new HtmlString(@Model.NodeCus.ToString()))
                }
                else
                {
                    <p style="font-style:italic" class="m-b-0 text-muted">Không có ghi chú</p>
                }
            </div>
        </div>
    </div>
</div>
<div id="modal-header" class="modal fade" tabindex="-1" VaiTro="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
        </div>
    </div>
</div>
<div class="page-footer" style="margin-left:8px">
    <a asp-area="Admin" asp-controller="AdminOrders" asp-action="DeleteOrder" asp-route-id="@Model.OrderId" class="btn btn-danger">
       Xóa đơn hàng
    </a>
</div>
@section Scripts {
    @* <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script> *@
    <script>
        $('#modal-header').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget); // Button that triggered the modal
            var url = button.attr("href");
            var modal = $(this);
            // note that this will replace the content of modal-content ever time the modal is opened
            modal.find('.modal-content').load(url);
        });
        function sendEmailOrderTrue(id, id2) {
            if (id2 == 7) {
                $("#checkedoderload").css("display", "block");
                $("#checkorder").css("display", "none");
            }
            if (id2 == 9) {
                $(".checkorderG").css("display", "none");
                $("#checkedoderload1").css("display", "block");
            }
            if (id2 == 11) {
                $("#check2s").css("display", "none");
                $("#checkedoderload2").css("display", "block");
            }
            if (id2 == 9 && $('#check1').is(':checked') || id2 == 11 && $('#check2').is(':checked') || id2 == 7) {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("methodSenmail","AdminOrders")',
                    dataType: "Json",
                    data: {
                        id: id,
                        optonemail: id2
                    },
                    success: function (data) {
                        // xac thuc don hang
                        if (data.success == "Ok" && id2 == 7) {
                            $.ajax({
                                type: 'POST',
                                url: '@Url.Action("updateComfim","AdminOrders")',
                                dataType: "Json",
                                data: {
                                    id: id
                                },
                                success: function (data) {
                                    if (data.success = "Ok") {
                                        $('#checkedoderload').css("display", "none");
                                        $("#checkedoder").html('<div class="m-r-10">'
                                            + '<i class="anticon anticon-check-o text-success"></i></div>'
                                            + '<i> Đơn hàng đã được xác thực </i>');
                                        if ($('#check1').is(':checked')) {
                                            $(".checkorderG").html('<input type="checkbox" checked id="check1"/>'
                                                + '<i> Gửi email cho khách hàng(nút sẽ tự động tích khi khách hàng yêu cầu nhận email) </i>'
                                                + '<a href="javascript:void(0)" onclick="sendEmailOrderTrue(' + id + ', 9)" class="btn btn-primary" style ="float:right">Giao hàng</a>');
                                        }
                                        else {
                                            $(".checkorderG").html('<input type="checkbox" id="check1"/>'
                                                + '<i> Gửi email cho khách hàng(nút sẽ tự động tích khi khách hàng yêu cầu nhận email) </i>'
                                                + '<a href="javascript:void(0)" onclick="sendEmailOrderTrue(' + id + ', 9)" class="btn btn-primary" style ="float:right">Giao hàng</a>');

                                        }

                                    } else {
                                        $('#checkedoderload').css("display", "none");
                                        $("#checkedoder").html('<div class="m-r-10">'
                                            + '<i>Lỗi xác thực đơn hàng</i>');
                                    }
                                }
                            })
                        }
                        // chuyen trạng thái chờ lấy hàng
                        if (data.success == "Ok" && id2 == 9 || id2 == 9) {
                            console.log(id2)
                            $.ajax({
                                type: 'POST',
                                url: '@Url.Action("updateDelivery","AdminOrders")',
                                dataType: "Json",
                                data: {
                                    id: id
                                },
                                success: function (data) {
                                    if (data.success = "Ok") {
                                        $("#checkedoderload1").css("display", "none");
                                        $(".check1s").html('<div class="m-r-10">'
                                            + '<i class="anticon anticon-check-o text-success"></i><i>Đơn hàng đang chờ lấy</i>'
                                            + '</div>');
                                        $("#deliveryStatus").html("Chờ lấy hàng");
                                    }
                                    else if (data.success = "No") {
                                        $(".check1s").html('<div class="m-r-10">'
                                            + '<i>Đơn hàng Không thể đổi trạng thái do gặp lỗi dữ liệu người dùng</i>'
                                            + '</div>');
                                    }
                                    else if (data.success = "No2") {
                                        $(".check1s").html('<div class="m-r-10">'
                                            + '<i>Đã đổi trạng thái vui lòng không lập lại</i>'
                                            + '</div>');
                                    }
                                }
                            })
                        }
                        // chuyen trang thai xac nhan thanh toán

                        if (data.success == "Ok" && id2 == 11) {
                            $.ajax({
                                type: 'POST',
                                url: '@Url.Action("updatePayment","AdminOrders")',
                                dataType: "Json",
                                data: {
                                    id: id
                                },
                                success: function (data) {
                                    if (data.success = "Ok") {
                                        $("#checkedoderload2").css("display", "none");
                                        $("#check2ss").html('<div class="m-r-10">'
                                            + '<i class="anticon anticon-check-o text-success"></i><i>Đã thanh toán đơn hàng</i>'
                                            + '</div>');
                                        $("#paymentStatus").html("Đã thanh toán");
                                    }
                                    else if (data.success = "No") {
                                        $("#check2ss").html('<div class="m-r-10">'
                                            + '<i>Đơn hàng Không thể đổi trạng thái do gặp lỗi dữ liệu người dùng</i>'
                                            + '</div>');
                                    }
                                    else if (data.success = "No2") {
                                        $("#check2ss").html('<div class="m-r-10">'
                                            + '<i>Đã đổi trạng thái vui lòng không lập lại</i>'
                                            + '</div>');
                                    }
                                }
                            })
                        }
                    }
                })
            }
            if (id2 == 9 && $('#check1').is(':checked') == false || id2 == 11 && $('#check2').is(':checked') ==false) {
                if (id2 == 9) {
                    
                    $.ajax({
                        type: 'POST',
                        url: '@Url.Action("updateDelivery","AdminOrders")',
                        dataType: "Json",
                        data: {
                            id: id
                        },
                        success: function (data) {
                            if (data.success = "Ok") {
