                                    + '<i class="anticon anticon-check-o text-success"></i><i>Đơn hàng đang chờ lấy</i>'
                                    + '</div>');
                                $("#deliveryStatus").html("Chờ lấy hàng");
                            }
                            else if (data.success = "No") {
                                $(".check1s").html('<div class="m-r-10">'
                                    + '<i>Đơn hàng Không thể đổi trạng thái do gặp lỗi dữ liệu người dùng</i>'
                                    + '</div>');
                            }
                            else if (data.success = "No2") {
                                $(".check1s").html('<div class="m-r-10">'
                                    + '<i>Đã đổi trạng thái vui lòng không lập lại</i>'
                                    + '</div>');
                            }
                        }
                    })
                }
                // chuyen trang thai xac nhan thanh toán

                if (id2 == 11) {
                    $.ajax({
                        type: 'POST',
                        url: '@Url.Action("updatePayment","AdminOrders")',
                        dataType: "Json",
                        data: {
                            id: id
                        },
                        success: function (data) {
                            if (data.success = "Ok") {
                                $("#checkedoderload2").css("display", "none");
                                $("#check2ss").html('<div class="m-r-10">'
                                    + '<i class="anticon anticon-check-o text-success"></i><i>Đã thanh toán đơn hàng</i>'
                                    + '</div>');
                                $("#paymentStatus").html("Đã thanh toán");
                            }
                            else if (data.success = "No") {
                                $("#check2ss").html('<div class="m-r-10">'
                                    + '<i>Đơn hàng Không thể đổi trạng thái do gặp lỗi dữ liệu người dùng</i>'
                                    + '</div>');
                            }
                            else if (data.success = "No2") {
                                $("#check2ss").html('<div class="m-r-10">'
                                    + '<i>Đã đổi trạng thái vui lòng không lập lại</i>'
                                    + '</div>');
                            }
                        }
                    })


                }

            }
        }
    </script>
