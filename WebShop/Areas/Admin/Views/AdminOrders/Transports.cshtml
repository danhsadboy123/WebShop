@using Microsoft.AspNetCore.Html;
@*@model WebShop.ModelViews.MuaHangVM*@
@{
    ViewData["Title"] = "Vận chuyển";

    //Layout = "~/Views/Shared/_Layout.cshtml";
    //List<WebShop.ModelViews.CartItem> Carts = ViewBag.GioHang;
    //List<DiscountAddProduct> listdiscount = ViewBag.discount;
    //List<GitAttribute> gift = ViewBag.gift;
    //Order orderfull = ViewBag.Orderd;
    //var totalCart = 0;
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
@section Styles{
    <link href="~/Adminassets/vendors/datatables/dataTables.bootstrap.min.css" rel="stylesheet">
    <style>
        
    </style>
}
<div class="container-2023">
    <div class="page-header" style="margin-bottom:24px">
        <div class="header-sub-title">
            <nav class="breadcrumb breadcrumb-dash">
                <a href="/" class="breadcrumb-item"><i class="anticon anticon-home m-r-5"></i>Trang chủ</a>
                <span class="breadcrumb-item active">Vận chuyển</span>
            </nav>
        </div>
    </div>
</div>

<div><button class="btn btn-primary btn-createTran">Tạo đơn hàng</button></div>
 
<div> <h4>Chọn địa chỉ nhận đơn hàng</h4></div>
<div class="form-control d-flex">
    <select class="form-control col-4 select-provineReceive">
        <option value="0" disabled selected>Chọn tỉnh/ thành phố</option>
    </select>
    <select class="form-control col-4 select-dictrictReceive">
        <option value="0" disabled selected>Chọn quận/huyện</option>
    </select>
    <select class="form-control col-4 select-wardReceive">
        <option value="0" disabled selected>Chọn phường/xã</option>
    </select>
</div>
 
<div> <h4>Chọn địa chỉ gửi đơn hàng</h4></div>
<div class="form-control d-flex">
    <select class="form-control col-4 select-provineSend">
        <option value="0" disabled selected>Chọn tỉnh/ thành phố</option>
    </select>
    <select class="form-control col-4 select-dictrictSend">
        <option value="0" disabled selected>Chọn quận/huyện</option>
    </select>
    <select class="form-control col-4 select-wardSend">
        <option value="0" disabled selected>Chọn phường/xã</option>
    </select>
</div>
<div><button class="btn-selectedService btn btn-success">Chọn loại dịch vụ vận chuyển</button></div>
<div class="d-none service">
    <div> <h4>Chọn loại dịch vụ</h4></div>
    <div class="form-control d-flex">
        <select class="form-control col-4 select-service">
            <option value="0" disabled selected>Chọn loại dịch vụ</option>
        </select> 
    </div>
</div>

<div><button class="btn btn-success mt-3 btn-sum" >Tính giá cước vận chuyển</button></div>
<div class="form-group row sum-view d-none">
    <div class="form-control col-3 mt-3  ">
        <label>Giá trị sản phẩm</label>
        <input class="form-control insurance_value" placeholder="Giá trị sản phẩm" />
    </div>
    <div class="form-control col-3 mt-3">
        <label>Mã giảm giá GHN</label>
        <input class="form-control coupon_value" placeholder="Nhập mã giảm giá" />
    </div>
    <div class="form-control col-3 mt-3">
        <label>Trọng lượng hàng hóa</label>
        <input class="form-control weight_value" placeholder="Trọng lượng hàng hóa" />
    </div>
    <div class="form-control col-3 mt-3  ">
        <label>Chiều dài hàng hóa</label>
        <input class="form-control length_value" placeholder="Chiều dài hàng hóa" />
    </div>
    <div class="form-control col-3 mt-3 ">
        <label>Chiều rộng hàng hóa</label>
        <input class="form-control width_value" placeholder="Chiều rộng hàng hóa" />
    </div>
    <div class="form-control col-3 mt-3 ">
        <label> Chiều cao hàng hóa</label>
        <input class="form-control height_value" placeholder=" Chiều cao hàng hóa" />
    </div>
    <button class="btn-total">Tính</button>
</div>
  
@section Scripts{
    <script src="~/Adminassets/vendors/datatables/jquery.dataTables.min.js"></script>
    <script src="~/Adminassets/vendors/datatables/dataTables.bootstrap.min.js"></script>
    <script>
        var table = $('#data-table').DataTable({
            dom: 'Bfrtip',
            buttons: [
                'excel'
            ],
            scrollX: true,
            order: [[0, 'asc']],
            language: {
                search: "Tìm kiếm",
                lengthMenu: "Hiển thị _MENU_",
                zeroRecords: "Không tìm thấy",
                info: "Hiển thị _START_ đến _END_ trong _TOTAL_ đơn hàng",
                infoEmpty: "",
                loadingRecords: "Loading...",
                infoFiltered: "",
                paginate: {
                    "previous": "Trước",
                    "next": "Sau"
                }
            },

        });
        $(document).ready(function () {
            $.ajax({
                url: 'https://online-gateway.ghn.vn/shiip/public-api/master-data/province',
                type: 'GET',
                contentType: 'application/json',
                headers: {
                    'Token': 'edf6e98d-092f-11ef-ab6e-ca4647523841'
                },
                success: function (response) {
                    var provinces = response.data;
                    
                    provinces.forEach(function (province) {
                        var option = $('<option></option>').text(province.ProvinceName).val(province.ProvinceID);
                        $('.select-provineReceive').append(option);
                    });     
                 

                },
                error: function (xhr, status, error) {
                    console.error('Đã xảy ra lỗi khi gửi yêu cầu:', error);
                     
                }
            });
            //send
            $.ajax({
                url: 'https://online-gateway.ghn.vn/shiip/public-api/master-data/province',
                type: 'GET',
                contentType: 'application/json',
                headers: {
                    'Token': 'edf6e98d-092f-11ef-ab6e-ca4647523841'
                },
                success: function (response) {
                    var provinces = response.data; 
                    provinces.forEach(function (province) {
                        var option = $('<option></option>').text(province.ProvinceName).val(province.ProvinceID);
                        $('.select-provineSend').append(option);
                    }); 
                },
                error: function (xhr, status, error) {
                    console.error('Đã xảy ra lỗi khi gửi yêu cầu:', error);

                }
            });

        });

        $('.select-provineReceive').on('change', function () {
            var selectedProvinceCode = $(this).val();
            $.ajax({
                url: 'https://online-gateway.ghn.vn/shiip/public-api/master-data/district?province_id=' + selectedProvinceCode,
                type: 'GET',
                contentType: 'application/json',
                headers: {
                    'Token': 'edf6e98d-092f-11ef-ab6e-ca4647523841'
                },
                success: function (response) {
                    var dictrict = response.data;
                    //console.log(dictrict);
                    $('.select-dictrictReceive').empty();
                    var defaultOption = $('<option></option>').text('Chọn quận/huyện').attr('disabled', true).attr('selected', true);
                    $('.select-dictrictReceive').append(defaultOption);
                    dictrict.forEach(function (dictrict) {
                        var option = $('<option></option>').text(dictrict.DistrictName).val(dictrict.DistrictID);
                        $('.select-dictrictReceive').append(option);
                    });
                },
                error: function (xhr, status, error) {
                    console.error('Đã xảy ra lỗi khi gửi yêu cầu:', error);
                }
            });
        });

        $('.select-dictrictReceive').on('change', function () {
            var selectedDictrictCode = $(this).val();
            $.ajax({
                url: 'https://online-gateway.ghn.vn/shiip/public-api/master-data/ward?district_id=' + selectedDictrictCode,
                type: 'GET',
                contentType: 'application/json',
                headers: {
                    'Token': 'edf6e98d-092f-11ef-ab6e-ca4647523841'
                },
                success: function (response) {
                    var ward = response.data;
                    $('.select-wardReceive').empty();
                    var defaultOption = $('<option></option>').text('Chọn phường/xã').attr('disabled', true).attr('selected', true);
                    $('.select-wardReceive').append(defaultOption);
                    ward.forEach(function (ward) {
                        var option = $('<option></option>').text(ward.WardName).val(ward.WardCode);
                        $('.select-wardReceive').append(option);
                    });
                    //console.log(ward);
                },
                error: function (xhr, status, error) {
                    console.error('Đã xảy ra lỗi khi gửi yêu cầu:', error);
                }
            });
        });

        //send
        $('.select-provineSend').on('change', function () {
            var selectedProvinceCode = $(this).val();
            $.ajax({
                url: 'https://online-gateway.ghn.vn/shiip/public-api/master-data/district?province_id=' + selectedProvinceCode,
                type: 'GET',
                contentType: 'application/json',
                headers: {
                    'Token': 'edf6e98d-092f-11ef-ab6e-ca4647523841'
                },
                success: function (response) {
                    var dictrict = response.data;
                    //console.log(dictrict);
                    $('.select-dictrictSend').empty();
                    var defaultOption = $('<option></option>').text('Chọn quận/huyện').attr('disabled', true).attr('selected', true);
                    $('.select-dictrictSend').append(defaultOption);
                    dictrict.forEach(function (dictrict) {
                        var option = $('<option></option>').text(dictrict.DistrictName).val(dictrict.DistrictID);
                        $('.select-dictrictSend').append(option);
                    });
                },
                error: function (xhr, status, error) {
                    console.error('Đã xảy ra lỗi khi gửi yêu cầu:', error);
                }
            });
        });
        $('.select-dictrictSend').on('change', function () {
            var selectedDictrictCode = $(this).val();
            $.ajax({
                url: 'https://online-gateway.ghn.vn/shiip/public-api/master-data/ward?district_id=' + selectedDictrictCode,
                type: 'GET',
                contentType: 'application/json',
                headers: {
                    'Token': 'edf6e98d-092f-11ef-ab6e-ca4647523841'
                },
                success: function (response) {
                    var ward = response.data;
                    //console.log(ward);
                    $('.select-wardSend').empty();
                    var defaultOption = $('<option></option>').text('Chọn phường/xã').attr('disabled', true).attr('selected', true);
                    $('.select-wardSend').append(defaultOption);
                    ward.forEach(function (ward) {
                        var option = $('<option></option>').text(ward.WardName).val(ward.WardCode);
                        $('.select-wardSend').append(option);
                    });
                    //console.log(ward);
                },
                error: function (xhr, status, error) {
                    console.error('Đã xảy ra lỗi khi gửi yêu cầu:', error);
                }
            });
        });

        $('.btn-selectedService').on('click', function () {
            var selectdictrictReceive = $('.select-dictrictReceive').val();
            var selectdictrictSend = $('.select-dictrictSend').val();
            var shopId = 5048033;
            if (selectdictrictReceive != null && selectdictrictSend != null) {
                $('.service').removeClass('d-none');
                $('.service').addClass('d-block'); 
                $.ajax({
                    url: 'https://online-gateway.ghn.vn/shiip/public-api/v2/shipping-order/available-services',
                    type: 'GET',
                    contentType: 'application/json',
                    headers: {
                        'Token': 'edf6e98d-092f-11ef-ab6e-ca4647523841'
                    },
                    data: { shop_id: shopId, from_district: selectdictrictReceive, to_district: selectdictrictSend },
                    success: function (response) {
                        //console.log(response.data);
                        response.data.forEach(function (ser) {
                            var option = $('<option></option>').text(ser.short_name).val(ser.service_id);
                            $('.select-service').append(option);
                        });
                    },
                    error: function (xhr, status, error) {
                        console.error('Đã xảy ra lỗi khi gửi yêu cầu:', error);
                    }
                });
            }
            else{
                alert('Vui lòng chọn địa chỉ gửi và nhận hàng trước khi chọn dịch vụ vận chuyển');
            } 
        });

        $('.btn-sum').on('click',function(){
            var idService = parseInt($('.select-service').val());
            var to_district_id = parseInt($('.select-dictrictReceive').val());// Quận / Huyện người nhận
            var to_ward_code = $('.select-wardReceive').val();//Phường/ Xã người nhận
            var from_district_id = parseInt($('.select-dictrictReceive').val());  //Quận/Huyện người gửi
            //console.log(idService, to_district_id, to_ward_code, to_ward_code);
            if (idService != null && to_district_id != null && to_ward_code != null && to_ward_code != null) {
                $('.sum-view').removeClass('d-none');
                $('.btn-total').on('click',function(){
                    var giatrihang = parseInt($('.insurance_value').val());
                    var coupon = $('.coupon_value').val();
                    var weight = parseInt($('.weight_value').val());
                    var length = parseInt($('.length_value').val());
                    var height = parseInt($('.height_value').val());
                    var width = parseInt($('.width_value').val());
                     
                    $.ajax({
                        url: 'https://online-gateway.ghn.vn/shiip/public-api/v2/shipping-order/fee',
                        type: 'GET',
                        contentType: 'application/json',
                        headers: {
                            'Token': 'edf6e98d-092f-11ef-ab6e-ca4647523841',
                            'shop_id': 5048033
                        },
                        data: {
                            service_id: idService,
                            insurance_value: giatrihang,
                            coupon: null,
                            from_district_id: from_district_id,
                            to_district_id: to_district_id,
                            to_ward_code: to_ward_code,
                            height: height,
                            length: length,
                            weight: weight,
                            width: width
                        },
                        success: function (response) {
                            console.log(response);
                            // Xử lý dữ liệu phản hồi nếu cần
                        },
                        error: function (xhr, status, error) {
                            console.error('Đã xảy ra lỗi khi gửi yêu cầu:', error);
                            // Xử lý lỗi nếu cần
                        }
                    });

                });
               
            }
            else
            {
                alert('Vui lòng chọn đầy đủ thông tin ');
            }
        });

    </script>
}