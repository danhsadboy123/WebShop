@model WebShop.Models.Customer
<div class="card-body">
    <a target="_blank" asp-controller="AdminCustomers" asp-action="Details" asp-route-id="@Model.CustomerId">@Model.HoTen</a>
    <a style="float:right" class="btn" id="cancelBtn" onclick="onCancel()">
        X
    </a>
    <p class="m-b-0 text-muted mt-2">@Model.Email</p>
    <p class="m-b-0 muted mt-2">@Model.SoDienThoai</p>
    @if (Model.CompanyName != null)
    {
        <p class="m-b-0 muted mt-2">@Model.CompanyName</p>
    }
</div>
<div class="card-footer">
    <div class="row justify-content-between">
        <h4>Thông tin giao hàng</h4>
    </div>
</div>
<div class="card-body pt-0">
    @if (ViewBag.Address != null)
    {
        var shippingAddress = ViewBag.Address as AccountAddress;
        var strThanhPho = shippingAddress.Province.ProvinceName;
        var strQuanHuyen = shippingAddress.District.Type + " " + shippingAddress.District.DistrictName;
        var strPhuongXa = shippingAddress.Ward.Type + " " + shippingAddress.Ward.WardName;
        <a href="javascript:void(0)">@shippingAddress.UserName</a>
        <p class="m-b-0 text-muted mt-2">@shippingAddress.SoDienThoai</p>
        <h5 class="m-b-0 m-t-10">Địa chỉ giao hàng</h5>
        <p class="m-b-0 mt-2">@shippingAddress.Content, @strPhuongXa, @strQuanHuyen, @strThanhPho</p>
    }
    @{
        <p class="m-b-0 mt-2">Khách hàng chưa có địa chỉ</p>
    }
</div>
<div class="card-footer">
    <div class="row justify-content-between">
        <h4>Ghi chú về khách hàng</h4>
    </div>
</div>
<div class="card-body pt-0">
    @if (Model.Note != null)
    {
        <p class="m-b-0 mt-2">@Model.Note</p>
    }
    else
    {
        <p style="font-style:italic" class="m-b-0 text-muted">Không có ghi chú</p>
    }
</div>
