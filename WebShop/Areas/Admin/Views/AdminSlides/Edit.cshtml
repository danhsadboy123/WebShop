@model WebShop.Models.Slide

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <div class="header-sub-title">
        <nav class="breadcrumb breadcrumb-dash">
            <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="breadcrumb-item"><i class="anticon anticon-home m-r-5"></i>Trang chủ</a>
            <a asp-area="Admin" asp-controller="AdminSlides" asp-action="Index" class="breadcrumb-item">Danh sách slide</a>
            <span class="breadcrumb-item IsActivated">@Model.SlideName</span>
        </nav>
    </div>
</div>
<div>
    <form asp-controller="AdminSlides" asp-action="Edit" asp-route-id="@Model.SlideId" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="SlideId" />
        <input type="hidden" asp-for="Thumb" />
        <div class="page-header no-gutters has-tab">
            <div class="d-md-flex m-b-15 align-items-center justify-content-between">
                <div class="media align-items-center m-b-15">
                    <div class="avatar avatar-image rounded" style="height:80px; width:200px">
                        <img src="~/images/slides/@Model.Thumb" alt="@Model.Thumb" />
                    </div>
                    <div class="m-l-15">
                        <h4 class="m-b-0">@Model.SlideName</h4>
                        <p class="text-muted m-b-0">ID: #@Model.SlideId</p>
                        <div class="form-group">
                            <input name="fThumb" type="file" class="form-control-file" asp-for="Thumb" />
                            <span asp-validation-for="Thumb" class="text-danger"></span>
                        </div>
                    </div>
                    
                </div>
                <div class="media align-items-center m-b-15">
                    <a asp-area="Admin" asp-controller="AdminSlides" asp-action="Index" class="btn btn-warning m-r-5">
                        <span>Đóng</span>
                    </a>
                    <div class="form-group">
                        <button type="submit" value="Save" class="btn btn-primary">Lưu chỉnh sửa</button>
                    </div>
                </div>
               
            </div>
        </div>
        <div class="card">
        <div class="card-body">
                
                <div class="row">
                    <div class="form-group col-md-6">
                        <div class="form-group">
                            <label asp-for="SlideName" class="control-label">Tên slide</label>
                            <input asp-for="SlideName" class="form-control" />
                            <span asp-validation-for="SlideName" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Alias" class="control-label">Liên kết</label>
                            <input asp-for="Alias" class="form-control" />
                            <span asp-validation-for="Alias" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label class="font-weight-semibold" for="productCategory">Danh mục</label>
                            <select class="custom-select" asp-for="CatId" style="min-width: 200px;" asp-items="ViewBag.DanhMuc">
                                <option value="" selected>Chọn danh mục</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group col-md-6">
                        
                        <div class="form-group d-flex align-items-center">
                            <div class="switch m-r-10">
                                <input type="checkbox" asp-for="IsActivated">
                                <label for="IsActivated"></label>
                            </div>
                            <label>Công khai</label>
                        </div>
                        <div class="form-group d-flex align-items-center">
                            <div class="switch m-r-10">
                                <input type="checkbox" asp-for="HomeFlag">
                                <label for="HomeFlag"></label>
                            </div>
                            <label>Đặt làm banner cho trang chủ</label>
                        </div>
                        <div class="form-group d-flex align-items-center">
                            <div class="switch m-r-10">
                                <input type="checkbox" asp-for="Bottom">
                                <label for="Bottom"></label>
                            </div>
                            <label>Banner bên dưới</label>
                        </div>
                        <div class="form-group d-flex align-items-center">
                            <div class="switch m-r-10">
                                <input type="checkbox" asp-for="Right">
                                <label for="Right"></label>
                            </div>
                            <label>Banner bên phải</label>
                        </div>                     
                    </div>
                </div>
        </div>
    </div>
    </form>
</div>



