@model IEnumerable<WebShop.Models.Slide>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <div class="header-sub-title">
        <nav class="breadcrumb breadcrumb-dash">
            <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="breadcrumb-item"><i class="anticon anticon-home m-r-5"></i>Trang chủ</a>
            <span class="breadcrumb-item IsActivated">Danh sách Slide</span>
        </nav>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="row m-b-30">
            <div class="col-lg-8">
                <a class="btn btn-primary" asp-area="Admin" asp-controller="AdminSlides" asp-action="Create"><i class="anticon anticon-plus m-r-5"></i><span>Tạo mới Slide</span></a>
            </div>
            <div class="col-lg-4 text-right">
            </div>
        </div>
        <div class="row m-b-30">
            <div class="col-lg-12">
                <div class="d-md-flex">
                    <div class="m-b-10">
                        <select class="custom-select" id="idstatus" name="idstatus" style="min-width: 200px;" asp-items="ViewBag.lsTrangThai">
                            <option value="" disabled selected>Chọn trạng thái</option>
                            <option value="1">Công khai</option>
                            <option value="0">Ẩn</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>


        <div class="table-responsive">
            <table class="table table-hover e-commerce-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Hình ảnh</th>
                        <th>Tiêu Đề</th>
                        <th>Đường Dẫn</th>
                        <th>Trạng thái</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @item.SlideId
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img class="img-fluid rounded" src="~/images/slides/@item.Thumb" style="width: 200px;height:80px" alt="">
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <h6 class="m-b-0 m-l-10">@item.SlideName</h6>
                                    </div>
                                </td>
                                
                                <td>@item.Alias</td>
                                <td>
                                    @if (item.IsActivated)
                                    {
                                        <div class="d-flex align-items-center">
                                            <div class="badge badge-success badge-dot m-r-10"></div>
                                            <div>Công khai</div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center">
                                            <div class="badge badge-danger badge-dot m-r-10"></div>
                                            <div>Ẩn</div>
                                        </div>
                                    }
                                </td>
                                <td>
                                    @*<a class="btn btn-primary btn-tone m-r-5" asp-area="Admin" asp-controller="AdminSlides" asp-action="Details" asp-route-id="@item.SlideId">Chi tiết</a>*@
                                    <a class="btn btn-secondary btn-tone m-r-5" asp-area="Admin" asp-controller="AdminSlides" asp-action="Edit" asp-route-id="@item.SlideId">Sửa</a>
                                    <a class="btn btn-success btn-tone m-r-5" asp-area="Admin" asp-controller="AdminSlides" asp-action="Delete" asp-route-id="@item.SlideId">Xóa</a>

                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>