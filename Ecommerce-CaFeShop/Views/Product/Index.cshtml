@model Ecommerce_CaFeShop.Models.ViewModels.PagedProductListVM
@using System.Globalization
@{
    ViewData["Title"] = "Sản phẩm";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sản Phẩm</title>
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastify-js/1.12.0/toastify.min.css">
    <style>
        /* Breadcrumb */
        .breadcrumb-section {
            background: linear-gradient(135deg, #f6e9d9 0%, #d4a373 100%);
            padding: 3rem 0;
        }

            .breadcrumb-section .container {
                max-width: 1200px;
                margin-left: auto;
                margin-right: auto;
                padding-left: 1rem;
                padding-right: 1rem;
            }

            .breadcrumb-section h3 {
                font-size: 1.875rem;
                font-weight: 700;
                color: #1f2937;
                margin-bottom: 0.5rem;
            }

            .breadcrumb-section nav ul {
                display: flex;
                space-x-2;
                font-size: 0.875rem;
                color: #4b5563;
            }

            .breadcrumb-section nav a {
                color: #4b5563;
                text-decoration: none;
            }

                .breadcrumb-section nav a:hover {
                    color: #d4a373;
                }

        /* Shop Section */
        .shop-section {
            padding: 3rem 0;
        }

            .shop-section .container {
                max-width: 1200px;
                margin-left: auto;
                margin-right: auto;
                padding-left: 1rem;
                padding-right: 1rem;
            }

            .shop-section .flex {
                display: flex;
                flex-direction: column-reverse;
            }

        @@media (min-width: 1024px) {
            .shop-section .flex {
                flex-direction: row;
                gap: 2rem;
            }
        }

        .shop-section .lg-w-1\/4 {
            width: 25%;
        }

        .shop-section .lg-w-3\/4 {
            width: 75%;
        }

        /* Sidebar */
        .bg-white {
            background-color: #ffffff;
        }

        .p-6 {
            padding: 1.5rem;
        }

        .rounded-lg {
            border-radius: 0.5rem;
        }

        .shadow-md {
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .mb-6 {
            margin-bottom: 1.5rem;
        }

        .text-lg {
            font-size: 1.125rem;
        }

        .font-semibold {
            font-weight: 600;
        }

        .mb-4 {
            margin-bottom: 1rem;
        }

        .flex {
            display: flex;
        }

        .items-center {
            align-items: center;
        }

        .w-full {
            width: 100%;
        }

        .p-2 {
            padding: 0.5rem;
        }

        .border {
            border: 1px solid #e5e7eb;
        }

        .rounded-l-md {
            border-top-left-radius: 0.375rem;
            border-bottom-left-radius: 0.375rem;
        }

        .product-card img {
            width: 100%;
            height: 250px;
            object-fit: cover;
            border-radius: 0.375rem;
        }

        .rounded-r-md {
            border-top-right-radius: 0.375rem;
            border-bottom-right-radius: 0.375rem;
        }

        .focus\:outline-none:focus {
            outline: none;
        }

        .focus\:ring-2:focus {
            --tw-ring-offset-shadow: var(--tw-ring-inset) 0 0 0 var(--tw-ring-offset-width) var(--tw-ring-offset-color);
            --tw-ring-shadow: var(--tw-ring-inset) 0 0 0 calc(2px + var(--tw-ring-offset-width)) var(--tw-ring-color);
            box-shadow: var(--tw-ring-offset-shadow), var(--tw-ring-shadow), var(--tw-ring-offset-shadow);
        }

        .focus\:ring-[#d4a373]:focus {
            --tw-ring-color: #d4a373;
        }

        .hover\:bg-[#b38b59]:hover {
            background-color: #b38b59;
        }

        /* Product Card */
        .product-card {
            background-color: #ffffff;
            padding: 1.5rem;
            border-radius: 0.5rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            display: flex;
            flex-direction: column;
        }

        @@media (min-width: 768px) {
            .product-card {
                flex-direction: row;
            }
        }

        .product-card a {
            display: block;
        }

        .product-card img {
            width: 100%;
            height: 12rem;
            object-fit: cover;
            border-radius: 0.375rem;
        }

        @@media (min-width: 768px) {
            .product-card img {
                width: 16rem;
                object-fit: contain;
            }
        }

        .md\:ml-6 {
            margin-left: 1.5rem;
        }

        .mt-4 {
            margin-top: 1rem;
        }

        .md\:mt-0 {
            margin-top: 0;
        }

        .flex-1 {
            flex: 1;
        }

        .text-xl {
            font-size: 1.25rem;
        }

        .hover\:text-[#d4a373]:hover {
            color: #d4a373;
        }

        .my-2 {
            margin-top: 0.5rem;
            margin-bottom: 0.5rem;
        }

        .star-rating {
            display: flex;
            space-x-1;
        }

            .star-rating .fas, .star-rating .fa-star-half-alt {
                color: #e4b95b;
            }

            .star-rating .far {
                color: #d1d5db;
            }

        .text-lg {
            font-size: 1.125rem;
        }

        .font-bold {
            font-weight: 700;
        }

        .text-[#d4a373] {
            color: #d4a373;
        }

        .mt-2 {
            margin-top: 0.5rem;
        }

        .text-gray-600 {
            color: #4b5563;
        }

        .py-2 {
            padding-top: 0.5rem;
            padding-bottom: 0.5rem;
        }

        .px-4 {
            padding-left: 1rem;
            padding-right: 1rem;
        }

        .mt-4 {
            margin-top: 1rem;
        }

        .rounded-md {
            border-radius: 0.375rem;
        }

        .btn-golden {
            background: #d4a373;
            color: #fff;
            transition: background 0.3s ease;
        }

            .btn-golden:hover {
                background: #b38b59;
            }

        /* Slider */
        .ui-slider {
            background: #e5e7eb;
            border: none;
            height: 8px;
            border-radius: 4px;
        }

        .ui-slider-range {
            background: #d4a373;
        }

        .ui-slider-handle {
            background: #ffffff;
            border: 2px solid #d4a373;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            top: -6px;
        }

        /* Pagination */
        .mt-8 {
            margin-top: 2rem;
        }

        .justify-center {
            justify-content: center;
        }

        .space-x-2 > :not([hidden]) ~ :not([hidden]) {
            margin-left: 0.5rem;
        }

        .px-3 {
            padding-left: 0.75rem;
            padding-right: 0.75rem;
        }

        .py-1 {
            padding-top: 0.25rem;
            padding-bottom: 0.25rem;
        }

        .bg-gray-200 {
            background-color: #e5e7eb;
        }

        .rounded {
            border-radius: 0.25rem;
        }

        .hover\:bg-[#d4a373]:hover {
            background-color: #d4a373;
        }

        .hover\:text-white:hover {
            color: #ffffff;
        }

        .bg-[#d4a373] {
            background-color: #d4a373;
        }

        /* Responsive */
        @@media (max-width: 1024px) {
            .lg-w-1\/4, .lg-w-3\/4 {
                width: 100%;
            }
        }

        @@media (max-width: 768px) {
            .product-card img {
                height: 10rem;
            }

            .text-xl {
                font-size: 1.125rem;
            }

            .text-lg {
                font-size: 1rem;
            }
        }</style>
</head>
<body class="bg-gray-100 font-sans">
    <!-- Breadcrumb Section -->
    <div class="breadcrumb-section">
        <div class="container">
            <div class="row">
                <div>
                    <h3 class="text-3xl font-bold text-gray-800 mb-2">Sản Phẩm</h3>
                    <nav aria-label="breadcrumb">
                        <ul class="flex space-x-2 text-sm text-gray-600">
                            <li><a asp-controller="Home" asp-action="Index" class="hover:text-[#d4a373]">Trang Chủ</a></li>
                            <li class="text-gray-800">/ Sản Phẩm</li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>

    <!-- Shop Section -->
    <div class="shop-section">
        <div class="container">
            <div class="flex flex-col-reverse lg:flex-row gap-8">
                <!-- Sidebar -->
                <div class="lg-w-1/4">
                    <form method="get" asp-controller="Product" asp-action="Index">
                        <!-- Search -->
                        <div class="bg-white p-6 rounded-lg shadow-md mb-6">
                            <h6 class="text-lg font-semibold mb-4">Tìm kiếm</h6>
                            <div class="flex items-center">
                                <input type="search" name="search" placeholder="Tìm kiếm..." class="w-full p-2 border rounded-l-md focus:outline-none focus:ring-2 focus:ring-[#d4a373]">
                                <button type="submit" class="p-2 bg-[#d4a373] text-white rounded-r-md hover:bg-[#b38b59]">
                                    <i class="fas fa-search"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Brand and Category Components -->
                        @await Component.InvokeAsync("MenuBrand")
                        @await Component.InvokeAsync("MenuCategory")

                        <!-- Price Filter -->
                        <div class="bg-white p-6 rounded-lg shadow-md mb-6">
                            <h6 class="text-lg font-semibold mb-4">Lọc theo giá</h6>
                            <div id="slider-range" class="mb-4"></div>
                            <div class="flex items-center justify-between">
                                <label for="amount" class="text-sm">Price range:</label>
                                <input type="text" id="amount" readonly class="border-none bg-transparent text-sm">
                            </div>
                        </div>
                        <button type="submit" id="filter-button" class="w-full btn-golden py-2 rounded-md">Lọc theo giá</button>
                    </form>
                </div>

                <!-- Product List -->
                <div class="lg-w-3/4">
                    <div class="grid grid-cols-1 gap-6">
                        @foreach (var item in Model.SanPhams)
                        {
                            <div class="product-card bg-white p-6 rounded-lg shadow-md flex flex-col md:flex-row" style="border:1px solid #ddd">
                                <a asp-controller="Product" asp-action="ProductDetail" asp-route-slug="@item.Slug" class="block">
                                    <img src="@Url.Content(item.Image)" alt="@item.ProductName" class="w-full md:w-64 h-48 object-cover rounded-md" onerror="this.src='/images/default-image.jpg';">
                                </a>
                                <div class="md:ml-6 mt-4 md:mt-0 flex-1">
                                    <h5 class="text-xl font-semibold">
                                        <a asp-controller="Product" asp-action="ProductDetail" asp-route-slug="@item.Slug" class="hover:text-[#d4a373]">@item.ProductName</a>
                                    </h5>
                                    <div class="price-section">
                                        @if (item.DiscountPrice.HasValue && item.DiscountPrice.Value > 0 && item.DiscountPrice.Value < item.Price)
                                        {
                                            <span class="text-lg font-bold text-[#d4a373]">@String.Format(new CultureInfo("vi-VN"), "{0:C}", item.DiscountPrice)</span>
                                            <span class="text-sm line-through text-gray-500 ml-2" style="text-decoration:line-through;color:red">@String.Format(new CultureInfo("vi-VN"), "{0:C}", item.Price)</span>
                                            <span class="bg-red-500 text-white text-xs px-2 py-1 rounded-full ml-2" style="color:red!important">-@item.DiscountPercent%</span>
                                        }
                                        else
                                        {
                                            <span class="text-lg font-bold text-[#d4a373]">@String.Format(new CultureInfo("vi-VN"), "{0:C}", item.Price)</span>
                                        }
                                    </div>
                                    <p class="text-gray-600 mt-2">@item.ShortDescription</p>
                                    <button class="add-to-cart btn-golden py-2 px-4 mt-4 rounded-md" data-slug="@item.Slug" data-quantity="1">Thêm vào giỏ</button>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Pagination -->
                    <div class="mt-8 flex justify-center">
                        <ul class="flex space-x-2">
                            @if (Model.CurrentPage > 1)
                            {
                                <li><a href="@Url.Action("Index", new { page = Model.CurrentPage - 1 })" class="px-3 py-1 bg-gray-200 rounded hover:bg-[#d4a373] hover:text-white">« Trước</a></li>
                            }
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="@(i == Model.CurrentPage ? "bg-[#d4a373] text-white" : "bg-gray-200")">
                                    <a href="@Url.Action("Index", new { page = i })" class="px-3 py-1 rounded hover:bg-[#d4a373] hover:text-white">@i</a>
                                </li>
                            }
                            @if (Model.CurrentPage < Model.TotalPages)
                            {
                                <li><a href="@Url.Action("Index", new { page = Model.CurrentPage + 1 })" class="px-3 py-1 bg-gray-200 rounded hover:bg-[#d4a373] hover:text-white">Sau »</a></li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/toastify-js/1.12.0/toastify.min.js"></script>
        <script>
            $(function() {
                var minPrice = 0;
                var maxPrice = 100000000;
                $("#slider-range").slider({
                    range: true,
                    min: minPrice,
                    max: maxPrice,
                    values: [minPrice, maxPrice],
                    slide: function(event, ui) {
                        $("#amount").val(ui.values[0].toLocaleString('vi-VN') + "₫ - " + ui.values[1].toLocaleString('vi-VN') + "₫");
                    }
                });
                $("#amount").val(
                    $("#slider-range").slider("values", 0).toLocaleString('vi-VN') + "₫ - " +
                    $("#slider-range").slider("values", 1).toLocaleString('vi-VN') + "₫"
                );

                $("#filter-button").on("click", function() {
                    var values = $("#amount").val().split(" - ");
                    var minVal = parseInt(values[0].replace(/[^0-9]/g, ''));
                    var maxVal = parseInt(values[1].replace(/[^0-9]/g, ''));
                    $('form').append($('<input>').attr({
                        type: 'hidden',
                        name: 'minPrice',
                        value: minVal
                    }));
                    $('form').append($('<input>').attr({
                        type: 'hidden',
                        name: 'maxPrice',
                        value: maxVal
                    }));
                    $('form').submit();
                });


            });
        </script>
    }
</body>
</html>