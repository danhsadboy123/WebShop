@model Ecommerce_CaFeShop.Models.ViewModels.SendMailVM
@{
    ViewData["Title"] = "Gửi Email";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="card-title mb-0">
                        <i class="fas fa-envelope"></i>
                        Gửi Email
                    </h4>
                </div>
                <div class="card-body">
                    @if (TempData["success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle"></i>
                            @TempData["success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-triangle"></i>
                            @TempData["error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="SendMail" method="post" id="mailForm">
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <div class="col-md-8">
                                <div class="mb-3">
                                    <label asp-for="ToEmail" class="form-label">
                                        <i class="fas fa-user"></i> @Html.DisplayNameFor(m => m.ToEmail) <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="ToEmail" class="form-control" placeholder="example@email.com" />
                                    <span asp-validation-for="ToEmail" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="ToName" class="form-label">
                                        <i class="fas fa-signature"></i> @Html.DisplayNameFor(m => m.ToName)
                                    </label>
                                    <input asp-for="ToName" class="form-control" placeholder="Tên người nhận" />
                                    <span asp-validation-for="ToName" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                           @*  <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="CcEmail" class="form-label">
                                        <i class="fas fa-copy"></i> @Html.DisplayNameFor(m => m.CcEmail)
                                    </label>
                                    <input asp-for="CcEmail" class="form-control" placeholder="cc@email.com" />
                                    <span asp-validation-for="CcEmail" class="text-danger"></span>
                                </div>
                            </div> *@
                            @* <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="BccEmail" class="form-label">
                                        <i class="fas fa-eye-slash"></i> @Html.DisplayNameFor(m => m.BccEmail)
                                    </label>
                                    <input asp-for="BccEmail" class="form-control" placeholder="bcc@email.com" />
                                    <span asp-validation-for="BccEmail" class="text-danger"></span>
                                </div>
                            </div> *@
                        </div>

                        <div class="mb-3">
                            <label asp-for="Subject" class="form-label">
                                <i class="fas fa-heading"></i> @Html.DisplayNameFor(m => m.Subject) <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Subject" class="form-control" placeholder="Tiêu đề email" />
                            <span asp-validation-for="Subject" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input asp-for="IsHtml" class="form-check-input" type="checkbox" />
                                <label asp-for="IsHtml" class="form-check-label">
                                    <i class="fas fa-code"></i> @Html.DisplayNameFor(m => m.IsHtml)
                                </label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Body" class="form-label">
                                <i class="fas fa-edit"></i> @Html.DisplayNameFor(m => m.Body) <span class="text-danger">*</span>
                            </label>
                            <textarea asp-for="Body" class="form-control" rows="10" placeholder="Nhập nội dung email..."></textarea>
                            <span asp-validation-for="Body" class="text-danger"></span>
                            <div class="form-text">
                                <small>Nếu chọn "Gửi dưới dạng HTML", bạn có thể sử dụng các thẻ HTML như &lt;strong&gt;, &lt;em&gt;, &lt;br&gt;, etc.</small>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button type="button" class="btn btn-secondary me-md-2" onclick="clearForm()">
                                <i class="fas fa-eraser"></i> Xóa form
                            </button>
                            <button type="submit" class="btn btn-primary" id="sendBtn">
                                <i class="fas fa-paper-plane"></i> Gửi Email
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Email Templates -->
            <div class="card mt-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-templates"></i> Mẫu Email Có Sẵn
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <button type="button" class="btn btn-outline-info w-100 mb-2" onclick="loadTemplate('welcome')">
                                <i class="fas fa-handshake"></i> Chào mừng khách hàng
                            </button>
                        </div>
                        <div class="col-md-4">
                            <button type="button" class="btn btn-outline-info w-100 mb-2" onclick="loadTemplate('promotion')">
                                <i class="fas fa-percent"></i> Khuyến mãi
                            </button>
                        </div>
                        <div class="col-md-4">
                            <button type="button" class="btn btn-outline-info w-100 mb-2" onclick="loadTemplate('newsletter')">
                                <i class="fas fa-newspaper"></i> Bản tin
                            </button>
                        </div>
                        <div class="col-md-4">
                            <button type="button" class="btn btn-outline-warning w-100 mb-2" onclick="loadTemplate('cancel_order')">
                                <i class="fas fa-times-circle"></i> Hủy đơn hàng
                            </button>
                        </div>
                        <div class="col-md-4">
                            <button type="button" class="btn btn-outline-success w-100 mb-2" onclick="loadTemplate('thank_you')">
                                <i class="fas fa-heart"></i> Cảm ơn khách hàng
                            </button>
                        </div>
                        <div class="col-md-4">
                            <button type="button" class="btn btn-outline-primary w-100 mb-2" onclick="loadTemplate('order_confirm')">
                                <i class="fas fa-check-circle"></i> Xác nhận đơn hàng
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
