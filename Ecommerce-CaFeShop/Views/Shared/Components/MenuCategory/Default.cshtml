@model List<Ecommerce_CaFeShop.Models.ViewModels.MenuCategoryVM>

@if (ViewContext.RouteData.Values["controller"]?.ToString() == "Category")
{
    <!-- Sidebar style for Category pages -->
    <div class="sidebar-single-widget">
        <h6 class="sidebar-title">DANH MỤC</h6>
        <div class="sidebar-content">
            <ul class="sidebar-menu">
                @foreach (var item in Model)
                {
                    <li>
                        <a asp-controller="Category" asp-action="Index" asp-route-slug="@item.Slug">
                            @item.CategoryName
                        </a>
                    </li>
                }
            </ul>
        </div>

    </div>
}
else
{
    <!-- Menu style for Header -->
    @foreach (var item in Model)
    {
        <li>
            <a asp-controller="Category" asp-action="Index" asp-route-slug="@item.Slug">
                @item.CategoryName
            </a>
        </li>
    }
}