@model IEnumerable<Ecommerce_CaFeShop.Models.Slider>

<!-- Start Hero Slider Section-->
<div class="banner-section">
    <!-- Banner main container -->
    <div class="banner-container">
        <!-- Banner items wrapper -->
        <div class="banner-items">
            @if (Model != null && Model.Any())
            {
                @foreach (var slider in Model)
                {
                    <!-- Start Banner Item -->
                    <div class="banner-item">
                        <!-- Banner Image -->
                        <div class="banner-image">
                            <img src="@Url.Content(slider.HinhAnh ?? "/Images/default-image.jpg")"
                                 alt="@slider.TieuDe"
                                 style="object-fit: cover; width: 100%; height: 100%;"
                                 onerror="this.src='/Images/default-image.jpg'; this.onerror=null;" />
                        </div>
                        <!-- Banner Content -->
                        <div class="banner-content-wrapper">
                            <div class="container">
                                <div class="row">
                                    <div class="col-auto">
                                        <div class="banner-content">
                                            @if (!string.IsNullOrEmpty(slider.MoTa))
                                            {
                                                <h4 class="text-white">@slider.MoTa</h4>
                                            }
                                            <h1 class="title text-white">@slider.TieuDe</h1>
                                            @if (!string.IsNullOrEmpty(slider.Link))
                                            {
                                                @if (slider.Link.StartsWith("/Product/ProductDetail/"))
                                                {
                                                    var productId = slider.Link.Split('/').LastOrDefault();
                                                    <a asp-controller="Product" asp-action="ProductDetail" asp-route-id="@productId" class="btn btn-lg btn-purple">Mua ngay</a>
                                                }
                                                else
                                                {
                                                    <a href="@slider.Link" class="btn btn-lg btn-purple">Mua ngay</a>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- End Banner Item -->
                }
            }
            else
            {
                <!-- Default banner when no data -->
                <div class="banner-item">
                    <div class="banner-image">
                        <img src="~/Images/default-image.jpg" alt="Default Banner" style="object-fit: cover; width: 100%; height: 100%;" />
                    </div>
                    <div class="banner-content-wrapper">
                        <div class="container">
                            <div class="row">
                                <div class="col-auto">
                                    <div class="banner-content">
                                        <h4 class="text-white">Chào mừng đến với</h4>
                                        <h1 class="title text-white">Coffee Shop</h1>
                                        <a asp-controller="Product" asp-action="Index" class="btn btn-lg btn-purple">Xem sản phẩm</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <!-- Navigation Buttons -->
        @if (Model != null && Model.Count() > 1)
        {
            <button class="banner-prev" style="font-size: 20px;">
                &lt;
            </button>
            <button class="banner-next" style="font-size: 20px;">
                &gt;
            </button>
        }
    </div>
</div>

<style>
    .banner-section {
        width: 100%;
        overflow: hidden;
        position: relative;
    }

    .banner-container {
        width: 100%;
        height: 500px; /* Default height for desktop */
        position: relative;
    }

    .banner-items {
        display: flex;
        transition: transform 0.5s ease;
    }

    .banner-item {
        position: relative;
        width: 100%;
        height: 500px; /* Match container height */
        flex-shrink: 0;
    }

    .banner-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .banner-content-wrapper {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        padding: 30px;
        background: linear-gradient(45deg, rgba(0,0,0,0.6), rgba(0,0,0,0.3));
    }

    .banner-content {
        text-align: left;
        max-width: 90%;
    }

    .text-white {
        color: #fff;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.7);
    }

    .title {
        font-size: 2.2em;
        margin: 15px 0;
        font-weight: 700;
    }

    .btn-purple {
        background-color: #6a0dad; /* Purple shade */
        color: #fff;
        padding: 15px 30px;
        text-decoration: none;
        border-radius: 10px;
        display: inline-block;
        transition: all 0.3s ease;
        border: none;
    }

        .btn-purple:hover {
            background-color: #4b0082; /* Darker purple */
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.3);
        }

    .banner-prev, .banner-next {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background-color: rgba(0, 0, 0, 0.5);
        color: #fff;
        border: none;
        padding: 10px 20px;
        cursor: pointer;
        z-index: 10;
        font-size: 16px;
        border-radius: 50%;
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
    }

    .banner-prev {
        left: 20px;
    }

    .banner-next {
        right: 20px;
    }

        .banner-prev:hover, .banner-next:hover {
            background-color: rgba(0, 0, 0, 0.8);
            transform: translateY(-50%) scale(1.1);
        }

    /* Responsive Media Queries */
    @@media (max-width: 768px) {
        .banner-container

    {
        height: 350px; /* Reduced height for tablets */
    }

    .banner-item {
        height: 350px;
    }

    .title {
        font-size: 1.8em; /* Smaller title for better fit */
    }

    .banner-content {
        max-width: 85%; /* Wider content area on smaller screens */
    }

    .btn-purple {
        padding: 12px 25px; /* Smaller button padding */
        font-size: 14px; /* Smaller font size */
    }

    .banner-prev, .banner-next {
        width: 40px;
        height: 40px;
        font-size: 14px; /* Smaller text */
    }

    }

    @@media (max-width: 480px) {
        .banner-container

    {
        height: 250px; /* Reduced height for mobile */
    }

    .banner-item {
        height: 250px;
    }

    .title {
        font-size: 1.4em; /* Even smaller title */
    }

    .banner-content {
        max-width: 90%; /* Almost full width on mobile */
    }

        .banner-content h4 {
            font-size: 14px;
        }

    .btn-purple {
        padding: 10px 20px; /* Smaller button */
        font-size: 12px; /* Smaller font */
    }

    .banner-prev, .banner-next {
        width: 35px;
        height: 35px;
        font-size: 12px; /* Smaller text */
        left: 10px;
    }

    .banner-next {
        right: 10px;
    }

    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const items = document.querySelector('.banner-items');
        const totalItems = document.querySelectorAll('.banner-item').length;
        let currentIndex = 0;

        if (totalItems <= 1) return; // No need for navigation if only one item

        const prevBtn = document.querySelector('.banner-prev');
        const nextBtn = document.querySelector('.banner-next');

        if (prevBtn) {
            prevBtn.addEventListener('click', () => {
                if (currentIndex > 0) {
                    currentIndex--;
                } else {
                    currentIndex = totalItems - 1; // Loop to last
                }
                updateSlide();
            });
        }

        if (nextBtn) {
            nextBtn.addEventListener('click', () => {
                if (currentIndex < totalItems - 1) {
                    currentIndex++;
                } else {
                    currentIndex = 0; // Loop to first
                }
                updateSlide();
            });
        }

        function updateSlide() {
            const offset = -currentIndex * 100;
            items.style.transform = `translateX(${offset}%)`;
        }

        // Auto-slide functionality
        let autoSlideInterval = setInterval(() => {
            if (nextBtn) {
                nextBtn.click();
            }
        }, 5000); // Change slide every 5 seconds

        // Pause auto-slide on hover
        const bannerContainer = document.querySelector('.banner-container');
        if (bannerContainer) {
            bannerContainer.addEventListener('mouseenter', () => {
                clearInterval(autoSlideInterval);
            });

            bannerContainer.addEventListener('mouseleave', () => {
                autoSlideInterval = setInterval(() => {
                    if (nextBtn) {
                        nextBtn.click();
                    }
                }, 5000);
            });
        }
    });
</script>
