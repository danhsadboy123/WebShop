@{
    ViewData["Title"] = ViewBag.CategoryName ?? "Sản phẩm";
}
@model Ecommerce_CaFeShop.Models.ViewModels.PagedProductListVM
@using System.Globalization
<!-- ...:::: Start Breadcrumb Section:::... -->
<div class="breadcrumb-section breadcrumb-bg-color--golden">
    <div class="breadcrumb-wrapper">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <h3 class="breadcrumb-title">@(ViewBag.CategoryName ?? "Sản Phẩm")</h3>
                    <div class="breadcrumb-nav breadcrumb-nav-color--black breadcrumb-nav-hover-color--golden">
                        <nav aria-label="breadcrumb">
                            <ul>
                                <li><a asp-controller="Home" asp-action="Index">Trang Chủ</a></li>
                                <li><a asp-controller="Product" asp-action="Index">Sản Phẩm</a></li>
                                <li class="active" aria-current="page">@ViewBag.CategoryName</li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> <!-- ...:::: End Breadcrumb Section:::... -->
<!-- ...:::: Start Shop Section:::... -->
<div class="shop-section">
    <div class="container">
        <div class="row flex-column-reverse flex-lg-row">
            <div class="col-lg-3">
                @await Component.InvokeAsync("MenuCategory")

               
      @*           <div class="sidebar-single-widget">
                    <h6 class="sidebar-title">Giá</h6>
                    <div class="sidebar-content">
                        <div class="filter-type-select">
                            <ul>
                                <li>
                                    <label class="checkbox-default" for="brakeParts">
                                        <input type="checkbox" id="brakeParts">
                                        <span>Dưới 1 triệu</span>
                                    </label>
                                </li>
                                <li>
                                    <label class="checkbox-default" for="accessories">
                                        <input type="checkbox" id="accessories">
                                        <span>1 - 3 triệu</span>
                                    </label>
                                </li>
                                <li>
                                    <label class="checkbox-default" for="EngineParts">
                                        <input type="checkbox" id="EngineParts">
                                        <span>3 - 6 triệu</span>
                                    </label>
                                </li>
                                <li>
                                    <label class="checkbox-default" for="hermes">
                                        <input type="checkbox" id="hermes">
                                        <span>6 - 9 triệu</span>
                                    </label>
                                </li>
                                <li>
                                    <label class="checkbox-default" for="tommyHilfiger">
                                        <input type="checkbox" id="tommyHilfiger">
                                        <span>9 - 12 triệu</span>
                                    </label>
                                </li>
                                <li>
                                    <label class="checkbox-default" for="tommyHilfiger">
                                        <input type="checkbox" id="tommyHilfiger">
                                        <span>12 - 15 triệu</span>
                                    </label>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div> *@
                @await Component.InvokeAsync("MenuBrand")
             
            </div> <!-- End Sidebar Area -->
            <div class="col-lg-9">
                <!-- Start Shop Product Sorting Section -->
                <div class="shop-sort-section">
                    <div class="container">
                        <div class="row">
                            <!-- Start Sort Wrapper Box -->
                            <div class="sort-box d-flex justify-content-between align-items-md-center align-items-start flex-md-row flex-column"
                                 data-aos="fade-up" data-aos-delay="0">
                                <!-- Start Sort tab Button -->
                            </div> <!-- Start Sort Wrapper Box -->
                        </div>
                    </div>
                </div> <!-- End Section Content -->
                <!-- Start Tab Wrapper -->
                <div class="sort-product-tab-wrapper">
                    <div class="container">
                        <div class="row">
                            <div class="col-12">
                                <div class="tab-content tab-animate-zoom">
                                    <!-- Start List View Product -->
                                    <div class="tab-pane active show sort-layout-single" id="layout-list">
                                        <div class="row">
                                            @foreach (var item in Model.SanPhams)
                                            {
                                                <div class="col-12">
                                                    <!-- Start Product Defautlt Single -->
                                                    <div class="product-list-single product-color--golden"
                                                         data-aos="fade-up" data-aos-delay="0">
                                                        <a asp-controller="Product" asp-action="ProductDetail" asp-route-slug="@item.Slug"
                                                           class="product-list-img-link">
                                                            <img class="img-fluid" src="@Url.Content(item.Image)"
                                                                 alt="@item.ProductName" style="width: 100%; height: 300px; object-fit: cover"
                                                                 onerror="this.src='/images/default-image.jpg';">
                                                        </a>
                                                        <div class="product-list-content">
                                                            <h5 class="product-list-link">
                                                                <a asp-controller="Product" asp-action="ProductDetail" asp-route-slug="@item.Slug">
                                                                    @item.ProductName
                                                                </a>
                                                            </h5>
                                                            <div class="price-section">
                                                                @if (item.DiscountPrice.HasValue && item.DiscountPrice.Value > 0 && item.DiscountPrice.Value < item.Price)
                                                                {
                                                                    <span class="text-lg font-bold text-[#d4a373]">@String.Format(new CultureInfo("vi-VN"), "{0:C}", item.DiscountPrice)</span>
                                                                    <span class="text-sm line-through text-gray-500 ml-2" style="text-decoration:line-through;color:red">@String.Format(new CultureInfo("vi-VN"), "{0:C}", item.Price)</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-lg font-bold text-[#d4a373]">@String.Format(new CultureInfo("vi-VN"), "{0:C}", item.Price)</span>
                                                                }
                                                            </div>
                                                            <p>
                                                                @item.ShortDescription
                                                            </p>
                                                            @* <div class="product-action-icon-link-list">
                                                                <a asp-controller="Cart" asp-action="Cart" data-bs-toggle="modal"
                                                                   data-bs-target="#modalAddcart"
                                                                   class="btn btn-lg btn-black-default-hover">
                                                                    Thêm vào giỏ
                                                                </a>
                                                            </div> *@
                                                        </div>
                                                    </div> <!-- End Product Defautlt Single -->
                                                </div>
                                            }
                                        </div>
                                        <!-- End List View Product -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div> <!-- End Tab Wrapper -->
                    <!-- Start Pagination -->
                    @if (Model.TotalPages > 1)
                    {
                        <div class="page-pagination text-center" data-aos="fade-up" data-aos-delay="0">
                            <ul>
                                @if (Model.CurrentPage > 1)
                                {
                                    <li><a asp-controller="Category" asp-action="Index" asp-route-slug="@ViewBag.CategorySlug" asp-route-page="@(Model.CurrentPage - 1)"><i class="ion-ios-skipbackward"></i></a></li>
                                }
                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li><a class="@(i == Model.CurrentPage ? "active" : "")" asp-controller="Category" asp-action="Index" asp-route-slug="@ViewBag.CategorySlug" asp-route-page="@i">@i</a></li>
                                }
                                @if (Model.CurrentPage < Model.TotalPages)
                                {
                                    <li><a asp-controller="Category" asp-action="Index" asp-route-slug="@ViewBag.CategorySlug" asp-route-page="@(Model.CurrentPage + 1)"><i class="ion-ios-skipforward"></i></a></li>
                                }
                            </ul>
                        </div>
                    }
 <!-- End Pagination -->
                </div> <!-- End Shop Product Sorting Section  -->
            </div>
        </div>
    </div>
</div>
    >