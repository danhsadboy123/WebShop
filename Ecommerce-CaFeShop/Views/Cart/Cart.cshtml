@model IEnumerable<Ecommerce_CaFeShop.Models.ViewModels.CartRequest>
@using System.Globalization
@{
    ViewData["Title"] = "Giỏ hàng";
}
<!-- ...:::: Start Breadcrumb Section:::... -->
<div class="breadcrumb-section breadcrumb-bg-color--golden">
    <div class="breadcrumb-wrapper">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <h3 class="breadcrumb-title">Giỏ hàng</h3>
                    <div class="breadcrumb-nav breadcrumb-nav-color--black breadcrumb-nav-hover-color--golden">
                        <nav aria-label="breadcrumb">
                            <ul>
                                <li><a asp-controller="Home" asp-action="index">Trang Chủ</a></li>
                                <li class="active" aria-current="page">Giỏ Hàng</li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> <!-- ...:::: End Breadcrumb Section:::... -->
<!-- ...:::: Start Cart Section:::... -->
<div class="cart-section">
    <!-- Start Cart Table -->
    <div class="cart-table-wrapper" data-aos="fade-up" data-aos-delay="0">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="table_desc">
                        <div class="table_page table-responsive">
                            <table>
                                <!-- Start Cart Table Head -->
                                <thead>
                                    <tr>
                                        <th class="product_thumb">Hình ảnh</th>
                                        <th class="product_name">Sản phẩm</th>
                                        <th class="product-price">Giá</th>
                                        <th class="product_quantity">Số lượng</th>
                                        <th class="product_total">Tổng tiền</th>
                                        <th class="product_remove"></th>
                                    </tr>
                                </thead> <!-- End Cart Table Head -->
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr data-product-slug="@item.Slug">
                                            <td class="product_thumb">
                                                <a asp-controller="Product" asp-action="ProductDetail" asp-route-slug="@item.Slug" class="image-link">
                                                    <img src="@Url.Content(item.Image ?? "/images/default-image.jpg")" alt="@item.ProductName"
                                                         onerror="this.src='/images/default-image.jpg'; this.onerror=null;">
                                                </a>
                                            </td>
                                            <td class="product_name">
                                                <a href="@Url.Action("ProductDetail", "Product", new { slug = item.Slug })">
                                                    @item.ProductName
                                                </a>
                                            </td>
                                            <td class="product-price item-price">@String.Format(new CultureInfo("vi-VN"), "{0:C}", item.Price)</td>
                                            <td class="product_quantity">
                                                <input type="number" class="quantity-input" data-slug="@item.Slug" value="@item.Quantity" min="1" onchange="updateQuantity(this)" />
                                            </td>
                                            <td class="product_total">
                                                <span id="item-total-price">@String.Format(new CultureInfo("vi-VN"), "{0:C}", (item.Price * item.Quantity))</span>
                                            </td>
                                            <td class="product_remove">
                                                <form asp-controller="Cart" asp-action="RemoveCartItem" asp-route-slug="@item.Slug" style="display: inline;">
                                                    <button class="remove-item-btn btn btn-danger btn-sm" type="submit" title="Xóa sản phẩm" onclick="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này khỏi giỏ hàng?')">
                                                        <i class="fa fa-trash" style="color: white;"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            @if (ViewBag.TotalPages > 1)
                            {
                                <div class="page-pagination text-center" data-aos="fade-up" data-aos-delay="0">
                                    <ul>
                                        <!-- Link trang trước -->
                                        @if (ViewBag.CurrentPage > 1)
                                        {
                                            <li>
                                                <a href="@Url.Action("Cart", new { page = ViewBag.CurrentPage - 1 })">« Trước</a>
                                            </li>
                                        }

                                        <!-- Link các trang -->
                                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                                        {
                                            <li class="@(i == ViewBag.CurrentPage ? "active" : "")">
                                                <a href="@Url.Action("Cart", new { page = i })">@i</a>
                                            </li>
                                        }

                                        <!-- Link trang sau -->
                                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                                        {
                                            <li>
                                                <a href="@Url.Action("Cart", new { page = ViewBag.CurrentPage + 1 })">Sau »</a>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                        <form asp-controller="Cart" asp-action="ClearCart">
                            <div class="cart_submit">
                                <button class="btn btn-md btn-golden" id="clear-cart-btn" type="submit">Xóa tất cả</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div> <!-- End Cart Table -->
    @{
        double cartTotal = 0;
        foreach (var item in Model)
        {
            cartTotal += (double)(item.Quantity * item.Price); // Tính tổng
        }
    }
    <!-- Start Coupon Start -->
    <div class="coupon_area">
        <div class="row justify-content-end">
            <!-- Voucher Section -->
            <div class="col-lg-5" style="margin-right: 2rem">
                <div class="coupon_code" data-aos="fade-up" data-aos-delay="200">
                    <h3>Voucher khuyến mãi</h3>
                    <div class="coupon_inner">
                        <div class="voucher-section mb-3">
                            <label for="voucher-select" class="form-label">Chọn voucher:</label>
                            <select id="voucher-select" class="form-select mb-2" onchange="applyVoucher()">
                                <option value="">-- Chọn voucher --</option>
                                <option value="FREESHIP500" data-type="freeship" data-min="500000">FREESHIP500 - Miễn phí ship đơn từ 500k</option>
                                <option value="DISCOUNT10" data-type="percent" data-value="10" data-min="200000">DISCOUNT10 - Giảm 10% đơn từ 200k</option>
                                <option value="SAVE50K" data-type="fixed" data-value="50000" data-min="300000">SAVE50K - Giảm 50k đơn từ 300k</option>
                                <option value="BUY2GET20" data-type="percent" data-value="20" data-min-qty="2">BUY2GET20 - Giảm 20% khi mua từ 2 sản phẩm</option>
                            </select>
                            <div id="voucher-message" class="small text-muted"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cart Totals -->
            <div class="col-lg-5">
                <div class="coupon_code" data-aos="fade-up" data-aos-delay="400">
                    <h3>Cart Totals</h3>
                    <div class="coupon_inner">
                        <div class="cart_subtotal">
                            <p>Tạm tính</p>
                            <p class="cart_amount" id="cart-subtotal">@String.Format(new CultureInfo("vi-VN"), "{0:C}", cartTotal)</p>
                        </div>
                        <div class="cart_subtotal" id="shipping-section" style="display: none;">
                            <p>Phí vận chuyển</p>
                            <p class="cart_amount" id="shipping-fee">30.000 ₫</p>
                        </div>
                        <div class="cart_subtotal" id="discount-section" style="display: none;">
                            <p>Giảm giá <span id="discount-label"></span></p>
                            <p class="cart_amount text-success" id="discount-amount">-0 ₫</p>
                        </div>
                        <div class="cart_subtotal border-top pt-2">
                            <p><strong>Tổng cộng</strong></p>
                            <p class="cart_amount" id="cart-final-total"><strong>@String.Format(new CultureInfo("vi-VN"), "{0:C}", cartTotal)</strong></p>
                        </div>
                        <div class="checkout_btn">
                            <form asp-controller="Checkout" asp-action="Index" method="post" id="checkout-form">
                                <input type="hidden" id="voucher-code" name="voucherCode" value="" />
                                <input type="hidden" id="discount-amount-hidden" name="discountAmount" value="0" />
                                <input type="hidden" id="shipping-fee-hidden" name="shippingFee" value="0" />
                                <button type="submit" class="btn btn-md btn-golden">Mua hàng</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- End Coupon Start -->
</div> <!-- ...:::: End Cart Section:::... -->
@section Scripts {
    <style>
        .remove-item-btn {
            background-color: #dc3545;
            border: none;
            padding: 8px 12px;
            border-radius: 4px;
            cursor: pointer;
            transition: background-color 0.3s;
        }

            .remove-item-btn:hover {
                background-color: #c82333;
            }

        .product_remove {
            text-align: center;
            vertical-align: middle;
        }
    </style>
    <script>
        let currentVoucher = null;
        let originalSubtotal = @cartTotal;

        function updateQuantity(input) {
            var slug = $(input).data('slug');
            var quantity = parseInt($(input).val());

            var priceStr = $(input).closest('tr').find('.item-price').text().trim();
            var price = parseFloat(priceStr.replace(/[^0-9]/g, ''));

            $.ajax({
                url: "@Url.Action("UpdateCart", "Cart")",
                type: 'POST',
                data: {
                    slug: slug,
                    quantity: quantity
                },
                success: function(response) {
                    if (response.success) {
                        var itemTotal = price * quantity;

                        var formattedItemTotal = new Intl.NumberFormat('vi-VN', {
                            style: 'currency',
                            currency: 'VND'
                        }).format(itemTotal);

                        $(input).closest('tr').find('#item-total-price').text(formattedItemTotal);

                        // Tính lại tổng tiền và cập nhật originalSubtotal
                        var cartData = updateCartTotals();

                        // Reset voucher sections
                        $('#shipping-section').hide();
                        $('#discount-section').hide();

                        // Áp dụng lại voucher nếu có
                        if (currentVoucher) {
                            var voucherSelect = $('#voucher-select');
                            var selectedVoucher = voucherSelect.val();
                            if (selectedVoucher) {
                                applyVoucher();
                            }
                        } else {
                            // Nếu không có voucher, chỉ cần cập nhật final total
                            calculateFinalTotal();
                        }

                    } else {
                        Swal.fire({
                            title: 'Lỗi!',
                            text: response.message,
                            icon: 'error',
                            confirmButtonText: 'OK',
                        }).then(() => {
                            if (response.originalQuantity !== undefined) {
                                $(input).val(response.originalQuantity);
                            }
                        });
                    }
                },
                error: function(xhr, status, error) {
                    console.error(error);
                    $(input).val($(input).attr('value'));
                }
            });
        }

        function updateCartTotals() {
            var cartTotal = 0;
            var totalQuantity = 0;

            $('[id="item-total-price"]').each(function() {
                var itemTotalStr = $(this).text().trim();
                cartTotal += parseFloat(itemTotalStr.replace(/[^0-9]/g, ''));
            });

            $('.quantity-input').each(function() {
                totalQuantity += parseInt($(this).val()) || 0;
            });

            originalSubtotal = cartTotal;

            var formattedCartTotal = new Intl.NumberFormat('vi-VN', {
                style: 'currency',
                currency: 'VND'
            }).format(cartTotal);

            $('#cart-subtotal').text(formattedCartTotal);

            return { total: cartTotal, quantity: totalQuantity };
        }

        function applyVoucher() {
            var voucherSelect = $('#voucher-select');
            var selectedOption = voucherSelect.find('option:selected');
            var messageDiv = $('#voucher-message');

            // Reset voucher
            currentVoucher = null;
            $('#shipping-section').hide();
            $('#discount-section').hide();
            messageDiv.text('').removeClass('text-success text-danger').addClass('text-muted');

            // Reset form values
            $('#voucher-code').val('');
            $('#discount-amount-hidden').val('0');
            $('#shipping-fee-hidden').val('0');

            if (!selectedOption.val()) {
                calculateFinalTotal();
                return;
            }

            var cartData = updateCartTotals();
            var voucherCode = selectedOption.val();
            var voucherType = selectedOption.data('type');
            var voucherValue = selectedOption.data('value');
            var minAmount = selectedOption.data('min') || 0;
            var minQty = selectedOption.data('min-qty') || 0;

            // Kiểm tra điều kiện áp dụng voucher
            if (minAmount > 0 && cartData.total < minAmount) {
                messageDiv.text('Đơn hàng chưa đủ điều kiện. Cần tối thiểu ' + formatCurrency(minAmount))
                    .removeClass('text-success text-muted').addClass('text-danger');
                voucherSelect.val('');
                calculateFinalTotal();
                return;
            }

            if (minQty > 0 && cartData.quantity < minQty) {
                messageDiv.text('Cần mua tối thiểu ' + minQty + ' sản phẩm')
                    .removeClass('text-success text-muted').addClass('text-danger');
                voucherSelect.val('');
                calculateFinalTotal();
                return;
            }

            // Áp dụng voucher
            currentVoucher = {
                code: voucherCode,
                type: voucherType,
                value: voucherValue
            };

            var discountAmount = 0;
            var discountLabel = '';

            switch (voucherType) {
                case 'freeship':
                    $('#shipping-section').show();
                    discountAmount = 30000; // Phí ship cố định
                    discountLabel = '(Miễn phí ship)';
                    messageDiv.text('Áp dụng thành công! Miễn phí vận chuyển.')
                        .removeClass('text-danger text-muted').addClass('text-success');
                    break;

                case 'percent':
                    discountAmount = cartData.total * (voucherValue / 100);
                    discountLabel = '(' + voucherValue + '%)';
                    messageDiv.text('Áp dụng thành công! Giảm ' + voucherValue + '% đơn hàng.')
                        .removeClass('text-danger text-muted').addClass('text-success');
                    break;

                case 'fixed':
                    discountAmount = Math.min(voucherValue, cartData.total);
                    discountLabel = '(Giảm cố định)';
                    messageDiv.text('Áp dụng thành công! Giảm ' + formatCurrency(voucherValue) + '.')
                        .removeClass('text-danger text-muted').addClass('text-success');
                    break;
            }

            if (discountAmount > 0) {
                $('#discount-section').show();
                $('#discount-label').text(discountLabel);
                $('#discount-amount').text('-' + formatCurrency(discountAmount));
            }

            // Lưu thông tin voucher vào form
            $('#voucher-code').val(voucherCode);
            $('#discount-amount-hidden').val(discountAmount);
            $('#shipping-fee-hidden').val($('#shipping-section').is(':visible') ? 30000 : 0);

            calculateFinalTotal();
        }

        function calculateFinalTotal() {
            var subtotal = originalSubtotal;
            var shipping = $('#shipping-section').is(':visible') ? 30000 : 0;
            var discount = 0;

            if ($('#discount-section').is(':visible')) {
                var discountText = $('#discount-amount').text().replace(/[^0-9]/g, '');
                discount = parseFloat(discountText) || 0;
            }

            var finalTotal = subtotal + shipping - discount;
            $('#cart-final-total').html('<strong>' + formatCurrency(finalTotal) + '</strong>');
        }

        function formatCurrency(amount) {
            return new Intl.NumberFormat('vi-VN', {
                style: 'currency',
                currency: 'VND'
            }).format(amount);
        }

        // Khởi tạo khi trang load
        $(document).ready(function() {
            updateCartTotals();
        });
    </script>
}