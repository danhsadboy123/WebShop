@model Ecommerce_CaFeShop.Models.HoaDon

@{
    ViewData["Title"] = "Đặt hàng thành công";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg">
                <div class="card-header bg-success text-white text-center">
                    <h2><i class="fas fa-check-circle"></i> Đặt hàng thành công!</h2>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <h4>Cảm ơn bạn đã đặt hàng!</h4>
                        <p class="text-muted">Mã đơn hàng: <strong>#DH@Model.MaHoaDon.ToString("D6")</strong></p>
                        <p class="text-muted">Ngày đặt: @Model.NgayDatHang.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <h5>Thông tin khách hàng</h5>
                            <hr>
                            <p><strong>Họ tên:</strong> @Model.HoTen</p>
                            <p><strong>Số điện thoại:</strong> @Model.SoDienThoai</p>
                            <p><strong>Email:</strong> @Model.Email</p>
                        </div>
                        <div class="col-md-6">
                            <h5>Địa chỉ giao hàng</h5>
                            <hr>
                            <p><strong>Địa chỉ:</strong> @Model.DiaChi</p>
                            <p><strong>Xã/Phường:</strong> @Model.Xa</p>
                            <p><strong>Quận/Huyện:</strong> @Model.Huyen</p>
                            <p><strong>Tỉnh/TP:</strong> @Model.Tinh</p>
                        </div>
                    </div>

                    <h5>Chi tiết đơn hàng</h5>
                    <hr>
                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th>Số lượng</th>
                                    <th>Đơn giá</th>
                                    <th>Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.ChiTietHoaDons)
                                {
                                    <tr>
                                        <td>@item.SanPham.TenSanPham</td>
                                        <td>@item.SoLuong</td>
                                        <td>@item.Gia.ToString("N0") VNĐ</td>
                                        <td>@item.TongTien.ToString("N0") VNĐ</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="3">Tổng cộng:</th>
                                    <th>@Model.TongTien.ToString("N0") VNĐ</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <div class="row mt-4">
                        <div class="col-md-6">
                            <p><strong>Phương thức thanh toán:</strong> @Model.PhuongThucThanhToan</p>
                            <p>
                                <strong>Trạng thái:</strong>
                                @switch (Model.TrangThai)
                                {
                                    case 1:
                                        <span class="badge bg-warning">Chờ xác nhận</span>
                                        break;
                                    case 2:
                                        <span class="badge bg-info">Đã xác nhận</span>
                                        break;
                                    case 3:
                                        <span class="badge bg-primary">Đang xử lý</span>
                                        break;
                                    case 4:
                                        <span class="badge bg-success">Hoàn thành</span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary">Không xác định</span>
                                        break;
                                }
                            </p>
                        </div>
                    </div>

                    <div class="text-center mt-4">
                        <a href="@Url.Action("Index", "Home")" class="btn btn-primary">
                            <i class="fas fa-home"></i> Tiếp tục mua sắm
                        </a>
                        <a href="@Url.Action("Order", "Account")" class="btn btn-outline-secondary">
                            <i class="fas fa-list"></i> Xem đơn hàng của tôi
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>