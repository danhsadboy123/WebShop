@model IEnumerable<Ecommerce_CaFeShop.Models.SanPham>
@{
    ViewData["Title"] = "Quản lý sản phẩm";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalProducts = ViewBag.TotalProducts ?? 0;
    string search = ViewBag.Search ?? "";
    string category = ViewBag.Category ?? "";
    string brand = ViewBag.Brand ?? "";
    string status = ViewBag.Status ?? "";
    var categories = ViewBag.Categories as List<Ecommerce_CaFeShop.Models.DanhMuc> ?? new List<Ecommerce_CaFeShop.Models.DanhMuc>();
    var brands = ViewBag.Brands as List<Ecommerce_CaFeShop.Models.ThuongHieu> ?? new List<Ecommerce_CaFeShop.Models.ThuongHieu>();
}

<div class="app-content pt-3 p-md-3 p-lg-4">
    <div class="container-xl">
        <!-- Header Section -->
        <div class="row g-3 mb-4 align-items-center justify-content-between">
            <div class="col-auto">
                <h1 class="app-page-title mb-0">
                    <i class="bi bi-box-seam me-2"></i>Quản lý sản phẩm
                </h1>
                <p class="text-muted mb-0">Tổng cộng @totalProducts sản phẩm</p>
            </div>
            <div class="col-auto">
                <div class="page-utilities">
                    <div class="row g-2 justify-content-start justify-content-md-end align-items-center">
                        <div class="col-auto">
                            <a class="btn app-btn-secondary" href="#">
                                <i class="bi bi-download me-2"></i>Xuất Excel
                            </a>
                        </div>
                        <div class="col-auto">
                            <a asp-action="Create" class="btn app-btn-primary">
                                <i class="bi bi-plus-circle me-2"></i>Thêm sản phẩm
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Statistics Cards -->
        <div class="row g-4 mb-4">
            <div class="col-12 col-lg-3">
                <div class="app-card app-card-stat shadow-sm h-100">
                    <div class="app-card-body p-3 p-lg-4">
                        <h4 class="stats-type mb-1">Tổng sản phẩm</h4>
                        <div class="stats-figure">@Model.Count()</div>
                        <div class="stats-meta text-success">
                            <i class="bi bi-arrow-up"></i> Trang @currentPage/@totalPages
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-3">
                <div class="app-card app-card-stat shadow-sm h-100">
                    <div class="app-card-body p-3 p-lg-4">
                        <h4 class="stats-type mb-1">Đang hiển thị</h4>
                        <div class="stats-figure">@Model.Count(p => p.TrangThai == 1)</div>
                        <div class="stats-meta">Sản phẩm hoạt động</div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-3">
                <div class="app-card app-card-stat shadow-sm h-100">
                    <div class="app-card-body p-3 p-lg-4">
                        <h4 class="stats-type mb-1">Đang ẩn</h4>
                        <div class="stats-figure">@Model.Count(p => p.TrangThai == 0)</div>
                        <div class="stats-meta text-warning">Cần xem xét</div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-3">
                <div class="app-card app-card-stat shadow-sm h-100">
                    <div class="app-card-body p-3 p-lg-4">
                        <h4 class="stats-type mb-1">Hết hàng</h4>
                        <div class="stats-figure">@Model.Count(p => p.SoLuong <= 0)</div>
                        <div class="stats-meta text-danger">Cần nhập thêm</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter and Search Section -->
        <div class="app-card app-card-orders-table shadow-sm mb-4">
            <div class="app-card-body">
                <form method="get" asp-action="Index" class="search-form">
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-3">
                            <div class="form-group">
                                <label class="form-label small">Tìm kiếm</label>
                                <input type="text" name="search" value="@search" class="form-control" placeholder="Tên sản phẩm, mã sản phẩm...">
                            </div>
                        </div>
                        <div class="col-12 col-md-2">
                            <div class="form-group">
                                <label class="form-label small">Trạng thái</label>
                                <select name="status" class="form-select">
                                    <option value="">Tất cả trạng thái</option>
                                    <option value="1" selected="@(status == "1")">Đang hiển thị</option>
                                    <option value="0" selected="@(status == "0")">Đang ẩn</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-12 col-md-2">
                            <div class="form-group">
                                <label class="form-label small">Danh mục</label>
                                <select name="category" class="form-select">
                                    <option value="">Tất cả danh mục</option>
                                    @foreach (var cat in categories)
                                    {
                                        <option value="@cat.MaDanhMuc" selected="@(category == cat.MaDanhMuc.ToString())">@cat.TenDanhMuc</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-12 col-md-2">
                            <div class="form-group">
                                <label class="form-label small">Thương hiệu</label>
                                <select name="brand" class="form-select">
                                    <option value="">Tất cả thương hiệu</option>
                                    @foreach (var br in brands)
                                    {
                                        <option value="@br.MaThuongHieu" selected="@(brand == br.MaThuongHieu.ToString())">@br.TenThuongHieu</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-12 col-md-3">
                            <div class="form-group">
                                <label class="form-label small">&nbsp;</label>
                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn app-btn-primary">
                                        <i class="bi bi-search me-1"></i>Lọc
                                    </button>
                                    <a href="@Url.Action("Index")" class="btn app-btn-secondary">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Products Table -->
        <div class="app-card app-card-orders-table shadow-sm mb-4">
            <div class="app-card-body">
                <div class="table-responsive">
                    <table class="table app-table-hover mb-0 text-left">
                        <thead>
                            <tr>
                                <th class="cell">
                                    <input class="form-check-input" type="checkbox" id="checkAll">
                                </th>
                                <th class="cell">Hình ảnh</th>
                                <th class="cell">Thông tin sản phẩm</th>
                                <th class="cell">Danh mục</th>
                                <th class="cell">Giá bán</th>
                                <th class="cell">Tồn kho</th>
                                <th class="cell">Trạng thái</th>
                                <th class="cell">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model)
                            {
                                <tr>
                                    <td class="cell">
                                        <input class="form-check-input row-checkbox" type="checkbox" value="@product.MaSanPham">
                                    </td>
                                    <td class="cell">
                                        <div class="product-image">
                                            <img src="@(product.HinhAnh ?? "/images/default-image.jpg")"
                                                 alt="@product.TenSanPham"
                                                 class="product-thumb"
                                                 onerror="this.src='/images/default-image.jpg';">
                                        </div>
                                    </td>
                                    <td class="cell">
                                        <div class="product-info">
                                            <div class="product-name">@product.TenSanPham</div>
                                            <div class="product-code">@product.MaSanPhamCode</div>
                                            <div class="product-brand">@(product.ThuongHieu?.TenThuongHieu ?? "N/A")</div>
                                        </div>
                                    </td>
                                    <td class="cell">
                                        <span class="badge bg-light text-dark">@(product.DanhMuc?.TenDanhMuc ?? "N/A")</span>
                                    </td>
                                    <td class="cell">
                                        <div class="price-info">
                                            <div class="current-price">@String.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:C}", product.Gia)</div>
                                            @if (product.GiaKhuyenMai.HasValue && product.GiaKhuyenMai.Value > 0)
                                            {
                                                <div class="sale-price">@String.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:C}", product.GiaKhuyenMai)</div>
                                                <div class="discount-percent">-@product.PhanTramGiam%</div>
                                            }
                                        </div>
                                    </td>
                                    <td class="cell">
                                        <div class="stock-info">
                                            @if (product.SoLuong > 10)
                                            {
                                                <span class="badge bg-success">@product.SoLuong</span>
                                            }
                                            else if (product.SoLuong > 0)
                                            {
                                                <span class="badge bg-warning">@product.SoLuong</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Hết hàng</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="cell">
                                        @if (product.TrangThai == 1)
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-eye me-1"></i>Hiển thị
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="bi bi-eye-slash me-1"></i>Ẩn
                                            </span>
                                        }
                                    </td>
                                    <td class="cell">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-id="@product.MaSanPham"
                                               class="btn btn-sm btn-outline-primary" title="Chỉnh sửa">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            @if (product.TrangThai == 1)
                                            {
                                                <form asp-action="HideProduct" method="post" style="display:inline;">
                                                    <input type="hidden" name="id" value="@product.MaSanPham" />
                                                    <button type="submit" class="btn btn-sm btn-outline-warning"
                                                            title="Ẩn sản phẩm"
                                                            onclick="return confirm('Bạn có chắc muốn ẩn sản phẩm này?')">
                                                        <i class="bi bi-eye-slash"></i>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="ShowProduct" method="post" style="display:inline;">
                                                    <input type="hidden" name="id" value="@product.MaSanPham" />
                                                    <button type="submit" class="btn btn-sm btn-outline-success"
                                                            title="Hiển thị sản phẩm"
                                                            onclick="return confirm('Bạn có chắc muốn hiển thị sản phẩm này?')">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                </form>
                                            }

                                            <form asp-action="Delete" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@product.MaSanPham" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                                        title="Xóa sản phẩm"
                                                        onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này? Hành động này có thể không hoàn tác được!')">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Bulk Actions -->
                <div class="bulk-actions mt-3" style="display: none;">
                    <div class="d-flex align-items-center gap-3">
                        <span class="selected-count">0 sản phẩm được chọn</span>
                        <button type="button" class="btn btn-sm btn-outline-success" onclick="bulkShow()">
                            <i class="bi bi-eye me-1"></i>Hiển thị
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-warning" onclick="bulkHide()">
                            <i class="bi bi-eye-slash me-1"></i>Ẩn
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="bulkDelete()">
                            <i class="bi bi-trash me-1"></i>Xóa
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <div class="d-flex justify-content-between align-items-center">
                <div class="showing-info">
                    <small class="text-muted">
                        Hiển thị @((currentPage - 1) * 10 + 1) - @(Math.Min(currentPage * 10, totalProducts)) trong tổng số @totalProducts sản phẩm
                    </small>
                </div>
                <nav aria-label="Phân trang sản phẩm">
                    <ul class="pagination pagination-sm mb-0">
                        <!-- First Page -->
                        @if (currentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { page = 1, search = search, category = category, brand = brand, status = status })">
                                    <i class="bi bi-chevron-double-left"></i>
                                </a>
                            </li>
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { page = currentPage - 1, search = search, category = category, brand = brand, status = status })">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                        }

                        <!-- Page Numbers -->
                        @{
                            int startPage = Math.Max(1, currentPage - 2);
                            int endPage = Math.Min(totalPages, currentPage + 2);
                        }

                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = i, search = search, category = category, brand = brand, status = status })">
                                    @i
                                </a>
                            </li>
                        }

                        <!-- Next Page -->
                        @if (currentPage < totalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { page = currentPage + 1, search = search, category = category, brand = brand, status = status })">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { page = totalPages, search = search, category = category, brand = brand, status = status })">
                                    <i class="bi bi-chevron-double-right"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<style>
    .app-page-title {
        color: #2c3e50;
        font-weight: 600;
    }

    .stats-figure {
        font-size: 2rem;
        font-weight: 700;
        color: #2c3e50;
    }

    .stats-type {
        color: #7c8db5;
        font-size: 0.875rem;
        font-weight: 600;
        text-transform: uppercase;
    }

    .stats-meta {
        font-size: 0.875rem;
        font-weight: 500;
    }

    .product-thumb {
        width: 60px;
        height: 60px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid #e9ecef;
    }

    .product-info .product-name {
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 2px;
    }

    .product-info .product-code {
        font-size: 0.875rem;
        color: #6c757d;
        font-family: monospace;
        margin-bottom: 2px;
    }

    .product-info .product-brand {
        font-size: 0.8rem;
        color: #0d6efd;
        font-weight: 500;
    }

    .price-info .current-price {
        font-weight: 600;
        color: #2c3e50;
    }

    .price-info .sale-price {
        font-size: 0.875rem;
        color: #dc3545;
        font-weight: 600;
    }

    .price-info .discount-percent {
        font-size: 0.75rem;
        color: #198754;
        font-weight: 500;
    }

    .search-form .position-relative i {
        color: #6c757d;
        pointer-events: none;
    }

    .btn-group .btn {
        border-radius: 6px !important;
        margin-right: 4px;
    }

    .bulk-actions {
        background: #f8f9fa;
        padding: 12px;
        border-radius: 8px;
        border: 1px solid #dee2e6;
    }

    .app-card {
        border: none;
        border-radius: 12px;
    }

    .app-card-body {
        padding: 1.5rem;
    }

    .table th {
        border-top: none;
        border-bottom: 2px solid #dee2e6;
        font-weight: 600;
        color: #495057;
        font-size: 0.875rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .table td {
        vertical-align: middle;
        border-bottom: 1px solid #f8f9fa;
    }

    .table tbody tr:hover {
        background-color: #f8f9fa;
    }

    .badge {
        font-size: 0.75rem;
        font-weight: 500;
        padding: 0.5em 0.75em;
    }

    .pagination .page-link {
        border-radius: 6px;
        margin: 0 2px;
        border: 1px solid #dee2e6;
        color: #6c757d;
        padding: 0.5rem 0.75rem;
    }

    .pagination .page-item.active .page-link {
        background-color: #0d6efd;
        border-color: #0d6efd;
        color: white;
    }

    .pagination .page-link:hover {
        background-color: #e9ecef;
        border-color: #dee2e6;
        color: #0d6efd;
    }

    .showing-info {
        color: #6c757d;
        font-size: 0.875rem;
    }

    @@media (max-width: 768px) {
        .table-responsive {
            font-size: 0.875rem;
        }

        .product-thumb {
            width: 40px;
            height: 40px;
        }

        .btn-group .btn {
            padding: 0.25rem 0.5rem;
        }

        .pagination {
            justify-content: center;
        }

        .showing-info {
            text-align: center;
            margin-bottom: 1rem;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Check all functionality
        const checkAll = document.getElementById('checkAll');
        const rowCheckboxes = document.querySelectorAll('.row-checkbox');
        const bulkActions = document.querySelector('.bulk-actions');
        const selectedCount = document.querySelector('.selected-count');

        checkAll.addEventListener('change', function() {
            rowCheckboxes.forEach(checkbox => {
                checkbox.checked = this.checked;
            });
            updateBulkActions();
        });

        rowCheckboxes.forEach(checkbox => {
            checkbox.addEventListener('change', updateBulkActions);
        });

        function updateBulkActions() {
            const checkedBoxes = document.querySelectorAll('.row-checkbox:checked');
            const count = checkedBoxes.length;

            if (count > 0) {
                bulkActions.style.display = 'block';
                selectedCount.textContent = `${count} sản phẩm được chọn`;
            } else {
                bulkActions.style.display = 'none';
            }

            checkAll.indeterminate = count > 0 && count < rowCheckboxes.length;
            checkAll.checked = count === rowCheckboxes.length;
        }
    });

    function bulkShow() {
        const checkedBoxes = document.querySelectorAll('.row-checkbox:checked');
        if (checkedBoxes.length === 0) return;

        if (confirm(`Bạn có chắc muốn hiển thị ${checkedBoxes.length} sản phẩm được chọn?`)) {
            // Implement bulk show logic
            console.log('Bulk show:', Array.from(checkedBoxes).map(cb => cb.value));
        }
    }

    function bulkHide() {
        const checkedBoxes = document.querySelectorAll('.row-checkbox:checked');
        if (checkedBoxes.length === 0) return;

        if (confirm(`Bạn có chắc muốn ẩn ${checkedBoxes.length} sản phẩm được chọn?`)) {
            // Implement bulk hide logic
            console.log('Bulk hide:', Array.from(checkedBoxes).map(cb => cb.value));
        }
    }

    function bulkDelete() {
        const checkedBoxes = document.querySelectorAll('.row-checkbox:checked');
        if (checkedBoxes.length === 0) return;

        if (confirm(`Bạn có chắc muốn xóa ${checkedBoxes.length} sản phẩm được chọn? Hành động này không thể hoàn tác!`)) {
            // Implement bulk delete logic
            console.log('Bulk delete:', Array.from(checkedBoxes).map(cb => cb.value));
        }
    }
</script>