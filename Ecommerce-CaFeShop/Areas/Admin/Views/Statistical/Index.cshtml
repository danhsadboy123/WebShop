@* @{
    ViewData["Title"] = "Thống kê";
}

<div class="app-content pt-3 p-md-3 p-lg-4">
    <div class="container-xl">
        <h1 class="app-page-title">Thống kê</h1>

        <!-- Nav Tabs -->
        <ul class="nav nav-tabs mb-4">
            <li class="nav-item">
                <a class="nav-link active" id="nav-revenue-tab" data-bs-toggle="tab" href="#tab-revenue" role="tab" aria-controls="tab-revenue" aria-selected="true">
                    Thống kê doanh thu
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="nav-sales-tab" data-bs-toggle="tab" href="#tab-sales" role="tab" aria-controls="tab-sales" aria-selected="false">
                    Thống kê sản phẩm
                </a>
            </li>
        </ul>

        <!-- Tab Content -->
        <div class="tab-content">
            <!-- Revenue Chart -->
            <div class="tab-pane fade show active" id="tab-revenue" role="tabpanel" aria-labelledby="nav-revenue-tab">
                <div class="row mb-4">
                    <div class="col-lg-12">
                        <div class="app-card app-card-chart h-100 shadow-sm">
                            <div class="app-card-header">
                                <h5 class="app-card-title">Biểu đồ doanh thu theo ngày</h5>
                                <div class="app-card-actions">
                                    <input type="date" id="datepicker" class="form-control" style="width: 200px;">
                                    <button type="button" class="btn btn-primary btn-filter-date ms-2">Lọc</button>
                                </div>
                            </div>
                            <div class="app-card-body p-3">
                                <div class="chart-container">
                                    <canvas id="revenueChart" style="height: 400px;"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Revenue Table -->
                <div class="row">
                    <div class="col-lg-12">
                        <div class="app-card app-card-table shadow-sm">
                            <div class="app-card-header">
                                <h5 class="app-card-title">Chi tiết doanh thu</h5>
                            </div>
                            <div class="app-card-body">
                                <table class="table app-table-hover mb-0">
                                    <thead>
                                        <tr>
                                            <th>STT</th>
                                            <th>Ngày</th>
                                            <th>Doanh thu (VNĐ)</th>
                                        </tr>
                                    </thead>
                                    <tbody id="load_data">
                                        <!-- Dữ liệu sẽ được thêm vào đây bằng JavaScript -->
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Product Chart -->
            <div class="tab-pane fade" id="tab-sales" role="tabpanel" aria-labelledby="nav-sales-tab">
                <div class="row">
                    <div class="col-lg-8">
                        <div class="app-card app-card-chart h-100 shadow-sm">
                            <div class="app-card-header">
                                <h5 class="app-card-title">Biểu đồ số lượng sản phẩm theo danh mục</h5>
                            </div>
                            <div class="app-card-body p-3">
                                <div class="chart-container">
                                    <canvas id="productChart" style="height: 400px;"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="app-card app-card-stats shadow-sm">
                            <div class="app-card-header">
                                <h5 class="app-card-title">Thống kê tổng quan</h5>
                            </div>
                            <div class="app-card-body">
                                <div class="stats-item mb-3">
                                    <div class="stats-icon">
                                        <i class="bi bi-box text-primary"></i>
                                    </div>
                                    <div class="stats-text">
                                        <div class="stats-number" id="totalProducts">0</div>
                                        <div class="stats-label">Tổng sản phẩm</div>
                                    </div>
                                </div>
                                <div class="stats-item mb-3">
                                    <div class="stats-icon">
                                        <i class="bi bi-people text-success"></i>
                                    </div>
                                    <div class="stats-text">
                                        <div class="stats-number" id="totalCustomers">0</div>
                                        <div class="stats-label">Tổng khách hàng</div>
                                    </div>
                                </div>
                                <div class="stats-item">
                                    <div class="stats-icon">
                                        <i class="bi bi-bag text-warning"></i>
                                    </div>
                                    <div class="stats-text">
                                        <div class="stats-number" id="totalOrders">0</div>
                                        <div class="stats-label">Tổng đơn hàng</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>

    <style>
        .stats-item {
            display: flex;
            align-items: center;
            padding: 15px;
            border: 1px solid #e3e6f0;
            border-radius: 8px;
            background: #f8f9fc;
        }

        .stats-icon {
            margin-right: 15px;
            font-size: 24px;
        }

        .stats-number {
            font-size: 24px;
            font-weight: bold;
            color: #5a5c69;
        }

        .stats-label {
            color: #858796;
            font-size: 14px;
        }

        .app-card-actions {
            display: flex;
            align-items: center;
        }
    </style>

    <script>
        $(document).ready(function () {
            // Biến global cho biểu đồ
            let revenueChart;
            let productChart;

            // Khởi tạo biểu đồ doanh thu
            function initRevenueChart() {
                const ctx = document.getElementById('revenueChart').getContext('2d');
                revenueChart = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: [],
                        datasets: [{
                            label: 'Doanh thu (VNĐ)',
                            data: [],
                            backgroundColor: 'rgba(54, 162, 235, 0.6)',
                            borderColor: 'rgba(54, 162, 235, 1)',
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function(value) {
                                        return new Intl.NumberFormat('vi-VN').format(value) + ' VNĐ';
                                    }
                                }
                            }
                        },
                        plugins: {
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return 'Doanh thu: ' + new Intl.NumberFormat('vi-VN').format(context.raw) + ' VNĐ';
                                    }
                                }
                            }
                        }
                    }
                });
            }

            // Khởi tạo biểu đồ sản phẩm
            function initProductChart() {
                const ctx = document.getElementById('productChart').getContext('2d');
                productChart = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Cà phê rang xay', 'Cà phê hòa tan', 'Thiết bị pha chế', 'Phụ kiện'],
                        datasets: [{
                            data: [45, 30, 15, 10],
                            backgroundColor: [
                                'rgba(255, 99, 132, 0.6)',
                                'rgba(54, 162, 235, 0.6)',
                                'rgba(255, 205, 86, 0.6)',
                                'rgba(75, 192, 192, 0.6)'
                            ],
                            borderColor: [
                                'rgba(255, 99, 132, 1)',
                                'rgba(54, 162, 235, 1)',
                                'rgba(255, 205, 86, 1)',
                                'rgba(75, 192, 192, 1)'
                            ],
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom'
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return context.label + ': ' + context.raw + '%';
                                    }
                                }
                            }
                        }
                    }
                });
            }

            // Load dữ liệu doanh thu
            function loadRevenueData() {
                $.ajax({
                    type: "POST",
                    url: "@Url.Action("GetRevenue", "Statistical")",
                    success: function (data) {
                        const labels = [];
                        const values = [];

                        data.forEach(item => {
                            labels.push(moment(item.date).format('DD/MM/YYYY'));
                            values.push(item.revenue);
                        });

                        revenueChart.data.labels = labels;
                        revenueChart.data.datasets[0].data = values;
                        revenueChart.update();

                        // Cập nhật bảng
                        updateRevenueTable(data);
                    },
                    error: function(xhr, status, error) {
                        console.error("Lỗi khi tải dữ liệu doanh thu:", error);
                    }
                });
            }

            // Cập nhật bảng doanh thu
            function updateRevenueTable(data) {
                let html = "";
                data.forEach((item, index) => {
                    html += `
                        <tr>
                            <td>${index + 1}</td>
                            <td>${moment(item.date).format('DD/MM/YYYY')}</td>
                            <td>${new Intl.NumberFormat('vi-VN').format(item.revenue)} VNĐ</td>
                        </tr>
                    `;
                });
                $("#load_data").html(html);
            }

            // Load thống kê tổng quan
            function loadOverallStats() {
                // Giả lập dữ liệu - bạn có thể tạo API endpoint để lấy dữ liệu thực
                $("#totalProducts").text("125");
                $("#totalCustomers").text("89");
                $("#totalOrders").text("67");
            }

            // Xử lý nút lọc ngày
            $(".btn-filter-date").click(function () {
                const filterdate = $("#datepicker").val();
                if (!filterdate) {
                    alert("Vui lòng chọn ngày để lọc!");
                    return;
                }

                $.ajax({
                    type: "POST",
                    url: "@Url.Action("SubmitFilterDate", "Statistical")",
                    data: { filterdate: filterdate },
                    success: function (data) {
                        const labels = [];
                        const values = [];

                        data.forEach(item => {
                            labels.push(moment(item.date).format('DD/MM/YYYY'));
                            values.push(item.revenue);
                        });

                        revenueChart.data.labels = labels;
                        revenueChart.data.datasets[0].data = values;
                        revenueChart.update();

                        updateRevenueTable(data);
                    },
                    error: function(xhr, status, error) {
                        console.error("Lỗi khi lọc dữ liệu:", error);
                    }
                });
            });

            // Khởi tạo tất cả
            initRevenueChart();
            initProductChart();
            loadRevenueData();
            loadOverallStats();
        });
    </script>
} *@