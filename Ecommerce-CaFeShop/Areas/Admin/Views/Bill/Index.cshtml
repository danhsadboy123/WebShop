                    <!-- Bộ lọc -->
                    <div class="filter-section mb-3">
                        <form method="get" asp-action="Index">
                            <div class="row">
                                <div class="col-md-3">
                                    <select class="form-select" name="status">
                                        <option value="">Tất cả trạng thái</option>
                                        <option value="0" selected="@(ViewBag.CurrentStatus?.ToString() == "0" ? "selected" : null)">Chờ xác nhận</option>
                                        <option value="1" selected="@(ViewBag.CurrentStatus?.ToString() == "1" ? "selected" : null)">Chưa thanh toán</option>
                                        <option value="2" selected="@(ViewBag.CurrentStatus?.ToString() == "2" ? "selected" : null)">Đã thanh toán</option>
                                        <option value="3" selected="@(ViewBag.CurrentStatus?.ToString() == "3" ? "selected" : null)">Đang giao hàng</option>
                                        <option value="4" selected="@(ViewBag.CurrentStatus?.ToString() == "4" ? "selected" : null)">Đã giao hàng</option>
                                        <option value="5" selected="@(ViewBag.CurrentStatus?.ToString() == "5" ? "selected" : null)">Đã hủy</option>
                                        <option value="6" selected="@(ViewBag.CurrentStatus?.ToString() == "6" ? "selected" : null)">Đang xử lý</option>
                                        <option value="7" selected="@(ViewBag.CurrentStatus?.ToString() == "7" ? "selected" : null)">Đã xác nhận</option>
                                        <option value="8" selected="@(ViewBag.CurrentStatus?.ToString() == "8" ? "selected" : null)">Hoàn thành</option>
                                        <option value="9" selected="@(ViewBag.CurrentStatus?.ToString() == "9" ? "selected" : null)">Trả hàng</option>
                                        <option value="10" selected="@(ViewBag.CurrentStatus?.ToString() == "10" ? "selected" : null)">Hoàn tiền</option>
