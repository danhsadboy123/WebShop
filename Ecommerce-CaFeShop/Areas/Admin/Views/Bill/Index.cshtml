                                {
                                    <tr>
                                        <td colspan="7" class="text-center">
                                            <em>Chưa có đơn hàng nào</em>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Phân trang -->
                    @if (ViewBag.TotalPages > 1)
                    {
                        <nav aria-label="Page navigation" class="mt-4">
                            <ul class="pagination justify-content-center">
                                @if (ViewBag.HasPrevious)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Index", new { 
                                            page = ViewBag.CurrentPage - 1, 
                                            status = ViewBag.CurrentStatus, 
                                            dateFilter = ViewBag.DateFilter, 
                                            search = ViewBag.Search 
                                        })">Trước</a>
                                    </li>
                                }

                                @for (int i = Math.Max(1, ViewBag.CurrentPage - 2); i <= Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2); i++)
                                {
                                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { 
                                            page = i, 
                                            status = ViewBag.CurrentStatus, 
                                            dateFilter = ViewBag.DateFilter, 
                                            search = ViewBag.Search 
                                        })">@i</a>
                                    </li>
                                }

                                @if (ViewBag.HasNext)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Index", new { 
                                            page = ViewBag.CurrentPage + 1, 
                                            status = ViewBag.CurrentStatus, 
                                            dateFilter = ViewBag.DateFilter, 
                                            search = ViewBag.Search 
                                        })">Sau</a>
                                    </li>
                                }
                            </ul>
                        </nav>

                        <div class="text-center mt-2">
                            <small class="text-muted">
                                Trang @ViewBag.CurrentPage của @ViewBag.TotalPages 
                                (Tổng @ViewBag.TotalBills đơn hàng)
                            </small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .stat-card {
            border-radius: 10px;
            padding: 20px;
            color: white;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
        }

        .stat-icon {
            font-size: 2.5rem;
            margin-right: 15px;
            opacity: 0.8;
        }

        .stat-content h4 {
            margin: 0;
            font-size: 2rem;
            font-weight: 700;
        }

        .stat-content p {
            margin: 0;
            font-size: 0.9rem;
            opacity: 0.9;
        }

        .filter-section {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 8px;
            border: 1px solid #dee2e6;
        }

        .customer-info, .date-info {
            line-height: 1.2;
        }

        .action-buttons {
            display: flex;
            gap: 5px;
        }

        .table th {
            background-color: #0d2a27;
            color: white;
            border: none;
        }

        .table-striped > tbody > tr:nth-of-type(odd) > td {
            background-color: #f8f9fa;
        }

        @@media (max-width: 768px) {
            .stat-card {
                text-align: center;
                flex-direction: column;
            }

            .stat-icon {
                margin-right: 0;
                margin-bottom: 10px;
            }
        }
    </style>
    <script>
        function updateStatus(orderId, status) {
            if (confirm('Bạn có chắc chắn muốn cập nhật trạng thái đơn hàng này?')) {
                var form = document.createElement('form');
                form.method = 'post';
                form.action = '@Url.Action("UpdateStatus", "Bill")';

                var idInput = document.createElement('input');
                idInput.type = 'hidden';
                idInput.name = 'id';
                idInput.value = orderId;

                var statusInput = document.createElement('input');
                statusInput.type = 'hidden';
                statusInput.name = 'status';
                statusInput.value = status;

                form.appendChild(idInput);
                form.appendChild(statusInput);
                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
}