@model IEnumerable<Ecommerce_CaFeShop.Models.HoaDon>
@{
    ViewData["Title"] = "Quản lý đơn hàng";
}

@{
    string GetStatusText(int status)
    {
        return status switch
        {
            0 => "Chờ xác nhận",
            1 => "Chưa thanh toán",
            2 => "Đã thanh toán",
            3 => "Đang giao hàng",
            4 => "Đã giao hàng",
            5 => "Đã hủy",
            6 => "Đang xử lý",
            7 => "Đã xác nhận",
            8 => "Hoàn thành",
            9 => "Trả hàng",
            10 => "Hoàn tiền",
            _ => "Không xác định"
        };
    }

    string GetStatusBadgeClass(int status)
    {
        return status switch
        {
            0 => "warning",      // Chờ xác nhận
            1 => "danger",       // Chưa thanh toán
            2 => "success",      // Đã thanh toán
            3 => "info",         // Đang giao hàng
            4 => "success",      // Đã giao hàng
            5 => "danger",       // Đã hủy
            6 => "warning",      // Đang xử lý
            7 => "success",      // Đã xác nhận
            8 => "success",      // Hoàn thành
            9 => "warning",      // Trả hàng
            10 => "info",        // Hoàn tiền
            _ => "secondary"     // Không xác định
        };
    }
}

